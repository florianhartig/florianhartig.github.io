@article{schiro2015genetic,
  author   = {Schiro, Gabriele and Fahrentrapp, Johannes and Hartig, Florian and Panassiti, Bernd},
  title    = {A genetic analysis reveals low prevalence of phytoplasma infection in Hyalesthes obsoletus Signoret, vector of ‘bois noir’, in SW-Germany},
  journal  = {PeerJ Preprints},
  year     = {2015},
  doi      = {10.7287/peerj.preprints.732},
  abstract = {Bois Noir is a grapevine disease responsible for severe economic losses in wine production. Bois Noir is caused by Candidatus Phytoplasma solani, cell wall-less bacteria belonging to the taxonomic group 16Sr-XII-A. In Germany, they are known to be vectored from plant to plant by the cixiid Hyalesthes obsoletus, but so far the prevalence of the disease in the vector population, as well as its spatio-temporal distribution is poorly understood. We therefore analyzed infections of H. obsoletus collected in different vineyards in Baden (South-Western Germany) with quantitative real-time PCR. From 125 analyzed individuals, only five were infected with Ca. Phytoplasma solani. All infected individuals were colonized by Ca. Phytoplasma solani type I which is associated with the host plant Urtica dioica (stinging nettle). More research is needed to understand the reasons of this surprisingly low prevalence of Bois Noir in the population of H. obsoletus in South-West Germany.},
  significance = {Bois noir is a grapevine disease that causes severe losses in wine production. It is caused by the bacterium Candidatus Phytoplasma solani, which the planthopper Hyalesthes obsoletus carries from plant to plant; the insect’s two most relevant host plants in Germany are stinging nettle and field bindweed, and the bacterium comes in a genetic type linked to each. The disease has become a growing concern in Germany. In the Baden region of south-western Germany, earlier work showed that the insect occurs throughout the region and gave a basic picture of its ecology, but how many of the insects actually carry the bacterium was poorly known. Earlier studies in other regions, and one in Baden in other years, had reported higher infection rates. \par The study finds that only five of 125 Hyalesthes obsoletus planthoppers collected in different vineyards in Baden carried the bois noir bacterium, and all five carried the type linked to stinging nettle. The infected insects came from places spread across the region, with no discernible spatial pattern. The paper judges that chance alone cannot reconcile this with a true prevalence of around 20%. It names differences in sampling as a plausible but untested explanation: its sites were chosen at random, whereas the site choice in earlier studies was sometimes not clearly described and may have been close to vineyards where the disease was already known, which would raise the apparent infection rate. The paper stresses that it can only speculate here. A further aim, to compare the body size and weight of infected and uninfected insects, could not be answered because so few insects were infected. \par The results suggest that infection in the planthopper in Baden may be lower than earlier figures imply. The paper does not decide whether this reflects a real decline of the disease in the insect population or systematic differences between studies. It calls for larger surveys with more insects and more sampling sites, together with analysis of the host plants (stinging nettle, field bindweed and grapevine), to tell the two apart. Limits remain: the text is a preprint that has not been peer-reviewed, and only five infected insects were found.},
  license = {CC BY 4.0},
  funding = {State institute of Oenology Freiburg (Staatliches Weinbauinstitut Freiburg)},
}

@article{latifi2015stratified,
  author  = {Latifi, Hooman and Fassnacht, Fabian E. and Hartig, Florian and Berger, Christian and Hern{\'a}ndez, Jaime and Corval{\'a}n, Patricio and Koch, Barbara},
  title   = {Stratified aboveground forest biomass estimation by remote sensing data},
  journal = {International Journal of Applied Earth Observation and Geoinformation},
  year    = {2015},
  volume  = {38},
  pages   = {229--241},
  doi     = {10.1016/j.jag.2015.01.016},
  abstract = {Remote sensing-assisted estimates of aboveground forest biomass are essential for modeling carbon budgets. It has been suggested that estimates can be improved by building species- or strata-specific biomass models. However, few studies have attempted a systematic analysis of the benefits of such stratification, especially in combination with other factors such as sensor type, statistical prediction method and sampling design of the reference inventory data. We addressed this topic by analyzing the impact of stratifying forest data into three classes (broadleaved, coniferous and mixed forest). We compare predictive accuracy (a) between the strata (b) to a case without stratification for a set of pre-selected predictors from airborne LiDAR and hyperspectral data obtained in a managed mixed forest site in southwestern Germany. We used 5 commonly applied algorithms for biomass predictions on bootstrapped subsamples of the data to obtain cross validated RMSE and r² diagnostics. Those values were analyzed in a factorial design by an analysis of variance (ANOVA) to rank the relative importance of each factor. Selected models were used for wall-to-wall mapping of biomass estimates and their associated uncertainty. The results revealed marginal advantages for the strata-specific prediction models over the unstratified ones, which were more obvious on the wall-to-wall mapped area-based predictions. Yet further tests are necessary to establish the generality of these results. Input data type and statistical prediction method are concluded to remain the two most crucial factors for the quality of remote sensing-assisted biomass models.},
  significance = {Estimates of aboveground forest biomass from remote sensing feed into carbon budgets. It has been suggested that these estimates improve when separate models are built for forest types, for example broadleaved, coniferous and mixed stands; this is a compromise where predicting individual tree species is unrealistic, as in highly mixed stands. Few studies have assessed this benefit systematically, especially alongside other choices that shape model quality, such as the type of remote-sensing data and the statistical method. The paper tests the assumption that stratifying the plots in this way improves the accuracy of biomass models. \par The paper argues that the value of stratification has to be judged against the other modelling choices, and finds it small compared with the type of input data and the prediction method. The study tested this in a managed mixed forest near Karlsruhe, southwest Germany. It used airborne LiDAR (laser scanning) and hyperspectral (many narrow colour bands) predictors in separate models, with five prediction algorithms, and repeated each model fit on 500 bootstrap subsamples (random resamples of the plots) to obtain cross-validated error measures. An analysis of variance then ranked how much each factor changed model quality. Models built separately for each forest type were only marginally better than a single unstratified model fitted on a similar number of plots. Maps of predicted biomass covering the whole study area also differed between the two approaches, but only moderately. Input data type, LiDAR versus hyperspectral, and prediction method ranked as the two most important factors for model quality. \par The results suggest that, for biomass models, the choice of input data and prediction method affects accuracy more than stratification does. The paper states that further tests on other datasets are needed to show whether the result holds beyond this site. It proposes the factor ranking as a basis for comparing modelling strategies objectively, a possible step towards a quantitative ranking of such strategies. It also notes a practical cost of stratification: each forest type yields its own map, and these would have to be merged into one product.},
  license = {publisher (subscription)},
  funding = {German Aerospace Center; German Federal Ministry of Economy and Technology based on the Bundestag resolution (50EE1025); German Federal Ministry of Economy and Technology based on the Bundestag resolution (50EE1265-66)},
}

@article{panassiti2015bayesian,
  author  = {Panassiti, Bernd and Hartig, Florian and Breuer, Michael and Biedermann, Robert},
  title   = {Bayesian inference of environmental and biotic factors determining the occurrence of the grapevine disease ‘bois noir’},
  journal = {Ecosphere},
  year    = {2015},
  volume  = {6},
  number  = {8},
  pages   = {143},
  doi     = {10.1890/ES14-00439.1},
  abstract = {Insect‐vectored plant diseases often create complex epidemiological systems that are challenging to understand, predict, and manage. An example is ‘bois noir' (BN), a phytoplasma‐associated grapevine disease commonly found in European vineyards. Although BN has the potential to cause substantial economic damage, the factors that contribute to BN prevalence in vineyards are still not well understood. We used Bayesian inference with generalized linear mixed‐effect models to test the hypotheses that (1) grapevine varieties exhibit different BN susceptibility; (2) environment drivers influence prevalence of the disease and occurrence of the vector; and (3) the presence of the main vector is a major determinant of BN occurrence. We found that the presence of the vector Hyalesthes obsoletus increased with increasing isothermality, minimum temperatures during the coldest period, soil erosion, and natural vegetation in close proximity to the vineyards. Presence of the BN disease increased with presence of the vector as well as increasing altitudes and mean annual temperatures. After accounting for those factors, Chardonnay and Riesling showed higher disease prevalence than Müller‐Thurgau, Silvaner, and Merlot. Although the vector had an overall positive effect on the disease prevalence, disease and vector occurrence show distinct spatial patterns. In conclusion, our analysis suggests that vector presence is not the only, and maybe not the most important factor for BN disease prevalence. Environment and grape cultivar also play important roles. Hence, area‐wide predictions of both environmental disease risk and vector presence, together with information about the susceptibility of grape cultivars, will enable a more targeted disease management. Our modelling framework could easily be applied to other diseases of concern, such as apple proliferation or flavescence dorée.},
  significance = {Insect-borne plant diseases are tangled systems of host plants, insect vectors and pathogens, and good data on them are often missing. For the grapevine disease bois noir, management focuses mainly on controlling its main vector, the planthopper Hyalesthes obsoletus, which is reasonable for the main carrier. An earlier habitat model (Panassiti et al. 2013) mapped where the insect is likely to live but did not test whether the disease occurs in the same places. The paper takes on the implicit assumption that knowing where the vector occurs is enough to explain where the disease occurs, although other vectors, other host plants or differences in cultivar susceptibility could break that link. \par The paper argues that the presence of the main vector explains only part of where bois noir occurs, so the distribution of the insect alone does not seem sufficient to explain the distribution of the disease. It tests this with a survey of more than 100,000 grapevines in the Baden region of south-west Germany, analysed with a Bayesian mixed regression model (infected versus healthy plants, allowing for differences between regions and owners, with uncertainty carried through). Vector presence, taken from the earlier habitat model, had a positive effect that the paper describes as relatively weak and seemingly variable across the region. The disease increased with altitude and mean annual temperature, and disease and vector seemed to prefer different environments, spatially separated except in the north-east. With environment accounted for, Chardonnay and Riesling had the highest disease prevalence. \par The paper reads these results as a reason to add to vector control less susceptible cultivars and area-wide maps of disease risk and vector presence to target measures. It treats the cultivar pattern as a correlation needing experimental verification, because growers choose cultivars to suit the site, and leaves open why vector and disease diverge, naming environmental effects, other host plants and unknown vectors as candidates. It proposes the framework for other diseases, such as apple proliferation, without testing it there. Murolo et al. (2020) discuss the paper’s findings on climate and altitude against their own result that climate did not correlate with the spatial pattern of the disease.},
  significance_refs = {10.1017/S0007485313000163 10.1038/s41598-020-66210-7},
  license = {CC BY 3.0},
  funding = {Association of German Wine Scientists (FDW)},
}

@article{hartig2015dale,
  author  = {Hartig, Florian},
  title   = {Dale & Fortin – the revised guide to spatial analysis},
  journal = {Frontiers of Biogeography},
  year    = {2015},
  volume  = {7},
  number  = {2},
  doi     = {10.21425/F5FBG27393},
  abstract = {It may be too early to call “Spatial Analysis – A Guide for Ecologists” by Fortin and Dale a modern classic, but since its publication in 2005 the book has certainly become a widely cited reference in the field of spatial ecology. Cambridge University Press has now published a second edition of this introductory textbook.},
  significance = {Since its first edition in 2005, “Spatial Analysis – A Guide for Ecologists” by Fortin and Dale has served spatial ecologists as a reference text. Spatial statistics has moved on since then: with more computing power and new numerical methods, the field has shifted from testing data against null models or spatial homogeneity towards fitting explicit, often hierarchical spatial models, with a larger role for Bayesian inference and simulation. The review assesses the book’s second edition against the authors’ stated aim of more breadth and against these developments. \par The review finds the second edition an improved and modernised version of an excellent reference, but not a broader one. The layout is more readable, the text has gained new material and more recent references, and the book still covers data types and sampling design, point patterns, continuous spatial patterns, spatial clustering and spatio-temporal data. The methodological scope, however, has hardly changed: the authors comment on hierarchical models and Bayesian inference in their final chapter, but the book does not treat them in depth. A restructuring that nearly doubles the number of chapters partly obscures this, and in the review’s view the simpler structure of the first edition supported the storyline better. \par The review sees no current alternative to the book for a theoretically solid yet accessible overview of classic spatial methods in ecology. It notes that the book remains rather theoretical, with little on practical and computational issues or case studies, and suggests that a chapter on Bayesian inference and hierarchical models, and a more applied focus such as a website with code, would have made it more useful for self-study. It points readers to complementary texts for a gentler introduction, for practical implementation, for point patterns and for hierarchical Bayesian modelling.},
  abstract_kind = {opening},
  license = {CC BY 4.0},
}

