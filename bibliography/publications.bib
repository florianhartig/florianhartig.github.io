@article{hulsmann2024latitudinal,
  author   = {Hülsmann, Lisa and Chisholm, Ryan A. and Comita, Liza and Visser, Marco D. and de Souza Leite, Melina and Aguilar, Salomon and Anderson-Teixeira, Kristina J. and Bourg, Norman A. and Brockelman, Warren Y. and Bunyavejchewin, Sarayudh and Castaño, Nicolas and Chang-Yang, Chia-Hao and Chuyong, George B. and Clay, Keith and Davies, Stuart J. and Duque, Alvaro and Ediriweera, Sisira and Ewango, Corneille and Gilbert, Gregory S. and Holík, Jan and Howe, Robert W. and Hubbell, Stephen P. and Itoh, Akira and Johnson, Daniel J. and Kenfack, David and Král, Kamil and Larson, Andrew J. and Lutz, James A. and Makana, Jean-Remy and Malhi, Yadvinder and McMahon, Sean M. and McShea, William J. and Mohamad, Mohizah and Nasardin, Musalmah and Nathalang, Anuttara and Norden, Natalia and Oliveira, Alexandre A. and Parmigiani, Renan and Perez, Rolando and Phillips, Richard P. and Pongpattananurak, Nantachai and Sun, I-Fang and Swanson, Mark E. and Tan, Sylvester and Thomas, Duncan and Thompson, Jill and Uriarte, Maria and Wolf, Amy T. and Yao, Tze Leong and Zimmerman, Jess K. and Zuleta, Daniel and Hartig, Florian},
  title    = {Latitudinal patterns in stabilizing density dependence of forest communities},
  journal  = {Nature},
  year     = {2024},
  volume   = {627},
  number   = {8004},
  pages    = {564--571},
  doi      = {10.1038/s41586-024-07118-4},
  abstract = {Numerous studies have shown reduced performance in plants that are surrounded by neighbours of the same species, a phenomenon known as conspecific negative density dependence (CNDD). A long-held ecological hypothesis posits that CNDD is more pronounced in tropical than in temperate forests, which increases community stabilization, species coexistence and the diversity of local tree species. Previous analyses supporting such a latitudinal gradient in CNDD have suffered from methodological limitations related to the use of static data. Here we present a comprehensive assessment of latitudinal CNDD patterns using dynamic mortality data to estimate species-site-specific CNDD across 23 sites. Averaged across species, we found that stabilizing CNDD was present at all except one site, but that average stabilizing CNDD was not stronger toward the tropics. However, in tropical tree communities, rare and intermediate abundant species experienced stronger stabilizing CNDD than did common species. This pattern was absent in temperate forests, which suggests that CNDD influences species abundances more strongly in tropical forests than it does in temperate ones. We also found that interspecific variation in CNDD, which might attenuate its stabilizing effect on species diversity, was high but not significantly different across latitudes. Although the consequences of these patterns for latitudinal diversity gradients are difficult to evaluate, we speculate that a more effective regulation of population abundances could translate into greater stabilization of tropical tree communities and thus contribute to the high local diversity of tropical forests.},
  featured = {true},
  significance = {The Janzen–Connell hypothesis seeks to explain the high diversity of tropical forests by conspecific negative density dependence (CNDD): trees do worse when many neighbours of their own species stand nearby, because specialised enemies such as herbivores and pathogens spread among such neighbours. This self-limitation should keep any one species from dominating and so let many coexist, and the hypothesis predicts that it is stronger towards the tropics. Seed and seedling experiments, which may be hard to compare across studies, found no trend with latitude. Large-scale studies of static forest inventories – single snapshots of which trees stand where – such as LaManna et al. (2017) reported a strong one, but later work attributed that pattern to statistical artefacts of such data. The problem the paper takes on is whether the average strength of CNDD really increases from temperate to tropical forests. \par The study tests whether trees suffer more from neighbours of their own species in tropical than in temperate forests, using repeated censuses at 23 forest sites from the tropics to the temperate zone. It follows individual small trees from one census to the next and relates their chance of dying to the density of conspecific neighbours, a design that avoids the artefacts of static data. CNDD was present at all sites but one, yet on average it was not stronger towards the tropics, and it varied strongly between species at every latitude. Only one pattern changed with latitude: in tropical forests rare species suffered stronger CNDD than common ones, whereas temperate forests showed no such link. LaManna et al. (2017) had reported this pattern from static data; the study provides stronger evidence for it, from dynamic data that avoid the main artefacts of static analyses. \par The results shift the question from how strong CNDD is to what it does. If CNDD hits rare species hardest in the tropics, it may hold species abundances in check more effectively there, even though its average strength is similar across latitudes. The paper reads this as a refined and only partly supportive version of the Janzen–Connell idea, and it states that the causal link between CNDD and rarity remains to be established.},
  significance_refs = {10.1126/science.aam5678},
  license = {CC BY 4.0},
  funding = {Bavarian Ministry of Science and the Arts, Bavarian Climate Research Network (bayklif); US National Science Foundation (DEB-1845403); ForestGEO network; Smithsonian Institute; PROEX-CAPES (Coordenação de Aperfeiçoamento de Pessoal de Nível Superior—Brazil); NSF (ForestGEO workshop 2019) (NSF-2020424)},
}

@article{hartig2024novel,
  author   = {Hartig, Florian and Abrego, Nerea and Bush, Alex and Chase, Jonathan M. and Guillera-Arroita, Gurutzeta and Leibold, Mathew A. and Ovaskainen, Otso and Pellissier, Lo{\"i}c and Pichler, Maximilian and Poggiato, Giovanni and Pollock, Laura and Si-Moussi, Sara and Thuiller, Wilfried and Viana, Duarte S. and Warton, David I. and Zurell, Damaris and Yu, Douglas W.},
  title    = {Novel community data in ecology-properties and prospects},
  journal  = {Trends in Ecology \& Evolution},
  year     = {2024},
  volume   = {39},
  number   = {3},
  pages    = {280--293},
  doi      = {10.1016/j.tree.2023.09.017},
  abstract = {New technologies for monitoring biodiversity such as environmental (e)DNA, passive acoustic monitoring, and optical sensors promise to generate automated spatiotemporal community observations at unprecedented scales and resolutions. Here, we introduce ‘novel community data’ as an umbrella term for these data. We review the emerging field around novel community data, focusing on new ecological questions that could be addressed; the analytical tools available or needed to make best use of these data; and the potential implications of these developments for policy and conservation. We conclude that novel community data offer many opportunities to advance our understanding of fundamental ecological processes, including community assembly, biotic interactions, micro- and macroevolution, and overall ecosystem functioning.},
  featured = {true},
  significance = {Describing, modelling and managing changes in biodiversity is hampered because conventional monitoring is limited in spatial, temporal and taxonomic coverage and is often poorly standardised. Automated sensors now promise to change this: DNA extracted from water, soil or air (environmental DNA, eDNA), passively recording microphones, and cameras whose images are identified by machine learning each produce, together with the pipelines that process their output, inventories of whole communities without a human identifying the species. It is tempting to treat such data as more of the same kind, to be fed into the established analyses of species ranges and niches. The paper challenges this assumption. \par “Novel community data” is the paper’s term for inventories of whole communities produced by automated sensors and pipelines, and the paper argues that they differ from conventional inventories in kind, not only in quantity. Novel community data typically follow fixed protocols with controls, so they depend less on individual observers. Their errors are real but usually more consistent, and therefore easier to correct statistically. They can reach finer spatial, temporal and taxonomic resolution, come with rich metadata, and can record interactions between species directly, for example from gut contents. Exploiting these properties, the paper argues, needs dedicated analysis. Joint species distribution models describe all species of a community together and estimate associations among them beyond their shared responses to the environment. Time-series methods use the order of events to separate cause from correlation. Network analysis and explicit models of observation error complete the set. \par For the paper, data and methods therefore need to be developed together. Combined, they could address long-standing questions about how communities assemble and how biotic interactions shape where species occur, and they could support biodiversity governance. An existing example is the UK’s licensing scheme for the great crested newt, where eDNA surveys for the newt underpin a risk-zone map and a market for compensation habitat.},
  license = {publisher (subscription)},
  funding = {sDiv, the Synthesis Centre of iDiv (DFG) (DFG FZT 118, 202548816); European Union's Horizon Europe, project NaturaConnect (grant agreement No 101060429); OBSGESSION; French Agence Nationale de la Recherche (ANR), Gambas project (ANR-18-CE02-0025); French Biodiversity Office, FrenchBiodiv project; Academy of Finland (336212 and 345110); European Research Council (ERC), Horizon 2020, ERC-synergy project LIFEPLAN (grant agreement No 856506); Spanish Ministry of Science and Innovation, Agencia Estatal de Investigación, 'ESF Investing in your future' (Ramón y Cajal grant) (RYC2020-028826-I); NSF (award 2025118); Spanish Ministry of Science and Innovation (Juan de la Cierva Incorporación postdoctoral grant) (IJC2020-044545-I); CAS Strategic Priority Research Program (XDA20050202); CAS Key Research Program of Frontier Sciences (QYZDY-SSW-SMC024)},
}

@article{lamanna2024consequences,
  author  = {LaManna, Joseph A. and Hartig, Florian and Myers, Jonathan A. and Freckleton, Robert P. and Detto, Matteo and Surendra, Akshay and Doolittle, Cole J. and Bachelot, B{\'e}n{\'e}dicte and Bagchi, Robert and Comita, Liza S. and DeFilippis, David M. and Huanca-Nunez, Nohemi and H{\"u}lsmann, Lisa and Jevon, Fiona V. and Johnson, Daniel J. and Krishnadas, Meghna and Magee, Lukas J. and Mangan, Scott A. and Milici, Valerie R. and Murengera, Aim{\'e} Lucky Barahebuza and Schnitzer, Stefan A. and Smith, Daniel J. B. and Stein, Claudia and Sullivan, Megan K. and Torres, Ethan and Uma{\~n}a, Mar{\'i}a Natalia and Delavaux, Camille S.},
  title   = {Consequences of Local Conspecific Density Effects for Plant Diversity and Community Dynamics},
  journal = {Ecology Letters},
  year    = {2024},
  volume  = {27},
  number  = {9},
  pages    = {e14506},
  doi      = {10.1111/ele.14506},
  abstract = {Conspecific density dependence (CDD) in plant populations is widespread, most likely caused by local‐scale biotic interactions, and has potentially important implications for biodiversity, community composition, and ecosystem processes. However, progress in this important area of ecology has been hindered by differing viewpoints on CDD across subfields in ecology, lack of synthesis across CDD‐related frameworks, and misunderstandings about how empirical measurements of local CDD fit within the context of broader ecological theories on community assembly and diversity maintenance. Here, we propose a conceptual synthesis of local‐scale CDD and its causes, including species‐specific antagonistic and mutualistic interactions. First, we compare and clarify different uses of CDD and related concepts across subfields within ecology. We suggest the use of local stabilizing/destabilizing CDD to refer to the scenario where local conspecific density effects are more negative/positive than heterospecific effects. Second, we discuss different mechanisms for local stabilizing and destabilizing CDD, how those mechanisms are interrelated, and how they cut across several fields of study within ecology. Third, we place local stabilizing/destabilizing CDD within the context of broader ecological theories and discuss implications and challenges related to scaling up the effects of local CDD on populations, communities, and metacommunities. The ultimate goal of this synthesis is to provide a conceptual roadmap for researchers studying local CDD and its implications for population and community dynamics.},
  significance = {Young plants often survive less well when crowded by their own species than by others. This “conspecific density dependence” (CDD) is read as one way species diversity is maintained: a common species is held back by enemies or competition that act mainly on it, which leaves room for rarer ones. The reading is reasonable. But the research is split across fields that use the term for different things and study different mechanisms, and a negative effect of local crowding on an individual’s survival or growth has often been taken to mean that diversity is stabilised across a whole community. How such local measurements scale up to populations, communities and metacommunities (linked communities) remained unclear. \par This synthesis of conspecific density dependence argues that a negative effect of same-species neighbours on a plant’s survival or growth says little about diversity unless it is compared with the effect of neighbours of other species, and that even then a local signal does not show that a population is regulated or that species coexist. It suggests using “stabilising CDD” (the term of Hülsmann et al. 2024) when conspecific effects are more negative than heterospecific ones (those of other species) and “destabilising CDD” when they are more positive. Mechanisms other than host-specific enemies can produce such a signal: mutualists such as mycorrhizal fungi, competition and plants altering their own soil can push it either way. Habitat preferences and dispersal can create patterns that look like CDD. An effect in one life stage can be cancelled by others, so it need not appear in population growth. And even stabilising CDD supports coexistence only if it outweighs the intrinsic fitness differences among species, in line with Broekman et al. (2019). In practice, most predictions tested up to then concerned individual plants rather than populations or communities. \par The paper offers a shared vocabulary and a research agenda rather than new data. It asks that studies compare conspecific effects with heterospecific ones before calling a pattern stabilising, combine life stages in population models, weigh stabilising CDD against fitness differences, and test predictions at population and community scales. Scale-transition theory, which links local, nonlinear processes to larger-scale dynamics, is suggested for the last step. Whether local CDD maintains diversity is a question for multiscale analysis, not for a local estimate.},
  significance_refs = {10.1038/s41586-024-07118-4 10.1111/ele.13349},
  license = {publisher (subscription)},
  funding = {Schweizerischer Nationalfonds zur Förderung der Wissenschaftlichen Forschung (TMPFP3_209925); Bayerisches Staatsministerium für Wissenschaft und Kunst; Division of Environmental Biology (DEB-1845403); Division of Environmental Biology (DEB-2024903); Division of Environmental Biology (DEB-2240431); Division of Environmental Biology (DEB-2310100)},
}

@article{malchow2024fitting,
  author  = {Malchow, Anne-Kathleen and Fandos, Guillermo and Kormann, Urs G. and Gr{\"u}ebler, Martin U. and K{\'e}ry, Marc and Hartig, Florian and Zurell, Damaris},
  title   = {Fitting individual-based models of spatial population dynamics to long-term monitoring data},
  journal = {Ecological Applications},
  year    = {2024},
  volume   = {34},
  number   = {4},
  pages    = {e2966},
  doi      = {10.1002/eap.2966},
  abstract = {Generating spatial predictions of species distribution is a central task for research and policy. Currently, correlative species distribution models (cSDMs) are among the most widely used tools for this purpose. However, a fundamental assumption of cSDMs, that species distributions are in equilibrium with their environment, is rarely fulfilled in real data and limits the applicability of cSDMs for dynamic projections. Process‐based, dynamic SDMs (dSDMs) promise to overcome these limitations as they explicitly represent transient dynamics and enhance spatiotemporal transferability. Software tools for implementing dSDMs are becoming increasingly available, but their parameter estimation can be complex. Here, we test the feasibility of calibrating and validating a dSDM using long‐term monitoring data of Swiss red kites (Milvus milvus). This population has shown strong increases in abundance and a progressive range expansion over the last decades, indicating a nonequilibrium situation. We construct an individual‐based model using the RangeShiftR modeling platform and use Bayesian inference for model calibration. This allows the integration of heterogeneous data sources, such as parameter estimates from published literature and observational data from monitoring schemes, with a coherent assessment of parameter uncertainty. Our monitoring data encompass counts of breeding pairs at 267 sites across Switzerland over 22 years. We validate our model using a spatial‐block cross‐validation scheme and assess predictive performance with a rank‐correlation coefficient. Our model showed very good predictive accuracy of spatial projections and represented well the observed population dynamics over the last two decades. Results suggest that reproductive success was a key factor driving the observed range expansion. According to our model, the Swiss red kite population fills large parts of its current range but has potential for further increases in density. We demonstrate the practicality of data integration and validation for dSDMs using RangeShiftR. This approach can improve predictive performance compared to cSDMs. The workflow presented here can be adopted for any population for which some prior knowledge on demographic and dispersal parameters as well as spatiotemporal observations of abundance or presence/absence are available. The fitted model provides improved quantitative insights into the ecology of a species, which can greatly aid conservation and management efforts.},
  significance = {Correlative species distribution models (cSDMs) are among the most used tools for predicting where species occur. They relate known occurrences to environmental conditions, which makes them flexible and easy to fit. They also assume that a distribution is in equilibrium with its environment, an assumption often violated for expanding or recovering populations. Process-based dynamic models (dSDMs), which simulate demography and dispersal, promise to avoid that assumption but are used less, because their parameters are hard to estimate and their predictions hard to validate. The study asks whether these obstacles can be overcome with existing tools. \par The study shows that an individual-based model of a species’ spatial population dynamics can be fitted to long-term monitoring data with Bayesian inference and validated by cross-validation, and that it then predicts a range-expanding bird population very well overall. The test case is the Swiss red kite (Milvus milvus). The model simulates the reproduction, survival and dispersal of individual birds. Priors for its parameters come from the literature; Bayesian inference then updates them with counts of breeding pairs at 267 monitoring sites. To test predictions for unseen regions, each spatial block of sites is held out in turn and the fit repeated. The study suggests a gain over correlative models, but only by comparison with an earlier study of the same survey data (Briscoe et al. 2021), not in a direct test. The data informed only some parameters clearly, and the fitted model suggests that reproductive success was a key driver of the range expansion. \par The study presents the workflow as a practical route to process-based models that represent transient dynamics rather than assuming equilibrium, transferable to any population with some prior knowledge of demographic and dispersal parameters and records of abundance or presence and absence. Because fitted parameters have ecological meaning, fitting can itself yield insight: for the red kite, the model suggests that the population fills large parts of its current range but has room for further increases in density. Only some parameters can be estimated, and which ones depends on the available data, so well-founded priors remain important. Jeltsch et al. (2025) cite the study in support of their expectation that advances in integrating individual-based modelling with big-data approaches will facilitate wider use of complex model–data fusion.},
  significance_refs = {10.1111/gcb.15723 10.3897/ibe.1.148200},
  license = {CC BY 4.0},
  funding = {Deutsche Forschungsgemeinschaft (DFG) (ZU 361/1-1)},
}

@article{amesoder2024cito,
  author  = {Ames{\"o}der, Christian and Hartig, Florian and Pichler, Maximilian},
  title   = {‘cito’: an R package for training neural networks using ‘torch’},
  journal = {Ecography},
  year    = {2024},
  volume   = {2024},
  number   = {6},
  pages    = {e07143},
  doi      = {10.1111/ecog.07143},
  abstract = {Deep neural networks (DNN) have become a central method in ecology. To build and train DNNs in deep learning (DL) applications, most users rely on one of the major deep learning frameworks, in particular PyTorch or TensorFlow. Using these frameworks, however, requires substantial experience and time. Here, we present ‘cito', a user‐friendly R package for DL that allows specifying DNNs in the familiar formula syntax used by many R packages. To fit the models, ‘cito' takes advantage of the numerically optimized ‘torch' library, including the ability to switch between training models on the CPU or the graphics processing unit (GPU) which allows the efficient training of large DNNs. Moreover, ‘cito' includes many user‐friendly functions for model plotting and analysis, including explainable AI (xAI) metrics for effect sizes and variable importance. All xAI metrics as well as predictions can optionally be bootstrapped to generate confidence intervals, including p‐values. To showcase a typical analysis pipeline using ‘cito', with its built‐in xAI features, we built a species distribution model of the African elephant. We hope that by providing a user‐friendly R framework to specify, deploy and interpret DNNs, ‘cito' will make this interesting class of models more accessible to ecological data analysis. A stable version of ‘cito' can be installed from the comprehensive R archive network (CRAN).},
  significance = {Neural networks are increasingly used in ecology but usually built in Python-based frameworks such as PyTorch or TensorFlow, whose complexity, the paper notes, can be prohibitive for scientists with limited knowledge. R interfaces to these frameworks are easier, but they follow Python syntax rather than the formula notation of R packages like ‘lme4’ and leave plots, bootstrapping and explainable-AI (xAI) metrics to the user. R packages with formula notation, such as ‘nnet’ and ‘neuralnet’, lack modern deep-learning techniques and training on graphics processing units (GPUs). What was missing was an R package that fits modern neural networks as simply as any other R regression model and covers the whole analysis. \par The paper presents ‘cito’, an R package that lets users specify, train and interpret a neural network in the model formula notation, in a single line of code. The package builds on ‘torch’ (PyTorch for R), so it needs no Python and can train on a GPU. It supports fully connected networks with modern training aids such as dropout and early stopping, and a baseline loss helps users spot networks that fail to converge. Predictions and xAI summaries can be bootstrapped to give confidence intervals, and p-values for the xAI summaries. In a feature comparison, the paper finds more functions in ‘cito’ than in ‘nnet’, ‘neuralnet’, ‘h2o’ and ‘brulee’; the paper calls ‘brulee’ very similar, also built on ‘torch’. In a runtime test on simulated data, GPU training time was practically independent of network size, and CPU training was on a par with ‘brulee’; for small networks ‘neuralnet’ was faster than both. A species distribution model of the African elephant illustrates the workflow. \par The paper argues that ‘cito’ removes many hurdles for inexperienced users and saves programming time for experienced users who only want simple networks, because it fits into the R regression ecosystem. Only fully connected networks are supported, and the paper cautions that the bootstrap intervals and p-values are not guaranteed to cover the true value as often as stated or to keep their stated error rates, so they should be tested for each combination of data and settings. Loiseau et al. (2024) used ‘cito’ to train a neural network that they combined with random forests to infer the extinction risk of marine fish.},
  significance_refs = {10.1371/journal.pbio.3002773},
  license = {CC BY 3.0},
  funding = {Projekt DEAL (Open Access funding)},
}

@article{kaber2024inferring,
  author  = {K{\"a}ber, Yannek and Hartig, Florian and Bugmann, Harald},
  title   = {Inferring the tree regeneration niche from inventory data using a dynamic forest model},
  journal = {Geoscientific Model Development},
  year    = {2024},
  volume  = {17},
  number  = {7},
  pages    = {2727--2753},
  doi      = {10.5194/gmd-17-2727-2024},
  abstract = {The regeneration niche of trees is governed by many processes and factors that are challenging to determine. Besides a species's geographic distribution, which determines if seeds are available, a myriad of local processes in forest ecosystems (e.g., competition and pathogens) exert influences on tree regeneration. Consequently, the representation of tree regeneration in dynamic forest models is a notoriously complicated process which often involves many subprocesses that are often data deficient. The ForClim forest gap model solved this problem by linking species traits to regeneration properties. However, this regeneration module was never validated with large-scale data. Here, we compare this trait-based approach with an inverse calibration approach where we estimate regeneration parameters directly from a large dataset of unmanaged European forests. The inverse calibration was done using Bayesian inference, estimating shade and drought tolerance as well as the temperature requirements for 11 common tree species along with the intensity of regeneration (i.e., the maximum regeneration rate). We find that the parameters determining the species' light niche (i.e., light requirements) are similar for the trait-based and calibrated values for both model variants, but only a more complex model variant that included competition between recruits leads to plausible estimates of the drought niche. The trait-derived temperature niche did not match to the estimates from either model variant using inverse calibration. The parameter estimates differed between the complex and the simple model, with the estimates for the complex model being closer to the trait-based parameters. In both model variants, the calibration strongly changed the parameters that determine regeneration intensity compared to the default. We conclude that the regeneration niche of trees can be recovered from a large forestry dataset in terms of the stand-level parameters light availability and regeneration intensity, while abiotic drivers (temperature and drought) are more elusive. The higher performance (better fit to hold out) of the inversely calibrated models underpins the importance of informing dynamic models by real-world observations. Future research should focus on even greater environmental coverage of observations of demographic processes in unmanaged forests to verify our findings at species range limits under extreme climatic conditions.},
  significance = {Predicting range shifts and forest dynamics under climate change relies on process-based models, and tree regeneration matters for both range shifts and forest resilience. Regeneration looks stochastic, varies across scales and is poorly observed. The forest model studied here, ForClim, therefore sets its regeneration niche in advance from species traits (light, drought and temperature requirements) plus a default amount of recruitment. These were never checked against large-scale data, and many forest models mismatch data from unmanaged European forests for reasons that remain vague (Díaz-Yáñez et al. 2024). The paper asks whether trait-derived regeneration niches are supported by real recruitment patterns. \par The study argues that fitting a forest model to inventory data (inverse calibration) can recover how tree regeneration depends on light, drought and temperature, but only in part: light requirements and the overall amount of regeneration are well constrained, whereas climatic requirements are not. It tests this with the forest gap model ForClim in a simple variant and a more complex one with competition among recruits, with recruitment records from 696 plots in strict European forest reserves (11 tree species), half for Bayesian calibration and half for testing. Calibrated light requirements mostly agreed with the trait-based values (closely in the complex variant, in ranking in the simple one). Drought tolerance gave plausible estimates only in the complex variant, and temperature requirements matched the trait-based values in neither. The calibrated amount of regeneration was lower than the default in both variants, and much lower in the complex one. On held-out plots, the calibrated complex variant predicted better than the default, and it outperformed the simple variant. \par The paper reads the agreement for light requirements as strong support for the trait-based values, the lower regeneration as a challenge to the default amount, and the climatic parameters as not constrained by the data. It concludes that light availability and regeneration intensity are the main controls on regeneration. Because temperature had little influence, it hypothesises, without testing this, that climate acts mainly later, through growth and the mortality of larger trees, so predictions of forest resilience may depend more on how dynamics within stands are represented than on species range limits. It encourages inverse calibration and asks for data from more extreme climates because few plots cover boreal or Mediterranean-type conditions.},
  significance_refs = {10.1002/ecs2.4807},
  license = {CC BY 4.0},
  funding = {ETH Zurich (ETH-35 18-1)},
}

@article{wiegrebe2024analyzing,
  author  = {Wiegrebe, Simon and Gorski, Mathias and Herold, Janina M. and Stark, Klaus J. and Thorand, Barbara and Gieger, Christian and B{\"o}ger, Carsten A. and Sch{\"o}del, Johannes and Hartig, Florian and Chen, Han and Winkler, Thomas W. and K{\"u}chenhoff, Helmut and Heid, Iris M.},
  title   = {Analyzing longitudinal trait trajectories using GWAS identifies genetic variants for kidney function decline},
  journal = {Nature Communications},
  year    = {2024},
  volume  = {15},
  number  = {1},
  pages    = {10061},
  doi      = {10.1038/s41467-024-54483-9},
  abstract = {Understanding the genetics of kidney function decline, or trait change in general, is hampered by scarce longitudinal data for GWAS (longGWAS) and uncertainty about how to analyze such data. We use longitudinal UK Biobank data for creatinine-based estimated glomerular filtration rate from 348,275 individuals to search for genetic variants associated with eGFR-decline. This search was performed both among 595 variants previously associated with eGFR in cross-sectional GWAS and genome-wide. We use seven statistical approaches to analyze the UK Biobank data and simulated data, finding that a linear mixed model is a powerful approach with unbiased effect estimates which is viable for longGWAS. The linear mixed model identifies 13 independent genetic variants associated with eGFR-decline, including 6 novel variants, and links them to age-dependent eGFR-genetics. We demonstrate that age-dependent and age-independent eGFR-genetics exhibit a differential pattern regarding clinical progression traits and kidney-specific gene expression regulation. Overall, our results provide insights into kidney aging and linear mixed model-based longGWAS generally.},
  significance = {Genome-wide association studies (GWAS) link genetic variants to traits. For kidney function (estimated glomerular filtration rate), single-time-point studies have found hundreds of loci. Few variants are known for how the trait changes over time, although worsening biomarkers mark disease progression. Earlier work used the difference between a person’s last and first measurement, or a fast two-stage approach that estimates each person’s slope first and tests it against genotype. Neither can include people measured only once; one-stage mixed models can, but were considered too demanding, and no systematic comparison existed. The problem is an approach that controls false positives, has good power, gives unbiased effects and is fast enough for genome-wide use. \par The paper argues that, for GWAS of change over time, a one-stage linear mixed model of the trait over age is preferable when power and unbiased effect sizes both matter. The model gives each person a starting level and a slope, lets them correlate, and includes people measured once. In simulations and UK Biobank kidney data comparing seven approaches, the two-stage approach was most powerful among those controlling false positives, but shrank effects by 11–38%. Models that ignored person-specific slopes, or the correlation between starting level and slope, inflated false positives. The age-based model was unbiased and, including people measured only once, nearly as powerful as the two-stage approach. With the GMMAT/MAGEE software, it could be run genome-wide. For kidney function it identified 13 independent variants for decline, six of them novel, and five genome-wide significant loci. Of 12 known kidney-function variants associated with decline, all but one had near-zero effects at age 40 and large effects at 70; 11 others had large, age-independent effects. \par The paper advises the age-based model for longitudinal GWAS of trait change when the start of follow-up is random, and a model of time since baseline when the start is informative, for example when analysing trait change in patients. It reads the two-stage approach as possibly acceptable for finding loci but not for interpreting effect sizes. For kidney research, the results suggest that decline variants act mainly from about age 40 onwards, and the enrichment of kidney-expressed genes in their loci points to kidney-intrinsic mechanisms, making the likely causal genes there candidates for studying kidney ageing.},
  license = {CC BY 4.0},
  funding = {Deutsche Forschungsgemeinschaft (DFG, German Research Foundation), SFB 1350 (Project-ID 387509280); Deutsche Forschungsgemeinschaft (DFG, German Research Foundation), TRR 374 (Project-ID 509149993)},
}

@article{cabral2024road,
  author  = {Cabral, Juliano Sarmento and Mendoza-Ponce, Alma and da Silva, Andr{\'e} Pinto and Oberpriller, Johannes and Mimet, Anne and Kieslinger, Julia and Berger, Thomas and Blechschmidt, Jana and Br{\"o}nner, Maximilian and Classen, Alice and Fallert, Stefan and Hartig, Florian and Hof, Christian and Hoffmann, Markus and Knoke, Thomas and Krause, Andreas and Lewerentz, Anne and Pohle, Perdita and Raeder, Uta and Rammig, Anja and Redlich, Sarah and Rubanschi, Sven and Stetter, Christian and Weisser, Wolfgang and Vedder, Daniel and Verburg, Peter H. and Zurell, Damaris},
  title   = {The road to integrate climate change projections with regional land-use--biodiversity models},
  journal = {People and Nature},
  year    = {2024},
  volume  = {6},
  number  = {5},
  pages    = {1716--1741},
  doi      = {10.1002/pan3.10472},
  abstract = {Current approaches to project spatial biodiversity responses to climate change mainly focus on the direct effects of climate on species while regarding land use and land cover as constant or prescribed by global land‐use scenarios. However, local land‐use decisions are often affected by climate change and biodiversity on top of socioeconomic and policy drivers. To realistically understand and predict climate impacts on biodiversity, it is, therefore, necessary to integrate both direct and indirect effects (via climate‐driven land‐use change) of climate change on biodiversity. In this perspective paper, we outline how biodiversity models could be better integrated with regional, climate‐driven land‐use models. We initially provide a short, non‐exhaustive review of empirical and modelling approaches to land‐use and land‐cover change (LU) and biodiversity (BD) change at regional scales, which forms the base for our perspective about improved integration of LU and BD models. We consider a diversity of approaches, with a special emphasis on mechanistic models. We also look at current levels of integration and at model properties, such as scales, inputs and outputs, to further identify integration challenges and opportunities. We find that LU integration in BD models is more frequent than the other way around and has been achieved at different levels: from overlapping predictions to simultaneously coupled simulations (i.e. bidirectional effects). Of the integrated LU‐BD socio‐ecological models, some studies included climate change effects on LU, but the relative contribution of direct vs. indirect effects of climate change on BD remains a key research challenge. Important research avenues include concerted efforts in harmonizing spatial and temporal resolution, disentangling direct and indirect effects of climate change on biodiversity, explicitly accounting for bidirectional feedbacks, and ultimately feeding socio‐ecological systems back into climate predictions. These avenues can be navigated by matching models, plugins for format and resolution conversion, and increasing the land‐use forecast horizon with adequate uncertainty. Recent developments of coupled models show that such integration is achievable and can lead to novel insights into climate–land use–biodiversity relations. Read the free Plain Language Summary for this article on the Journal blog.},
  significance = {Projections of how biodiversity will respond to climate change mostly consider the direct effect of climate on species and keep land use and land cover constant or take them from global land-use scenarios. Yet land use is arguably the strongest current driver of biodiversity change. Local land-use decisions are themselves often affected by climate and by biodiversity, besides socio-economic and policy drivers. The indirect route from climate change through land-use change to biodiversity, and the feedbacks between them, therefore remain relatively unexplored. The problem the paper takes on is how regional land-use and biodiversity models can be connected so that this route is included. \par The paper argues that projections of biodiversity under climate change should include both the direct effects of climate and the indirect effects that run through climate-driven land-use change. It holds that this is achievable by coupling regional land-use models with biodiversity models, with an emphasis on mechanistic ones (models that simulate the underlying processes). Its non-exhaustive review finds that land use enters biodiversity models much more often than biodiversity enters land-use models, in four approaches of increasing integration, from overlaying the outputs of both model types to running both models together in one framework that exchanges variables. It finds no study of indirect climate effects with mechanistic models, but regards this as achievable, because mechanistic land-use models that take climate as input have already been coupled to mechanistic biodiversity models. Coupling can change results: in a hypothetical crop–pollinator case, a model in which the two parts influence each other (two-way coupling) predicted larger changes in crop yield and pollinator populations than a version in which information flowed one way only (Synes et al. 2019). \par The paper names the steps needed: matching the spatial resolution and file formats of the two model types, longer land-use forecast horizons with explicit uncertainty, biodiversity information as an input to land-use decisions, and eventually feeding the combined outputs back into climate predictions. It holds that coupling can give insights that would not emerge without two-way coupling and, in the long run, allow weighing species numbers, stakeholder profits, carbon balance and temperature together. Limits the paper itself acknowledges: the review is non-exhaustive, and the relative contribution of direct and indirect climate effects is still open.},
  significance_refs = {10.1111/ecog.04039},
  license = {CC BY 4.0},
  funding = {Bavarian Ministry of Science and the Arts, Bavarian Climate Research Network (BayKliF); DAAD; DBU (Deutsche Bundesstiftung Umwelt); DFG (ZU 361/1-1); German Research Foundation (DFG), support of iDiv (FZT 118, 202548816); Projekt DEAL (Open Access funding)},
}

