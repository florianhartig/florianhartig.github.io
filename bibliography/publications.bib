@article{pichler2023can,
  author   = {Pichler, Maximilian and Hartig, Florian},
  title    = {Can predictive models be used for causal inference?},
  journal  = {arXiv},
  year     = {2023},
  preprint = {https://arxiv.org/abs/2306.10551},
  abstract = {Supervised machine learning (ML) and deep learning (DL) algorithms excel at predictive tasks, but it is commonly assumed that they often do so by exploiting non-causal correlations, which may limit both interpretability and generalizability. Here, we show that this trade-off between explanation and prediction is not as deep and fundamental as expected. Whereas ML and DL algorithms will indeed tend to use non-causal features for prediction when fed indiscriminately with all data, it is possible to constrain the learning process of any ML and DL algorithm by selecting features according to Pearl's backdoor adjustment criterion. In such a situation, some algorithms, in particular deep neural networks, can provide near unbiased effect estimates under feature collinearity. Remaining biases are explained by the specific algorithmic structures as well as hyperparameter choice. Consequently, optimal hyperparameter settings are different when tuned for prediction or inference, confirming the general expectation of a trade-off between prediction and explanation. However, the effect of this trade-off is small compared to the effect of a causally constrained feature selection. Thus, once the causal relationship between the features is accounted for, the difference between prediction and explanation may be much smaller than commonly assumed. We also show that such causally constrained models generalize better to new data with altered collinearity structures, suggesting generalization failure may often be due to a lack of causal learning. Our results not only provide a perspective for using ML for inference of (causal) effects but also help to improve the generalizability of fitted ML and DL models to new data.},
  significance = {Machine learning (ML) models, including deep learning, are seen as good predictors but poor explainers: they exploit correlations with features not causally connected to the outcome. This view is reflected in the position that predictive models are not for causal inference (Arif and MacNeil 2022; Shmueli 2010), which is reasonable for models fed all features. Causal inference theory, however, says how to choose features from a known causal graph so that a regression adjusts for confounders (common causes of a feature and the outcome), and Zhao and Hastie (2021) noted this should in principle carry over to ML. This is uncertain because the regularisation in ML algorithms can bias the effects of correlated (collinear) features. The paper takes on the assumption that this trade-off between prediction and explanation is fundamental to ML algorithms. \par The paper argues that the trade-off between predicting well and estimating effects correctly with machine-learning models is smaller than assumed, because much of it stems from which features the model is given, not only from the algorithm. When features are chosen with the backdoor criterion, a rule that blocks confounding, some algorithms estimate effects almost without bias. In simulations, neural networks without regularisation were nearly unbiased, whereas random forests showed strong “causal spillover”, in which an effect moves onto a correlated feature that has none. Hyperparameters (tuning settings) best for estimating effects differed from those best for prediction, but only slightly next to the gain from causal feature selection. In a simulated lung-cancer example, models lacking the collider variable lung volume (a variable caused by two others) predicted slightly worse on data like the training data but better in a randomised trial, where feature correlations differ. \par The results suggest that, if the causal graph is known, certain flexible ML models, neural networks in particular, can in principle be used like a multiple regression to estimate adjusted effects, and could beat parametric models when relationships are nonlinear or interactive. In the simulated case study, causal feature selection lowered the error on new data with different feature correlations, which suggests that some failures of ML to generalise may reflect a failure to learn causal structure. The paper notes limits: the graph must be known, guarantees are lacking, and comparison with double/debiased ML (Chernozhukov et al. 2018) is left open.},
  significance_refs = {10.1111/ele.14033 10.1214/10-STS330 10.1080/07350015.2019.1624293 10.1111/ectj.12097},
}

@article{lajaaiti2023comparison,
  author   = {Lajaaiti, Isma{\"e}l and Lambert, Sophia and Voznica, Jakub and Morlon, H{\'e}l{\`e}ne and Hartig, Florian},
  title    = {A Comparison of Deep Learning Architectures for Inferring Parameters of Diversification Models from Extant Phylogenies},
  doi       = {10.1101/2023.03.03.530992},
  license   = {CC BY-ND 4.0},
  journal  = {bioRxiv},
  year     = {2023},
  abstract = {To infer the processes that gave rise to past speciation and extinction rates across taxa, space and time, we often formulate hypotheses in the form of stochastic diversification models and estimate their parameters from extant phylogenies using Maximum Likelihood or Bayesian inference. Unfortunately, however, likelihoods can easily become intractable, limiting our ability to consider more complicated diversification processes. Recently, it has been proposed that deep learning (DL) could be used in this case as a likelihood-free inference technique. Here, we explore this idea in more detail, with a particular focus on understanding the ideal network architecture and data representation for using DL in phylogenetic inference. We evaluate the performance of different neural network architectures (DNN, CNN, RNN, GNN) and phylogeny representations (summary statistics, Lineage Through Time or LTT, phylogeny encoding and phylogeny graph) for inferring rates of the Constant Rate Birth-Death (CRBD) and the Binary State Speciation and Extinction (BISSE) models. We find that deep learning methods can reach similar or even higher accuracy than Maximum Likelihood Estimation, provided that network architectures and phylogeny representations are appropriately tuned to the respective model. For example, for the CRBD model we find that CNNs and RNNs fed with LTTs outperform other combinations of network architecture and phylogeny representation, presumably because the LTT is a sufficient and therefore less redundant statistic for homogenous BD models. For the more complex BiSSE model, however, it was necessary to feed the network with both topology and tip states information to reach acceptable performance. Overall, our results suggest that deep learning provides a promising alternative for phylogenetic inference, but that data representation and architecture have strong effects on the inferential performance.},
  significance = {Diversification models describe how lineages split and go extinct; their rates are usually estimated from the family tree of living species by maximum likelihood or Bayesian inference, both of which need the likelihood, the probability of the tree given the parameters. For richer models this becomes intractable, and the usual fallback, approximate Bayesian computation, needs many simulations. Deep learning is a likelihood-free alternative, and Voznica et al. (2022) and Lambert et al. (2023) showed that convolutional networks on a full matrix encoding of the tree can match or beat likelihood-based methods without hand-picked summary statistics. But the many ways of encoding trees for networks had not been compared systematically. The paper asks whether one rich encoding with one type of network suits every model, or whether the best choice depends on the model. \par The study shows that deep learning can infer the parameters of diversification models from phylogenetic trees about as accurately as maximum likelihood, provided that the representation of the tree and the type of network are matched to the model. It tests this on two models with computable likelihoods: a constant-rate birth–death model and a binary-state speciation and extinction (BiSSE) model (simplified here), in which a two-state trait affects the rates of speciation and extinction. For the birth–death model, networks given only the lineage-through-time curve (the number of lineages over time) did best, even beating maximum likelihood, presumably as the curve holds all the information the likelihood uses. For the BiSSE model that curve was not enough: only inputs with the tree’s shape and the tip trait states gave good accuracy, a convolutional network on the full encoding best. Networks on the tree as a graph did notably worse. \par The results make deep learning look promising for models whose likelihoods are out of reach, but show that it is not one method: representation and network must suit the model. The paper speculates that where a compact summary holding all relevant information (a sufficient statistic) exists, it should be used, and that the full tree may be needed where none does. It calls the work a proof of concept on simple models. A follow-up preprint, Leroy et al. (2025), traces part of the poor performance of the graph-based networks in this paper to insufficient tuning.},
  significance_refs = {10.1038/s41467-022-31511-0 10.1093/sysbio/syad044 10.1101/2025.08.14.670341},
}

@article{pichler2023machine,
  author   = {Pichler, Maximilian and Hartig, Florian},
  title    = {Machine learning and deep learning—A review for ecologists},
  journal  = {Methods in Ecology and Evolution},
  year     = {2023},
  volume   = {14},
  number   = {4},
  pages    = {994--1016},
  doi      = {10.1111/2041-210X.14061},
  preprint = {https://arxiv.org/abs/2204.05023},
  abstract = {The popularity of machine learning (ML), deep learning (DL) and artificial intelligence (AI) has risen sharply in recent years. Despite this spike in popularity, the inner workings of ML and DL algorithms are often perceived as opaque, and their relationship to classical data analysis tools remains debated. Although it is often assumed that ML and DL excel primarily at making predictions, ML and DL can also be used for analytical tasks traditionally addressed with statistical models. Moreover, most recent discussions and reviews on ML focus mainly on DL, failing to synthesise the wealth of ML algorithms with different advantages and general principles. Here, we provide a comprehensive overview of the field of ML and DL, starting by summarizing its historical developments, existing algorithm families, differences to traditional statistical tools, and universal ML principles. We then discuss why and when ML and DL models excel at prediction tasks and where they could offer alternatives to traditional statistical methods for inference, highlighting current and emerging applications for ecological problems. Finally, we summarize emerging trends such as scientific and causal ML, explainable AI, and responsible AI that may significantly impact ecological data analysis in the future. We conclude that ML and DL are powerful new tools for predictive modelling and data analysis. The superior performance of ML and DL algorithms compared to statistical models can be explained by their higher flexibility and automatic data‐dependent complexity optimization. However, their use for causal inference is still disputed as the focus of ML and DL methods on predictions creates challenges for the interpretation of these models. Nevertheless, we expect ML and DL to become an indispensable tool in ecology and evolution, comparable to other traditional statistical tools.},
  featured = {true},
  significance = {Machine learning (ML) and deep learning (DL, neural networks with many layers) are increasingly used in ecology and evolution, yet many ecologists see them as opaque, and their relation to classical statistical models is debated. Recent reviews concentrate on deep learning (Borowiec et al. 2022; Christin et al. 2019), although not everything that holds for deep networks holds for older methods such as boosted regression trees. And ML is often assumed to be purely predictive, an assumption with a reasonable core, since the best predictive model need not be the causal one. The paper takes on the missing account of ML as a whole and of why these methods work. \par The paper reviews machine and deep learning for ecologists as one field with shared principles. Its central argument is that ML gives up an explicit statistical model of how the data arise in favour of flexible algorithms whose effective complexity (how closely the model can follow the data) adjusts to the data. Ensembles of many simple models, such as random forests and boosted trees, offset individual errors. Penalties that shrink coefficients and settings tuned by cross-validation limit flexibility. In deep learning, overparameterisation combined with stochastic gradient descent is hypothesised to act as an implicit brake, which the paper presents as still debated. The paper offers this control of complexity as the explanation of the predictive advantage over statistical models, and of why classical ML does well on small datasets and data in table form, while deep learning excels on images and other unstructured data. A simulation shows where good prediction and causal insight part ways: with a strongly correlated confounder, the true causal model had the highest prediction error, while models with wrong effect estimates predicted better. The paper warns against reading feature importances or explainable-AI outputs as causal effects. \par The results mean that ML and DL are powerful tools for prediction, data processing and data analysis, while causal conclusions need care, extrapolation is as hard as for statistical models, and simpler models remain preferable where they suffice. The paper expects ML to become an indispensable tool in ecology and evolution, comparable to linear regression models or analysis of variance. Garcia-Quintas et al. (2023) cite it when discussing the opacity of deep learning and the interpretation of random forests.},
  significance_refs = {10.1111/2041-210x.13901 10.1111/2041-210x.13256 10.1002/ece3.10549},
  license = {CC BY 4.0},
  funding = {Bavarian Ministry of Science and the Arts (Bavarian Climate Research Network, bayklif); Projekt DEAL (open access funding)},
}

@article{malchow2023demography,
  author  = {Malchow, A.-K. and Hartig, F. and Reeg, J. and K{\'e}ry, M. and Zurell, D.},
  title   = {Demography–environment relationships improve mechanistic understanding of range dynamics under climate change},
  journal = {Philosophical Transactions of the Royal Society B: Biological Sciences},
  year    = {2023},
  volume  = {378},
  number  = {1881},
  pages   = {20220194},
  doi     = {10.1098/rstb.2022.0194},
  preprint = {https://www.biorxiv.org/content/10.1101/2022.09.23.509134v1},
  abstract = {Species respond to climate change with range and abundance dynamics. To better explain and predict them, we need a mechanistic understanding of how the underlying demographic processes are shaped by climatic conditions. Here, we aim to infer demography–climate relationships from distribution and abundance data. For this, we developed spatially explicit, process-based models for eight Swiss breeding bird populations. These jointly consider dispersal, population dynamics and the climate-dependence of three demographic processes—juvenile survival, adult survival and fecundity. The models were calibrated to 267 nationwide abundance time series in a Bayesian framework. The fitted models showed moderate to excellent goodness-of-fit and discriminatory power. The most influential climatic predictors for population performance were the mean breeding-season temperature and the total winter precipitation. Contemporary climate change benefitted the population trends of typical mountain birds leading to lower population losses or even slight increases, whereas lowland birds were adversely affected. Our results emphasize that generic process-based models embedded in a robust statistical framework can improve our predictions of range dynamics and may allow disentangling of the underlying processes. For future research, we advocate a stronger integration of experimental and empirical studies in order to gain more precise insights into the mechanisms by which climate affects populations. This article is part of the theme issue ‘Detecting and attributing the causes of biodiversity change: needs, gaps and solutions’.},
  significance = {In this study, led by A.-K. Malchow, the authors extend an inverse modelling approach to individual-based models, representing eight Swiss breeding bird species with climate-dependent juvenile survival, adult survival and fecundity plus dispersal, and calibrating them in a Bayesian framework against nationwide abundance time series. The calibrated models reproduced abundance patterns with moderate to excellent accuracy and suggested that typical mountain species benefited from the climate change observed over the survey period, with smaller population losses or even slight increases, while lowland species were adversely affected. Some fitted demography–climate relationships were physiologically implausible, so the authors stress that such inversely estimated relationships remain partly phenomenological and should be checked before extrapolating.},
  license = {CC BY 4.0},
  funding = {Deutsche Forschungsgemeinschaft (DFG) (ZU 361/1-1)},
}

