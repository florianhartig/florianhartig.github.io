@article{sohn2016drought,
  author  = {Sohn, Julia A. and Hartig, Florian and Kohler, Martin and Huss, J{\"u}rgen and Bauhus, J{\"u}rgen},
  title   = {Heavy and frequent thinning promotes drought adaptation in Pinus sylvestris forests},
  journal = {Ecological Applications},
  year    = {2016},
  volume  = {26},
  number  = {7},
  pages   = {2190--2205},
  doi     = {10.1002/eap.1373},
  abstract = {Droughts and their negative effects on forest ecosystems are projected to increase under climate change for many regions. It has been suggested that intensive thinning could reduce drought impacts on established forests in the short‐term. Most previous studies on the effect of thinning on drought impacts, however, have been confined to single forest sites. It is therefore still unclear how general and persisting the benefits of thinning are. This study assesses the potential of thinning to increase drought tolerance of the wide spread Scots pine (Pinus sylvestris) in Central Europe. We hypothesized (1) that increasing thinning intensity benefits the maintenance of radial growth of crop trees during drought (resistance) and its recovery following drought, (2) that those benefits to growth decrease with time elapsed since the last thinning and with stand age, and (3) that they may depend on drought severity as well as water limitations in pre‐ and post‐drought periods. To test these hypotheses, we assessed the effects of thinning regime, stand age, and drought severity on radial growth of 129 Scots pine trees during and after drought events in four long‐term thinning experiments in Germany. We found that thinning improved the recovery of radial growth following drought and to a lesser extent the growth resistance during a drought event. Growth recovery following drought was highest after the first thinning intervention and in recently and heavily thinned stands. With time since the last thinning, however, this effect decreased and could even become negative when compared to unthinned stands. Further, thinning helped to avoid an age‐related decline in growth resistance (and recovery) following drought. The recovery following drought, but not the resistance during drought, was related to water limitations in the drought period. This is the first study that analyzed drought‐related radial growth in trees of one species across several stands of different age. The interaction between thinning intensity and time since the last thinning underline the importance to distinguish between short‐ and long‐term effects of thinning. According to our analysis, only thinning regimes, with relatively heavy and frequent thinning interventions would increase drought tolerance in pine stands.},
  significance = {Droughts are expected to increase in many regions, and thinning (removing some trees so the rest have more room and water) has been proposed to reduce their impact on forests. Earlier evidence comes mostly from single sites, one stand age or one thinning regime, and it is inconsistent on whether thinning helps trees to keep growing during a drought, to regain growth afterwards, or both. How general and lasting a thinning benefit is, and whether it depends on the thinning regime and the time since the last thinning, was an open question; the paper addresses it. \par The study argues that thinning mainly improves how well Scots pine regains growth after a drought and only weakly how well it keeps growing during one, and that this recovery benefit fades with time since the last thinning, so that only heavy and frequent thinning would raise drought tolerance. It tested this with growth rings of 129 trees in four long-term thinning experiments in Germany, using statistical models that include thinning intensity, time since the last thinning, stand age and drought severity. The models, fitted to drought years selected by climate alone, predict that recovery after drought is higher than in unthinned stands one year after a heavy thinning, but lower than in unthinned stands 15 years after it. The effect on growth during drought was weak, not significant for heavy thinning against unthinned stands, and appeared in only one of the two ways of selecting drought years that the study compared, so the study urges caution. \par The study reads these results as follows: the thinning benefit is short-lived, and thinning cannot prevent growth loss in severe drought. For the whole production cycle, it advises shorter thinning intervals, because recovery declines with time since the last intervention. It notes that the heavy thinning in the experiments may be considered extreme compared with usual practice in Germany. In thinned stands no negative effect of stand age appeared, whereas recovery declined with age in unthinned stands; the study notes that the trees were young (on average 27 years old at the time of the droughts, with the climate-only selection of drought years).},
  license = {publisher (subscription)},
  funding = {German Science Foundation (BA 2821/11-1)},
}

@article{singer2016community,
  author  = {Singer, Alexander and Johst, Karin and Banitz, Thomas and Fowler, Mike S. and Groeneveld, J{\"u}rgen and Guti{\'e}rrez, Alvaro G. and Hartig, Florian and Krug, Rainer M. and Liess, Matthias and Matlack, Glenn and Meyer, Katrin M. and Pe'er, Guy and Radchuk, Viktoriia and Voinopol-Sassu, Ana-Johanna and Travis, Justin M. J.},
  title   = {Community dynamics under environmental change: How can next generation mechanistic models improve projections of species distributions?},
  journal = {Ecological Modelling},
  year    = {2016},
  volume  = {326},
  pages   = {63--74},
  doi     = {10.1016/j.ecolmodel.2015.11.007},
  abstract = {Environmental change is expected to shift the geographic range of species and communities. To estimate the consequences of these shifts for the functioning and stability of ecosystems, reliable predictions of alterations in species distributions are needed. Projections with correlative species distribution models, which correlate species’ distributions to the abiotic environment, have become a standard approach. Criticism of this approach centres around the omission of relevant biotic feedbacks and triggered the search for alternatives. A new generation of mechanistic process-based species distribution models aims at implementing formulations of relevant biotic processes to cover species’ life histories, physiology, dispersal abilities, evolution, and both intra- and interspecific interactions. Although this step towards more structural realism is considered important, it remains unclear whether the resulting projections are more reliable. Structural realism has the advantage that geographic range shifting emerges from the interplay of relevant abiotic and biotic processes. Having implemented the relevant response mechanisms, structural realistic models should better tackle the challenge of generating projections of species responses to (non-analogous) environmental change. However, reliable projections of future species ranges demand ecological information that is currently only available for few species. In this opinion paper, we discuss how the discrepancy between demand for structural realism on the one hand and the related knowledge gaps on the other hand affects the reliability of mechanistic species distribution models. We argue that omission of relevant processes potentially impairs projection accuracy (proximity of the mean outcome to the true value), particularly if species range shifts emerge from species and community dynamics. Yet, insufficient knowledge that limits model specification and parameterization, as well as process complexity, increases projection uncertainty (variance in the outcome of simulated model projections). The accuracy–uncertainty-relation reflects current limits to delivering reliable projections of range shifts. We propose a protocol to improve and communicate projection reliability. The protocol combines modelling and empirical research to efficiently fill critical knowledge gaps that currently limit the reliability of species and community projections.},
  significance = {Environmental change is expected to shift where species live, and decision-makers need projections of these shifts that can be trusted. Correlative species distribution models link records of where a species occurs to abiotic (non-living) conditions. Critics note that such models leave out biotic feedbacks, which prompted process-based (mechanistic) models of dispersal, life history, evolution and interactions between species. The paper takes on an assumption behind this step: that added structural realism makes projections more reliable, even though the ecological knowledge needed to specify and parameterise the processes is available for few species. \par The paper argues that process-based species distribution models cannot yet deliver reliable projections of range shifts for many species, because the realism they call for and the knowledge available pull in opposite directions. It is an opinion paper with no analysis of its own. It separates accuracy, how close the average projection is to the true value, from uncertainty, how much simulated outcomes vary. Omitting a relevant process, such as dispersal, can impair accuracy. Including processes that are poorly known raises uncertainty, and the stochastic, nonlinear dynamics of interacting species add inherent variability. A schematic example, a species with medium dispersal that depends on another species, shows a correlative model that, assuming no dispersal, comes closer to the true shift for the wrong reason, while a mechanistic model stays inaccurate until the interaction is added, and conveys wider uncertainty than the correlative one. Its way out is a five-step protocol: collect theory, expert knowledge and evidence; parameterise the relevant processes; assess and partition uncertainty; alternate model improvement with empirical data collection aimed at the gaps that matter most; and communicate the model, its alternatives and the uncertainty. \par The paper reads the heavy data demand of process-based models as a reflection of the knowledge needed for reliable projections, not as a defect. It nonetheless holds that such models should include the relevant biotic processes, because they are the framework in which these processes can be added and tested. They are also tools for locating the gaps that limit reliability, so that targeted empirical work can close them, and the paper advises stating the shortcomings of projections openly, since overly optimistic claims of reliability are risky in decision-making. Limits remain: the protocol is proposed, not tested, in the paper.},
  license = {publisher (subscription)},
  funding = {CONICYT-PAI (82130046); FP7 projects SCALES (226852); EU BON (308454)},
}

@article{moran2016intraspecific,
  author  = {Moran, Emily V. and Hartig, Florian and Bell, David M.},
  title   = {Intraspecific trait variation across scales: implications for understanding global change responses},
  journal = {Global Change Biology},
  year    = {2016},
  volume  = {22},
  number  = {1},
  pages   = {137--150},
  doi     = {10.1111/gcb.13000},
  abstract = {Recognition of the importance of intraspecific variation in ecological processes has been growing, but empirical studies and models of global change have only begun to address this issue in detail. This review discusses sources and patterns of intraspecific trait variation and their consequences for understanding how ecological processes and patterns will respond to global change. We examine how current ecological models and theories incorporate intraspecific variation, review existing data sources that could help parameterize models that account for intraspecific variation in global change predictions, and discuss new data that may be needed. We provide guidelines on when it is most important to consider intraspecific variation, such as when trait variation is heritable or when nonlinear relationships are involved. We also highlight benefits and limitations of different model types and argue that many common modeling approaches such as matrix population models or global dynamic vegetation models can allow a stronger consideration of intraspecific trait variation if the necessary data are available. We recommend that existing data need to be made more accessible, though in some cases, new experiments are needed to disentangle causes of variation.},
  significance = {Many authors have called for more mechanistic models of how species respond to global change, but most current models still describe a species by one set of mean trait values or by broad functional types. Traits, however, differ between populations and between individuals, through inherited differences and through plasticity (one genotype adjusting to its environment). The paper asks when this variation must be included and how far existing models can represent it. It questions the assumption that a species-level mean trait is enough to predict responses to global change. \par The paper argues that variation in traits within species is likely to matter for global change predictions in five situations, and that existing model types could represent it far more than they do. It is likely to matter when a trait affects demography (survival, growth or reproduction); when the response is nonlinear in the trait, so that the response at the average trait differs from the average response (Jensen’s inequality); in small populations; when variation is structured, such as individuals that consistently grow faster, so that random noise cannot replace it; and when timescales span several generations under directional selection. Surveying matrix, integral projection, individual-based, species distribution and dynamic global vegetation models, it concludes that none has fully used its capacity to include trait variation, mainly, it suggests, for lack of data and computing capacity. In one example it cites, a lodgepole pine (Pinus contorta) model with population differences projected less than half the range loss of a species-level model under climate change (Oney et al. 2013). \par The paper offers these conditions as guidelines for when variation within species is most important to consider. It expects computing limits to ease on their own, but says data limits will not ease without active effort. It therefore recommends that existing individual-level data be made accessible, since individual measurements usually cannot be recovered from the published literature, and that specialised experiments or long-term observations, such as common gardens (genotypes reared in shared conditions) or pedigrees, separate genetic from environmental causes of variation. It closes by arguing that combining theory with such data and modelling techniques will be crucial for robust predictions.},
  significance_refs = {10.1002/ece3.426},
  license = {publisher (subscription)},
  funding = {National Science Foundation (1241327)},
}

@article{latifi2015assessing,
  author  = {Latifi, Hooman and Heurich, Marco and Hartig, Florian and M{\"u}ller, J{\"o}rg and Krzystek, Peter and Jehl, Hans and Dech, Stefan},
  title   = {Estimating over- and understorey canopy density of temperate mixed stands by airborne LiDAR data},
  journal = {Forestry},
  year    = {2016},
  volume  = {89},
  number  = {1},
  pages   = {69--81},
  doi     = {10.1093/forestry/cpv032},
  abstract = {Estimating forest structural attributes is one of the essential forestry-related remote sensing applications. The methods applied so far typically concentrate on the structure of the overstorey. For various conservation and management applications, however, information on lower layers is also of great interest. Detecting understorey cover by remote sensing is challenging, as passive sensors do not penetrate to the forest ground layer. An alternative to these is 3D metrics from active light detection and ranging (LiDAR). Here, we evaluate this technique for describing the vegetation density of multiple stand layers within the temperate stands of a large protected area in south-eastern Germany. We combined LiDAR metrics and information on forest habitat types with regression models to investigate LiDAR metrics that are significantly correlated with vegetation density. The top canopy and the herbal layer showed strong correlations with the applied LiDAR metrics, whereas the predictive power was lower for the intermediate stand layers. Moreover, our results suggest that the relationship between LiDAR predictors and vegetation density depends on the forest type. A comparison of the regression models with random forest predictions showed no major improvement in predictive error. In conclusion, this study highlights the value of the LiDAR metrics for characterizing the structural properties of lower forest layers, which has implications for wildlife and forest management applications, especially in protected areas.},
  significance = {Remote sensing of forest structure has typically concentrated on the overstorey, the upper tree canopy. For wildlife, conservation and management the layers beneath it, down to the herb layer, matter too, but passive sensors do not see through the canopy to them. Airborne LiDAR, which records where laser pulses are reflected within the vegetation, can in principle reach them. Yet its signal reflects local leaf density, whereas field ecologists record the proportion of ground covered by each layer, and earlier studies with discrete-return LiDAR reported limited power for shrubs. The paper therefore asks how well LiDAR metrics, including those from waveform systems that record the full return of each pulse, describe cover in several vertical layers, and whether that relationship holds in all forest types. \par The paper shows that LiDAR metrics describe vegetation cover in the top tree layer and the herb layer better than in the intermediate tree and shrub layers and, the results suggest, that the link between LiDAR metrics and cover differs between forest habitat types. It tests this in the Bavarian Forest National Park on up to 166 field plots where cover had been estimated by eye in five height layers, with waveform LiDAR flown four years later. Regression models gave r² of 0.63 for the top layer and 0.53 for the herb layer, against 0.19 to 0.40 for the three intermediate layers; under cross-validation the two best values were 0.56 and 0.44. Habitat type was offered to every model as a main effect and through interactions with LiDAR metrics, and the selected models for the top, second tree and herb layers retain it. The same LiDAR signal therefore went with different cover in different habitat types. Random forests gave no major improvement in r² over the regressions. \par The paper reads the results as supporting LiDAR-based mapping of top-layer and herb-layer cover, while the intermediate layers carry less LiDAR information. It advises including habitat type as auxiliary information in LiDAR-based models of forest structure. It restricts its results to a protected area and notes that the four-year gap between field and LiDAR data may have affected the fits. Venier et al. (2019) cited it for forest type sometimes affecting model accuracy and compared their shrub-layer result with it.},
  significance_refs = {10.1371/journal.pone.0220096},
  license = {publisher (subscription)},
}

