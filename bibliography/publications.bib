@article{hartig2013does,
  author  = {Hartig, Florian and Dormann, Carsten F.},
  title   = {Does model-free forecasting really outperform the true model?},
  journal = {Proceedings of the National Academy of Sciences},
  year    = {2013},
  volume  = {110},
  number  = {42},
  pages   = {E3975},
  doi     = {10.1073/pnas.1308603110},
  abstract = {Estimating population models from uncertain observations is an important problem in ecology. Perretti et al. observed that standard Bayesian state–space solutions to this problem may provide biased parameter estimates when the underlying dynamics are chaotic (1). Consequently, forecasts based on these estimates showed poor predictive accuracy compared with simple “model-free” methods, which lead Perretti et al. to conclude that “Model-free forecasting outperforms the correct mechanistic model for simulated and experimental data.” However, a simple modification of the statistical methods also suffices to remove the bias and reverse their results.},
  preprint = {https://arxiv.org/abs/1305.3544},
  significance = {Models serve both to summarise understanding and to predict, and it is often assumed that the two go together: a “more correct” model should forecast better. Perretti et al. (2013) rightly challenged this. For simulated chaotic population dynamics (extremely sensitive to the smallest disturbance), the structurally correct model, fitted statistically to noisy observations, forecast worse than flexible methods that assume no model structure, and they suggested that such “model-free” forecasting may be the most promising way forward. They also pointed to a real problem: the fits can be biased, and such bias could have gone unnoticed with empirical data. The paper takes on the further assumption that the poor forecasts show a weakness of the mechanistic approach, rather than of the way its parameters were estimated. \par The paper argues that the apparent advantage of model-free forecasting over the true model, reported by Perretti et al. (2013), is an artefact of biased parameter estimation. Because chaotic trajectories diverge under the smallest noise, the likelihood (how well parameters explain the data) over a long series can favour wrong but stable parameters over the true chaotic ones, a problem already described by Pisarenko and Sornette (2004). For the same reason, even the true model errs more on average over long horizons than a flat forecast at the series mean, so wrong but stable parameters can look better. Using the logistic map (a simple population model that becomes chaotic at high growth rates) from Perretti et al. as the test case, the full-series fit gave growth rates biased towards stable dynamics once the model became chaotic. Fitting short segments instead gave nearly unbiased estimates, fast convergence and forecasts close to those of the true parameters. The short-term error was then lower than the values Perretti et al. reported for the model-free methods (values taken from their study, not re-run). \par The results, shown for the logistic map only, give little reason to regard model-free forecasting as generally superior; the paper conjectures, without testing it, that the same holds for the other models. Mechanistic models can therefore keep their other advantages, such as transferability and theoretical understanding, if estimation is adapted to chaotic dynamics. Hamilton et al. (2017) cite the paper as showing that better model fitting can let model-based (parametric) forecasts outperform model-free ones.},
  significance_refs = {10.1073/pnas.1216076110 10.1103/PhysRevE.69.036122 10.1371/journal.pcbi.1005655},
  abstract_kind = {opening},
  license = {publisher (subscription)},
}

@article{taubert2013challenge,
  author  = {Taubert, Franziska and Hartig, Florian and Dobner, Hans-J{\"u}rgen and Huth, Andreas},
  title   = {On the Challenge of Fitting Tree Size Distributions in Ecology},
  journal = {PLoS ONE},
  year    = {2013},
  volume  = {8},
  number  = {2},
  pages   = {e58036},
  doi     = {10.1371/journal.pone.0058036},
  abstract = {Patterns that resemble strongly skewed size distributions are frequently observed in ecology. A typical example represents tree size distributions of stem diameters. Empirical tests of ecological theories predicting their parameters have been conducted, but the results are difficult to interpret because the statistical methods that are applied to fit such decaying size distributions vary. In addition, binning of field data as well as measurement errors might potentially bias parameter estimates. Here, we compare three different methods for parameter estimation – the common maximum likelihood estimation (MLE) and two modified types of MLE correcting for binning of observations or random measurement errors. We test whether three typical frequency distributions, namely the power-law, negative exponential and Weibull distribution can be precisely identified, and how parameter estimates are biased when observations are additionally either binned or contain measurement error. We show that uncorrected MLE already loses the ability to discern functional form and parameters at relatively small levels of uncertainties. The modified MLE methods that consider such uncertainties (either binning or measurement error) are comparatively much more robust. We conclude that it is important to reduce binning of observations, if possible, and to quantify observation accuracy in empirical studies for fitting strongly skewed size distributions. In general, modified MLE methods that correct binning or measurement errors can be applied to ensure reliable results.},
  significance = {Strongly skewed size distributions, in which small values are common and large ones rare, occur frequently in ecology; tree stem diameters are a typical example. Theories such as metabolic scaling and self-organised criticality predict their form and parameters, so testing them means fitting the distributions to field data. Maximum likelihood estimation (MLE), which finds the parameter values that make the recorded data most probable, is regarded as the most accurate way to do this, and as better than regression on size classes. Field data, however, are rounded or sorted into classes (“binning”) or carry random errors, whereas standard MLE treats every recorded value as exact. To the authors’ knowledge, how this biases the fitted parameters and the choice between candidate distributions had not been examined systematically. \par The paper shows that even maximum likelihood fitting of skewed size distributions becomes biased and often picks the wrong distribution once data are binned or carry random measurement error, and that likelihoods built to model this uncertainty largely repair the problem. The study used 1,000 simulated datasets per case (250 for the measurement-error correction), drawn from power-law, negative exponential and Weibull distributions. In the main runs, with 500 values each, standard MLE kept the mean parameter bias under 5% only for very small bin widths or errors. Beyond small thresholds it favoured the wrong distribution for power-law and exponential data when candidates were compared with Akaike weights, a score that rewards fit and penalises complexity, and larger samples did not remove the problem. Two modified likelihoods, one for binning and one for normally distributed measurement error, reduced the bias for most parameters and identified power-law and Weibull data correctly. For 207,105 stem diameters from Barro Colorado Island, where bin width and error are small, the MLE variants gave similar estimates, whereas regression fits differed markedly. \par The paper reads these results as a warning: fitted parameters from different datasets, or from data and theory, are hard to compare unless binning and measurement error are handled. It advises reducing binning, quantifying observation accuracy and using the corrected likelihoods when uncertainty matters. Open questions include estimating the truncation limits and treating binning and error together. Moore et al. (2018) cite the paper for MLE working well on forest size distributions when binning is fine.},
  significance_refs = {10.1088/1748-9326/aad6d1},
  license = {CC BY 4.0},
  funding = {Helmholtz Impulse and Networking Fund through Helmholtz Interdisciplinary Graduate School for Environmental Research (HIGRADE)},
}

@article{schymanski2013process,
  author  = {Schymanski, Stanislaus J. and Dormann, Carsten F. and Cabral, Juliano and Chuine, Isabelle and Graham, Catherine H. and Hartig, Florian and Kearney, Michael and Morin, Xavier and R{\"o}mermann, Christine and Schr{\"o}der, Boris and Singer, Alexander},
  title   = {Process, correlation and parameter fitting in species distribution models: a response to Kriticos et al},
  journal = {Journal of Biogeography},
  year    = {2013},
  volume  = {40},
  number  = {3},
  pages   = {612--613},
  doi     = {10.1111/jbi.12075},
  abstract = {In a recent article (Dormann et al., 2012, Journal of Biogeography, 39, 2119–2131), we compared different approaches to species distribution modelling and depicted modelling approaches along an axis from purely ‘correlative’ to ‘forward process‐based’ models. In their correspondence, Kriticos et al. (2013, Journal of Biogeography, doi:10.1111/j.1365‐2699.2012.02791.x) challenge this view, claiming that our continuum representation neglects differences among models and does not consider the ability of fitted process‐based models to combine the advantages of both process‐based and correlative modelling approaches. Here we clarify that the continuum view resulted from recognition of the manifold differences between models. We also reinforce the point that the current trend towards combining different modelling approaches may lead not only to the desired combination of the advantages but also to the accumulation of the disadvantages of those approaches. This point has not been made sufficiently clear previously.},
  significance = {Species distribution models (SDMs) estimate where a species can occur. Correlative models relate recorded occurrences directly to environmental variables; process-based models let the distribution emerge from implemented processes such as dispersal or demography. Dormann et al. (2012) arranged the approaches on a continuum from purely correlative to “forward” process-based models. Kriticos et al. (2013) objected that this hides marked differences among models and misrepresents “fitted” process-based models, some of whose parameters are estimated from distribution data (Hartig et al. 2012) and which, they argue, combine the strengths of both approaches. The problem the paper takes on is whether fitted process-based models and hybrid models (correlative models with added processes) gain both sets of advantages without taking over the disadvantages. \par The paper argues that species distribution models which mix fitting to distribution data with the representation of ecological processes may not simply add up the strengths of both approaches, but inherit some weaknesses of the correlative side and may create new ones, so a continuum describes them better than separate categories. A process-based model fitted to distribution data shares some assumptions, data requirements, validation issues and sources of uncertainty with a correlative model. Fitting is often done by necessity rather than design, because such models have many parameters, some of them hard to measure beforehand. Where model structure and independent ecological knowledge do not sufficiently constrain the outcome, fitting may give an illusion of predictive power, and may bring drawbacks in transferability and extrapolation similar to those of correlative models. Combination can also add errors: a dispersal kernel placed on a suitability map already fitted to observed distributions may, the response argues, count dispersal limitation twice, and can add resolution-dependent errors (Bocedi et al. 2012). A continuum also accommodates novel approaches, whereas fixed categories produce borderline cases. \par The paper does not reject combined models. It holds that tuning is inevitable in many cases but that its consequences should be taken into account when models are validated, and restates that no method is intrinsically superior to another. The reply clarifies that the continuum was meant to acknowledge the variety of models, and it closes by inviting continued open discussion of their strengths and weaknesses.},
  significance_refs = {10.1111/j.1365-2699.2011.02659.x 10.1111/j.1365-2699.2012.02791.x 10.1111/j.1365-2699.2012.02745.x 10.1111/j.2041-210x.2012.00235.x},
  license = {publisher (subscription)},
}

@article{vanoijen2013bayesian,
  author  = {van Oijen, Marcel and Reyer, Christopher and Bohn, Friedrich J. and Cameron, David R. and Deckmyn, Gaby and Flechsig, Michael and H{\"a}rk{\"o}nen, Sanna and Hartig, Florian and Huth, Andreas and Kiviste, Andres and Lasch, Petra and M{\"a}kel{\"a}, Annikki and Mette, Tobias and Minunno, Francesco and Rammer, Werner},
  title   = {Bayesian calibration, comparison and averaging of six forest models, using data from Scots pine stands across Europe},
  journal = {Forest Ecology and Management},
  year    = {2013},
  volume  = {289},
  pages   = {255--268},
  doi     = {10.1016/j.foreco.2012.09.043},
  abstract = {Forest management requires prediction of forest growth, but there is no general agreement about which models best predict growth, how to quantify model parameters, and how to assess the uncertainty of model predictions. In this paper, we show how Bayesian calibration (BC), Bayesian model comparison (BMC) and Bayesian model averaging (BMA) can help address these issues. We used six models, ranging from simple parameter-sparse models to complex process-based models: 3PG, 4C, ANAFORE, BASFOR, BRIDGING and FORMIND. For each model, the initial degree of uncertainty about parameter values was expressed in a prior probability distribution. Inventory data for Scots pine on tree height and diameter, with estimates of measurement uncertainty, were assembled for twelve sites, from four countries: Austria, Belgium, Estonia and Finland. From each country, we used data from two sites of the National Forest Inventories (NFIs), and one Permanent Sample Plot (PSP). The models were calibrated using the NFI-data and tested against the PSP-data. Calibration was done both per country and for all countries simultaneously, thus yielding country-specific and generic parameter distributions. We assessed model performance by sampling from prior and posterior distributions and comparing the growth predictions of these samples to the observations at the PSPs. We found that BC reduced uncertainties strongly in all but the most complex model. Surprisingly, country-specific BC did not lead to clearly better within-country predictions than generic BC. BMC identified the BRIDGING model, which is of intermediate complexity, as the most plausible model before calibration, with 4C taking its place after calibration. In this BMC, model plausibility was quantified as the relative probability of a model being correct given the information in the PSP-data. We discuss how the method of model initialisation affects model performance. Finally, we show how BMA affords a robust way of predicting forest growth that accounts for both parametric and model structural uncertainty.},
  significance = {Forest management needs predictions of stand growth, but there is no agreement on which dynamic growth models predict best, how to set their parameters, or how to judge the uncertainty of their forecasts. The models range from simple, parameter-sparse ones to complex process-based ones, and the paper notes that none has come into general use across Europe, possibly because they are hard to parameterise and their transferability is unclear. Bayesian calibration of parameter-rich process-based models was still rare, and Bayesian model comparison had been applied to four forest biogeochemistry models (van Oijen et al. 2011). The paper asks whether one Bayesian framework can calibrate, rank and combine forest models of very different structure. \par The paper argues that Bayesian calibration, model comparison and model averaging, used together, offer a general way to fit, rank and combine forest growth models of very different structure while tracking parameter and structural uncertainty. Calibration narrows prior parameter ranges with data, comparison gives each model a probability of being correct given the observations, and averaging weights forecasts by those probabilities. The study tested this on six models with Scots pine data from twelve sites in four European countries, calibrating on two sites per country and testing on a third. Calibration reduced uncertainty in all but the most complex model, mostly through a few parameters. The comparison ranked BRIDGING, of intermediate complexity, first before calibration and 4C after it; the paper suggests that models started from measured height and diameter had an advantage over those started at planting. Averaging with weights from the comparison before calibration predicted out of sample robustly; the average after calibration was only average, partly in-sample. \par The paper concludes that model comparison can identify plausible models and that averaging may be a promising tool for forest management, as it is less prone than picking a single model to underestimate predictive uncertainty. For a manager who wants a single model from these six it recommends 4C, but reads the probabilities as a guide, not as formal model probabilities, since the comparison presumes one model is correct. It notes that rankings might differ with more data or other outputs than height and diameter. Trotsiuk et al. (2020) cite the paper as an earlier large-dataset Bayesian calibration of a forest model.},
  significance_refs = {10.1016/j.agrformet.2011.06.017 10.1111/gcb.15011},
  license = {publisher (subscription)},
  funding = {EU, COST Action FP603; EU FP7, IP Carbo-Extreme (GA 226701); ERC advanced grant (233066)},
}

