@article{hartig2010ecotrade,
  author  = {Hartig, Florian and Horn, Martin and Drechsler, Martin},
  title   = {EcoTRADE – A multi-player network game of a tradable permit market for biodiversity credits},
  journal = {Environmental Modelling \& Software},
  year    = {2010},
  volume  = {25},
  number  = {11},
  pages   = {1479--1480},
  doi     = {10.1016/j.envsoft.2009.01.003},
  abstract = {EcoTRADE is a multi-player network game of a virtual biodiversity credit market. Each player controls the land use of a certain amount of parcels on a virtual landscape. The biodiversity credits of a particular parcel depend on neighboring parcels, which may be owned by other players. The game can be used to study the strategies of players in experiments or classroom games and as a communication tool for stakeholders participating in credit markets that include spatially interdependent credits.},
  preprint = {https://arxiv.org/abs/0812.0956},
  significance = {Tradable permits are an economic instrument for controlling the use of environmental resources: rights to use are traded. Carbon emissions trading is one example; similar schemes, called biobanking or biodiversity credit trading, had also come into use to restrict land use and maintain natural habitats (Wissel and Wätzold 2010). Unlike carbon emissions, however, biodiversity credits (tradable units of habitat conservation) cannot be issued independently of location. Species depend on the connectedness of their habitat, so conserving a site is worth more near other conserved sites, and credits should be issued accordingly (Drechsler and Wätzold 2009). The problem the paper takes on is that such spatially interdependent credits make landowners influence each other’s payoffs (Hartig and Drechsler 2010), which leaves open how participants behave and how the difficulty can be conveyed to stakeholders. \par EcoTRADE is a networked multiplayer game in which players trade biodiversity credits whose amount depends on how neighbouring parcels, possibly owned by other players, are used, which makes the problem of spatially interdependent credits tangible. Each player starts with land and a conservation obligation and sets each parcel to conservation or agriculture. A player who falls short of the obligation must buy credits from others; a surplus can be sold. The aim is to maximise profit from farming and credit sales. The paper reports use in several workshops, with participants ranging from children aged 10 to 15 to ecology and economics students and scientists in conservation and resource economics. According to the authors, the game proved useful for observing typical player behaviour and strategies and for communicating the problems of spatially interdependent credits. This experience is described informally, without data. \par The paper poses questions that such credit markets raise: whether landowners coordinate or cooperate to raise profits, whether they find the land configurations that pay best, and whether they consider it unfair that others influence their payoffs. The authors hope the game will be used for classroom games, stakeholder workshops and experimental economics. The paper itself makes no claim about how real credit markets perform; its contribution is the game itself, first available in 2008, with documentation and an online applet offered at the time of publication.},
  significance_refs = {10.1111/j.1523-1739.2009.01444.x 10.1016/j.ecolecon.2008.07.019 10.1016/j.ecocom.2009.07.001},
  license = {publisher (subscription)},
}

@article{hartig2010stay,
  author  = {Hartig, Florian and Drechsler, Martin},
  title   = {Stay by thy neighbor? Social organization determines the efficiency of biodiversity markets with spatial incentives},
  journal = {Ecological Complexity},
  year    = {2010},
  volume  = {7},
  number  = {1},
  pages   = {91--99},
  doi     = {10.1016/j.ecocom.2009.07.001},
  preprint = {https://arxiv.org/abs/0808.0111},
  abstract = {Market-based conservation instruments, such as payments, auctions or tradable permits, are environmental policies that create financial incentives for landowners to engage in voluntary conservation on their land. But what if ecological processes operate across property boundaries and land use decisions on one property influence ecosystem functions on neighboring sites? This paper examines how to account for such spatial externalities when designing market-based conservation instruments. We use an agent-based model to analyze different spatial metrics and their implications on land use decisions in a dynamic cost environment. The model contains a number of alternative submodels which differ in incentive design and social interactions of agents, the latter including coordinating as well as cooperating behavior of agents. We find that incentive design and social interactions have a strong influence on the spatial allocation and the costs of the conservation market.},
  significance = {Market-based conservation schemes (payments, auctions, tradable permits) award landowners credits for voluntary conservation. Ecological processes often cross property boundaries, so a conserved site is worth more when its neighbours are conserved too. Spatial incentives, such as those of Parkhurst et al. (2002), build this into the credits. The paper asks how the benefit shared by neighbouring sites should be divided: equally between them (“additive” incentives) or by crediting each site with the loss in total value that its removal would cause (“marginal” incentives). It also asks whether landowners who each decide for themselves produce the intended landscape pattern at reasonable cost. Finally, it asks whether the design of the incentive alone settles the outcome, or whether the social organisation of the landowners matters as well. \par In market-based conservation with spatial incentives, both the design of the incentive and the social organisation of the landowners shape the resulting landscape pattern and what it costs. The paper shows this with an agent-based model: every cell of a 50 × 50 grid has its own owner, and costs fluctuate. Owners who decide individually end up with either one large cluster of conserved sites or scattered ones, switching sharply between the two once the variation in costs passes a critical level. They stop trading once no owner can gain alone, leaving them in a local cost optimum: an arrangement that no individual move can improve. Additive incentives make owners abandon the cluster too early, at a cost variation of about 0.33 instead of 0.5 under marginal incentives (for a connectivity weight of 0.5). This raises costs by roughly 20% near the transition. Non-binding exchange of intentions (“cheap talk”) closes most of the cost gap without moving the transition. With full cooperation, costs are lowest, the response is gradual, and the two incentive types perform identically. \par The results suggest that simple local incentives can steer landscape-scale conservation. Marginal incentives, which depend on the order of trading, suit sequential, long-term schemes such as tradable permits; additive incentives, for which the order does not matter, suit parallel, short-term schemes such as yearly payments. If landowners decide individually, marginal incentives perform better. The paper concludes that market designs encouraging cooperation among landowners look beneficial, while leaving open whether it is stable against free-riding and strategic misreporting, which the model excludes.},
  significance_refs = {10.1016/S0921-8009(02)00036-8},
  license = {publisher (subscription)},
}

@phdthesis{hartig2010metapopulations,
  author   = {Hartig, Florian},
  title    = {Metapopulations, Markets and the Individual: Refining incentive-based approaches for biodiversity conservation on private lands},
  school   = {Osnabr{\"u}ck University},
  year     = {2009},
  url      = {https://osnadocs.ub.uni-osnabrueck.de/handle/urn:nbn:de:gbv:700-2010012932},
  abstract = {When designing financial incentives for voluntary conservation of threatened habitats and ecosystems, we are faced with the problem that there is no single indicator for "biodiversity value". The value of a habitat depends on multiple factors such as habitat type, area, and spatial and temporal connectivity. Moreover, not only are there local trade-offs between these indicators, but land use changes at one location may also change the value of sites in the vicinity. This doctoral thesis analyzes the consequences of including trade-offs and interactions between sites in market-based conservation schemes. We ask the following questions: How can trade-offs between the survival of different species be quantified? How can spatial processes and temporal processes be included in market-based conservation, in particular the value of spatial and temporal connectivity? And how do underlying economic dynamics relate to the spatio-temporal allocation of conservation measures in market-based conservation schemes?},
  significance = {Market-based instruments such as payments and tradable permits induce landowners to conserve habitat voluntarily. They need a single currency for habitats that differ in type, area and connectivity, and the thesis observes that most existing schemes value a site by its local quality and size alone. A site’s worth, however, also depends on its neighbours and on timing, and a land-use change on one site alters the value of nearby ones. Landowners therefore affect one another, yet have limited information about one another. An apparent remedy, in the thesis’s account, is to build spatial dependence into the market values. The problem the thesis takes on is how to design incentives without assuming that conservation value is local and static, or that ecology alone can set it. \par The thesis argues that incentives for market-based conservation must account for space, time and the behaviour of landowners, and that their design needs ecology and economics analysed together. In a two-species case, the ranking of conservation options under objectives that add up species’ survival probabilities can change when the time horizon (the date at which survival is judged) crosses a critical value. In a model that couples a metapopulation (a set of linked local populations) with landowners as individual agents, incentives that reward connectivity are more cost-effective than purely area-based ones, and the best design depends on how far species disperse and how costs vary in space and time. Incentive design and landowners’ social organisation strongly affect where habitat ends up and what it costs. In a simulated market for wet grasslands and reed marshes in the Netherlands, spatial incentives and a tax on habitat relocation can control the amount, fragmentation and dynamics of habitat (that paper was in preparation at submission). \par The thesis reads these results as showing that simple spatial and temporal incentives are a policy option for real conservation markets. It adds that the best incentives depend on the species and the economic setting, so schemes need “ecological-economic surrogates”, that is, indicators linking incentives to conservation success in a given setting. It also calls for experiments on landowner behaviour (the thesis presents a network game) and for socio-economic data, and argues that time preferences are a normative choice to be stated explicitly.},
}

% ------------------------------------------------------------------ 2009 ----

@article{hartig2009smart,
  author  = {Hartig, Florian and Drechsler, Martin},
  title   = {Smart spatial incentives for market-based conservation},
  journal = {Biological Conservation},
  year    = {2009},
  volume  = {142},
  number  = {4},
  pages   = {779--788},
  doi     = {10.1016/j.biocon.2008.12.014},
  abstract = {Market-based instruments such as payments, auctions or tradable permits have been proposed as flexible and cost-effective instruments for biodiversity conservation on private lands. Trading the service of conservation requires one to define a metric that determines the extent to which a conserved site adds to the regional conservation objective. Yet, while markets for conservation are widely discussed and increasingly applied, little research has been conducted on explicitly accounting for spatial ecological processes in the trading. In this paper, we use a coupled ecological–economic simulation model to examine how spatial connectivity may be considered in the financial incentives created by a market-based conservation scheme. Land use decisions, driven by changing conservation costs and the conservation market, are simulated by an agent-based model of land users. On top of that, a metapopulation model evaluates the conservational success of the market. We find that optimal spatial incentives for agents correlate with species characteristics such as the dispersal distance, but they also depend on the spatio-temporal distribution of conservation costs. We conclude that a combined analysis of ecological and socio-economic conditions should be applied when designing market instruments to protect biodiversity.},
  preprint = {https://arxiv.org/abs/0809.0228},
  significance = {Payments, auctions and tradable permits are promoted as cost-effective ways to conserve biodiversity on private land. Each needs a metric that turns a conserved site into conservation credits. Most existing schemes value a site only by its own size and quality, although for many species a site’s worth depends on the habitat around it. Connectivity metrics from reserve planning are an obvious model, but they assume a planner who sees the whole landscape. Landowners in a market decide individually and with limited information, so copying the planners’ metrics directly would be short-sighted. The paper asks how connectivity should enter the incentives of such landowners. \par Rewarding landowners for the connectivity of the sites they conserve (how much conserved habitat lies nearby), and not only for size and quality, considerably improves the outcome of a conservation market where dispersal limits the species concerned; the best form of that reward depends on the species and on how conservation costs vary. The study couples a model of landowners trading credits under a fixed budget with a stochastic metapopulation model (colonisations and extinctions of local populations) on a virtual landscape. Markets with a connectivity reward gave higher species survival than markets without one, most clearly for species that disperse over short distances. These did best when a site’s credits depended strongly on conserved habitat in its immediate surroundings, whereas species that disperse across the whole landscape did better with a low weight, because that lets the budget pay for more conserved sites. The cost pattern shifted the optimum too, because the incentive also changes turnover, the rate at which conserved sites are dropped and recreated elsewhere, and turnover acts like extra local extinction. With uncorrelated random costs, a strong connectivity weight was best for all species because it lowers turnover. \par The results suggest that spatial incentives may raise the cost-effectiveness of conservation markets substantially where fragmentation limits the species concerned. Because a voluntary market lets landowners withdraw while others step in, it is likely to produce dynamic landscapes, and this turnover must be considered in design. Optimal spatial incentives are not context-free: ecological and socio-economic conditions should be analysed together. The paper also recommends examining the efficiency gains that spatially explicit metrics could bring to existing market schemes.},
  license = {publisher (subscription)},
}

% ------------------------------------------------------------------ 2008 ----

@article{hartig2008time,
  author  = {Hartig, Florian and Drechsler, Martin},
  title   = {The time horizon and its role in multiple species conservation planning},
  journal = {Biological Conservation},
  year    = {2008},
  volume  = {141},
  number  = {10},
  pages   = {2625--2631},
  doi     = {10.1016/j.biocon.2008.07.028},
  abstract = {Survival probability within a certain time horizon T is a common measure of population viability. The choice of T implicitly involves a time preference, similar to economic discounting: conservation success is evaluated at the time horizon T, while all effects that occur later than T are not considered. Despite the obvious relevance of the time horizon, ecological studies seldom analyze its impact on the evaluation of conservation options. In this paper, we show that, while the choice of T does not change the ranking of conservation options for single species under stationary conditions, it may substantially change conservation decisions for multiple species. We conclude that it is of crucial importance to investigate the sensitivity of model results to the choice of the time horizon or other measures of time preference when prioritizing biodiversity conservation efforts.},
  preprint = {https://arxiv.org/abs/0807.4040},
  significance = {Conservation planning compares options with objective functions, and species’ survival probabilities are a measure tied directly to the goal of persistence. A survival probability always refers to a time horizon T: success is judged at T and everything that happens later is ignored. Ignoring everything after T is a time preference, much like discounting in economics, where a short horizon resembles a high discount rate. Environmental economists debate discounting at length, yet conservation planning appears to have largely neglected the choice of T. One possible reason is that, under constant environmental conditions, T does not change which option is best for a single species, and the same was assumed to hold for several species. The paper tests that assumption. \par The paper shows that the time horizon T of a survival-probability analysis can change which multi-species conservation option is best: survival probability decays exponentially with T, so small differences between options grow with longer horizons. In a stylised model that splits a fixed budget between two species, objectives that add up survival probabilities (the expected number of surviving species), with or without extra weight on an even split, favour an even split at short horizons and, beyond a critical horizon, concentrating the money on one species. This happens when each extra unit of spending buys less and less survival, or when an even split is weighted strongly and the gain from spending does not increase steeply. The objective “probability that all species survive” is provably unaffected by T, but the paper does not see this as an argument for it: if the budget is too small to save every species, it can minimise the expected number of survivors. A numerical analysis finds that a switch within typical horizons occurs over a fairly large range of parameters. \par The results mean that T cannot be treated as a technical default. The paper calls it a fundamental, normative part of the objective function, to be chosen with care, with its influence tested and communicated alongside any conservation recommendation, all the more as conservation turns to dynamic problems such as climate change.},
  license = {publisher (subscription)},
}
