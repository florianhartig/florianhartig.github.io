@article{machac2025species,
  author  = {Machac, Antonin and Hurlbert, Allen and Cabral, Juliano Sarmento and Cerezer, Felipe O. and Dambros, Cristian S. and Fritz, Susanne and Graham, Catherine H. and Hagen, Oskar and Hartig, Florian and Huang, Shan and Pontarp, Mikael and Storch, David},
  title   = {Species Richness Gradients Vary Across Phylogenetic Scales},
  journal = {Global Ecology and Biogeography},
  year    = {2025},
  volume  = {34},
  number  = {12},
  pages   = {e70067},
  doi     = {10.1111/geb.70067},
  abstract = {Aim: To determine how species richness gradients—commonly considered universal—vary across the phylogenetic hierarchy of birds and mammals, and to uncover how clade age and size predetermine the gradients. Location: Global. Time Period: Last 120 million years. Taxa Studied: Birds and mammals (~15,000 species). Methods: We used large‐scale phylogenies of birds and mammals and captured the species richness gradient for each of their monophyletic clades. Gradient strength was quantified with respect to latitude, environmental productivity and temperature using multiple measures (raw slopes, log transformation, log–log transformation, and correlations). To distinguish statistical from biological effects, we compared the observed gradients to those generated by null models that randomly reassigned species to clades while preserving the phylogeny and species distributions. Results: Species richness gradients show considerable variation. Small and young clades exhibited inconsistent gradients—including reverse or flat gradients—while older and larger clades converged on steep, consistent gradients. Even moderately large clades (~500 species) commonly displayed reverse gradients. Null models replicated this trend but only partially, implying that biological effects also drive gradient variation. These phylogenetic trends were sensitive to the choice of gradient measure: raw slopes frequently inflated the strength of this trend and the apparent differences among clades, while log and log–log transformations revealed only moderate trends. Main Conclusions: Species richness gradients are not universal, nor are they phylogenetic scale‐invariant. Instead, they follow systematic trends across the phylogenetic hierarchy. Young, small clades often bear signatures of their region of origin and historical dispersal, whereas older, larger clades converge on similar gradients. Recognising the variation and the phylogenetic trends within it elucidates the formation of biodiversity patterns. We offer guidelines for choosing gradient measures, arguing that multiple metrics, combined with careful use of null models, are necessary for a nuanced understanding of how, and why, global biodiversity patterns diverge from the presumed universal gradients.},
  significance = {The decline of species richness from the tropics towards the poles is a classic pattern in biology and is well documented for large groups. Smaller groups, however, show many other shapes, including reverse gradients, sometimes dismissed as idiosyncratic exceptions. Studies often assume, implicitly, that richness patterns look much the same however the studied group is delimited. This has rarely been tested across nested groups (clades, each an ancestor with all its descendants) of different age and size. Testing is difficult because part of any change with clade size may be statistical, and the measure of gradient strength may itself create trends. This is the assumption the paper examines. \par The paper argues that the strength and direction of a species richness gradient depend systematically on the age and size of the group of species studied, so a gradient found in one part of the evolutionary tree need not hold in another. The study measured gradients for every clade of at least 10 species within birds and mammals. Small and young clades varied widely: reverse gradients occurred in 37% of all mammal clades and 36% of all bird clades analysed, and even clades of up to about 500 species often showed them, whereas larger clades converged on steep, classic gradients. A null model that randomly reassigns species to clades reproduced a weaker but similar trend and explained about half of the variation in gradient strength, so clade size explains part of the pattern, not all of it. Raw regression slopes often exaggerated this trend, whereas log and log–log transformations showed only moderate trends. \par Gradients are thus neither universal nor the same at every level of the tree: the age and size of the studied group shape the gradient found, which may reconcile some contrasting results among earlier studies. The paper favours the view that the processes forming gradients change as clades grow, with young, small clades keeping the imprint of their region of origin and large clades converging on the classic pattern; this explanation is not tested directly. It suggests that some earlier work based on raw slopes, such as Hillebrand (2004), may need reinterpretation, and recommends matching the measure to the theory tested, using several measures when theory is weak, and applying null models before drawing biological conclusions.},
  significance_refs = {10.1086/381004},
  license = {CC BY 4.0},
  funding = {Czech Science Foundation (23-05977S); Czech Science Foundation (20-29554X); Swiss National Science Foundation (SNSF) (315230_197753); iDiv funded by the German Research Foundation (DFG) (FZT 118, 202548816); Swiss National Science Foundation (SNSF) (P500PB_206815); sDiv, Synthesis Centre of iDiv (DFG FZT 118), working group sELDIG; Ministry of Education, Youth and Sports of the Czech Republic (MetaCentrum grid computing and e-INFRA CZ project) (90254)},
}

@article{leite2025dispersion,
  author  = {de Souza Leite, Melina and Rettelbach, Daniel and Hartig, Florian},
  title   = {Dispersion tests in generalized linear mixed-effects models: a methods comparison and practical guide for ecologists},
  journal = {EcoEvoRxiv},
  year    = {2025},
  abstract = {Underdispersion and overdispersion are common issues when analysing ecological data with generalized linear (mixed) models (GLMs/GLMMs). Overdispersion, the phenomenon where observations spread wider than expected by the fitted model, usually leads to anti-conservative p-values and, thus, to inflated type I error. In contrast, underdispersion, a narrower spread of the data than expected, causes overly conservative p-values and, therefore, reduced power. A range of tests has been proposed to detect such dispersion problems, but there are few comparative studies of their performance across models and analysis settings, and, most importantly, sparse recommendations for ecologists on how to check for dispersion issues. Our goal was to identify a general dispersion test for GLMs/GLMMs applicable to standard distributions and random-effects structures commonly used in ecological data analysis. Following an initial review of available tests, we selected two classes of dispersion tests: (1) parametric and nonparametric tests based on Pearson residuals and (2) simulation-based tests that compare the expected and observed residual variance. Comparing their performance by type I error, power, and dispersion estimate, across a range of Poisson and binomial GLMs/GLMMs, we found that the nonparametric Pearson residuals test performed best across all metrics, particularly for data with low incidence or count rates and/or small samples; however, at the cost of high computational expense. The parametric Pearson residuals test, recommended in many books and guidelines, was fast and effective for GLMs, but biased towards underdispersion in GLMMs due to the naïve computation of the random-effect degrees of freedom. The simulation-based residual variance test was slightly less powerful, but showed overall good calibration. The latter offers a compromise between the strengths and weaknesses of the two Pearson-based tests. We conclude that for GLMs, the parametric Pearson residuals test offers the best balance of speed and accuracy. For GLMMs, we recommend either the computationally demanding nonparametric Pearson residuals test or the faster, although somewhat less powerful, simulation-based residual variance test. We also analyze two case studies in ecology that differ in complexity and include recommendations for ecological data analysis to address dispersion issues, using the most commonly used R packages, avoiding pitfalls, and improving model fit and the interpretation of ecological datasets.},
  significance = {Ecological counts and proportions are often analysed with generalised linear models (GLMs) and their mixed-effects extension (GLMMs). Data that scatter more widely (overdispersion) or more narrowly (underdispersion) than such a model expects distort p-values. Many dispersion tests exist, but many were designed and checked only for narrow cases such as a simple Poisson GLM. They have rarely been compared across mixed-model structures, so ecologists get little guidance. The popular parametric Pearson test, recommended in many books and guidelines, is reasonable and quick for simple models. But it presupposes a chi-squared null distribution, which needs a known number of residual degrees of freedom (unclear with random effects) and large samples (sparse data break it). The paper asks which dispersion test ecologists can trust across their models. \par The paper concludes that no dispersion test excels in every respect: the nonparametric Pearson test is the most reliable general test but computationally costly, so the choice depends on model type, data size and computing time. Simulations of three tests on Poisson and binomial models carry this. The parametric Pearson test is fast and effective for GLMs with enough data, but biased towards underdispersion in GLMMs, because random effects are counted with too few degrees of freedom. The nonparametric Pearson test, which refits the model to simulated data, performs best, particularly for low counts and small samples. The simulation-based residual variance test is well calibrated overall but somewhat less powerful, partly because it is often conservative. In two case studies, overdispersion in Swiss redstart counts traced back to spatial autocorrelation rather than the distribution. In a re-analysis of an orangutan behaviour study, the parametric Pearson test, usable only for overdispersion in GLMMs, could not detect underdispersion that the other tests found. \par The paper turns this into a decision guide: the parametric Pearson test for standard GLMs with enough data; the nonparametric Pearson test for GLMMs, or the simulation-based test when refitting is too slow or fails. A significant result does not by itself call for another distribution: first check how far the dispersion statistic departs from 1, then look for misspecification such as spatial autocorrelation. All three tests are available in the DHARMa R package, which two of the authors develop. The simulations focused on overdispersion, and the study is a preprint that has not been peer-reviewed.},
  funding = {Deutsche Forschungsgemeinschaft (DFG) (528747641)},
  license = {CC BY 4.0},
  doi = {10.32942/X23M14},
}

@article{lwin2025human,
  author  = {Lwin, Ye Htet and Quan, Rui-Chang and Hartig, Florian and K{\"u}hl, Hjalmar S. and Heurich, Marco},
  title   = {Human and apex predators shape lower trophic levels through top-down control},
  journal = {Biological Conservation},
  year    = {2025},
  volume  = {310},
  pages   = {111352},
  doi     = {10.1016/j.biocon.2025.111352},
  abstract = {Apex predators are thought to regulate ecosystems through top-down control, but the extent of their impact often varies, potentially due to differences in their abundance and other aspects of the ecosystem, including human disturbances. Here, we analyzed three years of data collected from 114 camera traps placed in Htamanthi Wildlife Sanctuary, northwestern Myanmar. Using multigroup piecewise structural equation modeling, we explored associations among multiple trophic levels, including humans, apex predators, mesopredators, prey species and vegetation across varying apex predator biomass levels within similar environments. We found that variation in apex predator biomass significantly influences trophic associations, especially concerning top-down control exerted by humans and apex predators. Human disturbances had a regulatory role on apex predators and large prey populations and alter their behavior. Apex predators both suppressed and facilitated prey populations, underscoring the crucial role of sustaining apex predator populations in ecosystems. Furthermore, our study highlights positive associations between mesopredators and prey species, demonstrating their coexistence within the ecosystem. Bottom-up effects from vegetation were weaker than top-down processes. Nevertheless, the observed positive link between vegetation and small prey suggests that this bottom-up component also plays an important role in the trophic network. Our study highlights the complex associations between different trophic levels and underscores the importance of considering multiple species for effective conservation and ecosystem stability.},
  significance = {Classic ecological ideas describe apex predators, the top carnivores of a food web, as regulators from above: if they decline, mid-sized predators and plant-eaters are expected to increase (the mesopredator release idea) and plants to suffer (the “green world” idea). How strongly this control works varies between systems, possibly with predator numbers and with human disturbance. However, how these ideas play out in real, multi-species food webs is not well understood, nor is the role of humans when they act as “super predators” (Darimont et al. 2015). The paper asks how humans and apex predators together shape the lower levels of such a food web. \par The paper argues that in a tropical forest food web, top-down control of the lower levels comes from humans as well as from apex predators, and suggests that human pressure weakens the predators’ own regulatory role. The evidence is camera-trap records from 114 sites in Htamanthi Wildlife Sanctuary, Myanmar. The study compares two nearby areas with higher and lower apex-predator biomass and fits a statistical model of associations (not experiments) among humans, three size classes of predators, prey groups and vegetation. In the area with more apex predators, human disturbance was negatively associated with apex predators and with large prey. Apex predators themselves showed mixed associations: negative with small predators and with semi-arboreal prey (animals such as primates that use both ground and trees), but positive with medium-sized predators and absent for large prey, against the expectation from these ideas. Associations among the lower levels were mostly positive, and vegetation was linked only to small prey, so effects from the bottom of the food web (plants on animals) appeared weaker than control from above. \par The study reads these results as showing that protecting and restoring apex predators is not enough to keep a food web in balance unless human pressure is reduced as well, and that conservation should aim at whole communities of species rather than charismatic species alone. The paper acknowledges limits of its evidence: imperfect detection of species by the cameras is not modelled, species are grouped, vegetation is represented by rough proxies, and the results did not fully match its initial predictions. The associations come from observational camera-trap data in one sanctuary.},
  significance_refs = {10.1126/science.aac4249},
  license = {CC BY 4.0},
  funding = {CAS-SEABRI (Y4ZK111B01); National Natural Science Foundation of China (32361143867); Yunnan Province Science and Technology Department (202203AP140007); Transboundary Cooperation on Biodiversity Research and Conservation in Gaoligong Mountains (E1ZK251); Deutscher Akademischer Austauschdienst (DAAD), Research Grants - Doctoral Programmes in Germany, 2022/23 (57588370)},
}

@article{alkemade2025learning,
  author  = {Alkemade, Joris A. and Hawkins, Nichola J. and Baraldi, Elena and Buddie, Alan G. and Cockerton, Helen M. and Corkley, Isabel and Fraaije, Bart A. and Gaya, Ester and Gifford, Danna R. and Hartig, Florian and Kanyuka, Kostya and Koch, Aline and Sánchez, Jonatan Niño and Preston, Gail M. and Seidl, Michael F. and Spanu, Pietro D. and Werner, Bernhard T. and Lyu, Joy and Barraclough, Timothy G.},
  title   = {Learning from fungicide resistance: Evolutionary insights to guide RNAi-based control of fungal crop pathogens},
  journal = {Fungal Biology Reviews},
  year    = {2025},
  volume  = {53},
  pages   = {100443},
  doi     = {10.1016/j.fbr.2025.100443},
  abstract = {Crop protection against fungal pathogens is essential to prevent crop losses and maintain food security. Current crop protection relies heavily on chemical fungicides. However, rapid evolution of fungicide resistance, the constant appearance of new pathogens, and legislation against chemical pesticides due to concerns regarding their impact on human health and the environment, mean new crop protection strategies are urgently required. One elegant solution is double-stranded RNA-based crop protection, which aims to silence selected genes in the pathogen to reduce crop damage. This technology brings the promise of targeting specific genes, which could be chosen to maximise protection, minimize off-target effects and reduce the risk of resistance evolution. Here we discuss strategies for successful use of this novel technology based on lessons learned from fungicide resistance and recent discoveries in fungal evolution derived from genome-sequencing.},
  significance = {Control of fungal crop diseases relies mainly on chemical fungicides. Resistance has repeatedly undermined these products, and some have been banned, so new methods are needed. One candidate is double-stranded RNA (dsRNA) sprayed onto crops. It is built to match, and so switch off, chosen genes of the pathogen (RNA interference, RNAi). Proponents expect high specificity, a short life in the environment and a lower risk of resistance, which is a reasonable hope. But any treatment that lowers a pathogen’s fitness favours less susceptible variants, and it has not been worked out how lessons from fungicide resistance and knowledge of fungal genomes should guide the choice of targets and the use of this technology. \par The paper argues that sprayed double-stranded RNA against fungal crop pathogens needs to be designed with pathogen evolution in mind to stay effective, because high specificity does not by itself protect against resistance. Fungicide history shows the trade-off: products acting on many sites carry a lower risk of resistance but a higher risk of harming non-target organisms, whereas precise single-site products are vulnerable to resistance through small genetic changes. Silencing essential genes gives strong control but also strong selection. The paper therefore recommends targets that balance safety for non-target organisms against resistance risk. It suggests, as possible routes, several dsRNAs aimed at genes far apart in the genome, or genes involved in causing disease rather than in survival, though each has drawbacks. Adaptation can also proceed by routes beyond point mutations, such as mobile DNA, gene duplication and gene loss. RNAi adds its own risks: mutations that weaken the match to the target and, most seriously, loss of dsRNA uptake or of the RNAi machinery. Some fungi already take up little or no dsRNA or have lost RNAi. \par The argument means that durability has to be planned from the start rather than repaired after resistance appears. The paper places dsRNA within integrated pest management. It lists what is missing: laboratory selection experiments, knowledge of how much sequence mismatch RNAi tolerates and why some fungi do not take up dsRNA, and, in Europe, a regulatory framework that includes resistance monitoring. It concludes that, with focused research, careful implementation and open communication, RNAi can become a valuable addition to integrated crop protection.},
  license = {CC BY 4.0},
  funding = {Calleva Centre at Magdalen College Oxford; Biotechnology and Biological Sciences Research Council (BBSRC) (BB/W009935/1); Biotechnology and Biological Sciences Research Council (BBSRC) (BB/Z515632/1); UK Research and Innovation (UKRI) (NE/X005259/1); UK Research and Innovation (UKRI) (MR/Y034023/1); Agriculture and Horticulture Development Board (AHDB) (21120018a)},
}

@article{leroy2025graph,
  author  = {Leroy, Am{\'e}lie and Lajaaiti, Isma{\"e}l and Lambert, Sophia and Voznica, Jakub and Pichler, Maximilian and Morlon, H{\'e}l{\`e}ne and Hartig, Florian and Jacob, Laurent},
  title   = {Graph Neural Networks for Likelihood-Free Inference in Diversification Models},
  journal = {bioRxiv},
  year    = {2025},
  abstract = {A common approach to infer the processes that gave rise to past speciation and extinction rates across taxa, space and time is to formulate hypotheses in the form of probabilistic diversification models and estimate their parameters from extant phylogenies using Maximum Likelihood or Bayesian inference. A drawback of this approach is that likelihoods can easily become computationally intractable, limiting our ability to extend current diversification models with new hypothesized mechanisms. Neural networks have been proposed as a likelihood-free alternative for parameter inference of stochastic models, but so far there is little experience in using this method for diversification models, and the quality of the results is likely to depend on finding the right network architecture and data representation. As phylogenies are essentially graphs, graph neural networks (GNNs) appear to be the most natural architecture but previous results on their performance are conflicting, with some studies reporting poor accuracy of GNNs in practice. Here, we show that this underperformance was likely caused by optimization issues and inappropriate pooling operations that flatten the information along the phylogeny and make it harder to extract relevant information about the diversification parameters. When equipped with PhyloPool, a new time-informed pooling procedure, GNNs show similar or better performance compared to all other architectures and data representations (including Maximum Likelihood Estimation) that we tested for two common diversification models, the Constant Rate Birth-Death and the Binary State Speciation and Extinction. We conclude that GNNs could serve as a generic tool for estimating diversification parameters of complex diversification models with intractable likelihoods.},
  significance = {Speciation and extinction rates are estimated by fitting probabilistic diversification models to phylogenies, but the likelihood of richer models can quickly become intractable. Neural estimation does not need the likelihood: a network is trained on simulated trees to return the parameters. Because a phylogeny is a graph, graph neural networks (GNNs) look like the natural choice. Earlier attempts gave conflicting results; two, an earlier version of this work (Lajaaiti et al. 2023) and a trial by Perez and Gascuel (2024), reported poor accuracy. The paper takes on the assumption that this shows GNNs to be unsuited to phylogenies. \par The paper argues that graph neural networks are not inherently poor at estimating diversification parameters: the earlier failures likely came, at least in part, from two fixable problems. One was overly restrictive training settings (strong weight decay, a penalty on large weights, left the network predicting one extinction rate for every tree). The other was the final averaging over all nodes, which discards their order in time. That order gives the lineage-through-time curve, which carries the information on the rates in a constant-rate birth–death model. The paper introduces PhyloPool, which sorts nodes by age, applies a learned filter along that order and averages over ten equal segments. On two models with computable likelihoods, a constant-rate birth–death model and a constrained model with rates that depend on a binary trait (BiSSE), the GNN with PhyloPool was at least as accurate as maximum likelihood and the other networks tested, and mostly more accurate (under BiSSE comparable to maximum likelihood), except for the relative error of one BiSSE rate. \par The results suggest that GNNs could serve as a general tool for diversification models whose likelihoods are intractable, provided the architecture keeps the information that bears on the parameters and the network is properly trained, which the paper suggests checking by whether it can almost perfectly fit a small training set. Limits remain: a smaller advantage of PhyloPool under BiSSE, point estimates instead of full posteriors, untested diffuse priors, and tests only on data simulated under the same models as the estimators. A later study on mass extinctions (Du et al. 2026) cites it as prior evidence that pooling tailored to trees improves graph networks. It is a bioRxiv preprint, not peer reviewed.},
  significance_refs = {10.1101/2023.03.03.530992 10.1101/2024.12.13.628187 10.1098/rsos.252096},
  license = {CC BY-ND 4.0},
  doi = {10.1101/2025.08.14.670341},
}

@article{cai2025assembly,
  author  = {Cai, Wang and Pichler, Maximilian and Biggs, Jeremy and Nicolet, Pascale and Ewald, Naomi and Griffiths, Richard A. and Bush, Alex and Leibold, Mathew A. and Hartig, Florian and Yu, Douglas W.},
  title   = {Assembly processes inferred from eDNA surveys of a pond metacommunity are consistent with known species ecologies},
  journal = {Ecography},
  year    = {2025},
  volume  = {2025},
  number  = {6},
  pages    = {e07461},
  doi      = {10.1111/ecog.07461},
  preprint = {https://www.biorxiv.org/content/10.1101/2023.12.12.571176v2},
  abstract = {Technological advances are enabling ecologists to conduct large‐scale and structured community surveys. However, it is unclear how best to extract information from these novel community data. We metabarcoded 48 vertebrate species from their eDNA in 320 ponds across England and applied the ‘internal structure' approach, which uses joint species distribution models (JSDMs) to explain compositions as the result of four metacommunity processes: environmental filtering, dispersal, species interactions, and stochasticity. We confirm that environmental filtering plays an important role in community assembly, and find that species' estimated environmental preferences are consistent with known ecologies. We also detect negative biotic covariances between fish and amphibians after controlling for divergent environmental preferences, consistent with predator–prey interactions (likely mediated by predator avoidance behaviour), and we detect high spatial autocorrelation for the palmate newt, consistent with its hypothesised relict distribution. Promisingly, ecologically and spatially distinctive sites are better explained by their environmental covariates and geographic locations, respectively, revealing sites where environmental filtering and dispersal limitation act more strongly. These results are consistent with the recent proposal that applying JSDMs to species distribution patterns can help reveal the relative importance of environmental filtering, dispersal limitation, and biotic interaction processes for individual sites and species. Our results also highlight the value of the modern interpretation of metacommunity ecology, which embraces the fact that assembly processes differ among species and sites. We discuss how novel community data allow for several study design improvements that will strengthen the inference of metacommunity assembly processes from observational data.},
  significance = {Metacommunity theory explains which species occur where through four forces: environmental filtering, dispersal, interactions between species and chance. Early work tended to study subsets of these forces, which gave rise to four idealised paradigms, although no real metacommunity (a set of local communities linked by dispersal) follows any one of them alone. Summary measures such as alpha and beta diversity (diversity within and between sites) cannot show how strongly each force acts on individual species and sites. Leibold et al. (2022) therefore proposed reading the “internal structure” of a metacommunity from a joint species distribution model (a statistical model that fits all species at once). This splits the pattern of each species and each site into environmental, spatial and biotic-covariance parts (shared patterns that neither environment nor location explain), and they tested the idea on simulated communities. What remained open was how best to apply this to the novel community data, such as eDNA surveys, that were becoming available. \par The study tests the “internal structure” approach, which reads assembly processes from a joint species distribution model, on a real system of pond vertebrates, and argues that it gives plausible, informative results: assembly processes differ among species and among sites, and the inferred patterns agree with what is known about the species, rather than one paradigm describing the whole system. As its test case, the study uses environmental DNA (DNA that animals shed into their surroundings) from 320 English ponds, with 48 vertebrate species. Environmental filtering emerged as an important force, and the estimated environmental preferences of species were consistent with their known ecologies. Fish and amphibians showed negative biotic covariances, which fits predation. The palmate newt’s distribution was strongly spatially structured, which fits its suggested relict distribution. \par The results suggest that ideas from metacommunity theory can be checked on observational survey data, by comparing the environmental, spatial and covariance components with independent knowledge of the species. The question for a system then becomes how much each process matters for which species and sites, rather than which single paradigm applies. The evidence is consistency with known ecology, not direct proof of the processes. The study also discusses how study designs enabled by new kinds of community data could strengthen such inference.},
  significance_refs = {10.1111/oik.08618},
  license = {CC BY 3.0},
  funding = {Postdoctoral Fellowship of Xishuangbanna Tropical Botanical Garden, CAS; China Postdoctoral Science Foundation (2023M743747); Yunnan CAIYUN Postdoctoral Foundation; Kunming Institute of Zoology; NSF (2025118); National Key Research and Development Program of China (2022YFC2602500); Strategic Priority Research Program of Chinese Academy of Sciences (XDA20050202); National Natural Science Foundation of China (41661144002); Yunnan Revitalization Talent Support Program: High-end Foreign Expert Project; sDiv, the Synthesis Centre of iDiv (DFG FZT 118, 202548816)},
}

@article{topper2025advancing,
  author  = {Töpper, Joachim Paul and Hoeks, Selwyn and Hartig, Florian and Kolstad, Anders and Tucker, Marlee A. and Bartlett, Jesamine and Bærum, Kim Magnus and Chipperfield, Joseph and Harfoot, Michael and Huijbregts, Mark Antonius Jan and Svenning, Jens-Christian},
  title   = {Advancing general ecosystem models (GEMs): Towards a mechanistic understanding of the biosphere in the light of the Anthropocene},
  journal = {Ecological Solutions and Evidence},
  year    = {2025},
  volume  = {6},
  number  = {2},
  pages    = {e70053},
  doi      = {10.1002/2688-8319.70053},
  abstract = {General ecosystem models (GEMs) are process‐based simulations of ecosystems functioning worldwide. They represent all essential processes in an ecosystem, going beyond a focus on specific biomes or organismal groups. GEMs are a comparably young development, and currently, there is still only one GEM available: the Madingley model, which was first announced in 2013. GEMs allow studying ecosystem mechanisms that are difficult or impossible to investigate empirically, and to perform simulation experiments to assess impacts of human pressures on ecosystems. As such, GEMs can be seen as the nature equivalent to ‘climate models'. As managers and policymakers urgently need good information on nature values and human impacts on them for policy design and decision‐making, they have much to gain from GEMs, which allow understanding current and predicting future outcomes of human actions on biodiversity and ecosystem functioning. To increase the applicability of GEMs for informing management and policy, we argue for an acceleration and diversification in model development, and we suggest a range of developments to propel GEMs forward not only towards both improved global representativeness but also towards applicability for more landscape‐level problems, a scale at which actual decision‐making often takes place. In addition, we argue for more accessible implementations and better documentation to increase both the transparency and credibility of GEMs, as well as the user basis applying GEMs. Practical implication. While some modelling developments target the global level, others are computationally only feasible for landscape‐level applications. We suggest that the development of GEMs should follow design principles employed in climate science and be structured so that they are modular and compatible in a standardized workflow.},
  significance = {Climate models, through simulation experiments and projections, have contributed significantly to climate policy. General ecosystem models (GEMs) were proposed by Purves et al. (2013) as the biodiversity counterpart. The paper uses the term narrowly, for process-based simulations of all trophic groups (levels of the food web) in any ecosystem on Earth. Managers and policymakers need this kind of mechanistic prediction of human impacts, but the field is young. Only one model fits the paper’s definition, the Madingley model (Harfoot et al. 2014), with a second still in development. It was designed for the whole globe at coarse resolution, whereas many management decisions are made at landscape scale. The paper asks how GEMs should be developed so that they can inform management and policy at both scales. \par The paper argues that general ecosystem models should be developed faster and in several complementary directions, not as one model that does everything. It calls for global models alongside more detailed landscape-level models with the same goal of predicting biomass, flows of matter and body-size distributions. These should be modular, compatible and open-source, with shared workflows and common ways of handling uncertainty, as in climate science. The paper uses Madingley as its worked example. To show how such a model could support management and policy, it answers the three questions that Grimm et al. (2020) pose for models meant to support decisions (what the model is for, how it is organised, whether there is evidence it works), and it illustrates the model with a simplified simulation of South America, in which human use of plant production lowers the biomass of consumers. The gaps it names in Madingley include weak performance in strongly seasonal ecosystems, very simple vegetation, coarse animal movement, missing exchange between land and sea, and implementations that are hard to use without programming experience. \par The paper is a research agenda, not a report of new results. It holds that GEMs are already useful for exploring hypotheses, for instance for gaining insight into the natural state of ecosystems that have no undisturbed counterpart. Active development, it argues, would make them relevant to research, management and policy from global to local scales, and would show where ecological knowledge is missing. The paper therefore judges investment in GEM development to be a high-gain, low-risk venture.},
  significance_refs = {10.1038/493295a 10.1371/journal.pbio.1001841 10.1038/s41467-020-17785-2},
  license = {CC BY 4.0},
  funding = {Research Council of Norway (Norges Forskningsråd) (160022/F40); Danish National Research Foundation (Danmarks Grundforskningsfond), via the Center for Ecological Dynamics in a Novel Biosphere (ECONOVO) (DNRF173)},
}

@article{dormann2025predicting,
  author  = {Dormann, Carsten F. and Castillo, William and Pascual Tudanca, Mar{\'i}a and CaraDonna, Paul and Burkle, Laura and Rakosy, Demetra and Winfree, Rachael and Zoller, Leana and Benadi, Gita and Kaiser-Bunbury, Christopher and Fr{\"u}nd, Jochen and Hartig, Florian and Knight, Tiffany and Minachilis, Konstantinos and Pichler, Maximilian and Resasco, Julian and Petanidou, Theodora and Peralta, Guadalupe and V{\'a}zquez, Diego},
  title   = {Predicting interaction frequency in plant-pollinator networks},
  journal = {EcoEvoRxiv},
  year    = {2025},
  abstract = {Flowers and their pollinators represent a bipartite interaction system, whose links are hypothesised to be related to species traits. To explore whether we can predict the weight of this link, i.e. the frequency of interactions, in an validation network, we analysed 14 studies of pollinator-flower visitation network from around the world. We used information on species abundances, their traits and their phylogenetic (for plants) or taxonomic (for animals) position as predictors of interaction frequency, and fitted different statistical modelling approaches. We expected to see prediction quality on validation data to decay with spatial and temporal distance to the training networks. Similarly, we expect that changes in pollinator or plant composition will negatively affect predictive performance. Using the best-predicting modelling approach (randomForest), we indeed see a slight decay in predictive quality with plant and pollinator compositional distance. Temporal distance played little role, although predictions for one year ahead (or back) were better than across the season or across multiple years. The overall predictive power of our models was low (Spearman's ρ ≈ 0.4), suggesting a very noisy system. Also, the most important predictor was abundance, as revealed by a parameter-free benchmark model that only used the cross-product of abundances to predict interaction frequency. Trait and phylogenetic information did not substantially improve predictive performance beyond abundance-based predictions. Across all studies, we failed to confirm a substantial contribution of ecological characteristics to pollinator-flower interaction frequency. One reason why predictions were relatively poor is that sampling effort is not standardised, and thus networks differed substantially in the observed number of interactions, network size, and interaction density. Also the pooling of networks across space or across time may have diluted preferences in the data, reducing their explanatory value. Finally, the majority of species in each network are rare, and the interaction information they provide may be much less relevant that that of common species. At present, we conclude that the frequencies of interactions are very difficult to predict, and using traits we cannot really do better than simply using abundance information.},
  significance = {Network ecologists assume that species traits causally shape who visits which flower: interactions are more likely when traits match. The idea is reasonable: some flowers are clearly adapted to animal pollination. If it holds, a model that learns from traits and abundances should predict interaction frequency, that is how often a pollinator visits a plant, in a network at a new site or time. Earlier work mostly predicted whether a link exists (Terry and Lewis 2020); the paper knows of only two earlier attempts at frequency, both technical tests (Pichler et al. 2020; Benadi et al. 2022). The problem it takes on is whether traits, and phylogeny as a stand-in for traits that are hard to measure, improve predictions in new networks beyond species abundance alone. \par The paper finds that interaction frequency is hard to predict, and that abundance does practically all of the predicting while traits and phylogeny add little. It tested this on 14 published studies of plant-pollinator networks recorded repeatedly in space or time, predicting held-out networks. Random forest, gradient boosting and a trait-matching model all reached only modest skill; for random forest, the best, the rank correlation (Spearman’s ρ; 1 would be perfect) was 0.42 in time and 0.27 in space. In space all three matched a simple benchmark with nothing to fit, the product of plant and pollinator abundances; in time, random forest and gradient boosting exceeded it only slightly. For pollinators, the abundances were mostly the network’s own visit totals, which the paper acknowledges is circular. Predicting a whole left-out study failed: a model trained on the other 13, using phylogeny only, had virtually no skill (mean ρ of 0.10, not distinguishable from zero). \par The paper suggests that, for now, interaction frequency is best treated as driven mainly by abundance, with little generalisable trait signal and much chance variation. It does not rule out trait matching, which may be hard to detect in visitation data, since a visit does not necessarily result in pollination. Scent and vision traits, rather than larger data sets or more elaborate methods, may, the paper suggests, improve predictions; it names unstandardised sampling, pooling of networks and the rarity of most species as possible limits. This is a preprint and has not been peer reviewed.},
  significance_refs = {10.1002/ecy.3047 10.1111/2041-210x.13329 10.1086/714420},
  funding = {DFG (Deutsche Forschungsgemeinschaft) Research Unit FG 5207 Reassembly (FG 5207)},
  license = {CC BY-ND 4.0},
  doi = {10.32942/X2S63Z},
}

@article{grimm2025using,
  author  = {Grimm, Volker and Berger, Uta and Calabrese, Justin M. and Cort{\'e}s-Avizanda, Ainara and Ferrer, Jordi and Franz, Mathias and Groeneveld, J{\"u}rgen and Hartig, Florian and Jakoby, Oliver and Jovani, Roger and Kramer-Schadt, Stephanie and M{\"u}nkem{\"u}ller, Tamara and Piou, Cyril and Premo, L. S. and P{\"u}tz, Sandro and Quintaine, Thomas and Rademacher, Christine and R{\"u}ger, Nadja and Schmolke, Amelie and Thiele, Jan C. and Touza, Julia and Railsback, Steven F.},
  title   = {Using the ODD protocol and NetLogo to replicate agent-based models},
  journal = {Ecological Modelling},
  year    = {2025},
  volume  = {501},
  pages   = {110967},
  doi     = {10.1016/j.ecolmodel.2024.110967},
  abstract = {Replicating existing models and their key results not only adds credibility to the original work, it also allows modellers to start model development from an existing approach rather than from scratch. New theory can then be developed by changing the assumptions or scenarios tested, or by carrying out more in-depth analysis of the model. However, model replication can be challenging if the original model description is incomplete or ambiguous. Here we show that the use of standards can facilitate and speed up replication: the ODD protocol for describing models, and NetLogo, an easy-to-learn but powerful software platform and language for implementing agent-based models. To demonstrate the benefits of this approach, we conducted a replication experiment on 18 agent-based models from different disciplines. The researchers doing the replications had no or little previous experience using ODD and NetLogo. Their task was to rewrite the original model description using ODD, implement the model in NetLogo and try to replicate at least one exemplary main result. They were also asked to produce, if time allowed, some initial new results with the replicated model, and to record the total time spent on the replication exercise. Replication was successful for 15 out of 18 models. The time taken varied between 2 and 12 days, with an average of 5 days. ODD helped to systematically scan the original model description, while NetLogo proved easy and quick to learn, but difficult to debug when implementation problems arose. Although most of the models replicated were relatively simple, we conclude that even for more complex models it can be useful to use ODD and NetLogo for replication, at least for developing a prototype to help decide how to proceed with the replicated model. Overall, the use of both, standard approaches such as ODD and easy to learn but powerful software such as NetLogo, can promote coherence and efficiency within and between different models and modelling communities. Imagine if all modellers spoke ODD and NetLogo as a common language or lingua franca.},
  significance = {Agent-based models, simulations of many interacting individual agents, are used across ecology and the social sciences. When used to understand real systems, their insights are often case-specific and hard to generalise. The paper sees one obstacle to more general models in modelling practice: building a model from scratch tends to be valued more than starting from an existing one. This preference has grounds: developing a model teaches the modeller about the system, whereas simply re-using someone else’s model risks applying it beyond its purpose and trusting it blindly. The paper proposes a middle way, an idea it takes from Thiele and Grimm (2015): starting new projects by replicating an existing model, that is, rebuilding it from its published description. Replication, however, is often thought to be difficult, because original descriptions are often incomplete or ambiguous. The paper challenges the belief that replication is too hard and slow to be a practical way to begin a modelling project. \par The paper argues that two standards, the ODD protocol for describing simulation models and the easy-to-learn NetLogo platform for building agent-based ones, make replicating existing agent-based models easier and faster than is generally believed. To test this, researchers, mostly experienced modellers with little or no experience of ODD and NetLogo, replicated 18 models from different disciplines: they rewrote each description in ODD (a recommended structure for writing up a model), implemented the model in NetLogo and reproduced at least one main result. This worked for 15 of the 18 models; the exercises took between 2 and 12 days, 5 on average. ODD helped to scan the original descriptions systematically and expose gaps in them, whereas NetLogo proved quick to learn but hard to debug (to find and fix errors). Most models were simple; complex ones will take longer. \par For relatively simple models like these, the results indicate that replication need not be a large investment: a modeller can start from an existing model, change its assumptions or test new scenarios. For more complex models, the paper judges ODD and NetLogo useful at least for a prototype that helps decide how to proceed. More broadly, the paper presents the two as examples of standards that could make modelling more coherent and efficient across modelling communities.},
  significance_refs = {10.1111/oik.02170},
  license = {CC BY 4.0},
  funding = {Center for Advanced Systems Understanding (CASUS), financed by Germany's Federal Ministry of Education and Research (BMBF) and the Saxon Ministry for Science, Culture and Tourism (SMWK)},
}

