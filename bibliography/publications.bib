@article{chanthorn2017structure,
  author  = {Chanthorn, Wirong and Hartig, Florian and Brockelman, Warren Y.},
  title   = {Structure and community composition in a tropical forest suggest a change of ecological processes during stand development},
  journal = {Forest Ecology and Management},
  year    = {2017},
  volume  = {404},
  pages   = {100--107},
  doi     = {10.1016/j.foreco.2017.08.001},
  abstract = {Ecological theories assume that ecological processes change during stand development. This change should be reflected in patterns of tree and crown allometries, stand demography and community composition. Empirical tests of these predictions have largely concentrated on temperate forests. Here, we ask whether these expectations also hold in tropical forests. We established eight permanent inventory plots of different ages in a tropical forest in Thailand, and measured dbh, crown architecture and community composition. We then tested whether differences in (1) allometries, (2) size structure, (3) stand structure and (4) community composition between plots are consistent with expectations from succession theory. In particular, we tested if tree and stand patterns conform to the expectation that competition intensity is highest during intermediate development stages, and that species specialize into particular successional niches. We find that the empirical patterns in the plots are compatible with both assumptions. Observed dbh-height and crown allometries, as well as stand attributes, suggest that trees respond to denser packing in the intermediate development stage (stem exclusion stage) by increased investments in height growth, presumably because of strong resource competition, particularly for light. Packing and competition seems less pronounced in earlier and later stages. An analysis of community composition shows that species composition clustered with development stages, suggesting a specialization into successional niches. In conclusion, stand attributes of the tropical plots used in this study largely conform to the predictions of forest stand development theories that have so far mainly been tested in temperate forests. We did not find evidence for qualitative differences between tropical and temperate stand development.},
  significance = {Theories of forest stand development assume that a stand passes through stages after a disturbance, with ecological processes changing along the way. In the four-stage model for temperate forests, the central change is competition for light and space: low in the open young stand, highest once the canopy closes and trees thin each other out (the stem-exclusion stage), and mixed with other processes in old growth. This should show in tree shape, stand structure and species composition. The theories were built and tested mainly in temperate forests, so it is fair to ask whether they carry over to far more diverse tropical forests. To the paper’s knowledge, no study had tested this quantitatively across all stages. The paper examines the assumption that the temperate model may not hold in the tropics. \par The study finds that tree and stand patterns in a Thai tropical forest are broadly compatible with the temperate theory that competition for light peaks at an intermediate stage of stand development and that species specialise in particular stages, with no sign of a qualitative tropical–temperate difference. The study compared eight plots in Khao Yai National Park: young and intermediate stands regrown on abandoned fields, and old growth. At the same trunk diameter, trees were tallest in the stem-exclusion stage and shortest in the youngest stage, and the crowns of a plot together covered most ground area in stem exclusion. Plots of one stage also grouped together by species composition, read as specialisation in stages. The evidence is partial. Crown-length differences were weak, stem density did not peak in stem exclusion as expected, and species richness did not differ between the two younger stages. \par The paper concludes that the results are compatible with qualitatively similar processes during stand development in species-rich tropical and species-poor temperate forests. The data come from eight plots at one site, with the youngest plots lying apart from the others and one possibly shaped by local moisture. The paper adds that replication in forests of differing richness and soils would be interesting and might one day help refine a general theory of succession. A later study with overlapping authorship (Jha et al. 2020) applied the paper’s stage classification and stage ages to 70 plots, eight of them the paper’s own.},
  significance_refs = {10.5194/bg-17-121-2020},
  license = {publisher (subscription)},
  funding = {National Science and Technology Development Agency},
}

@article{augustynczik2017productivity,
  author  = {Augustynczik, Andrey L.D. and Hartig, Florian and Minunno, Francesco and Kahle, Hans-Peter and Diaconu, Daniela and Hanewinkel, Marc and Yousefpour, Rasoul},
  title   = {Productivity of Fagus sylvatica under climate change – A Bayesian analysis of risk and uncertainty using the model 3-PG},
  journal = {Forest Ecology and Management},
  year    = {2017},
  volume  = {401},
  pages   = {192--206},
  doi     = {10.1016/j.foreco.2017.06.061},
  abstract = {To assess the long-term impacts of forest management interventions under climate change, process-based models, which allow to predict transient dynamics under environmental change, are arguably the most suitable tools available. A challenge for using these models for management decisions, however, is their higher parametric uncertainty, which propagates to predictions and thus into the decision-making process. Here, we demonstrate how this problem can be addressed through Bayesian inference. We first conduct a Bayesian calibration to generate an estimate of posterior parametric uncertainty for the process-based forest growth model 3-PG for Fagus sylvatica. The calibration uses data from twelve sites in Germany, together with a robust (Student’s t) error model. We then propagate the estimated uncertainty together with economic uncertainty to forest productivity and Land Expectation Value (LEV), allowing us to evaluate alternative management regimes under climate change. Our results demonstrate that parametric and economic uncertainty have strong impacts on the variation of predicted forest productivity and profitability. Management regimes with increased thinning intensity were overall most robust to economic, climate change and parametric model uncertainty. We conclude that estimating and propagating economic and model uncertainty is crucial for developing robust adaptive management strategies for forests under climate change.},
  significance = {Process-based forest models, which simulate tree growth from physiology and climate, are arguably the most suitable tools for judging how forest management will fare under climate change, because they can follow change over time. Many of their numerous parameters, however, are not well known, and this parametric uncertainty carries through into predictions and decisions. According to the paper, this uncertainty is usually neglected in forest planning, as are uncertainty in future climate and in timber prices and interest rates. The problem the paper takes on is whether the best result of a single simulation with fixed (median) parameter values is a sound basis for choosing management when so much remains uncertain. \par The study argues that Bayesian inference offers a coherent way to estimate parametric uncertainty and carry it, together with climate and economic uncertainty, into a risk analysis that identifies management regimes that remain robust. As a demonstration, the growth model 3-PG (Landsberg and Waring 1997) is calibrated for European beech (Fagus sylvatica) with data from twelve German plots, using an error model that limits the influence of outliers. The calibrated uncertainty is then run through 20 management regimes under 12 climate trajectories for a site in Baden-Württemberg, with uncertain timber prices and interest rates. Regimes are judged by Land Expectation Value, the economic value of the forest land, and by its Value-at-Risk, the value exceeded in 95% of simulated cases. At interest rates of 1–3%, the most robust regime combined increased thinning with a 160-year rotation. Ignoring parametric and economic uncertainty would instead have picked regimes with shorter rotations (120–140 years), whose Value-at-Risk was 29–82% lower, meaning a higher risk of poor returns. With economic uncertainty alone, a different regime would have counted as robust; adding parametric uncertainty changed the choice. \par The paper reads these results as showing that neglecting parametric, climate and economic uncertainty can lead to risky management choices, and presents the approach as a blueprint for including such uncertainty in forest planning. It supplies a thinned sample of the calibrated parameters so that later studies can reuse it as a starting point when new data arrive. Limits remain: regimes were judged by profit alone, disturbances such as pests were not included, and wide priors were used because the authors knew of no earlier calibration of 3-PG for beech.},
  significance_refs = {10.1016/s0378-1127(97)00026-1},
  license = {publisher (subscription)},
  funding = {German Research Foundation; ConFoBi project (GRK 2123); BMEL; BMUB; BuTaKli project (28WC4069)},
}

@article{pullens2017nucombog,
  author  = {Pullens, Johannes W. M. and Bagnara, Maurizio and Silveyra Gonz{\'a}lez, Ramiro and Gianelle, Damiano and Sottocornola, Matteo and Heijmans, Monique M. P. D. and Kiely, Gerard and Hartig, Florian},
  title   = {The NUCOMBog R package for simulating vegetation, water, carbon and nitrogen dynamics in peatlands},
  journal = {Ecological Informatics},
  year    = {2017},
  volume  = {40},
  pages   = {35--39},
  doi     = {10.1016/j.ecoinf.2017.05.001},
  abstract = {Since peatlands store up to 30\% of the global soil organic carbon, it is important to understand how these ecosystems will react to a change in climate and management. Process-based ecosystem models have emerged as important tools for predicting long-term peatland dynamics, but their application is often challenging because they require programming skills. In this paper, we present NUCOMBog, an R package of the NUCOM-Bog model (Heijmans et al. 2008), which simulates the vegetation, carbon, nitrogen and water dynamics of peatlands in monthly time steps. The package complements the model with appropriate functions, such as the calculation of net ecosystem exchange, as well as parallel functionality. As a result, the NUCOMBog R package provides a user-friendly tool for simulating vegetation and biogeochemical cycles/fluxes in peatlands over years/decades, under different management strategies and climate change scenarios, with the option to use all the in-built model analysis capabilities of R, such as plotting, sensitivity analysis or optimization.},
  significance = {Peatlands hold up to about 30% of the world’s soil organic carbon, so it matters how they respond to climate change and to changes in management. Process-based ecosystem models are used to project peatland vegetation and carbon over years to decades. Such models are, however, often hard for new users to apply. They need specialised input formats and programming for tasks such as sensitivity analysis (finding out which parameters matter most) or calibration (fitting parameters to measurements). The problem the paper takes on is how to make such a model available in an established scientific computing environment such as R. \par The paper presents NUCOMBog, an R package for running the peatland model NUCOM-Bog from within R. It argues that this makes the model easy to apply and opens it to the analysis tools available in R for sensitivity analysis, calibration and Bayesian inference. NUCOM-Bog (Heijmans et al. 2008) simulates, in monthly steps, how five plant groups (graminoids, shrubs and three kinds of peat moss) compete and how carbon, nitrogen and water cycle in a one-square-metre patch of bog. The package’s functions set up a run and read the results back. The package also adds heterotrophic respiration, the carbon released by decomposition, as an output. Combined with plant growth (net primary production), this gives net ecosystem exchange (NEE), the net carbon flux between ecosystem and atmosphere, so that results can be compared with flux measurements from eddy covariance towers and flux chambers. A further function runs many parameter combinations in parallel, to make sensitivity analysis and calibration practical. As an example, the paper simulates Walton Moss bog in England for 1766–1999 with test data supplied in the package; this illustrates the workflow rather than testing the model. \par The paper offers the package as a way to lower the effort of applying the model, and names the study of peatland vegetation stability and teaching as uses. Where many years of flux data exist, the model could be evaluated against them, and sensitivity analysis and calibration are expected to show how important and how uncertain the parameters are. The authors hope that this will improve the model and reveal gaps in knowledge about how peatlands function under climate change and management. The paper’s contribution is the tool, not a finding about peatlands.},
  significance_refs = {10.3170/2008-8-18368},
  license = {publisher (subscription)},
  funding = {STSM (COST Action FP1304 short-term scientific mission) (FP1304); DFG (DO 786/8-1)},
}

@incollection{hartig2017simulation,
  author    = {Hartig, Florian},
  title     = {Simulation Modeling},
  booktitle = {Oxford Bibliographies in Ecology},
  publisher = {Oxford University Press},
  year      = {2017},
  doi       = {10.1093/OBO/9780199830060-0189},
  preprint  = {https://arxiv.org/abs/1812.09137},
  note      = {Book chapter, edited by D. Gibson.},
  abstract  = {With the rise of computers, simulation models have emerged beside the more traditional statistical and mathematical models as a third pillar for ecological analysis. Broadly speaking, a simulation model is an algorithm, typically implemented as a computer program, which propagates the states of a system forward. Unlike in a mathematical model, however, this propagation does not employ the methods of calculus but rather a set of rules or formulae that directly prescribe the next state. Such an algorithmic model specification is particularly suited for describing systems that are difficult to capture or analyze with differential equations such as: (a) systems that are highly nonlinear or chaotic; (b) discrete systems, for example networks or groups of distinct individuals; (c) systems that are stochastic; and (d) systems that are too complex to be successfully treated with classical calculus. As these situations are frequently encountered in ecology, simulation models are now widely applied across the discipline. They have been instrumental in developing new insights into classical questions of species’ coexistence, community assembly, population dynamics, biogeography, and many more. The methods for this relatively young field are still being actively developed, and practical work with simulation models requires ecologists to learn new skills such as coding, sensitivity analysis, calibration, validation, and forecasting uncertainties. Moreover, scientific inquiry with complex systems has led to subtle changes to the philosophical and epistemological views regarding simplicity, reductionism, and the relationship between prediction and understanding.},
  significance = {Ecologists work with statistical and mathematical models, but many ecological systems are hard to capture with differential equations: they are nonlinear or chaotic, made of discrete units such as individual organisms, driven by chance, or too complex for calculus. Simulation models take another route. They are computer programs that move a system forward step by step by explicit rules, and they are used across the discipline. Working with them requires skills such as programming, sensitivity analysis (testing how outputs respond to changed inputs), calibration (fitting parameters to data), validation and forecasting under uncertainty. Scientific inquiry with complex systems has also led to subtle changes in philosophical views on simplicity, reductionism and the relation between prediction and understanding. The article responds to the need for simulation models of such systems and for the concepts and methods to build and test them. \par This article, an annotated bibliography in the Oxford Bibliographies in Ecology, presents simulation modelling (the use of computer programs that step a system forward by explicit rules) as a third pillar of ecological analysis beside statistical and mathematical models, and guides readers through the literature on it. It begins with overviews, textbooks and journals, then covers core concepts: models of discrete entities (cellular automata, networks, individual-based models, which follow single organisms), emergence, stochasticity and chaos, and what it means for a model to be valid. A sample of applications follows, from population and community models to movement and evolution, explicitly a cross-section rather than a complete survey. The route ends with the working steps: programming languages, checking that the code does what is intended, sensitivity analysis, calibration, and forecasting with uncertainty analysis. On the philosophy of models, the article suggests that modellers have become bolder: simulations had come to be used frequently to test or compare hypotheses, which implicitly assumes that they are structurally realistic, going beyond the view that a model only has to be valid for its purpose. \par The article is a reference map rather than a new finding. For ecologists who want to work with simulation modelling, it connects what these models are good for with the practical steps of building, fitting and forecasting with them, and it notes that the methods of this relatively young field were still under development.},
  abstract_kind = {opening},
  license = {publisher (subscription)},
}

@article{brieger2017roe,
  author  = {Brieger, Falko and Hagen, Robert and Kr{\"o}schel, Max and Hartig, Florian and Petersen, Imke and Ortmann, Sylvia and Suchant, Rudi},
  title   = {Do roe deer react to wildlife warning reflectors? A test combining a controlled experiment with field observations},
  journal = {European Journal of Wildlife Research},
  year    = {2017},
  volume  = {63},
  number  = {5},
  pages   = {72},
  doi     = {10.1007/s10344-017-1130-5},
  abstract = {Millions of animals are killed by vehicle collisions each year. As mitigation measures, wildlife warning reflectors have become increasingly popular, although clear evidence for their effectiveness is lacking. A reason for inconclusive results in the literature may be that most previous studies on the effectiveness of wildlife warning reflectors compare animal-vehicle collision rates with and without reflectors, a setting characterised by low event rates and weak experimental control. Animal behaviour can be expected to provide a more direct evidence for a possible effect of reflectors. In this study, we analyse roe deer behaviour in the presence of a blue semicircle reflector, one of the most frequently applied wildlife warning reflectors in Germany and other parts of Europe. Behavioural response to these reflectors (classified as no reaction, vigilance, short-distance flight and long-distance flight) was recorded both under controlled experimental conditions with captive roe deer and for free-ranging roe deer at road sections with traffic occurrence. We used generalised linear mixed models (GLMMs) to test if reflector presence induced threat-related behaviour (vigilance, flight) and movement away from the reflectors. We found no significant evidence that the light stimulus emitted by reflectors was perceived as a threat or induced evasive movement. We conclude that our study provides no evidence that blue semicircle reflectors induce behaviour in roe deer that seems suitable to reduce roe deer-vehicle collisions.},
  significance = {Wildlife warning reflectors are meant to throw a vehicle’s headlight back into the roadside, so that deer take it as a threat and stay away from the road. The idea is not unreasonable, since deer eyes are sensitive to blue and green light. Yet evidence that reflectors prevent collisions is inconclusive: most earlier studies compared collision counts before and after installation, where events are rare and control is weak, and a reanalysis of such studies (Brieger et al. 2016) found no significant reduction in collisions. The paper argues that future work should measure behaviour directly. The problem it takes on is whether the reflected light is in fact perceived as a threat and makes deer move away from the road. \par The study finds no significant evidence that blue semicircle reflectors change roe deer behaviour in a way that could prevent collisions, so any effect that exists must be rather small. Two tests carry this. In an experiment, 31 captive roe deer crossed a mock road where a headlight was switched on for a few seconds, with and without reflectors but without vehicles (1820 crossings). The light itself made reactions stronger, but adding reflectors did not. In a field study, thermal cameras recorded free-ranging deer meeting real vehicles at five road sections in Baden-Württemberg, before and after reflectors were mounted (1091 events). Reflectors neither increased vigilance or flight nor made deer more likely to move back from the road. Only a non-significant tendency towards stronger reactions close to the road appeared (p = 0.06), and the paper found no sign that deer then moved away from the road. \par The paper concludes that if reflectors affect roe deer behaviour, the effect must be rather small, and doubts that they would reduce collisions substantially. It would not recommend investing in broad use unless new studies convincingly demonstrate their utility in the field, and thinks measures aimed at drivers, such as lower speed limits or driver warning systems, seem better suited. Reflectors are clearly discernible to drivers, which may change driver alertness, but the paper notes that studies of this effect are lacking. A later study on a railway line found no effect of reflectors on escape probability and cites the paper as consistent for blue reflectors (Jasińska et al. 2022).},
  significance_refs = {10.1016/j.aap.2016.08.030 10.3897/natureconservation.47.73052},
  license = {publisher (subscription)},
  funding = {Federal state of Baden-Württemberg (Landesjagdabgabe); Dr. Joachim und Hanna Schmidt Stiftung für Umwelt und Verkehr (PhD scholarship to F. Brieger)},
}

@article{roberts2017cross,
  author  = {Roberts, David R. and Bahn, Volker and Ciuti, Simone and Boyce, Mark S. and Elith, Jane and Guillera-Arroita, Gurutzeta and Hauenstein, Severin and Lahoz-Monfort, Jos{\'e} J. and Schr{\"o}der, Boris and Thuiller, Wilfried and Warton, David I. and Wintle, Brendan A. and Hartig, Florian and Dormann, Carsten F.},
  title   = {Cross-validation strategies for data with temporal, spatial, hierarchical, or phylogenetic structure},
  journal = {Ecography},
  year    = {2017},
  volume  = {40},
  number  = {8},
  pages   = {913--929},
  doi     = {10.1111/ecog.02881},
  abstract = {Ecological data often show temporal, spatial, hierarchical (random effects), or phylogenetic structure. Modern statistical approaches are increasingly accounting for such dependencies. However, when performing cross‐validation, these structures are regularly ignored, resulting in serious underestimation of predictive error. One cause for the poor performance of uncorrected (random) cross‐validation, noted often by modellers, are dependence structures in the data that persist as dependence structures in model residuals, violating the assumption of independence. Even more concerning, because often overlooked, is that structured data also provides ample opportunity for overfitting with non‐causal predictors. This problem can persist even if remedies such as autoregressive models, generalized least squares, or mixed models are used. Block cross‐validation, where data are split strategically rather than randomly, can address these issues. However, the blocking strategy must be carefully considered. Blocking in space, time, random effects or phylogenetic distance, while accounting for dependencies in the data, may also unwittingly induce extrapolations by restricting the ranges or combinations of predictor variables available for model training, thus overestimating interpolation errors. On the other hand, deliberate blocking in predictor space may also improve error estimates when extrapolation is the modelling goal. Here, we review the ecological literature on non‐random and blocked cross‐validation approaches. We also provide a series of simulations and case studies, in which we show that, for all instances tested, block cross‐validation is nearly universally more appropriate than random cross‐validation if the goal is predicting to new data or predictor space, or for selecting causal predictors. We recommend that block cross‐validation be used wherever dependence structures exist in a dataset, even if no correlation structure is visible in the fitted model residuals, or if the fitted models account for such correlations.},
  significance = {Cross-validation estimates how well a model will predict new data by fitting it to part of a dataset and testing it on the rest. The usual version holds out a random part, which assumes it is independent of the data used for fitting. Ecological data often break this assumption because observations from nearby places or times, the same group or related species resemble each other. Models that build the structure in (autoregressive, mixed or phylogenetic regressions) are expected to cope with it. Some studies had already validated models on separate blocks of data (Bahn and McGill 2013). The paper asks whether random splits, or models that already include the structure, give trustworthy error estimates for structured data. \par The paper compares random and block cross-validation as estimates of prediction error on structured ecological data and argues that random splits underestimate this error, even when the model accounts for the structure. The problem persists with such models because covariates which themselves follow the structure let a model absorb it through non-causal predictors: the residuals look independent, yet predictions fail for new places, times or groups. Block cross-validation, which holds out whole blocks of space, time, individuals or clades, gives estimates closer to the error on independent data. In a simulated landscape analysed with random forests, random splits gave optimistic errors, whereas blocks larger than the range of residual autocorrelation, and leave-one-out validation with a buffer around each test point, came closer to the error on independent data. In a simulated trait–latitude regression with phylogenetic structure, phylogenetic least squares still gave errors that were too low, whereas blocked validation, or leave-one-out validation with a large enough buffer, gave reliable errors and good model selection. Blocks can remove parts of the predictor range from training and so force extrapolation, wanted only if extrapolation is the aim. The paper ties block design to the prediction goal and gives a five-step workflow. \par Random cross-validation can be trusted only where independence and the absence of extrapolation hold. The paper recommends block cross-validation wherever dependence exists, even if residuals look independent or the model includes the structure, and argues that a slightly conservative estimate costs little against unwarranted confidence in predictions used for conservation and management. Spatial and environmental blocks can be built with the blockCV R package (Valavi et al. 2019).},
  significance_refs = {10.1111/j.1600-0706.2012.00299.x 10.1111/2041-210x.13107},
  license = {publisher (subscription)},
  funding = {German Science Foundation (DFG), workshop 'Model averaging in Ecology' (DO 786/9-1); Alexander von Humboldt Foundation through the German Federal Ministry of Education and Research (DRR); German Science Foundation (BS) (SCHR1000/6-2); DFG (CFD) (DO786/10-1); Australian Research Council Future Fellowships (DIW, JE) (FT120100501; FT0991640); Australian Research Council Discovery Early Career Research Award (GGA) (DE160100904); Australian Research Council Discovery Project (JJLM) (DP160101003); Alberta Conservation Association (ACA - Grant Eligible Conservation Fund) (elk data); Natural Sciences and Engineering Research Council of Canada (NSERC CRD) (elk data); Shell Canada limited (elk data)},
  featured = {true},
}

@article{panassiti2017identifying,
  author  = {Panassiti, Bernd and Hartig, Florian and Fahrentrapp, Johannes and Breuer, Michael and Biedermann, Robert},
  title   = {Identifying local drivers of a vector-pathogen-disease system using Bayesian modeling},
  journal = {Basic and Applied Ecology},
  year    = {2017},
  volume  = {18},
  pages   = {75--85},
  doi     = {10.1016/j.baae.2016.11.005},
  abstract = {‘Bois noir’ is a phytoplasma-mediated grapevine yellows disease that causes great economic damage in European vineyards. Previous studies have examined habitat relationships on a regional scale, which help to better understand the large-scale epidemiology. Local drivers, such as micro-habitat preferences of the vector (Hyalesthes obsoletus, a cixiid planthopper), or local interactions with reservoir host plants, however, are still poorly understood, although this knowledge is crucial for developing site-specific management strategies. Here, we examined the local environment-species relationships of a phytoplasma-mediated grapevine disease on a scale of 15 m in a 2.9 ha vineyard using: (i) data on elevation and habitat types; (ii) cover of host plants Urtica dioica and Convolvulus arvensis over three seasons, (iii) vector monitoring over four seasons; (iv) genetic tests for phytoplasma presence in the vector; and (v) inspection of 6056 grapevine plants for visual symptoms of the ‘bois noir’ disease. The data were analyzed in a joint causal model that describes the interplay between vector, pathogen, disease and environment, estimated with Bayesian inference. Our results indicate that surrounding natural and semi-natural vegetation (fallow land, forest and managed agricultural land) and high density of the major host plant U. dioica are associated with an increase in vector population densities. Higher vector population densities at low availability of U. dioica were associated with higher phytoplasma infection rates in the vector. The prevalence of disease symptoms in grapevine plants was nonetheless more affected by grapevine cultivar and higher elevation than by the estimated availability of infected vectors. The results of our local analysis support current bois noir management recommendations stating that (1) removal of the host plant U. dioica should be best carried out in either spring or autumn; and (2) grapevine cultivars are unequally susceptible. Moreover, we provide evidence that U. dioica control before the flight period may result in low U. dioica densities and high H. obsoletus population densities, causing an increase in vector infection rates and disease pressure.},
  significance = {Crop diseases caused by phytoplasma bacteria depend on several players: an insect that carries the pathogen (the vector), the plants that harbour it, and the crop. This makes them hard to predict. Habitat models describe the large-scale preferences of such disease systems but, as the paper puts it, may miss small-scale biotic interactions and micro-habitat effects. Analysing the chain from environment to symptoms step by step does not use the data optimally, and path analysis, which fits chains jointly, is limited for binary and count data. The problem the paper takes on is estimating, at the scale of a single vineyard, how environment, host plants, vector, pathogen and disease depend on one another. \par The paper argues that fitting vector counts, pathogen infection in the vector and disease symptoms in one Bayesian model can identify the local drivers of a plant disease, and applies this to bois noir, a phytoplasma disease of grapevine, in a 2.9 ha vineyard in south-western Germany. The planthopper vector, Hyalesthes obsoletus, was more abundant near fallow land, forest and managed grassland and where its host plant, stinging nettle (Urtica dioica), was dense. The share of planthoppers carrying the phytoplasma depended on an interaction between the two: it was higher where planthoppers were dense and nettle scarce. The model would also predict this for the opposite combination, which the paper judges implausible and poorly covered by data. Disease symptoms were associated with cultivar and elevation, though the cultivar estimates were uncertain, but not detectably with the estimated density of infected planthoppers. The paper suspects the analysis lacked the power to detect such a link. \par The paper states that the results support existing advice: control nettle in spring or autumn, and expect cultivars to differ in susceptibility. It argues that removing nettle before or during the planthoppers’ flight period may leave many planthoppers on a few remaining, possibly infected plants and so raise disease pressure; it advises delaying host-plant management until the flight ends. Limits remain: no link between infected planthoppers and symptoms was found, and the advice rests on one vineyard and an unevenly covered interaction, not on a removal trial. Murolo et al. (2020) cite the finding on low nettle density and high planthopper abundance in discussing how weed management can drive planthoppers onto grapevines.},
  significance_refs = {10.1038/s41598-020-66210-7},
  license = {publisher (subscription)},
  funding = {Association of German Wine Scientists},
}

@article{fornoff2017functional,
  author  = {Fornoff, Felix and Klein, Alexandra-Maria and Hartig, Florian and Benadi, Gita and Venjakob, Christine and Schaefer, H. Martin and Ebeling, Anne},
  title   = {Functional flower traits and their diversity drive pollinator visitation},
  journal = {Oikos},
  year    = {2017},
  volume  = {126},
  number  = {7},
  pages   = {1020--1030},
  doi     = {10.1111/oik.03869},
  abstract = {Recent studies have shown that the diversity of flowering plants can enhance pollinator richness and visitation frequency and thereby increase the resilience of pollination. It is assumed that flower traits explain these effects, but it is still unclear which flower traits are responsible, and knowing that, if pollinator richness and visitation frequency are more driven by mass‐ratio effects (mean trait values) or by trait diversity. Here, we analyse a three‐year data set of pollinator observations collected in a European grassland plant diversity experiment (The Jena experiment). The data entail comprehensive flower trait measurements, including reward traits (nectar and pollen amount), morphological traits (height, symmetry, area, colour spectra) and chemical traits (nectar‐amino acid and nectar‐sugar concentration). We test if pollinator species richness and visitation frequency of flower communities depend on overall functional diversity combining all flower traits within a community, single trait diversities (within trait variation) and community‐weighted means of the single traits, using Bayesian inference. Overall functional diversity did not affect pollinator species richness, but reduced visitation frequency. When looking at individual flower traits separately, we found that single trait diversity of flower reflectance and flower morphology were important predictors of pollinator visitation frequency. Moreover, independent of total flower abundance, community‐weighted means of flower height, area, reflectance, nectar‐sugar concentration and nectar‐amino acid concentration strongly affected both pollinator species richness and visitation frequency. Our results, challenge the idea that functional diversity always positively affects ecosystem functions. Nonetheless, we demonstrate that both single trait diversity and mass‐ratio effects of flower traits play an important role for diverse and frequent flower visits, which underlines the functionality of flower traits for pollination services.},
  significance = {Diverse plant communities can attract more pollinators, and varied flower traits are assumed to explain this, as many kinds of flowers should let more pollinator species coexist. Functional diversity, the spread of trait values in a community, is therefore expected to raise ecosystem functions. A rival view, the mass-ratio hypothesis, holds that the most abundant trait values, summarised as community-weighted means, drive a function instead. The paper argues that both should be tested in one analysis, which few studies do. It questions the assumption that higher functional diversity always benefits an ecosystem function, here pollinator richness and visitation. \par The study finds that functional diversity of flowers does not always raise pollinator visitation: in a community of mostly generalist visitors, flower communities with more varied traits received fewer visits and no more pollinator species. It combined three years of pollinator observations in the Jena grassland experiment with 13 measured flower traits. Bayesian models separated the diversity of all traits combined, the diversity of single traits and the community-weighted mean of each trait, with flower cover as a control. Overall trait diversity lowered visitation frequency, though with wide uncertainty, and did not affect pollinator richness. Visits and richness instead followed dominant trait values: tall or large flowers went with more visitors, high amino acid concentration and strong green reflectance with fewer. Single-trait diversity affected visits only: diversity in reflectance raised them, diversity in flower morphology lowered them. \par The paper reads this as a caution against assuming that functional diversity always benefits an ecosystem function. It suggests that generalist pollinators lose efficiency when flowers differ in traits such as height and shape, and that many bees stay constant to one flower type, so varied communities are less attractive. It expects the patterns could reverse where specialised pollinators are more common, as a simulation by Junker et al. (2015), in which functional diversity raised pollinator richness, suggests. The negative diversity effect contrasts with the positive effect of plant species richness found earlier in the same experiment (Ebeling et al. 2008), which the paper attributes to that analysis pooling surveys over time. Consequences for crop monocultures and diverse grasslands are left to future studies. As the paper notes, nectar was not sampled alongside the observations, so the amino acid result could be biased.},
  significance_refs = {10.1007/s10682-014-9747-2 10.1111/j.1600-0706.2008.16819.x},
  license = {publisher (subscription)},
  funding = {Deutsche Forschungsgemeinschaft (FOR 1451)},
}

@article{cabral2017mechanistic,
  author  = {Cabral, Juliano Sarmento and Valente, Luis and Hartig, Florian},
  title   = {Mechanistic simulation models in macroecology and biogeography: state-of-art and prospects},
  journal = {Ecography},
  year    = {2017},
  volume  = {40},
  number  = {2},
  pages   = {267--280},
  doi     = {10.1111/ecog.02480},
  abstract = {Macroecology and biogeography are concerned with understanding biodiversity patterns across space and time. In the past, the two disciplines have addressed this question mainly with correlative approaches, despite frequent calls for more mechanistic explanations. Recent advances in computational power, theoretical understanding, and statistical tools are, however, currently facilitating the development of more system‐oriented, mechanistic models. We review these models, identify different model types and theoretical frameworks, compare their processes and properties, and summarize emergent findings. We show that ecological (physiology, demographics, dispersal, biotic interactions) and evolutionary processes, as well as environmental and human‐induced drivers, are increasingly modelled mechanistically; and that new insights into biodiversity dynamics emerge from these models. Yet, substantial challenges still lie ahead for this young research field. Among these, we identify scaling, calibration, validation, and balancing complexity as pressing issues. Moreover, particular process combinations are still understudied, and so far models tend to be developed for specific applications. Future work should aim at developing more flexible and modular models that not only allow different ecological theories to be expressed and contrasted, but which are also built for tight integration with all macroecological data sources. Moving the field towards such a ‘systems macroecology’ will test and improve our understanding of the causal pathways through which eco‐evolutionary processes create diversity patterns across spatial and temporal scales.},
  significance = {Macroecology and biogeography ask why biodiversity is distributed as it is across space and time. They have answered mostly with correlative statistics, which describe patterns but struggle to identify causes, and with simple classical theories, most built on a few processes, typically at one level of organisation. Simplicity and an easy link to data arguably explain the success of the classical theories. But when a theory leaves out processes, a misfit to data is hard to read as evidence against its core assumptions; a flexible theory can fit well without showing that its processes matter; and predictions under environmental change need the essential processes to be included. Mechanistic simulation models, programs that run hypothesised processes step by step, offer an alternative, yet most were built for specific purposes. The problem the paper takes on is how they can become a general tool for testing theories causally and predicting biodiversity. \par The paper, a review of mechanistic simulation models in macroecology and biogeography, argues that explaining and predicting biodiversity causally requires models that simulate several ecological and evolutionary processes together, and that the field should build them as flexible, modular system models linked to data, which it calls ‘systems macroecology’. It supports this by surveying published models, grouped by process, from physiology to evolution and human drivers. A wide range of these processes was already being modelled, but usually only a few at a time, and some combinations had rarely been studied. Combining processes produces complex and frequently contrasting patterns, and models that unify several theories behave differently from the ‘pure’ theories; the paper takes this as evidence that simple theories are hard to falsify. It names four obstacles: scaling up, calibrating with data, validating, and balancing complexity. \par The paper’s route is to join existing models into modular ones with exchangeable parts and standardised inputs and outputs, and to connect them to large biodiversity databases through modern statistical inference methods such as approximate Bayesian computation. Such models would let competing theories be contrasted in one framework, alongside simpler analyses. Its long-term hope is convergence on system models that synthesise what has been learned, perhaps in place of one general theory. Connolly et al. (2017) cited the paper among reviews that treat ‘mechanistic’ and ‘process-based’ as synonyms, and proposed distinguishing them.},
  significance_refs = {10.1016/j.tree.2017.08.011},
  license = {publisher (subscription)},
  funding = {sDiv, the Synthesis Centre of iDiv (DFG FZT 118); Alexander von Humboldt Foundation; Brandenburg Ministry for Science, Research and Culture; DFG (Research grant) (VA 1102/1-1)},
}

