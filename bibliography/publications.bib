@article{etienne2019minimal,
  author  = {Etienne, Rampal S. and Cabral, Juliano Sarmento and Hagen, Oskar and Hartig, Florian and Hurlbert, Allen H. and Pellissier, Loïc and Pontarp, Mikael and Storch, David},
  title   = {A Minimal Model for the Latitudinal Diversity Gradient Suggests a Dominant Role for Ecological Limits},
  journal = {The American Naturalist},
  year    = {2019},
  volume  = {194},
  number  = {5},
  pages   = {E122--E133},
  doi     = {10.1086/705243},
  abstract = {The latitudinal diversity gradient (LDG) is one of Earth’s most iconic biodiversity patterns and still one of the most debated. Explanations for the LDG are often categorized into three broad pathways in which the diversity gradient is created by (1) differential diversification rates, (2) differential carrying capacities (ecological limits), or (3) differential time to accumulate species across latitude. Support for these pathways has, however, been mostly verbally expressed. Here, we present a minimal model to clarify the essential assumptions of the three pathways and explore the sensitivity of diversity dynamics to these pathways. We find that an LDG arises most easily from a gradient in ecological limits compared with a gradient in the time for species accumulation or diversification rate in most modeled scenarios. Differential diversification rates create a stronger LDG than ecological limits only when speciation and dispersal rates are low, but then the predicted LDG seems weaker than the observed LDG. Moreover, range dynamics may reduce an LDG created by a gradient in diversification rates or time for species accumulation, but they cannot reduce an LDG induced by differential ecological limits. We conclude that our simple model provides a null prediction for the effectiveness of the three LDG pathways and can thus aid discussions about the causal mechanisms underlying the LDG or motivate more complex models to confirm or falsify our findings.},
  significance = {Explanations of the latitudinal diversity gradient (LDG), the rise in species richness from the poles towards the tropics, are often grouped into three broad pathways. The tropics may gain species faster (through higher speciation or lower extinction), may support more species in total (higher “ecological limits”, a ceiling on how many species can coexist), or may have had more time to accumulate species. These ideas have mostly been argued in words. According to the paper, simulation models show that each pathway can produce a gradient, and one study explored how several pathways act together (Pontarp and Wiens 2017), but such models require a multitude of modelling decisions. No consensus on the dominant process has been reached. How effective each pathway is at creating a gradient when taken on its own was an open question, and it is the one the paper addresses. \par The paper argues that, in a deliberately minimal model of the latitudinal diversity gradient, the gradient arises most easily from a gradient in ecological limits. The model has only two zones, tropical and temperate, with speciation, extinction, dispersal between the zones and a limit on diversity in each. Each pathway is represented by a gradient in one factor, and the resulting richness differences are compared. Over a much wider range of conditions than for the other pathways, the gradient in limits produces the largest difference. A gradient in diversification rates produces a stronger one only when speciation and dispersal rates are low; the paper reads this as a system still far from equilibrium, meaning richness has not yet levelled off, where the predicted gradient seems weaker than the observed one. Range dynamics, meaning species shifting or spreading between zones, can reduce a gradient created by diversification rates or by time to accumulate species, but not one created by limits. \par The paper treats this as suggestive, not as proof. Together with general parsimony arguments, it shifts the evidence towards ecological limits playing an important role, possibly together with other mechanisms. The paper offers the model as a null prediction, a reference against which more complex models can test and challenge these findings.},
  significance_refs = {10.1111/jbi.12896},
  license = {CC BY-NC 4.0},
  funding = {sDiv, the Synthesis Centre of iDiv (DFG FZT 118); Netherlands Organization for Scientific Research (VICI grant); Czech Science Foundation (16-26369S)},
}

@article{rogers2019total,
  author  = {Rogers, Haldre S and Beckman, Noelle G and Hartig, Florian and Johnson, Jeremy S and Pufal, Gesine and Shea, Katriona and Zurell, Damaris and Bullock, James M and Cantrell, Robert Stephen and Loiselle, Bette and Pejchar, Liba and Razafindratsima, Onja H and Sandor, Manette E and Schupp, Eugene W and Strickland, W Christopher and Zambrano, Jenny},
  title   = {The total dispersal kernel: a review and future directions},
  journal = {AoB PLANTS},
  year    = {2019},
  volume  = {11},
  number  = {5},
  pages   = {plz042},
  doi     = {10.1093/aobpla/plz042},
  abstract = {The distribution and abundance of plants across the world depends in part on their ability to move, which is commonly characterized by a dispersal kernel. For seeds, the total dispersal kernel (TDK) describes the combined influence of all primary, secondary and higher-order dispersal vectors on the overall dispersal kernel for a plant individual, population, species or community. Understanding the role of each vector within the TDK, and their combined influence on the TDK, is critically important for being able to predict plant responses to a changing biotic or abiotic environment. In addition, fully characterizing the TDK by including all vectors may affect predictions of population spread. Here, we review existing research on the TDK and discuss advances in empirical, conceptual modelling and statistical approaches that will facilitate broader application. The concept is simple, but few examples of well-characterized TDKs exist. We find that significant empirical challenges exist, as many studies do not account for all dispersal vectors (e.g. gravity, higher-order dispersal vectors), inadequately measure or estimate long-distance dispersal resulting from multiple vectors and/or neglect spatial heterogeneity and context dependence. Existing mathematical and conceptual modelling approaches and statistical methods allow fitting individual dispersal kernels and combining them to form a TDK; these will perform best if robust prior information is available. We recommend a modelling cycle to parameterize TDKs, where empirical data inform models, which in turn inform additional data collection. Finally, we recommend that the TDK concept be extended to account for not only where seeds land, but also how that location affects the likelihood of establishing and producing a reproductive adult, i.e. the total effective dispersal kernel.},
  significance = {Plants spread through their seeds, and ecologists describe where a seed lands relative to its parent with a dispersal kernel, a probability density over distance. Seeds are carried by several vectors (wind, animals, water, humans), often one after another. For a plant with a single vector, that vector’s kernel is the total kernel, although closer examination usually reveals further vectors. Yet many studies still cover one vector where several act. The total dispersal kernel, which combines all vectors, describes where seeds end up and is needed to predict how a plant population responds if a vector is lost. The concept is simple, but few well-characterised examples exist. The paper addresses the problem of estimating such a kernel from real data. \par The paper argues that the total dispersal kernel of a plant, the pattern of where its seeds land once all vectors are counted, can be built from the kernels of individual vectors and fitted in an iterative modelling cycle, in which data inform models and models direct further data collection. Vectors acting side by side combine as a weighted mixture of their kernels; vectors acting in sequence combine by composition, typically a convolution rather than a simple multiplication. Fitting raises five statistical issues, among them sequential dispersal and seed fate (what happens to a seed after it lands). The paper holds that separating vector contributions from the observed total alone is very difficult, so robust prior information on single-vector kernels is needed. Two boxes, on musk thistle and on the fruit-eating animals of Guam, show systems where parts of the kernel have been explored. \par The paper recommends extending the kernel to the total effective dispersal kernel, which adds how a landing site affects the chances that a seed establishes. It hypothesises that the total and the total effective kernel rarely resemble each other, because of distance-dependent mortality, uneven habitat and the effect of gut passage on germination, so measuring where seeds land is not enough. It also proposes “total dispersal kernel” as the common term instead of “complete” or “full”. The aim is to support predictions of how plant populations respond to losing or changing vectors under global change. The paper is a review with recommendations, not a test of the cycle.},
  license = {CC BY 4.0},
  funding = {National Science Foundation (Seed Dispersal Workshop) (DEB 1548194); Swiss National Science Foundation (SNF) (PZ00P3_168136/1); German Science Foundation (DFG) (ZU 361/1-1); CEH National Capability (NEC06895)},
}

@article{nadalsala2019global,
  author  = {Nadal-Sala, Daniel and Hartig, Florian and Gracia, Carlos A. and Sabat{\'e}, Santiago},
  title   = {Global warming likely to enhance black locust (Robinia pseudoacacia L.) growth in a Mediterranean riparian forest},
  journal = {Forest Ecology and Management},
  year    = {2019},
  volume  = {449},
  pages   = {117448},
  doi     = {10.1016/j.foreco.2019.117448},
  abstract = {Mediterranean riparian forests are comparably humid environments that provide shelter for several broadleaved deciduous tree species at their southernmost distribution margin. The stability of these communities, however, is threatened by climate change as well as invasive tree species, such as black locust (Robinia pseudoacacia L.). So far, black locust's European distribution appears to be mostly limited by low temperatures, but global warming might enhance its growth in colder areas. Moreover, R. pseudoacacia can better access water from the phreatic level than some native non-phreatophytic tree species such as European ash (Fraxinus excelsior L.). In this study, we compare the performance of European ash, a native deciduous tree species at its southernmost distribution border, with the invasive black locust, under a range of climate change projections, in a stand located at N.E. Spain. We first use Bayesian inference to calibrate the GOTILWA + vegetation model against sap flow data for both tree species. We then project each tree species’ performance under several climate change scenarios. Our results indicate that increasing temperatures will enlarge black locust's vegetative period, leading to substantially increased annual productivity if the phreatic water table keeps reachable. For European ash, we project a slight increase in productivity, but with higher uncertainty. Our findings suggest that black locust will profit more from global warming than the native European ash, which is concerning because of the already detrimental impact of black locust for the local ecosystems. We conclude that climate change has the potential to stimulate black locust growth on Mediterranean riparian forests. Forest management should therefore include mechanisms to avoid black locust establishment, such as avoid clear-cutting and maintaining closed riparian forest canopies.},
  significance = {Climate change and the arrival of non-native species are two pressures on forests that can reinforce each other, and the paper takes Mediterranean riparian forests as an example. There, native trees such as European ash find shelter at the southern edge of their range, while the invasive black locust, which appears to be held back in Europe mainly by cold, can also draw on groundwater. Warming could favour the invader. Earlier projections relied on statistical distribution models, which the paper describes as limited for changing conditions and for climates without a present-day equivalent, while process-based models lacked reliable estimates of black locust’s water use and growing-season timing. What is missing is a mechanistic comparison, with quantified uncertainty, of invader and native under future climates. \par The paper argues that, in a riparian forest stand in north-eastern Spain, the invasive black locust would profit more from climate change than native European ash, because, under warming and rising CO2, its growing season lengthens and its daily carbon uptake rises. The study fitted a process-based forest model (GOTILWA+) to sap-flow measurements, which record water moving through tree stems, from both species. Bayesian inference, which yields ranges of plausible parameter values, made the projections’ uncertainty explicit. Under a baseline of constant climate with no further forcing, ash is the more productive species. In 2071–2100 the gain is larger for black locust: gross primary production (the carbon fixed by photosynthesis) under a moderate warming scenario is 27% above that baseline for black locust and 18% for ash. The ash projections are more uncertain, and the gains of black locust are likely to hold only if groundwater stays reachable. \par The paper reads these results as evidence that climate change could raise the invasion potential of black locust in Mediterranean riparian forests. Because black locust is hard to remove once established, yet regenerates poorly under a closed canopy, the paper advises prevention: not planting it, and avoiding thinning or clear-cutting that opens gaps. It names its limits: one year of calibration data without a serious summer water deficit, productivity assumed to indicate how well a species does, and no modelling of interactions between the species. The paper therefore presents the results as pointing to better growth of black locust, with considerable uncertainty.},
  license = {publisher (subscription)},
  funding = {European Cooperation in Science and Technology; Ministerio de Economía y Competitividad (CGL2014-59977-C3-1-R); Ministerio de Economía y Competitividad (BES-2015-072983)},
}

@article{czaczkes2019multi,
  author  = {Czaczkes, Tomer J. and Beckwith, John J. and Horsch, Anna-Lena and Hartig, Florian},
  title   = {The multi-dimensional nature of information drives prioritization of private over social information in ants},
  journal = {Proceedings of the Royal Society B: Biological Sciences},
  year    = {2019},
  volume  = {286},
  number  = {1909},
  pages   = {20191136},
  doi     = {10.1098/rspb.2019.1136},
  abstract = {When personally gathered and socially acquired information conflict, animals often prioritize private information. We propose that this is because private information often contains details that social information lacks. We test this idea in an ant model. Ants using a food source learn its location and quality rapidly (private information), whereas pheromone trails (social information) provide good directional information, but lack reliable information about food quality. If this lack is indeed responsible for the choice of memory over pheromone trails, adding information that better food is available should cause foragers to switch their priority to social information. We show it does: while ants follow memory rather than pheromones when they conflict, adding unambiguous information about a better potential food source (a 2 µl droplet of good food) reverses this pattern, from 60% of ants following their memory to 75% following the pheromone trail. Using fluorescence microscopy, we demonstrate that food (and thus information) flows from fed workers to outgoing foragers, explaining the frequent contacts of ants on trails. Ants trained to poor food that contact nest-mates fed with good food are more likely to follow a trail than ants which received information about poor food. We conclude that social information may often be ignored because it lacks certain crucial dimensions, suggesting that information content is crucial for understanding how and when animals prioritize social and private information.},
  significance = {When what an animal has learned itself (private information) conflicts with what other animals do or signal (social information), animals mostly follow their own information. This holds even for ants and bees, whose dedicated signals include pheromone trails. Earlier explanations point to source reliability or age, the cost of gathering new information, and the gain for a colony when workers specialise; these are reasonable and not disputed by the paper. The paper takes on what they leave out, information content: a signal can be precise about direction yet ambiguous about food quality. \par The paper argues that animals neglect social information, such as an ant pheromone trail, when it lacks a kind of information their own experience supplies, such as food quality, so supplying that kind of information should make them follow the social signal. It tests this with the ant Lasius niger, whose trails show the way but say little reliably about food quality. In a Y-shaped maze, ants trained to poor food on one arm chose that arm rather than a trail on the other in about 60% of cases, not clearly different from chance. When they also met a tiny droplet of better sucrose, the pattern reversed, from about 60% following memory to 75% following the trail; neither trail nor droplet alone did this. In a second experiment, ants meeting nest-mates fed on rich sucrose followed memory less often than ants meeting nest-mates fed on poor food. A fluorescent dye in the nest-mates’ food reached the meeting ant in 21 of 30 trials, so contact with fed nest-mates can pass on food and information about food quality. \par The results suggest that research on private versus social information, which has asked when to use social information and whom to copy, should also ask what type of information a source provides. The paper proposes that on a trail, an outgoing forager compares its own food with that of returning nest-mates and follows the trail only if theirs is better (“copy if better”), a rule the study did not test directly. It also notes that quality information, although it carries no direction, changed trail following; psychophysical models of trail following explain this poorly. A review of ant foraging cites the paper for the suggestion that trails may give rather inaccurate information about food quality (Kolay et al. 2020).},
  significance_refs = {10.3389/fpsyg.2020.00734},
  license = {publisher (subscription)},
  funding = {DFG (Deutsche Forschungsgemeinschaft), grant to T.J.C (CZ 237/1-1)},
}

@article{chanthorn2019defaunation,
  author  = {Chanthorn, Wirong and Hartig, Florian and Brockelman, Warren Y. and Srisang, Wacharapong and Nathalang, Anuttara and Santon, Jantima},
  title   = {Defaunation of large-bodied frugivores reduces carbon storage in a tropical forest of Southeast Asia},
  journal = {Scientific Reports},
  year    = {2019},
  volume  = {9},
  number  = {1},
  pages   = {10015},
  doi     = {10.1038/s41598-019-46399-y},
  abstract = {Recent studies have suggested that defaunation of large-bodied frugivores reduces above-ground carbon storage in tropical forests of South America and Africa, but not, or less so, in Southeast Asian tropical forests. Here we analyze the issue using the seed dispersal network (data of interaction between trees and animal seed dispersers) and forest composition of a 30-ha forest dynamics plot in central Thailand, where an intact fauna of primates, ungulates, bears and birds of all sizes still exists. We simulate the effect of two defaunation scenarios on forest biomass: 1) only primates extirpated (a realistic possibility in near future), and 2) extirpation of all large-bodied frugivores (LBF) including gibbons, macaques, hornbills and terrestrial mammals, the main targets of poachers in this region. For each scenario, we varied the population size reduction of the LBF dispersed tree species from 20% to 100%. We find that tree species dependent on seed dispersal by large-bodied frugivores (LBF) account for nearly one-third of the total carbon biomass on the plot, and that the community turnover following a complete defaunation would result in a carbon reduction of 2.4% to 3.0%, depending on the defaunation scenario and the model assumptions. The reduction was always greater than 1% when the defaunation intensity was at least 40%. These effect sizes are comparable to values reported for Neotropical forests, suggesting that the impact of defaunation on carbon deficit is not necessarily lower in Southeast Asian forests. The problem of defaunation in Asia, and the mutual benefits between biodiversity conservation and climate change mitigation, should therefore not be neglected by global policies to reduce carbon emissions.},
  significance = {Hunting removes large animals across the tropics, and with the fruit-eaters that carry tree seeds a forest may lose the tree species that depend on them. Several earlier studies predicted that this lowers carbon storage, which the paper traces to such trees tending to have dense, carbon-rich wood, and drew consequences for climate policies such as REDD+ (the UN scheme linking forest carbon with biodiversity conservation). For Southeast Asia, earlier studies had found little such effect. A reasonable explanation is that dipterocarps, a common regional tree family with wind-dispersed seeds, could make up for the loss (Osuri et al. 2016). The paper takes on the assumption that this buffer holds for Southeast Asian forests in general, since not all are dominated by dipterocarps. \par The study argues that the carbon loss from losing large fruit-eating animals is not necessarily smaller in Southeast Asian forests than in Neotropical ones, and suggests that a low share of dipterocarps, the dense-wooded, wind-dispersed trees that could compensate, may be a key factor. It examines the question in the 30-ha Mo Singto forest plot in Thailand, where hunting has been low for decades and dipterocarps make up only 13% of tree basal area (trunk cross-section). Tree species that depend on large-bodied fruit-eaters hold nearly one third of the plot’s above-ground carbon and have significantly higher wood density than other species. Simulating their loss at intensities from 20 to 100%, with the remaining species taking their place, the study finds that complete loss lowers above-ground carbon by roughly 2 to 3%, depending on scenario and model assumptions. It reads most of this as an effect of wood density and finds it similar in size to Neotropical estimates. \par The paper therefore advises that REDD+ and forest restoration projects take fauna and seed dispersal into account. It calls the assumption that the remaining species take over all roles of the lost ones rather optimistic, with stronger losses possible if they do not. Limits remain: the estimate comes from one plot and assumes a community in equilibrium, so how far it carries to other Asian forests is open.},
  significance_refs = {10.1038/ncomms11351},
  license = {CC BY 4.0},
  funding = {National Science and Technology Development Agency (Thailand)},
}

@article{maliet2019model,
  author  = {Maliet, Odile and Hartig, Florian and Morlon, H{\'e}l{\`e}ne},
  title   = {A model with many small shifts for estimating species-specific diversification rates},
  journal = {Nature Ecology \& Evolution},
  year    = {2019},
  volume  = {3},
  number  = {7},
  pages   = {1086--1092},
  doi     = {10.1038/s41559-019-0908-0},
  abstract = {Understanding how and why diversification rates vary through time and space and across species groups is key to understanding the emergence of today’s biodiversity. Phylogenetic approaches aimed at identifying variations in diversification rates during the evolutionary history of clades have focused on exceptional shifts subtending evolutionary radiations. While such shifts have undoubtedly affected the history of life, identifying smaller but more frequent changes is important as well. We developed ClaDS---a new Bayesian approach for estimating branch-specific diversification rates on a phylogeny that relies on a model with changes in diversification rates at each speciation event. We show, using Monte Carlo simulations, that the approach performs well at inferring both small and large changes in diversification. Applying our approach to bird phylogenies covering the entire avian radiation, we find that diversification rates are remarkably heterogeneous within evolutionarily restricted species groups. Some groups such as Accipitridae (hawks and allies) cover almost the full range of speciation rates found across the entire bird radiation. As much as 76\% of the variation in branch-specific rates across this radiation is due to intraclade variation, suggesting that a large part of the variation in diversification rates is due to many small, rather than few large, shifts.},
  significance = {Most methods that look for variation in diversification rates along phylogenies (family trees of species) have focused on a few exceptional shifts, in which one lineage starts a radiation. Such shifts have surely shaped the history of life, but the paper argues that smaller and more frequent changes in rate matter as well. It therefore asks how much of the variation in diversification rates comes from many small changes rather than a few large ones. \par The paper argues that much of the variation in diversification rates among birds arises from many small shifts within closely related groups, and it introduces ClaDS, a Bayesian method, to show this. In the underlying model the speciation rate of each lineage changes at every speciation event, and the method estimates a rate for every branch. Simulations indicate that it recovers both small and large changes reliably on average, although extreme rates are somewhat smoothed. Applied to 42 bird clades (mostly families), rates are very heterogeneous within groups: on a logarithmic scale, Accipitridae (hawks and allies) cover a large part of the range of speciation rates across all birds, and 76% of the variation in branch-specific rates lies within groups. A method built around discrete shifts would place only 46% of the variance within groups, which the paper takes to mean that many small shifts escape such methods. \par The paper reads these results as suggesting that a large part of the variation in diversification rates is due to many small rather than a few large shifts. Small, frequent changes are then important alongside exceptional shifts.},
  license = {publisher (subscription)},
  funding = {École Polytechnique (AMX grant); LabEx MemoLife; PROCOPE Mobility Grant (57134817); European Research Council (ERC 616419-PANDA)},
}

@article{johnson2019rapid,
  author  = {Johnson, Jeremy S and Cantrell, Robert Stephen and Cosner, Chris and Hartig, Florian and Hastings, Alan and Rogers, Haldre S and Schupp, Eugene W and Shea, Katriona and Teller, Brittany J and Yu, Xiao and Zurell, Damaris and Pufal, Gesine},
  title   = {Rapid changes in seed dispersal traits may modify plant responses to global change},
  journal = {AoB PLANTS},
  year    = {2019},
  volume  = {11},
  number  = {3},
  pages   = {plz020},
  doi     = {10.1093/aobpla/plz020},
  abstract = {When climatic or environmental conditions change, plant populations must either adapt to these new conditions, or track their niche via seed dispersal. Adaptation of plants to different abiotic environments has mostly been discussed with respect to physiological and demographic parameters that allow local persistence. However, rapid modifications in response to changing environmental conditions can also affect seed dispersal, both via plant traits and via their dispersal agents. Studying such changes empirically is challenging, due to the high variability in dispersal success, resulting from environmental heterogeneity, and substantial phenotypic variability of dispersal-related traits of seeds and their dispersers. The exact mechanisms that drive rapid changes are often not well understood, but the ecological implications of these processes are essential determinants of dispersal success, and deserve more attention from ecologists, especially in the context of adaptation to global change. We outline the evidence for rapid changes in seed dispersal traits by discussing variability due to plasticity or genetics broadly, and describe the specific traits and biological systems in which variability in dispersal is being studied, before discussing some of the potential underlying mechanisms. We then address future research needs and propose a simulation model that incorporates phenotypic plasticity in seed dispersal. We close with a call to action and encourage ecologists and biologist to embrace the challenge of better understanding rapid changes in seed dispersal and their consequences for the reaction of plant populations to global change.},
  significance = {When conditions change, plant populations can adapt where they stand or follow their suitable conditions by dispersing seeds. Rapid change in traits such as phenology (the timing of life-cycle events) has been studied much more often, but rapid change in the traits that determine where seeds go has received much less attention. One reading is that selection acts on local survival rather than on where seeds land. Given how much dispersal matters for fitness, the paper contends instead that adaptive change in dispersal does occur and that the lack of evidence mostly reflects how hard dispersal is to study. Predictive models, too, rarely include variation in dispersal traits. The paper addresses this gap: whether dispersal can change quickly with the environment, and so help plants cope. \par The paper argues that seed dispersal, in plants and their dispersers, can change rapidly with the environment, through plasticity or genetic change, and that this deserves study and a place in models of plant responses to global change. Plasticity means one genotype producing different traits in different environments. Most dispersal studies the paper reviews show how traits vary with conditions without asking whether the variation is genetic or plastic; fewer address rapid change itself. In Crepis sancta, small fragmented urban habitat patches had a much higher proportion of non-dispersing seeds, a pattern that Cheptou et al. (2008) read as evolution within a few generations. The paper calls the smaller seeds of the palm Euterpe edulis in forests that have lost large fruit-eating birds, reported by Galetti et al. (2013), perhaps the most elegant demonstration of rapid change in dispersal. Its own simple model lets an annual plant make two seed types that disperse differently, in patchy habitat; in simulations a mix of the two types sometimes gave the fastest spread, depending on how well each type survived. \par The paper concludes that there is evidence and potential for rapid regulation of dispersal, while the effects on plant fitness and plant communities are less clear. It asks for data on dispersal-trait variation within single plants that separates genetic from plastic sources; for theory of how dispersal traits change, linked to models of population spread and vegetation; and for predictions of which species cannot keep up with their niche that include such change.},
  significance_refs = {10.1073/pnas.0708446105 10.1126/science.1233774},
  license = {CC BY 4.0},
  funding = {National Science Foundation (workshop on seed dispersal) (NSF DEB # 1548194); National Socio-Environmental Synthesis Center (SESYNC), funded by NSF (NSF DBI-1052875); NSF (DMS # 1514752); Swiss National Science Foundation (SNF) (PZ00P3_168136/1); German Science Foundation (DFG) (ZU 361/1-1)},
}

@article{hauenstein2019calibrating,
  author  = {Hauenstein, Severin and Fattebert, Julien and Gr{\"u}ebler, Martin U. and Naef-Daenzer, Beat and Pe'er, Guy and Hartig, Florian},
  title   = {Calibrating an individual-based movement model to predict functional connectivity for little owls},
  journal = {Ecological Applications},
  year    = {2019},
  volume  = {29},
  number  = {4},
  pages   = {e01873},
  doi     = {10.1002/eap.1873},
  abstract = {Dispersal is crucial for population viability and thus a popular target for conservation measures. However, the ability of individuals to move between habitat patches is notoriously difficult to estimate. One solution is to quantify functional connectivity via realistic individual‐based movement models. Such simulation models, however, are difficult to build and even more difficult to parameterize. Here, we use the example of natal little owl (Athene noctua) dispersal to develop a new analysis chain for the calibration of individual‐based dispersal models using a hybrid of statistical parameter estimation and Approximate Bayesian Computation (ABC). Specifically, we use locations of 126 radio‐tracked juveniles to first estimate habitat utilization by generalized additive models (GAMs) and the biased random bridges (BRB) method. We then include the estimated parameters in a spatially explicit individual‐based model (IBM) of little owl dispersal and calibrate further movement parameters using ABC. To derive efficient summary statistics, we use a new dimension reduction method based on random forest (RF) regression. Finally, we use the calibrated IBM to predict the dispersal potential of little owls from local populations in southwestern Germany to suitable habitat patches in northern Switzerland. We show that pre‐calibrating habitat preference parameters while inferring movement behavioral parameters via ABC is a computationally efficient solution to obtain a plausible IBM parameterization. We also find that dimension reduction via RF regression outperforms the widely used least squares regression, which we applied as a benchmark approach. Estimated movement parameters for the individuals reveal plausible inter‐individual and inter‐sexual differences in movement behavior during natal dispersal. In agreement with a sex‐biased dispersal distance in little owls, females show longer individual flights and higher directional persistence. Simulations from the fitted model indicate that a (re)colonization of northern Switzerland is generally possible, albeit restricted. We conclude that the presented analysis chain is a sensible work‐flow to assess dispersal connectivity across species and ecosystems. It embraces species‐ and individual‐specific behavioral responses to the landscape and allows likelihood‐based calibration, despite an irregular sampling design. Our study highlights existing, yet narrow dispersal corridors, which may require enhancements to facilitate a recolonization of little owl habitat patches in northern Switzerland.},
  significance = {Functional connectivity, the ability of individuals to move between habitat patches, matters for conservation but is hard to estimate. The usual shortcuts, least-cost paths and circuit theory, give a rough picture of corridors but ignore what is known about the species and assume that dispersing animals know the whole landscape. Movement models that follow each animal as an individual avoid this assumption, but they have no tractable formula for how likely the observed data are under given parameters, so likelihood-based statistics cannot fit them, particularly to irregularly timed tracking data. Approximate Bayesian Computation fits such simulation models by keeping parameter values whose simulations resemble the data, but its cost rises quickly with the number of parameters and it needs well-chosen summary statistics, for which there was little guidance. The paper’s aim is to calibrate such a model to real tracking data feasibly and efficiently. \par The paper shows that a realistic individual-based model of little owl dispersal can be fitted to irregularly timed tracking data by splitting its parameters: habitat preference is estimated first with an ordinary statistical model, and only four movement parameters are calibrated with Approximate Bayesian Computation (ABC). A random forest (a machine-learning method) compresses the 49 summary statistics into four, one per parameter, instead of a linear least-squares regression. On simulated data with known parameters, the random forest summaries gave estimates close to the true values, with clearly narrower 80% credible intervals than least squares. As the worked example, the study uses 126 radio-tracked juvenile little owls in southwestern Germany. Females made longer and more directed flights than males. Simulations showed narrow dispersal corridors into northern Switzerland and only a slow build-up of simulated dispersers there. \par The study offers this two-step procedure (statistical habitat model, then ABC with random-forest summaries) as a workflow for assessing dispersal connectivity across species, one that serves inference about behaviour and prediction of connectivity at once. The authors describe it modestly, as an example with a few smaller innovations. For the little owl, the results suggest that recolonisation of northern Switzerland is possible, but that without habitat improvement along the corridors it may not happen soon. The model covers only the movement phase and leaves out demography, so it cannot give recolonisation times.},
  license = {publisher (subscription)},
  funding = {Schweizerischer Nationalfonds zur Förderung der Wissenschaftlichen Forschung (3100A 132951/1); Hirschmann-Stiftung; Karl Mayer Stiftung; Deutsche Forschungsgemeinschaft (INST 39/963-1 FUGG); State of Baden-Württemberg (bwHPC); German Centre for Integrative Biodiversity Research (iDiv) Halle-Jena-Leipzig (G.P.)},
}

@article{aslan2019employing,
  author  = {Aslan, Clare and Beckman, Noelle G and Rogers, Haldre S and Bronstein, Judie and Zurell, Damaris and Hartig, Florian and Shea, Katriona and Pejchar, Liba and Neubert, Mike and Poulsen, John and HilleRisLambers, Janneke and Miriti, Maria and Loiselle, Bette and Effiom, Edu and Zambrano, Jenny and Schupp, Geno and Pufal, Gesine and Johnson, Jeremy and Bullock, James M and Brodie, Jedediah and Bruna, Emilio and Cantrell, Robert Stephen and Decker, Robin and Fricke, Evan and Gurski, Katie and Hastings, Alan and Kogan, Oleg and Razafindratsima, Onja and Sandor, Manette and Schreiber, Sebastian and Snell, Rebecca and Strickland, Christopher and Zhou, Ying},
  title   = {Employing plant functional groups to advance seed dispersal ecology and conservation},
  journal = {AoB PLANTS},
  year    = {2019},
  volume  = {11},
  number  = {2},
  pages   = {plz006},
  doi     = {10.1093/aobpla/plz006},
  abstract = {Seed dispersal enables plants to reach hospitable germination sites and escape natural enemies. Understanding when and how much seed dispersal matters to plant fitness is critical for understanding plant population and community dynamics. At the same time, the complexity of factors that determine if a seed will be successfully dispersed and subsequently develop into a reproductive plant is daunting. Quantifying all factors that may influence seed dispersal effectiveness for any potential seed-vector relationship would require an unrealistically large amount of time, materials and financial resources. On the other hand, being able to make dispersal predictions is critical for predicting whether single species and entire ecosystems will be resilient to global change. Building on current frameworks, we here posit that seed dispersal ecology should adopt plant functional groups as analytical units to reduce this complexity to manageable levels. Functional groups can be used to distinguish, for their constituent species, whether it matters (i) if seeds are dispersed, (ii) into what context they are dispersed and (iii) what vectors disperse them. To avoid overgeneralization, we propose that the utility of these functional groups may be assessed by generating predictions based on the groups and then testing those predictions against species-specific data. We suggest that data collection and analysis can then be guided by robust functional group definitions. Generalizing across similar species in this way could help us to better understand the population and community dynamics of plants and tackle the complexity of seed dispersal as well as its disruption.},
  significance = {Seed dispersal, the movement of seeds away from the parent plant, helps plants reach suitable sites and escape natural enemies. Predicting how global change and the loss of animal dispersers will affect plant populations therefore requires knowing when and how much dispersal matters to a plant’s fitness. The Seed Dispersal Effectiveness (SDE) framework (Schupp et al. 2010) is a reasonable way to organise the many interacting factors involved. Applied in full, however, it needs up to 15 measured quantities for each pair of plant and disperser species, which is out of reach for thousands of species pairs. Earlier functional groupings, for example of seed dispersers (Dennis and Westcott 2006), stayed narrow in scope. Dispersal syndromes, which sort plants by the type of vector (animals or wind) that disperses their seeds, risk being too crude to predict what losing a vector means. The paper questions the use of the individual species as the unit of analysis. \par The paper argues that the Seed Dispersal Effectiveness framework should use plant functional groups (groups of species sharing an ecological function) instead of individual species as its units of analysis. The groups are defined by how much it matters to a plant whether its seeds are dispersed (for example, high colonisation ability), where or when they are dispersed (for example, intolerance of shade) and by which vector (for example, seed size). Table 1 lists 17 such groups, almost all paired with a contrasting trait for which losing dispersal should matter less. Published cases illustrate rather than test the vector category: the large-seeded plant Platymitra macrocarpa in Thailand appears to depend on which animals disperse it, whereas for two small-seeded Miconia species in Brazil the dispersing birds differed in the number of seeds moved but not in dispersal quality. To avoid overgeneralising, the paper proposes to test whether predictions derived from the groups hold against data on single species, collected in a standardised way across many systems. \par If groups pass such tests, researchers and conservation planners could judge from a species’ traits whether it is likely to suffer from the loss of its dispersers, and could generalise across species and systems with far less data. The paper offers a proposal and research agenda, not a test, and invites the ecological community to join in.},
  significance_refs = {10.1111/j.1469-8137.2010.03402.x 10.1007/s00442-006-0475-3},
  license = {CC BY 4.0},
  funding = {US National Science Foundation (DEB-1548194); National Socio-Environmental Synthesis Center under the US National Science Foundation (DBI-1052875); Swiss National Science Foundation (SNF) (PZ00P3_168136/1); German Science Foundation (DFG) (ZU 361/1-1)},
}

@article{pontarp2019latitudinal,
  author   = {Pontarp, Mikael and Bunnefeld, Lynsey and Cabral, Juliano Sarmento and Etienne, Rampal S. and Fritz, Susanne A. and Gillespie, Rosemary and Graham, Catherine H. and Hagen, Oskar and Hartig, Florian and Huang, Shan and Jansson, Roland and Maliet, Odile and Münkemüller, Tamara and Pellissier, Loïc and Rangel, Thiago F. and Storch, David and Wiegand, Thorsten and Hurlbert, Allen H.},
  title    = {The Latitudinal Diversity Gradient: Novel Understanding through Mechanistic Eco-evolutionary Models},
  journal  = {Trends in Ecology \& Evolution},
  year     = {2019},
  volume   = {34},
  number   = {3},
  pages    = {211--223},
  doi      = {10.1016/j.tree.2018.11.009},
  abstract = {The latitudinal diversity gradient (LDG) is one of the most widely studied patterns in ecology, yet no consensus has been reached about its underlying causes. We argue that the reasons for this are the verbal nature of existing hypotheses, the failure to mechanistically link interacting ecological and evolutionary processes to the LDG, and the fact that empirical patterns are often consistent with multiple explanations. To address this issue, we synthesize current LDG hypotheses, uncovering their eco-evolutionary mechanisms, hidden assumptions, and commonalities. Furthermore, we propose mechanistic eco-evolutionary modeling and an inferential approach that makes use of geographic, phylogenetic, and trait-based patterns to assess the relative importance of different processes for generating the LDG.},
  featured = {true},
  significance = {The latitudinal diversity gradient, the rise in species richness from the poles to the equator, has at least 26 proposed explanations. They fall into three groups: differences in ecological limits (how many species a region can support), in diversification rates (how fast species form) and in the time available for species to accumulate. Each names an explicit driver that varies with latitude, and data appear compatible with many of them, yet no consensus has emerged. The paper traces this largely to the verbal form of the hypotheses: each rests on one driver, predicts few patterns and leaves assumptions about other processes unstated. Because the explanations may not be mutually exclusive, such predictions alone may not separate them, and how strongly each underlying process contributes remains unresolved. \par The paper proposes to replace competing verbal explanations of the latitudinal diversity gradient with computer simulations of four processes that any explanation must involve: selection, ecological drift (chance variation in births and deaths), dispersal and speciation. Such models produce many patterns at once, such as species ranges, family trees and trait distributions. Fitting these patterns to data could estimate how much each process contributes, rather than only asking which hypothesis wins. Re-reading four classic hypotheses through the four processes exposes hidden assumptions: the more-individuals hypothesis assumes that richness has reached equilibrium, and tropical niche conservatism implicitly assumes no zero-sum limit on the number of individuals, hence no diversity-limiting competition. An existing simulation model (Hurlbert and Stegen 2014), run with settings that mimic three hypotheses, shows how this works. Some patterns arose under all of them, including the gradient itself and the imbalance of family trees (how unevenly lineages branch), while others, such as the relation between speciation rate and latitude, may tell the hypotheses apart. \par The paper concludes that the unit of analysis should be the processes and their assumptions, not the names of hypotheses. Hypotheses then become alternative model structures within one framework. Each is compared with data by matching simulated to observed patterns or by fitting with simulation-based methods such as Approximate Bayesian Computation, and a model that fails to reproduce a pattern shows where it needs improving. The paper presents this as a roadmap rather than a fitted analysis; model complexity, implementation choices and computing cost remain open challenges.},
  significance_refs = {10.3389/fgene.2014.00420},
  license = {publisher (subscription)},
  funding = {sDiv, the Synthesis Centre of the German Centre for Integrative Biodiversity Research (iDiv) Halle-Jena-Leipzig (DFG) (FZT 118); Alexander von Humboldt Foundation (postdoctoral fellowship, SH); German Research Foundation (DFG) (FR 3246/2-1); Czech Science Foundation (16-26369S)},
}

@article{delpierre2019chilling,
  author  = {Delpierre, Nicolas and Lireux, Ségolène and Hartig, Florian and Camarero, Jesus Julio and Cheaib, Alissar and Čufar, Katarina and Cuny, Henri and Deslauriers, Annie and Fonti, Patrick and Gričar, Jožica and Huang, Jian-Guo and Krause, Cornelia and Liu, Guohua and de Luis, Martin and Mäkinen, Harri and del Castillo, Edurne Martinez and Morin, Hubert and Nöjd, Pekka and Oberhuber, Walter and Prislan, Peter and Rossi, Sergio and Saderi, Seyedeh Masoumeh and Treml, Vaclav and Vavrick, Hanus and Rathgeber, Cyrille B. K.},
  title   = {Chilling and forcing temperatures interact to predict the onset of wood formation in Northern Hemisphere conifers},
  journal = {Global Change Biology},
  year    = {2019},
  volume  = {25},
  number  = {3},
  pages   = {1089--1105},
  doi     = {10.1111/gcb.14539},
  abstract = {The phenology of wood formation is a critical process to consider for predicting how trees from the temperate and boreal zones may react to climate change. Compared to leaf phenology, however, the determinism of wood phenology is still poorly known. Here, we compared for the first time three alternative ecophysiological model classes (threshold models, heat‐sum models and chilling‐influenced heat‐sum models) and an empirical model in their ability to predict the starting date of xylem cell enlargement in spring, for four major Northern Hemisphere conifers (Larix decidua, Pinus sylvestris, Picea abies and Picea mariana). We fitted models with Bayesian inference to wood phenological data collected for 220 site‐years over Europe and Canada. The chilling‐influenced heat‐sum model received most support for all the four studied species, predicting validation data with a 7.7‐day error, which is within one day of the observed data resolution. We conclude that both chilling and forcing temperatures determine the onset of wood formation in Northern Hemisphere conifers. Importantly, the chilling‐influenced heat‐sum model showed virtually no spatial bias whichever the species, despite the large environmental gradients considered. This suggests that the spring onset of wood formation is far less affected by local adaptation than by environmentally driven plasticity. In a context of climate change, we therefore expect rising winter–spring temperature to exert ambivalent effects on the spring onset of wood formation, tending to hasten it through the accumulation of forcing temperature, but imposing a higher forcing temperature requirement through the lower accumulation of chilling.},
  significance = {Terrestrial ecosystem models mostly tie wood formation to leaf phenology or to generic temperature functions, because the timing of wood growth is far less understood than that of leaves. Earlier studies asked when the cambium, the wood-forming cell layer, resumes activity in spring, and proposed three temperature rules: crossing a threshold; accumulating heat above a base temperature (a heat sum); or a heat sum whose requirement depends on accumulated chilling, shown to work for Douglas fir (Ford et al. 2016). Each was tested separately, and according to the paper they had not been compared on the same data. Heat-sum models capture that spring warmth restarts growth, but they assume that dormancy ends on a fixed date, so that heat alone sets the timing. The paper asks which temperature rule best explains when wood formation starts. \par The study finds that the spring onset of wood formation in four Northern Hemisphere conifers is best predicted by a model in which both chilling and forcing (warm) temperature act, not by a threshold or by heat accumulation alone. It compared the three model types, plus an empirical regression, by Bayesian inference on wood-formation records from 220 site-years in Europe and Canada, for Larix decidua, Pinus sylvestris, Picea abies and Picea mariana; onset was the start of xylem (wood) cell enlargement. The chilling-influenced heat-sum model, in which more chilling lowers the heat needed, received most support for all four species and predicted validation data with a 7.7-day error on average. Its predictions of site means showed virtually no spatial bias despite large environmental gradients, which the study reads as environmentally driven plasticity (trees adjusting to local conditions) outweighing local adaptation. \par The study concludes that warmer winters and springs act in two directions: more forcing heat hastens onset, but less chilling raises the forcing requirement. It therefore questions predictions of a continuing advance of onset under warming, and proposes the chilling-influenced model as a building block for wood-phenology modules in ecosystem models. The study notes that direct evidence for a chilling effect on xylem onset is lacking and that some fitted chilling thresholds look low, so the mechanism needs experimental tests. Tumajer et al. (2021), who share one co-author with the paper, follow its heat-sum delimitation of active cambium in their wood-growth model.},
  significance_refs = {10.1111/gcb.13328 10.3389/fpls.2021.613643},
  license = {publisher (subscription)},
  funding = {GIP-ECOFOR (SACROBOQUE project) (2016.013); French Ministry of Ecology (project GICC GRAAL) (10-MCGOT-GICC-8-CVS-139); French National Research Agency (Lab of Excellence ARBRE) (ANR-11-LABX-0002-01); Swiss National Science Foundation (projects INTEGRAL and LOTFOR) (INTEGRAL-121859; LOTFOR-150205); Academy of Finland (115650; 124390); European Social Fund; State budget of the Czech Republic, Project Indicators of trees vitality (CZ.1.07/2.3.00/20.0265); Slovenian Research Agency (ARRS) (P4-0015; P4-0107); 100 Talents Program of the Chinese Academy of Sciences (Y421081001); National Natural Science Foundation of China (31570584); Consortium de Recherche sur la Forêt Boréale Commerciale; Fonds de Recherche sur la Nature et les Technologies du Québec; Forêt d'enseignement et de recherche Simoncouche; Natural Sciences and Engineering Research Council of Canada},
}

@article{valdez2019recruitment,
  author  = {Valdez, Jose W. and Hartig, Florian and Fennel, Sabine and Poschlod, Peter},
  title   = {The Recruitment Niche Predicts Plant Community Assembly Across a Hydrological Gradient Along Plowed and Undisturbed Transects in a Former Agricultural Wetland},
  journal = {Frontiers in Plant Science},
  year    = {2019},
  volume  = {10},
  pages   = {88},
  doi     = {10.3389/fpls.2019.00088},
  abstract = {Seedling emergence in plant communities depends on the composition in the soil seed bank, in combination with species-specific responses to the environment. It is generally assumed that this juvenile transition, known as the recruitment niche, is a crucial filter that determines species’ distributions and plant community assemblies. The relative importance of this filter, however, has been widely debated. Empirical descriptions of the recruitment niche are scarce, as most field studies focus on environmental effects at later life stages. In this study, we examine the importance of the recruitment niche for predicting plant communities across a hydrological gradient in a disturbed and undisturbed area in Lake Schmiechen, Baden-Württemberg, Germany. We combine a seed bank experiment, measuring germination in water basins under standardized conditions and different water levels, with field observations of plant communities along a hydrological gradient in plowed and undisturbed transects in a former agricultural wetland. We find that hydrology consistently predicted plant community composition in both the germination experiment and in the field. The hydrological recruitment niches measured in the seed bank experiment correlated with the hydrological niche in both the plowed and undisturbed area, with slightly stronger correlation in the plowed area. We explain the latter by the fact that the seed bank experiment most closely resembles the plowed area, whereas succession and competitive interactions become more important in the undisturbed area. Our results support the view that the recruitment niche is an important driver of species composition, in both the plowed and undisturbed area. Recognizing the recruitment niche and the response of seeds within a seed bank to environmental gradients and anthropogenic disturbance is necessary to understand and predict future plant community composition.},
  significance = {Plant ecology mostly studies adult stages or assumes that life stages respond alike to the environment. The paper notes, however, that most plant mortality occurs at the seed-to-seedling transition. The conditions that allow a seed to germinate and establish are called the recruitment niche, one component of the broader regeneration niche (Grubb 1977). It has therefore been suggested that recruitment is a critical filter determining which species occur where, but its importance is debated and empirical descriptions are scarce. The problem the paper takes on is whether the recruitment niche, measured on its own under standardised conditions, predicts where species occur along an environmental gradient, with and without disturbance. \par The study reports that species’ germination preferences for water level, measured in a controlled experiment, correspond to where those species grow along a water-level gradient in the field, and it reads this as support for germination conditions being an important filter of plant community composition. The test system is a former agricultural field at Lake Schmiechen, Germany, with one half ploughed in 1991 and 1996 and the other left undisturbed. Soil from the site was kept in pots under six water regimes, from dry to flooded, and 27 of 34 species showed a significant response, each giving a germination optimum. Vegetation surveys between 1990 and 1999 gave each species’ position along the field’s water-level gradient. The two correlated: the rank correlation was 0.76 in the ploughed half (18 species) and 0.59 in the undisturbed half (20 species). The paper explains the slightly stronger match in the ploughed half by the experiment’s mixed soil resembling ploughed ground, whereas succession and competition weigh more where the soil was undisturbed. It reports this difference as significant for one of the two measures it compares. \par The paper states that the results are consistent with two readings: recruitment dominates community composition along the gradient, or recruitment and adult niches are very similar in these wetland communities. Limits remain: only about 40% of the species seen in the field germinated in the experiment, and the evidence comes from one site. The paper argues that recognising the recruitment niche and disturbance is needed to predict community composition, and that this may improve restoration decisions and projections under environmental change.},
  significance_refs = {10.1111/j.1469-185X.1977.tb01347.x},
  license = {CC BY 4.0},
  funding = {Geschwister Stauder Foundation of the University of Hohenheim},
}

@article{bugmann2019tree,
  author  = {Bugmann, Harald and Seidl, Rupert and Hartig, Florian and Bohn, Friedrich and Brůna, Josef and Cailleret, Maxime and Fran{\c{c}}ois, Louis and Heinke, Jens and Henrot, Alexandra-Jane and Hickler, Thomas and H{\"u}lsmann, Lisa and Huth, Andreas and Jacquemin, Ingrid and Kollas, Chris and Lasch-Born, Petra and Lexer, Manfred J. and Mergani{\v c}, J{\'a}n and Mergani{\v c}ov{\'a}, Katar{\'i}na and Mette, Tobias and Miranda, Brian R. and Nadal-Sala, Daniel and Rammer, Werner and Rammig, Anja and Reineking, Bj{\"o}rn and Roedig, Edna and Sabat{\'e}, Santi and Steinkamp, J{\"o}rg and Suckow, Felicitas and Vacchiano, Giorgio and Wild, Jan and Xu, Chonggang and Reyer, Christopher P. O.},
  title   = {Tree mortality submodels drive simulated long-term forest dynamics: assessing 15 models from the stand to global scale},
  journal = {Ecosphere},
  year    = {2019},
  volume  = {10},
  number  = {2},
  pages   = {e02616},
  doi     = {10.1002/ecs2.2616},
  abstract = {Models are pivotal for assessing future forest dynamics under the impacts of changing climate and management practices, incorporating representations of tree growth, mortality, and regeneration. Quantitative studies on the importance of mortality submodels are scarce. We evaluated 15 dynamic vegetation models (DVMs) regarding their sensitivity to different formulations of tree mortality under different degrees of climate change. The set of models comprised eight DVMs at the stand scale, three at the landscape scale, and four typically applied at the continental to global scale. Some incorporate empirically derived mortality models, and others are based on experimental data, whereas still others are based on theoretical reasoning. Each DVM was run with at least two alternative mortality submodels. Model behavior was evaluated against empirical time series data, and then, the models were subjected to different scenarios of climate change. Most DVMs matched empirical data quite well, irrespective of the mortality submodel that was used. However, mortality submodels that performed in a very similar manner against past data often led to sharply different trajectories of forest dynamics under future climate change. Most DVMs featured high sensitivity to the mortality submodel, with deviations of basal area and stem numbers on the order of 10–40% per century under current climate and 20–170% under climate change. The sensitivity of a given DVM to scenarios of climate change, however, was typically lower by a factor of two to three. We conclude that (1) mortality is one of the most uncertain processes when it comes to assessing forest response to climate change, and (2) more data and a better process understanding of tree mortality are needed to improve the robustness of simulated future forest dynamics. Our study highlights that comparing several alternative mortality formulations in DVMs provides valuable insights into the effects of process uncertainties on simulated future forest dynamics.},
  significance = {Dynamic vegetation models, which simulate how forests develop over decades to centuries, are used to project climate-change effects. Growth alone would change forests fairly smoothly, but mortality could bring fast, strong change. Models represent tree death with theoretical, empirical (fitted to inventory data) or highly mechanistic formulations; which is right cannot be decided in advance, and past data typically cover only a few decades. Sensitivity to mortality had been tested only in a fairly small number of case studies. The paper asks how large the uncertainty from the mortality formulation is, across model types and relative to climate change itself, when past data usually cannot decide between formulations. \par The paper argues that the formulation of tree mortality in dynamic vegetation models is a major source of uncertainty in projected forest dynamics, and that agreement with past data does not resolve it. It ran 15 models (eight at stand, three at landscape, four at continental to global scale), each with at least two mortality formulations. Where models could be tested against long inventory series (six of the 15), most matched the records under either formulation, yet equally good fits often diverged sharply under climate change. In the stand-scale models, the sensitivity of basal area (tree cross-section per area) and stem numbers to the mortality formulation was at least of the same order of magnitude as their sensitivity to the climate scenario. In many stand-scale models, sensitivity rose with the severity of climate change and was highest in the models built on empirical formulations, some of which the paper considers likely to be applied beyond their calibration range. The three landscape-scale models were less sensitive to the mortality formulation and, unlike the stand-scale models, more to climate; the paper does not generalise from so few, whose alternative formulations were structurally similar. \par For about a century ahead, the formulations mostly gave similar trajectories, which the paper reads as good news for management planning. For longer horizons, such as the role of forests in the carbon cycle, using a single mortality formulation understates uncertainty. The paper suggests several conceptually different formulations or formal sensitivity analysis, calls for calibration against multiple data sources, and for more mortality data.},
  license = {CC BY 4.0},
  funding = {COST Action FP1304 PROFOUND, supported by COST (European Cooperation in Science and Technology); Austrian Science Fund FWF (START Grant) (Y895-B25); German Federal Ministry of Education and Research (BMBF) (01LS1201A1); German Federal Office for Agriculture and Food (BLE) (2816ERA06S); The Czech Academy of Sciences, long-term research and development project (RVO 67985939); Ministry of Education, Youth and Sports (LD15158); Slovak Research and Development Agency (APVV-0480-12)},
}

@article{panassiti2019temperature,
  author  = {Panassiti, Bernd and Sander, Nicolas and Mazzoni, Valerio and Fischnaller, Stefanie and Parth, Martin and Messner, Manuel and Janik, Katrin and Hartig, Florian},
  title   = {A temperature-based model for predicting the immigration of Cacopsylla melanoneura and C. picta, vectors of the apple proliferation disease, in South Tyrol, Northern Italy (Hemiptera: Psylloidea)},
  doi       = {10.25673/92148},
  license   = {CC BY-NC-ND 4.0},
  scholar_id = {ynsZFq2pu0MC},
  journal = {Cicadina},
  year    = {2019},
  volume  = {18},
  pages   = {1--11},
  url     = {https://public.bibliothek.uni-halle.de/index.php/cicadina/article/view/1789},
  abstract = {Insects in temperate regions usually emerge in spring, based on climatic cues. Temperature-based models that predict the first flight onset of pest insects in crop fields are therefore useful tools for agriculture and crop protection. Here, we calibrate and apply such a temperature-based model for Cacopsylla melanoneura and Cacopsylla picta (Hemiptera - Psyllidae) in South Tyrol, Northern Italy. These psyllid species are the main vectors of apple proliferation, an economically important phytoplasma disease. We found that the temperature associated with the onset (first presence) of the insects in the orchards differs between vectors and between different regions. For the regions Burggrafenamt and Vinschgau, the first adults of Cacopsylla melanoneura remigrants mostly occurred in January while first Cacopsylla picta remigrants mostly occurred in the orchard between March and April. The presented temperature-based immigration model may be used as a tool to predict the first vector appearance in apple orchards in South Tyrol.},
  significance = {Insects in temperate regions usually emerge in spring, triggered by climatic cues. Models that link temperature to the first appearance of a pest insect in crop fields are therefore useful for crop protection. Two psyllids, Cacopsylla melanoneura and C. picta, are the main vectors (carriers) of apple proliferation, an economically important phytoplasma (bacterial) disease of apple. The problem the paper takes on is that no model predicting when these two vectors first return to orchards existed for South Tyrol, Northern Italy; it applies and calibrates a temperature-threshold model for them. \par The study finds that the temperature threshold associated with the first presence of the two vectors in apple orchards differs clearly between the species and, tentatively, between the two regions analysed, Burggrafenamt and Vinschgau; thresholds were estimated separately for each species and region. In these regions, the model indicates that the first C. melanoneura remigrants (adults returning to the orchards) can appear as early as January, and the first C. picta remigrants mostly between March and April. \par The paper offers the immigration model as a possible tool for predicting when the vectors first appear in apple orchards in South Tyrol, but only after further calibration with more years of survey data. It covers only two regions and these two species.}
}

@article{bagnara2019r,
  author  = {Bagnara, Maurizio and Silveyra Gonzalez, Ramiro and Reifenberg, Stefan and Steinkamp, J{\"o}rg and Hickler, Thomas and Werner, Christian and Dormann, Carsten F. and Hartig, Florian},
  title   = {An R package facilitating sensitivity analysis, calibration and forward simulations with the LPJ-GUESS dynamic vegetation model},
  journal = {Environmental Modelling \& Software},
  year    = {2019},
  volume  = {111},
  pages   = {55--60},
  doi     = {10.1016/j.envsoft.2018.09.004},
  abstract = {Dynamic global vegetation models (DGVMs) are of crucial importance for understanding and predicting vegetation, carbon, nitrogen and water dynamics of ecosystems in response to climate change. Their complexity, however, creates challenges for model analysis and data integration. A solution is to interface DGVMs with established statistical computing environments. Here we introduce rLPJGUESS, an R-package that couples the widely used DGVM LPJ-GUESS with the R environment for statistical computing, making existing R-packages and functions readily available to perform complex analyses with this model. We demonstrate the advantages of this framework by using rLPJGUESS to perform several otherwise laborious tasks: first, a set of single simulations, followed by global and local sensitivity analyses, a Bayesian calibration with a Markov-Chain Monte Carlo (MCMC) algorithm, and a predictive simulation with multiple climate scenarios. Our example highlights the opportunities of interfacing existing models in earth and environmental sciences with state-of-the-art computing environments such as R.},
  significance = {Dynamic global vegetation models (DGVMs) are process-based simulators of how vegetation and the carbon, nitrogen and water cycles of ecosystems respond to climate change. They are complex and often slow, so studying them takes very many runs: sensitivity analysis (finding which parameters matter), Bayesian calibration (fitting parameters to data while quantifying uncertainty) and uncertainty propagation need thousands to millions of simulations. The statistical methods for this are well known and available in R, MATLAB and Python, yet they are rarely applied to DGVMs. The paper states that, in the authors’ experience, an important reason is the work of connecting models written in lower-level languages such as C/C++ or Fortran to statistical software. \par The paper presents rLPJGUESS, an R package that runs the vegetation model LPJ-GUESS from within the statistical software R, and argues that this lets researchers use existing R tools for demanding model analyses with little coding. Model set-up, simulation and output collection all happen in R, and runs can be spread over many processors on a personal computer, a server or a computing cluster. A case study on one forest site in Germany, using weather data from Erfurt and analysing beech, carries out the whole workflow. Screening 57 parameters with a one-at-a-time and a global (Morris) sensitivity analysis took about 5 and 15 minutes using parallel runs. A Bayesian calibration of the 16 most influential parameters with a Markov chain Monte Carlo sampler returned parameter values close to those used to generate the (model-generated) reference data; it took about 118 hours without parallelisation. Ten climate scenarios were then simulated in about 5 seconds on 10 processor cores. Because the reference data were themselves model output, the calibration shows that the workflow works, not that the model fits real observations. \par The paper concludes that coupling LPJ-GUESS to R will make it easier to study the model systematically and will facilitate a better integration of the model with data, and that the approach could be adopted for other vegetation models and even other model classes, such as climate or hydrological models. Breier et al. (2024) cite it when presenting an R toolkit for the vegetation model LPJmL, noting that LPJ-GUESS, unlike LPJmL, already had such an interface.},
  significance_refs = {10.21105/joss.05447},
  license = {publisher (subscription)},
  funding = {Deutsche Forschungsgemeinschaft (DO 786/8–1)},
}

% ------------------------------------------------------------------ 2018 ----

@article{hulsmann2018comment,
  author  = {H{\"u}lsmann, Lisa and Hartig, Florian},
  title   = {Comment on ``Plant diversity increases with the strength of negative density dependence at the global scale''},
  journal = {Science},
  year    = {2018},
  volume  = {360},
  number  = {6391},
  pages   = {eaar2435},
  doi     = {10.1126/science.aar2435},
  abstract = {LaManna et al. (Reports, 30 June 2017, p. 1389) claim that subadult trees are proportionally less common at high conspecific adult density (CNDD) and that this effect increases toward the tropics and for rare species. We show that the CNDD-abundance correlation may have arisen from a methodological artifact and that a range of processes can explain the reported latitudinal pattern.},
  significance = {Conspecific negative density dependence (CNDD) means that a tree species does worse where its own adults are common. It has long been discussed as a mechanism that keeps many tree species together. LaManna et al. (2017) tested it in 24 forest plots. In small quadrats they related recruits (young trees) to adults of the same species and reported that the recruit/adult ratio falls more steeply with adult density towards the tropics and for rare species. They checked for bias with simulations and null models (simulated data without CNDD), but their method assumes that, without CNDD, recruit and adult numbers are proportional, that is, that young trees stay spatially coupled to adults. The comment examines this assumption. \par The comment argues that the stronger negative density dependence reported by LaManna et al. (2017) towards the tropics and for rare species may be an artefact of how it was estimated. In simulations without density dependence, seed dispersal, adult mortality or habitat preferences broke the coupling between recruits and adults and produced density-dependence estimates and a correlation with rarity compatible with those reported. The comment traces part of this to quadrats with recruits but no adults: one model assigned them an artificial background adult density, the other added 1 to every count, and both distort recruit/adult ratios, most strongly for rare species. Allowing each species its own baseline ratio removed the correlation with rarity, in simulated data and in the Barro Colorado Island plot. The original null models were too limited to rule this out: they included only dispersal, at unrealistically low levels. \par The comment concludes that the reported patterns are not strong evidence for density dependence that increases towards the tropics or with rarity, although this does not prove such patterns absent. It regards it as far more likely that other processes, possibly together with CNDD but not primarily driven by it, are responsible, for example weak spatial association between adults and recruits in the tropics (which breaks the assumed proportionality) or latitudinal differences in tree size structure (not examined further, as the original data were not fully available). Because a reliable correction of the original analysis seems nearly impossible, it holds that analysing density dependence in the growth and mortality of saplings, less affected by dispersal, seems far more promising.},
  significance_refs = {10.1126/science.aam5678},
  license = {publisher (subscription)},
}

@article{fassnacht2018using,
  author  = {Fassnacht, Fabian Ewald and Latifi, Hooman and Hartig, Florian},
  title   = {Using synthetic data to evaluate the benefits of large field plots for forest biomass estimation with LiDAR},
  journal = {Remote Sensing of Environment},
  year    = {2018},
  volume  = {213},
  pages   = {115--128},
  doi     = {10.1016/j.rse.2018.05.007},
  abstract = {With the maturation of methods for estimating aboveground forest biomass by remote sensing, researchers increasingly need test data, particularly ground reference data, that are large enough to fine-tune existing approaches and test their robustness under diverse conditions. In this context, realistic synthetic datasets present an interesting alternative to costly and limited field data. Here, we present a new approach to simulate realistic canopy height and cover type data by combining an individual-tree forest simulator with real LiDAR point clouds of individual trees. We demonstrate the utility of our approach by re-examining the influence of field plot size on the predictive power of remote-sensing models for biomass estimation. Our approach with a complete (wall-to-wall) field reference dataset and matching synthetic remote sensing data allowed us to not only perform internal cross-validations with field plots that were used to fit the model (as in studies with real data), but to also consider the quality of model predictions to a standardized spatial grid or to the entire region. Our results confirm earlier reports of smaller predictive errors with increased field plot sizes under internal model validation (RMSE of 125 t/ha at 10 m field plot size and RMSE of 40 t/ha for 50 m field plots). However, we show that this is mainly an artifact of comparing the models with the same data they were fit, thus with validation data of different scales. When validating on a grid with standardized scale, smaller field plots performed almost equally well as larger field plots (small RMSE decrease between 4 t/ha and 7 t/ha when going from 10 m to 50 m plots), and even outperformed them if we assumed that increasing the plot size means that fewer field plots can be obtained (small RMSE increase between 9 t/ha and 12 t/ha when going from 10 m to 50 m plots). We conclude that synthetic remote sensing datasets are a useful tool for method testing. The suggested approach may be used to reexamine our current methodological understanding, which is often based on tests with real data of very limited sizes, as well as to optimize workflows, model choices and data collection. A wider use of synthetic data could be instrumental in improving remote sensing methodology.},
  significance = {Maps of forest biomass (the aboveground mass of trees per hectare) are often made from airborne laser scanning (LiDAR), with a statistical model calibrated on field plots measured on the ground. Such plots are costly: real studies often have fewer than 100, and ordinary forest inventories were not designed for this purpose. Advice on field campaigns therefore rests on small datasets in which the true biomass is never fully known. Simulating the laser signal could help, but ray-tracing simulators are computationally expensive and have mostly used simple crown shapes. The gap the paper addresses is that large, realistic test datasets with a complete, known reference are missing. \par The paper shows that the reported advantage of larger field plots for LiDAR-based forest biomass models largely disappears when all models are tested on the same 50 m grid, and that synthetic data make such a re-test possible. The study places real LiDAR point clouds of single beech and pine trees at the tree positions produced by an individual-tree forest growth simulator, which gives a complete biomass reference for the whole forest. When each model is validated on plots of its own size the prediction error falls from about 125 t/ha for 10 m plots to about 40 t/ha for 50 m plots. When every model is instead evaluated on the same 50 m grid, the gain from larger plots shrinks to 4–7 t/ha. For a fixed total sampled area, larger plots mean fewer plots; then small plots do slightly better (by 9–12 t/ha), chiefly because they give more plots. The study attributes the earlier benefit mainly to unequal validation, presumably because small plots are more variable and so harder to predict. \par In the simulated setting (two tree species, no positional mismatch between field and laser data), small to medium plots can be as good as or better than large ones at a fixed sampled area (a stand-in for a fixed field budget), contrary to earlier work favouring large plots, including a meta-analysis of 48 studies (Zolkos et al. 2013). The study notes that real forests may differ and that plot shape, model type and sensor settings remain to be tested. It also argues that synthetic datasets with a complete reference help to re-examine methodological beliefs, and it provides the workflow as R scripts.},
  significance_refs = {10.1016/j.rse.2012.10.017},
  license = {publisher (subscription)},
  funding = {Fulbright visiting scholar program (F.E.F., research stay)},
}

@article{dormann2018model,
  author  = {Dormann, Carsten F. and Calabrese, Justin M. and Guillera-Arroita, Gurutzeta and Matechou, Eleni and Bahn, Volker and Barto{\'n}, Kamil and Beale, Colin M. and Ciuti, Simone and Elith, Jane and Gerstner, Katharina and Guelat, J{\'e}r{\^o}me and Keil, Petr and Lahoz-Monfort, Jos{\'e} J. and Pollock, Laura J. and Reineking, Bj{\"o}rn and Roberts, David R. and Schr{\"o}der, Boris and Thuiller, Wilfried and Warton, David I. and Wintle, Brendan A. and Wood, Simon N. and W{\"u}est, Rafael O. and Hartig, Florian},
  title   = {Model averaging in ecology: a review of Bayesian, information-theoretic, and tactical approaches for predictive inference},
  journal = {Ecological Monographs},
  year    = {2018},
  volume  = {88},
  number  = {4},
  pages   = {485--504},
  doi     = {10.1002/ecm.1309},
  preprint = {https://www.biom.uni-freiburg.de/mitarbeiter/dormann/dormann2018ecolmono-preprintversion.pdf},
  abstract = {In ecology, the true causal structure for a given problem is often not known, and several plausible models and thus model predictions exist. It has been claimed that using weighted averages of these models can reduce prediction error, as well as better reflect model selection uncertainty. These claims, however, are often demonstrated by isolated examples. Analysts must better understand under which conditions model averaging can improve predictions and their uncertainty estimates. Moreover, a large range of different model averaging methods exists, raising the question of how they differ in their behaviour and performance. Here, we review the mathematical foundations of model averaging along with the diversity of approaches available. We explain that the error in model‐averaged predictions depends on each model's predictive bias and variance, as well as the covariance in predictions between models, and uncertainty about model weights. We show that model averaging is particularly useful if the predictive error of contributing model predictions is dominated by variance, and if the covariance between models is low. For noisy data, which predominate in ecology, these conditions will often be met. Many different methods to derive averaging weights exist, from Bayesian over information‐theoretical to cross‐validation optimized and resampling approaches. A general recommendation is difficult, because the performance of methods is often context dependent. Importantly, estimating weights creates some additional uncertainty. As a result, estimated model weights may not always outperform arbitrary fixed weights, such as equal weights for all models. When averaging a set of models with many inadequate models, however, estimating model weights will typically be superior to equal weights. We also investigate the quality of the confidence intervals calculated for model‐averaged predictions, showing that they differ greatly in behaviour and seldom manage to achieve nominal coverage. Our overall recommendations stress the importance of non‐parametric methods such as cross‐validation for a reliable uncertainty quantification of model‐averaged predictions.},
  significance = {When several plausible models of an ecological system exist and none can be shown to be the true one, ecologists often average their predictions instead of picking a single model. The practice rests on two claims: that the average errs less than the individual models, and that it carries the uncertainty about which model is right into the prediction. Both were often supported by isolated examples. Several earlier reviews covered only weights derived from Akaike’s information criterion (AIC), and no review had covered the many other ways of setting weights and of putting intervals around averaged predictions together. The paper asks when averaging improves predictions, and how weights and uncertainty should be obtained. \par Whether averaging improves ecological predictions, this review shows, depends on how the errors of the averaged models are structured. It splits the squared error of an averaged prediction into the models’ bias (systematic error that persists with new data), their variance (scatter of predictions across new datasets), the covariance between their predictions (how far their predictions vary together) and the extra variance from estimating weights from data. Averaging helps mainly when errors are dominated by variance and predictions are only weakly correlated, because then errors partly cancel; a bias that the models share is not averaged away. Estimated weights do not always beat equal weights, although they typically do when many of the models are inadequate. Neither Bayesian nor AIC-based weights are designed to minimise prediction error, and the usual analytical confidence intervals for averaged predictions rarely reach their nominal coverage: they contain the true value less often than the stated percentage promises. \par The review concludes that model averaging is a conditional tool, not a default improvement. Its gain should be checked against simple benchmarks, such as the best single model or equal weights. Weights and uncertainty should come from validation on held-out data, through cross-validation or stacking (which chooses weights to minimise the averaged prediction’s error on held-out data), and studies should report the weights and the uncertainty of the predictions – recommendations the authors present as reducing harm rather than as an optimal solution. A later comparison of ensembles of species distribution models found them not consistently better than their untuned component models (Hao et al. 2020).},
  significance_refs = {10.1111/ecog.04890},
  license = {publisher (subscription)},
  funding = {German Science Foundation (DFG), workshop 'Model averaging in Ecology' (DO 786/9-1); DFG (research stay of CFD at University of Melbourne) (DO 786/10-1); DFG (to BS) (SCHR1000/6-2; SCHR1000/8-2); Australian Research Council (ARC) Future Fellowship (to DIW) (FT120100501); Alexander von Humboldt Foundation through the German Federal Ministry of Education and Research (to DRR); ARC Discovery Early Career Research Award (to GGA) (DE160100904); ARC (to JE) (FT0991640; DP160101003); Australia's National Environmental Research Program (NERP) Environmental Decisions Hub (to JJLM); ARC (to JJLM) (DP160101003); National Science Center (to KB) (DEC-2015/16/S/NZ8/00158); German Federal Ministry of Education and Research (BMBF) (to KG) (01LL0901A); European Research Council, European Community's FP7/2007-2013 (TEEMBIO) (to WT) (281422)},
  featured = {true},
}

@article{dormann2018biotic,
  author  = {Dormann, Carsten F. and Bobrowski, Maria and Dehling, D. Matthias and Harris, David J. and Hartig, Florian and Lischke, Heike and Moretti, Marco D. and Pagel, J{\"o}rn and Pinkert, Stefan and Schleuning, Matthias and Schmidt, Susanne I. and Sheppard, Christine S. and Steinbauer, Manuel J. and Zeuss, Dirk and Kraan, Casper},
  title   = {Biotic interactions in species distribution modelling: 10 questions to guide interpretation and avoid false conclusions},
  journal = {Global Ecology and Biogeography},
  year    = {2018},
  volume  = {27},
  number  = {9},
  pages   = {1004--1016},
  doi     = {10.1111/geb.12759},
  abstract = {Aim: Recent studies increasingly use statistical methods to infer biotic interactions from co‐occurrence information at a large spatial scale. However, disentangling biotic interactions from other factors that can affect co‐occurrence patterns at the macroscale is a major challenge. Approach: We present a set of questions that analysts and reviewers should ask to avoid erroneously attributing species association patterns to biotic interactions. Our questions relate to the appropriateness of data and models, the causality behind a correlative signal, and the problems associated with static data from dynamic systems. We summarize caveats reported by macroecological studies of biotic interactions and examine whether conclusions on the presence of biotic interactions are supported by the modelling approaches used. Findings: Irrespective of the method used, studies that set out to test for biotic interactions find statistical associations in species’ co‐occurrences. Yet, when compared with our list of questions, few purported interpretations of such associations as biotic interactions hold up to scrutiny. This does not dismiss the presence or importance of biotic interactions, but it highlights the risk of too lenient interpretation of the data. Combining model results with information from experiments and functional traits that are relevant for the biotic interaction of interest might strengthen conclusions. Main conclusions: Moving from species‐ to community‐level models, including biotic interactions among species, is of great importance for process‐based understanding and forecasting ecological responses. We hope that our questions will help to improve these models and facilitate the interpretation of their results. In essence, we conclude that ecologists have to recognize that a species association pattern in joint species distribution models will be driven not only by real biotic interactions, but also by shared habitat preferences, common migration history, phylogenetic history and shared response to missing environmental drivers, which specifically need to be discussed and, if possible, integrated into models.},
  significance = {Species ranges reflect the environment, dispersal, history and interactions with other organisms, and there is growing interest in detecting the last from large-scale data on which species occur together. Joint species distribution models (jSDMs) set each species’ baseline from the abiotic environment and look for interactions in the residuals, the associations left over once the environment is accounted for (Pollock et al. 2014). In principle this should be more robust, because it can rule out some explanations based on shared environmental requirements. The assumption the paper takes on is that such a leftover association can be read as a biotic interaction. \par The paper argues that species associations found in large-scale co-occurrence data, including those left over in joint species distribution models, cannot be read as biotic interactions without further evidence, because other causes can produce the same pattern. The difficulty lies less in the statistics than in how their results are interpreted. Such causes and complications include missing environmental predictors, interactions that depend on the environment, shared phylogenetic history, dispersal limitation, temporal dynamics and food-web context. The paper condenses this into ten questions for analysts and reviewers, on data and models, confounding with the environment, and snapshots of changing populations. One simulated example illustrates the point: two shrub species suppress each other yet often occur together, which would normally suggest facilitation, because a tree species left out of the analysis confines both to the same habitats. The paper also scanned published studies on biotic interactions in species distribution models and reports that associations turned up whatever the method, but that few interpretations of them as biotic interactions held up against the questions. \par The paper does not dismiss biotic interactions, and it calls the move from species-level to community-level models important for understanding processes and forecasting. It advises careful, sceptical interpretation: at present, it sees model results as most promising for generating hypotheses, and it holds that the burden of proof lies with whoever claims an interaction. The paper suggests that claims might be strengthened by comparison with alternative hypotheses and independent data sets and by support from experiments and from species traits relevant to the interaction. The questions turn caveats raised in earlier work into concrete suggestions for interpreting and reporting results.},
  significance_refs = {10.1111/2041-210x.12180},
  license = {publisher (subscription)},
  funding = {German Research Foundation (DFG) (DO786/10-1; SH 924/1-1; DE 2754/1-1); EU Marie Skłodowska-Curie action (700796; 707491); Danish Carlsbergfondet (CF14-0148); Ministerium für Wissenschaft, Weiterbildung und Kultur Rheinland-Pfalz (Research initiative, project AufLand)},
}

@article{fasiolo2018extended,
  author  = {Fasiolo, Matteo and Wood, Simon N. and Hartig, Florian and Bravington, Mark V.},
  title   = {An extended empirical saddlepoint approximation for intractable likelihoods},
  journal = {Electronic Journal of Statistics},
  year    = {2018},
  volume  = {12},
  number  = {1},
  pages   = {1544--1578},
  doi     = {10.1214/18-EJS1433},
  abstract = {The challenges posed by complex stochastic models used in computational ecology, biology and genetics have stimulated the development of approximate approaches to statistical inference. Here we focus on Synthetic Likelihood (SL), a procedure that reduces the observed and simulated data to a set of summary statistics, and quantifies the discrepancy between them through a synthetic likelihood function. SL requires little tuning, but it relies on the approximate normality of the summary statistics. We relax this assumption by proposing a novel, more flexible, density estimator: the Extended Empirical Saddlepoint approximation. In addition to proving the consistency of SL, under either the new or the Gaussian density estimator, we illustrate the method using three examples. One of these is a complex individual-based forest model for which SL offers one of the few practical possibilities for statistical inference. The examples show that the new density estimator is able to capture large departures from normality, while being scalable to high dimensions, and this in turn leads to more accurate parameter estimates, relative to the Gaussian alternative. The new density estimator is implemented by the esaddle R package, which is freely available on the Comprehensive R Archive Network (CRAN).},
  significance = {Many simulation models have no computable likelihood, which rules out standard fitting. Synthetic likelihood (Wood 2010) works around this by reducing observed and simulated data to a few summary statistics and comparing them through a likelihood built from the simulations. It needs much less tuning than approximate Bayesian computation (ABC) but it assumes that the summary statistics are approximately multivariate normal. This assumption can be problematic, and transformations that make statistics normal are hard to find for all parameter values. The paper sets out to drop the normality requirement while keeping the method’s scalability. \par The paper shows that synthetic likelihood can do without its normality assumption by using a more flexible density estimator for the summary statistics. The new estimator, the extended empirical saddlepoint (EES) density, is built directly from the simulated statistics and blended with a Gaussian one (mixing the two at the level of the cumulant generating function), so that it is defined even for values outside the range spanned by the simulations. One parameter sets the blend and is chosen by cross-validation, that is, by testing on held-out simulations. The paper proves that maximising the synthetic likelihood yields consistent parameter estimates under either the new or the Gaussian density, under stated regularity conditions. In a boom-and-bust population model and in the forest model Formind (with deliberately strongly skewed statistics), EES-based synthetic likelihood gave lower estimation errors than the Gaussian version; in the population model it also gave lower errors than ABC for three of the four parameters. In a toy example, the paper argues from an analytical calculation that ABC would need rapidly growing effort to match EES as the number of statistics rises. \par The results mean that where summary statistics are clearly non-normal, synthetic likelihood can give more accurate estimates, which, the paper argues, frees users to concentrate on choosing informative statistics. The paper names two open points: whether extra assumptions would allow conclusions about the efficiency of the estimates, and whether one Gaussian-process speed-up, which models only the first two moments, can take higher moments into account. The method is available in the R package esaddle. An et al. (2020) built a Bayesian version and, in their test examples, found a semi-parametric alternative of their own to be mostly more accurate.},
  significance_refs = {10.1038/nature09319 10.1007/s11222-019-09904-x},
  license = {CC BY 4.0},
  funding = {EPSRC (Engineering and Physical Sciences Research Council) (EP/I000917/1; EP/K005251/1)},
}

@article{reisch2018comparison,
  author  = {Reisch, Christoph and Schmid, Christoph and Hartig, Florian},
  title   = {A comparison of methods for estimating plant population size},
  journal = {Biodiversity and Conservation},
  year    = {2018},
  volume  = {27},
  number  = {8},
  pages   = {2021--2028},
  doi     = {10.1007/s10531-018-1522-1},
  abstract = {Assessing local population size is one of the most common tasks in biodiversity monitoring. Population size estimates are not only important for conservation management and population threat assessment; they also enter many other analyses in landscape ecology and conservation. It is therefore concerning that methods for estimating plant population sizes are not standardized. We surveyed the literature and found that the most commonly used methods are counting either all or only flowering individuals on a site, as well as counting individuals in random plots or plots on transects. Sometimes, these methods are combined in the same study, without assurance that they produce comparable results. We therefore conducted a field study, in which we obtained population size estimates from all four methods for six different calcareous grassland species at 18 study sites. Our results demonstrate not only substantial differences between overall count rates generated by the different methods, but methods that surveyed the whole population also systematically yielded lower counts when species were less visible and when the area was larger, suggesting that these methods suffer from biases that could distort species and site comparisons. We conclude that estimates from different methods should not be mixed, and that plot or transect based surveys have likely smaller biases for large areas or poorly visible individuals, and are therefore preferable.},
  significance = {Counting the individuals of a plant population is a routine task in ecology and conservation. Population size is linked to genetic variation and extinction risk and feeds into monitoring and conservation law. Yet no standard method exists. A survey of 143 studies found that a third gave no details of their method, that nearly half counted or estimated the individuals on the whole site (all plants, or only flowering ones), and that a few counted in sample plots or along transects and scaled up to the site area. Studies sometimes mix methods without assurance that they give comparable results. Such mixing is only safe if the methods agree, and the paper asks whether they do, and whether their errors depend on the species or the site, which would distort comparisons even within one study. \par The paper argues that the common methods for estimating plant population size are not interchangeable and that whole-site counts are probably biased, in ways that depend on the species and the site. The study estimated the population size of six grassland species at 18 sites near Regensburg with four methods: counting all individuals or only flowering ones on the whole site, and counting in random squares or along transects and multiplying by the site area. Whole-site counts were roughly ten times lower than plot-based estimates, lower for less conspicuous species, and estimated density fell as sites got larger, whereas for plot-based estimates density showed no significant change with area (estimates were on average proportional to it). Because true population sizes were unknown, the analysis can show only that the methods differ. The authors judge it highly likely that the whole-site counts are the biased ones, in line with Keith (2000), who had suggested that counting all individuals underestimates population size at large sites. \par Estimates from different methods should not be mixed, since this can lead to wrong conclusions. Whole-site counts can distort comparisons between species and sites, so the paper recommends plot-based methods for situations like the one studied. It adds that in less dense habitats with easily recognised plants, whole-site counts could do as well, which it leaves for further study. Perret et al. (2023), a study of how often observers miss plants when counting in quadrats, cite the paper.},
  significance_refs = {10.1046/j.1442-8903.2000.00034.x 10.1111/1365-2745.14110},
  license = {publisher (subscription)},
}

@article{marques2018last,
  author  = {Marqués, Laura and Madrigal-González, Jaime and Zavala, Miguel A. and Camarero, Jesús Julio and Hartig, Florian},
  title   = {Last-century forest productivity in a managed dry-edge Scots pine population: the two sides of climate warming},
  journal = {Ecological Applications},
  year    = {2018},
  volume  = {28},
  number  = {1},
  pages   = {95--105},
  doi     = {10.1002/eap.1631},
  abstract = {Climate change in the Mediterranean, associated with warmer temperatures and more frequent droughts, is expected to impact forest productivity and the functioning of forests ecosystems as carbon reservoirs in the region. Climate warming can positively affect forest growth by extending the growing season, whereas increasing summer drought generally reduces forest productivity and may cause growth decline, trigger dieback, hamper regeneration, and increase mortality. Forest management could potentially counteract such negative effects by reducing stand density and thereby competition for water. The effectiveness of such interventions, however, has so far mostly been evaluated for short time periods at the tree and stand levels, which limits our confidence regarding the efficacy of thinning interventions over longer time scales under the complex interplay between climate, stand structure, and forest management. In this study, we use a century‐long historical data set to assess the effects of climate and management on forest productivity. We consider rear‐edge Scots pine (Pinus sylvestris) populations covering continental and Mediterranean conditions along an altitudinal gradient in Central Spain. We use linear mixed‐effects models to disentangle the effects of altitude, climate, and stand volume on forest growth and ingrowth (recruitment and young trees’ growth). We find that warming tends to benefit these tree populations, warmer winter temperature has a significant positive effect on both forest growth and ingrowth, and the effect is more pronounced at low elevations. However, drought conditions severely reduce growth and ingrowth, in particular when competition (stand volume) is high. We conclude that summer droughts are the main threat to Scots pine populations in the region, and that a reduction of stand volume can partially mitigate the negative impacts of more arid conditions. Mitigation and adaptation measures could therefore manage stand structure to adopt for the anticipated impacts of climate change in Mediterranean forest ecosystems.},
  significance = {Climate warming can help forests and harm them at once. Warmer winters lengthen the growing season, whereas hotter, drier summers reduce growth and recruitment, especially at a species’ dry southern range edge. Thinning, which lowers the number of trees competing for water, is therefore proposed as a way to buffer drought. That evidence, however, comes mostly from short-term experiments and from tree-level studies, while tree-ring records, which span long periods, often lack information on past management. The open question is whether management changes how climate affects forest productivity over a century and across a whole forest, not only in single trees or short trials. \par The paper shows that warming has two sides for a Scots pine forest at the dry edge of the species’ range: warmer winters raised growth and recruitment, whereas the harm done by dry summers increased with stand volume, the wood standing per hectare, which management controls. The study digitises ten-yearly forest inventories from 1896 to 2008 for 45 stands of one managed forest in the Guadarrama mountains of central Spain, at 1,300 to 2,000 m. With linear mixed models, it relates growth (the increase in wood volume of adult trees) and ingrowth (new trees above 20 cm trunk diameter, a measure of recruitment) to winter temperature, a summer drought index, altitude and the stand volume of the previous decade. Warmer winters raised both, unexpectedly more at low than at high elevation, a pattern the authors consider possibly spurious. Stand volume mattered most in dry summers: in wet summers it was nearly inconsequential, whereas in dry ones growth and ingrowth fell markedly as volume increased. \par The study concludes that summer drought is the main threat to these populations and that keeping stand volume low can partly offset it, so stand structure is a lever for adapting forests to a drier climate. It also suggests that the moderate, long-rotation shelterwood cutting practised in this forest is effective in reducing competition, so strong and frequent thinning, which other work presents as necessary, is not the only effective option. The evidence has limits: it covers one forest, has ten-yearly resolution, includes no mortality data, and the fixed effects (climate, altitude, stand volume) explain only about 10% of the variance in growth and 30% in ingrowth.},
  license = {publisher (subscription)},
  funding = {EU COST ACTION FP1304 PROFOUND; University of Alcala; VULPINECLIM (CGL-2013-44553-R); FUNDIVER (CGL2015-69186-C2-1-R); FUNDIVER (CGL2015-69186-C2-2-R)},
}

