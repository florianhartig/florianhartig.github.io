@article{hannappel2026local,
  author  = {Hannappel, Ira and Westphal, Catrin and Artola, Jordi and Cabodevilla, Xabier and Devalez, Jelle and Giralt, David and Hartig, Florian and Helm, Aveliina and Jacquemyn, Hans and Keller, Alexander and Kleijn, David and Libr{\'a}n-Embid, Felipe and Naagel, Laura and Reitalu, Triin and Traba, Juan and Velado-Alonso, Elena and Hass, Annika L.},
  title   = {Local management at low- to moderate-intensity benefits wild bees in European calcareous grasslands while landscape conservation effects vary},
  journal = {Journal of Applied Ecology},
  year    = {2026},
  volume  = {63},
  number  = {9},
  pages   = {e70580},
  doi     = {10.1111/1365-2664.70580},
  abstract = {Calcareous grasslands are important habitats for many pollinators including wild bees but have declined dramatically in habitat quantity and quality due to land use changes at local and landscape scale. Such developments might be mitigated by local management, such as low‐intensity land use and landscape measures, including the conservation of calcareous grasslands and the establishment of biodiversity‐friendly farming practices like agri‐environment schemes (AES). Yet, the effectiveness of these measures for conserving pollinator communities is still poorly explored and might depend, for example on the landscape context or the AES type (productive vs. non‐productive). Using transect walks, we investigated how local and landscape‐scale management affects bee communities in 96 calcareous grasslands in three European countries (Estonia, Germany, Spain), covering three biogeographic regions (boreal, continental, Mediterranean). Over a period of 2 years, we recorded 6716 individuals from 235 species across our study regions, underpinning the importance of calcareous grasslands for wild bee conservation. According to a local land use intensity index, we found that both long‐term abandonment and intensive management reduced wild bee species richness and abundance, either directly or indirectly through effects on floral resource availability. At the landscape scale, cover of calcareous grassland and AES in the surroundings benefited wild bee communities, though the effectiveness of AES often depended on the AES type and the landscape cover of calcareous grasslands. In Germany, for example productive AES increased wild bee abundance and richness only in landscapes with higher calcareous grassland cover, while non‐productive AES were most effective if landscape calcareous grassland cover was lower. However, landscape effects varied across study regions. Synthesis and applications. Conserving wild bee diversity in these grasslands requires avoiding long‐term abandonment and intensive management, while promoting local management at low to moderate intensity. Moreover, it is essential to conserve and restore calcareous grasslands in the surroundings. This may be complemented by implementing AES in the landscape, depending on the AES type, landscape and regional context. Our findings stress that future restoration and conservation planning should combine local and landscape management measures to successfully conserve wild bees in European calcareous grasslands.},
  significance = {In this study, led by Ira Hannappel, the authors survey wild bees over two years in 96 calcareous grasslands across Estonia, Germany and Spain and relate bee richness and abundance to a local gradient from long-term abandonment to intensive management and to the landscape cover of calcareous grassland and agri-environment schemes. Both long-term abandonment and intensive management reduced wild bee richness and abundance, directly or through fewer flowers, and in Spain, and similarly in Estonia, richness and abundance peaked at intermediate levels of management. Surrounding calcareous grassland benefited bees in two of the three regions, whereas the effects of agri-environment schemes depended on scheme type, landscape context and region. The authors conclude that low- to moderate-intensity local management needs to be combined with conserving and restoring grassland in the wider landscape, with measures adapted to regional conditions.},
  license = {CC BY 4.0},
  funding = {Biodiversa+ and Water JPI joint call (2020-2021), BiodivRestore ERA-NET Cofund, with the EU (GA N°101003777); Deutsche Forschungsgemeinschaft (DFG, German Research Foundation) (491739988); Estonian Research Council; Spanish Ministry of Science, Innovation and Universities; Spanish State Investigation Agency (PCI2022-132974 and PCI2022-132961); Belgian Science Policy (BelSPO) (B2/22E/InterRest); Deutsche Forschungsgemeinschaft (DFG), project number (C.W.) (493487387); Estonian Ministry of Education and Research, Centre of Excellence for Sustainable Land Use (A.H., T.R., J.D.) (TK232); Estonian Research Council (A.H., T.R., J.D.) (PRG874)},
}

@article{hurlbert2026evaluating,
  author  = {Hurlbert, Allen H. and Cabral, Juliano Sarmento and Etienne, Rampal S. and Hagen, Oskar and Huang, Shan and Jang, Yun-Ting and Janzen, Thijs and Machac, Antonin and Santos Neves, Pedro and Pontarp, Mikael and Storch, David and Xu, Liang and Hartig, Florian},
  title   = {Evaluating the Robustness of Process-Pattern Links Using Phylogenies—Insights from a Comparison of Eight Simulation Models},
  journal = {Systematic Biology},
  year    = {2026},
  pages   = {syag050},
  doi     = {10.1093/sysbio/syag050},
  abstract = {Macroevolutionary studies have shown that the shape of phylogenetic trees differs in space, time, and between taxa. It is commonly assumed that these differences in tree shape reflect variability in the underlying ecological and evolutionary processes that produced them, and mechanistic eco-evolutionary models are increasingly used to explore this link. A concern in this context is whether conclusions drawn from such mechanistic models are robust to idiosyncrasies in how eco-evolutionary processes are formalized in the models. Here, we use eight mechanistic macroevolutionary models to study how 52 metrics of phylogenetic tree shape respond to variation in the strength of five fundamental processes: competition, dispersal, environmental filtering, niche conservatism, and speciation. We find that models agree on how some tree metrics respond to changes in these processes, in particular dispersal and speciation. However, no tree metric uniquely correlated with a single process, suggesting that single tree metrics have limited utility as shortcuts for inferring the underlying eco-evolutionary processes. Moreover, although it was possible to infer the underlying processes if the data-generating model was known, inference was not consistent across the different models. We conclude that the relationship between phylogenetic patterns and eco-evolutionary processes in macroevolutionary analysis is likely sensitive to the structural and mechanistic details of how a given process is implemented within models.},
  significance = {The shape of phylogenetic trees, the branching family trees of species, differs between regions, periods and organism groups, and this variation is assumed to reflect the ecological and evolutionary processes that produced the trees. Simulation models that build in processes such as competition, dispersal, environmental filtering, niche conservatism and speciation are therefore used to link these processes to tree shape. Turning a verbal process concept into computer code requires many implementation choices (Pontarp et al. 2019), and their consequences are hard to anticipate. Earlier studies typically examined one or two processes and one or two tree metrics at a time. The paper takes on the open question of whether a link between process and tree shape, and any inference built on it, holds regardless of how the model is built. \par The paper finds that links between processes and phylogenetic tree shape differ between simulation models, which suggests that they are sensitive to how each model implements a process, so that inferences drawn with one model carry over poorly to another. It runs eight simulation models across varying strengths of five processes and describes the resulting trees with 52 summary metrics of tree shape. Only for speciation and dispersal do some metrics respond in the same direction in all models that include the process, and no metric responds to one process alone, so no single metric identifies a process. A random forest (a machine-learning method) that uses all metrics recovers process strength for trees from its own model (cross-validated R², the share of variation explained, mostly 0.2 to 0.9). Tested on trees from another model, it transfers less reliably: for speciation it works for several model pairs (not symmetrically), for dispersal mostly not, and for the other three processes generally poorly. For six sister-clade pairs of birds and mammals, the seven models that include speciation disagreed for some pairs on which clade has the higher speciation rate. \par Inferring processes from tree shape is therefore possible in principle, but apparently only if the model that generated the data is known. The paper cautions against generalising conclusions from any single simulation framework to real data. The paper recommends checking conclusions against several plausible models and suggests adding other information, such as spatial richness and abundance or trait distributions, as a possible way forward.},
  significance_refs = {10.1016/j.tree.2018.11.009},
  license = {publisher (subscription)},
  funding = {National Science Foundation (EF-1702708); Swiss National Science Foundation (P500PB_206815); German Research Foundation (202548816); Czech Science Foundation (23-05977S); Czech Science Foundation (25-18055S)},
}

@article{rubanschi2026impacts,
  author  = {Rubanschi, Sven and Lewerentz, Anne and Krause, Andreas and Blechschmidt, Jana and Fallert, Stefan and Gosling, Elizabeth and Gregor, Konstantin and Jarisch, Isabelle and Stetter, Christian and Br{\"o}nner, Maximilian and Hartig, Florian and Hoffmann, Markus and Kieslinger, Julia and Knoke, Thomas and Pohle, Perdita and Raeder, Uta and Reiss, Mona and Weisser, Wolfgang W. and Meyer, Sebastian T. and Sauer, Johannes and Cabral, Juliano Sarmento and Rammig, Anja},
  title   = {Impacts of climate change on biodiversity and ecosystems in Bavaria: a sectoral analysis},
  journal = {Regional Environmental Change},
  year    = {2026},
  volume  = {26},
  number  = {2},
  pages   = {95},
  doi     = {10.1007/s10113-026-02586-y},
  abstract = {Climate change is expected to create a range of impacts on biodiversity, land use, and economic activities, but those sector impacts are rarely analysed together. Here, we assess how climate change and socioeconomic narratives will affect land use and biodiversity in the state of Bavaria, Germany. We apply a multi-sectoral modelling approach with two climate projections (RCP 2.6 and 8.5) downscaled from three different climate models in combination with three land-use scenarios: biodiversity protection, climate change mitigation, and climate change adaptation. We evaluate changes in different sectors such as forestry and agriculture, considering impacts on carbon storage, terrestrial and aquatic biodiversity, and the adaptation of agricultural practices. In our simulations, biodiversity declined sharply under the higher emission scenario, highlighting climate change as a major threat to biodiversity in Bavaria. Prioritising biodiversity through forest conversion and expanding pasture reduced species decline and enhanced carbon storage more effectively than pure climate-focused mitigation. Climate change intensity had minimal impacts on land-use patterns (e.g. allocation of forest types), but it significantly changed farmers’ preferences, increasing their inclination toward more conservative land management practices, i.e. favouring the status quo. We conclude from our findings that policymakers should strategically prioritise biodiversity protection alongside targeted forest-management practices to simultaneously enhance ecosystem health, biodiversity, and carbon storage. Intensified agricultural and land management, on the other hand, should be approached cautiously to avoid biodiversity loss.},
  significance = {In this study, led by Sven Rubanschi, the authors link several sector models for Bavaria and combine a low- and a high-emission climate pathway with three land-use narratives, focused on biodiversity protection, climate change mitigation and climate change adaptation, to assess joint effects on land use, carbon storage, farmer decisions and terrestrial and aquatic biodiversity. In the simulations, the high-emission pathway caused marked biodiversity declines whatever the land-use scenario, while climate intensity had little effect on land-use patterns or carbon storage but shifted farmers towards keeping the status quo. The biodiversity-protection narrative, with forest conversion, reduced harvest and expanded pasture, limited species losses and stored more carbon than the mitigation-focused scenario, suggesting that biodiversity and climate goals can be pursued together. The authors present the results as a policy screening tool and note that biodiversity impacts are probably underestimated because incoming warm-adapted species were not simulated.},
  license = {CC BY 4.0},
  funding = {Projekt DEAL (open access funding); Bavarian Ministry of Science and the Arts, Bavarian Climate Research Network (bayklif), project BLIZ; Deutsche Forschungsgemeinschaft (DFG) through TUM International Graduate School of Science and Engineering (IGSSE) (S.R.) (GSC 81); DBU/Deutsche Bundesstiftung Umwelt (S.F.)},
}

@article{maskova2026hydrological,
  author  = {Ma{\v{s}}kov{\'a}, Tereza and Hartig, Florian and Poschlod, Peter},
  title   = {Hydrological recruitment niches of wetland plants are associated with dormancy, alternating temperature, and oxygen requirements},
  journal = {Basic and Applied Ecology},
  year    = {2026},
  volume  = {93},
  pages   = {52--62},
  doi     = {10.1016/j.baae.2026.04.004},
  abstract = {Permanently or seasonally flooded wetlands are hotspots for plant diversity. Their community composition usually depends strongly on hydrological conditions, suggesting that hydrology drives community assembly. However, the mechanisms underlying this effect are still not fully understood, and they could arise either through hydrological effects on reproduction, growth or mortality of plants. Here, we concentrate on the effect of hydrology on seed germination, also known as the recruitment niche. We investigated seed germination in sediments from eight localities in southern Germany, exposing them to four permanently and two temporarily flooded treatments and tested for the association of species' hydrological niches with their functional traits (type of dormancy, alternating temperature and oxygen requirements for germination). Our results show that hydrological conditions significantly affected species-specific germination. Interspecific variation in germination responses could be partly explained by seed physiological traits: non-dormant species were more likely to germinate in non-flooded hydrological treatments and species with alternating temperature and oxygen requirements exhibited higher germination in dry and wet treatments. The longer flooded conditions persisted, the more negatively they affected the germination of these species. Overall, we conclude that hydrological conditions have trait-mediated species-specific effects on seed germination, and that these effects likely contribute to the final community composition.},
  significance = {In this study, led by Tereza Mašková, the authors use germination experiments with sediments from eight wetland localities in southern Germany, exposed to permanent and temporary flooding treatments, to show that hydrological conditions shape which species recruit from seed. Seed physiological traits partly explained the differences: non-dormant species germinated more readily without flooding, whereas species requiring alternating temperatures and oxygen germinated better in dry and wet treatments and were increasingly suppressed the longer flooding lasted. The authors conclude that hydrology acts on germination in a trait-mediated, species-specific way that likely contributes to wetland community composition.},
  license = {CC BY 4.0},
}

@article{malchow2026calibration,
  author  = {Malchow, Anne-Kathleen and Hartig, Florian},
  title   = {Calibration, Sensitivity and Uncertainty Analysis of Complex Ecological Models—A Review},
  journal = {Ecology Letters},
  year    = {2026},
  volume  = {29},
  number  = {4},
  pages   = {e70375},
  preprint = {https://www.authorea.com/doi/full/10.22541/au.173090741.12160653/v1},
  doi     = {10.1111/ele.70375},
  abstract = {Ecologists increasingly use complex models to predict and understand ecological systems and their responses to external drivers or anthropogenic pressures. An ongoing challenge in this context is quantifying and reducing uncertainty in model inputs, parameters and structure and understanding their implications for model predictions. Three major methodological fields have emerged in this context: sensitivity analysis, uncertainty analysis and model inversion or calibration. While these three methods are an integral part of any modelling or forecasting process, the corresponding literature is often scattered, and distinct terminology and definitions are used in different methodological and scientific contexts. Here, we review and connect these three fields and discuss best practices for their practical implementation with a focus on complex ecological models. We classify relevant types of uncertainty, discuss the complementary roles of sensitivity and uncertainty analyses, give an overview of available calibration methods and emphasize the importance of effective communication of uncertainty. We conclude that using state‐of‐the‐art methods for understanding model behaviour as well as consistently accounting for all uncertainties is essential for correctly understanding model predictions and thus forms the basis for a responsible use of models in ecological decision making.},
  significance = {Ecologists increasingly use complex models to predict ecosystems and guide management, and quantifying and reducing the uncertainty in such models is a key challenge. Three groups of methods address it. Sensitivity analysis measures how strongly a model’s output responds to changes in its inputs; uncertainty analysis traces how uncertain inputs become uncertain predictions; and model inversion or calibration fits a model to data to narrow down its parameters. Each has its own literature and terminology, and existing reviews mostly cover one method or one type of model. Existing guidance has a reasonable core, for example in favouring global sensitivity analysis, which varies all inputs together and so captures interactions (Saltelli et al. 2006). What is missing is a view in which the three are used together. \par The paper presents sensitivity analysis, uncertainty analysis and model calibration, the three methods for handling uncertainty in complex ecological models, as one framework to be used together. Looking forward, from inputs to predictions, the uncertainty of a prediction depends on how uncertain each input is and how sensitive the model is to it. Looking backward, from data to inputs (calibration), data can most easily reduce uncertainty in the inputs and components to which the prediction is sensitive. A one-at-a-time analysis, changing one input at a time, is advised early in a project because it gives visual feedback on model behaviour, explicitly against guidance that only global methods should be used; a global analysis follows. Uncertainties should usually be expressed as probability distributions. Full Bayesian calibration is called the gold standard. Informal methods, such as generalised likelihood uncertainty estimation (GLUE) or pattern-oriented modelling, may be more robust against structural error (errors in the model’s equations rather than its parameters), but give no probabilistic uncertainty. The paper reports no new data; published studies serve as illustrations. \par The paper concludes that treating all relevant uncertainties consistently is central to the credibility of models used for management decisions, and that applying even one of the three methods gives valuable insight into a project’s uncertainty. Predictions should therefore be shown with credible intervals (parameter uncertainty), prediction intervals (which add observation error), and marked regions where the model interpolates within the range of the data or extrapolates beyond it. The paper notes that many recommendations rest on practical experience rather than systematic comparisons.},
  significance_refs = {10.1016/j.ress.2005.11.014},
  license = {CC BY 4.0},
  funding = {Bavarian Ministry of Science and the Arts, Bavarian Climate Research Network (bayklif)},
}

@article{dormann2026full,
  author  = {Dormann, Carsten F. and K{\"a}ber, Yannek and Hartig, Florian},
  title   = {Full prediction uncertainty quantification: A plea from science and decision making},
  journal = {Advances in Ecological Research},
  year    = {2026},
  pages   = {191--212},
  doi     = {10.1016/bs.aecr.2026.02.003},
  abstract = {It is often tacitly assumed that the usefulness of a model depends primarily on the accuracy of its predictions. We disagree with this viewpoint and argue that in both applied decision making and theory development, understanding prediction uncertainty is often equally important. Unfortunately, many researchers still see the quantification and description of uncertainties as a nuisance that is unnecessary at best and counterproductive to the success of a model or theory at worst. Here, we argue that many objections against full prediction uncertainty quantification (FPUQ) are incoherent, or are reflecting a non-probabilistic tradition of process-oriented modelling communities. However, there are some real, at times substantial, problems when attempting a FPUQ. Those include quantifying structural model uncertainty, weighting of non-independent model predictions, estimating the fat-tailed prediction distributions and the challenge to obtain truly independent data. We discuss these challenges and argue that nevertheless these issues are outweighed by the reward of FPUQ, in particular the identification of real gaps in knowledge, and the establishment of credibility in decision making.},
  significance = {Models are often judged chiefly by how accurately they predict, but this article argues that understanding the uncertainty of predictions is frequently just as important, both for decision making and for developing theory. The authors contend that many objections to full prediction uncertainty quantification are incoherent or stem from a non-probabilistic tradition in process-oriented modelling, while acknowledging genuine difficulties: quantifying structural model uncertainty, weighting non-independent model predictions, estimating fat-tailed predictive distributions and obtaining truly independent data. The article concludes that the rewards, above all exposing real gaps in knowledge and establishing credibility with decision makers, outweigh these problems.},
  license = {publisher (subscription)},
  funding = {Deutsche Forschungsgemeinschaft (CRC 1537)},
}

@article{wintermantel2026equivalence,
  author   = {Wintermantel, Dimitry and Osterman, Julia and Mair, Magdalena M. and Hartig, Florian},
  title    = {Equivalence testing in pesticide risk assessment: evaluation and practical guidance for design, analysis and interpretation},
  journal  = {Environment International},
  year     = {2026},
  pages    = {110576},
  doi      = {10.1016/j.envint.2026.110576},
  license  = {CC BY 4.0},
  preprint = {https://arxiv.org/abs/2607.07543},
  abstract = {Harmful pesticide effects exceeding specific protection goals (SPG) may go undetected in underpowered studies. Regulatory honeybee field studies have consistently failed to reach the statistical power required under European Food Safety Authority (EFSA) guidance, which may have contributed to the approval of high-risk substances. Therefore, EFSA advised a shift from testing the null hypothesis of ‘no effect’ (difference testing) to equivalence testing. Under this new approach, a pesticide is classified as ‘low risk’ if the null hypothesis that its effect exceeds the SPG can be rejected. For honeybees, the recommended SPG is a colony size reduction below 10 %. Critics have argued that this framework requires excessive experimental effort to demonstrate pesticide safety and proposed an alternative equivalence test defining treatment effects relative to the lower bound of the 90 %-control-group confidence interval. Using simulations mimicking a regulatory honeybee field study, we show that although the two equivalence tests share the same trade-off between false ‘low-risk’ and false ‘high-risk’ classifications, only EFSA’s equivalence test reliably identifies pesticides with effects > SPG at α = 0.2. Our results show that increasing sample sizes beyond current practice is often necessary for reliable regulatory assessment. However, for pesticides with effect sizes ≤ 5 %, sample size requirements remain lower than those implied by the power requirement of EFSA’s former difference-test-based guidance. Moreover, covariate adjustment – through a model term or balanced colony allocation using anticlustering randomisation – can reduce sample size requirements without losing power and thus save costs. Finally, we provide practical guidance for anticlustering randomisation, equivalence testing and their implementation in R.},
  significance = {Higher-tier pesticide studies have traditionally often treated a non-significant difference between treated and control groups as evidence of safety, although such studies are often too small to detect large harm. For honeybees, the European Food Safety Authority (EFSA 2023) therefore recommended an equivalence test: a pesticide is “low risk” only if colony-size loss is shown to stay below a protection goal of 10%. Hotopp et al. (2024) found that most simulated studies failed it and proposed measuring the loss against the lower confidence bound of the control mean. Their concern, that harmless pesticides should be able to pass, is reasonable. The paper asks whether this modification improves the test or merely loosens it. \par The paper argues that the equivalence test recommended by the European Food Safety Authority is a sound basis for higher-tier honeybee risk assessment, because its significance level controls how often a pesticide exceeding the harm threshold is wrongly passed. Simulations based on control data from one regulatory study (Rolke et al. 2016) show that both tests discriminate equally well at matched error rates. With 10 sites per treatment, the modified test passed 48% of simulated studies of a pesticide that reduces colony size by 12%; it needs a nominal significance level of about 2% instead of 20% to match EFSA’s protection. Hotopp et al.’s low pass rates, the paper argues, arose because their simulated studies were half the size of the Rolke et al. study. Harmless pesticides (no true effect) can be shown to be low risk with site numbers close to current practice; pesticides with a 5% effect need about 24–34 sites per treatment for 80% power, fewer than the 29–41 that the simulations imply for the earlier guidance’s power requirement (EFSA 2013). Adjusting for initial colony size (in the model or by balanced anticlustering) saves up to about ten sites. \par The equivalence test can remain the basis of honeybee risk assessment; more sites and less variation between colonies serve better than changing it. The paper adds guidance: pre-register analysis plans, and add a second test of whether harm exceeds the threshold, so that “high risk” is concluded only when shown; if neither test is significant, the result reads “high risk not excluded”. It adds that other higher-tier ecotoxicity studies with a control may benefit from these principles.},
  significance_refs = {10.2903/j.efsa.2023.7989 10.1002/ieam.4911 10.1007/s10646-016-1725-8 10.2903/j.efsa.2013.3295},
  funding = {European Union's Horizon Europe research and innovation framework programme (WildPosh) (grant agreement No. 101135238); European Union's Horizon Europe research and innovation framework programme (RestPoll) (grant agreement No. 101082102); Svenska Forkingsrådet Formas (2024-00298); Strategic Research Area 'Biodiversity and Ecosystem Services in a Changing Climate' BECC, funded by the Swedish government},
}

@article{fronville2026analyzing,
  author  = {Fronville, Thibault and Pichler, Maximilian and Signer, Johannes and Grabow, Marius and Kramer-Schadt, Stephanie and Radchuk, Viktoriia and Hartig, Florian},
  title   = {Analyzing animal movement using deep learning},
  journal = {arXiv},
  year    = {2026},
  preprint = {https://arxiv.org/abs/2603.24009},
  abstract = {Understanding how animals move through heterogeneous landscapes is central to ecology and conservation. In this context, step selection functions (SSFs) have emerged as the main statistical framework to analyze how biotic and abiotic predictors influence movement paths observed by radio tracking, GPS tags, or similar sensors. A traditional SSF consists of a generalized linear model (GLM) that infers the animal's habitat preferences (selection coefficients) by comparing each observed movement step to random steps. Such GLM-SSFs, however, cannot flexibly consider non-linear or interacting effects, unless those have been specified a priori. To address this problem, generalized additive models have been integrated in the SSF framework, but those GAM-SSFs are still limited in their ability to represent complex habitat preferences and inter-individual variability. Here we explore the utility of deep neural networks (DNNs) to overcome these limitations. We find that DNN-SSFs, coupled with explainable AI to extract selection coefficients, offer many advantages for analyzing movement data. In the case of linear effects, they effectively retrieve the same effect sizes and p-values as conventional GLMs. At the same time, however, they can automatically detect complex interaction effects, nonlinear responses, and inter-individual variability if those are present in the data. We conclude that DNN-SSFs are a promising extension of traditional SSF. Our analysis extends previous research on DNN-SSF by exploring differences and similarities of GLM, GAM and DNN-based SSF models in more depth, in particular regarding the validity of statistical indicators that are derived from the DNN. We also propose new DNN structures to capture inter-individual effects that can be viewed as a nonlinear random effect. All methods used in this paper are available via the 'citoMove' R package.},
  significance = {Step selection functions relate recorded animal movement paths to the environment. Each observed step (the move between consecutive locations) is compared with random alternative steps, usually in a conditional logistic regression (a generalised linear model, GLM), requiring the shape of every response and interaction to be specified in advance. Klappstein et al. (2024) relaxed this with smooth curves (generalised additive models, GAMs) and random effects, a reasonable step for nonlinear single-predictor responses and individual differences. Interactions, also between habitat and movement, still have to be specified. Neural networks can learn such interactions, but earlier deep-learning step selection models (Cífka et al. 2023; Forrest et al. 2026) concentrated on complex predictors and prediction. It remained open whether a network can still give the effect sizes, p-values and confidence intervals ecologists need, on the small datasets typical of animal tracking. \par The paper shows that a simple neural network can replace the pre-specified functional form of a step selection model for animal movement and, read out with explainable-AI methods (techniques that show how output depends on input), still deliver effect sizes, p-values and confidence intervals with acceptable statistical properties in simulations. The network recovered linear effects with near-nominal false-positive rates and coverage, and nonlinear responses of a single predictor as accurately as a GAM. With nine predictors and 36 interactions, both the network and a GLM identified the three true ones. Averaged over all effects, the network had the lower error (0.08 against 0.14), because it shrank absent interactions towards zero while GLM estimates for them varied more; for the true interactions it underestimated the effects, with larger error (0.27 against 0.15). A further layer places individuals in a low-dimensional space where similar individuals lie close together, acting as a nonlinear random effect that can be read like an ordination biplot. It separated four simulated groups of individuals and three types of neighbouring animal (neutral, attracting, repelling). In eight wild boar, rural animals clustered apart from more variable urban ones. \par The results suggest that such networks extend GLM- and GAM-based step selection rather than forming a separate black-box model class. Nonlinear responses, interactions and individual differences can be explored without specifying them beforehand, though the paper notes that flexibility can reduce statistical power. The paper implements the methods in the R package citoMove.},
  significance_refs = {10.1111/2041-210X.14367 10.1101/2023.03.05.531080 10.1111/2041-210X.70136},
  funding = {German Research Foundation (DFG) Research Training Group "BioMove" (DFG-GRK 2118/2)},
}

@article{barth2026efficiency,
  author  = {Barth, Patrick and Drumm, Jakob and Schmidt, Alexandra Erika and Hartig, Florian and Koch, Aline},
  title   = {Efficiency of RNAi-based gene silencing in fungi: a meta-analysis},
  journal = {New Phytologist},
  year    = {2026},
  doi     = {10.1111/nph.71552},
  preprint = {https://doi.org/10.64898/2026.03.04.709060},
  abstract = {RNA interference (RNAi) shows great potential to protect crops against fungal diseases, yet reported protection efficiencies vary greatly, and our understanding of the factors responsible for this variance remains limited. In this meta‐analysis, we evaluated 89 studies that compare the efficiency of host‐induced gene silencing (HIGS) and spray‐induced gene silencing (SIGS) in controlling fungal diseases, focusing on biotrophic, hemibiotrophic, and necrotrophic fungi, the use of formulations, and the dsRNA design as explanatory factors for differences between reported efficiency values. Our results indicate that SIGS is slightly more effective, particularly against biotrophs. Surprisingly, SIGS studies using formulations did not outperform those applying naked dsRNA. We also assessed parameters of RNA design. Differences in dsRNA length and the number of constructs and number of targets showed no consistent significant effect on resistance in either HIGS or SIGS. However, HIGS studies reported significantly higher efficiency when targeting genes closer to the 3′ end and SIGS when targeting genes closer to the 5′ end. We discuss potential reasons for the reported patterns, such as variability in dsRNA uptake mechanisms, intercellular trafficking, and Dicer processing, and conclude that more research is needed to understand the biological mechanisms determining RNAi efficiency for fungal control.},
  significance = {In this meta-analysis, led by Patrick Barth, the authors pool 89 studies of RNA interference against fungal plant pathogens and find that spray-induced gene silencing tends to give slightly higher protection than host-induced gene silencing, particularly against biotrophic fungi, whereas host-induced silencing performed better against necrotrophs. Formulated sprays did not outperform naked dsRNA, and dsRNA length or the number of constructs and targets showed no consistent effect, although the position of the target region within the gene mattered in opposite directions for the two delivery routes. The paper argues that RNAi delivery should be matched to fungal lifestyle and that the mechanisms of dsRNA uptake and processing need further study.},
  license = {CC BY 4.0},
  funding = {Landesgraduiertenförderung Baden-Württemberg (LGFG), scholarship via University of Hohenheim, funded by the Ministry of Science, Research and the Arts of Baden-Württemberg; Deutsche Forschungsgemeinschaft (DFG), Research Training Group (RTG) 2355 'Mechanisms and Functions of RNA-based Regulation' (325443116); Projekt DEAL (Open Access funding)},
}

@article{herold2026novel,
  author  = {Herold, Janina M. and Wiegrebe, Simon and Thorand, Barbara and Winkler, Thomas W. and Gieger, Christian and Hartig, Florian and Behr, Merle and Peters, Annette and K{\"u}chenhoff, Helmut and Heid, Iris M.},
  title   = {A novel age-informative polygenic score improves predictive ability for kidney function and kidney function decline},
  journal = {medRxiv},
  year    = {2026},
  preprint = {https://doi.org/10.64898/2026.01.22.26344420},
  abstract = {Polygenic scores (PGSs) are widely used to summarize the joint genetic effects for disease-related traits. However, while age-dependent genetic effects are increasingly recognized, their integration into PGSs remains underexplored. Kidney function, assessed by estimated glomerular filtration rate (eGFR), has strong age-related genetic effects, and prediction of kidney function decline is an unmet need. We develop an age-informative PGS for quantitative traits by generating age-specific weights via main and interaction effects and compare its performance to the age-agnostic PGS in theory and real data of eGFR. We test PGSs across 282 kidney function SNPs in cross-sectional and longitudinal data from UK Biobank (n=348,275, m=1,520,382) and independent population-based individuals aged 25 to 98 years (KORA&AugUR; n=9,057, m=16,804). In theory and real data, we illustrate that ignoring age mis-specifies genetic effects. The age-informative PGS has better performance than the age-agnostic PGS in young and old individuals (KORA&AugUR: 6.3% versus 5.9% of eGFR variance in 25-to 45-year-old, 2.3% versus 1.8% in 75-to 98-year-old). The PGS based on interaction effects explains more of the eGFR-decline variability than the age-agnostic PGS. The highest versus lowest PGS quintile predict eGFR-decline of −0.88 (95%-CI=[−0.93;−0.83]) versus −0.75 ml/min/1.73m² (95%-CI=[−0.79;−0.71]) on the population-level, similar to strata by acquired risks like diabetes, obesity or albuminuria. Prediction of eGFR-decline on the individual level remains challenging by both, genetic or acquired risks. Overall, we provide a simple approach to an age-informative PGS for quantitative disease traits and illustrate its chances and challenges for predicting kidney function and kidney function decline.},
  significance = {Genetic effects on kidney function strengthen with age, yet standard polygenic scores ignore this. In this preprint, led by Janina M. Herold, the authors construct an age-informative score with age-specific SNP weights derived from main and age-interaction effects and evaluate it in UK Biobank and independent population-based cohorts spanning ages 25 to 98. Ignoring age misestimated genetic effects, and the age-informative score predicted kidney function better, especially in young and old individuals, although the overall gain was small, while a score built from interaction effects explained more of the variation in kidney function decline. Genetic risk groups differed in decline at population level about as much as groups defined by diabetes, obesity or albuminuria, but neither genetic nor acquired risk factors predicted an individual's decline well. The approach is offered as a simple, general way to build age-aware scores for other quantitative traits.},
  funding = {Deutsche Forschungsgemeinschaft (DFG) – SFB1350 (Subproject C6) (Project-ID 387509280); Deutsche Forschungsgemeinschaft (DFG) – TRR 374 (Project-ID 509149993); German Federal Ministry of Education and Research (AugUR study) (BMBF 01ER1206, BMBF 01ER1507); German Research Foundation (AugUR study) (HE 3690/7-1); Helmholtz Zentrum München (KORA study), funded by the German Federal Ministry of Education and Research (BMBF) and the State of Bavaria},
}

