@article{hartig2012connecting,
  author  = {Hartig, Florian and Dyke, James and Hickler, Thomas and Higgins, Steven I. and O'Hara, Robert B. and Scheiter, Simon and Huth, Andreas},
  title   = {Connecting dynamic vegetation models to data – an inverse perspective},
  journal = {Journal of Biogeography},
  year    = {2012},
  volume  = {39},
  number  = {12},
  pages   = {2240--2252},
  doi     = {10.1111/j.1365-2699.2012.02745.x},
  abstract = {Dynamic vegetation models provide process‐based explanations of the dynamics and the distribution of plant ecosystems. They offer significant advantages over static, correlative modelling approaches, particularly for ecosystems that are outside their equilibrium due to global change or climate change. A persistent problem, however, is their parameterization. Parameters and processes of dynamic vegetation models (DVMs) are traditionally determined independently of the model, while model outputs are compared to empirical data for validation and informal model comparison only. But field data for such independent estimates of parameters and processes are often difficult to obtain, and the desire to include better descriptions of processes such as biotic interactions, dispersal, phenotypic plasticity and evolution in future vegetation models aggravates limitations related to the current parameterization paradigm. In this paper, we discuss the use of Bayesian methods to bridge this gap. We explain how Bayesian methods allow direct estimates of parameters and processes, encoded in prior distributions, to be combined with inverse estimates, encoded in likelihood functions. The combination of direct and inverse estimation of parameters and processes allows a much wider range of vegetation data to be used simultaneously, including vegetation inventories, species traits, species distributions, remote sensing, eddy flux measurements and palaeorecords. The possible reduction of uncertainty regarding structure, parameters and predictions of DVMs may not only foster scientific progress, but will also increase the relevance of these models for policy advice.},
  significance = {Dynamic vegetation models describe plant growth, competition, mortality and regeneration from basic processes. For vegetation not in equilibrium, for example under climate change, this gives them advantages over correlative species distribution models. The models’ parameters, however, are traditionally set directly from independent measurements, and model output is compared with field data only to validate. That route is appealing because processes can be tested independently, but it limits how many processes, species and places a model can cover, leaves large uncertainty, and leaves unused data, such as distribution or pollen records, that reflect many interacting processes at once. The problem the paper takes on is the assumption that a process-based vegetation model must be parameterised directly, independently of the data it is meant to predict. \par The paper argues that Bayesian inference lets dynamic vegetation models be fitted to a much wider range of data while keeping their process basis. Direct knowledge about parameters enters as prior distributions; observations of the quantities the model predicts enter inversely, through likelihoods, which state how probable the observations are given the parameters and an assumed error model. The resulting posterior distribution, which weighs the prior knowledge against the data, supports parameter estimation, comparison of model structures and prediction uncertainty. The paper spells out what this requires: more complex error models for correlated data, diagnostics in which systematic mismatches can point to structural errors in the model or systematic errors in the data, and about 5 × 10⁴ to 5 × 10⁵ model runs for about 20 parameters, so that, with limited parallelisation, one simulation should take no more than about a minute. It reviews candidate data, from inventories to eddy flux (gas exchange) measurements and palaeorecords, and recommends combining data from different scales, because their errors tend to be less correlated. \par The paper concludes that fitting vegetation models to data need not reduce them to a complicated correlative model that is blindly adjusted to data, because prior knowledge about parameters and model structure stays central. The authors expect better-constrained predictions with quantified uncertainty, which matters for policy, and tests of ecological theory at different scales. Van Oijen et al. (2013) cite the paper in support of combining prior knowledge with data in their Bayesian calibration, comparison and averaging of six forest models.},
  significance_refs = {10.1016/j.foreco.2012.09.043},
  license = {publisher (subscription)},
  funding = {ERC advanced grant (FH) (233066); Biodiversity and Climate Research Centre (BiK-F), LOEWE programme of Hesse’s Ministry of Higher Education, Research and the Arts (R.B.O’H., S.S.; also the workshop); Helmholtz Association, research alliance ‘Planetary Evolution and Life’ (J.D.)},
}

@article{marion2012parameter,
  author  = {Marion, Glenn and McInerny, Greg J. and Pagel, Jörn and Catterall, Stephen and Cook, Alex R. and Hartig, Florian and O'Hara, Robert B.},
  title   = {Parameter and uncertainty estimation for process-oriented population and distribution models: data, statistics and the niche},
  journal = {Journal of Biogeography},
  year    = {2012},
  volume  = {39},
  number  = {12},
  pages   = {2225--2239},
  doi     = {10.1111/j.1365-2699.2012.02772.x},
  abstract = {The spatial distribution of a species is determined by dynamic processes such as reproduction, mortality and dispersal. Conventional static species distribution models (SDMs) do not incorporate these processes explicitly. This limits their applicability, particularly for non‐equilibrium situations such as invasions or climate change. In this paper we show how dynamic SDMs can be formulated and fitted to data within a Bayesian framework. Our focus is on discrete state‐space Markov process models which provide a flexible framework to account for stochasticity in key demographic processes, including dispersal, growth and competition. We show how to construct likelihood functions for such models (both discrete and continuous time versions) and how these can be combined with suitable observation models to conduct Bayesian parameter inference using computational techniques such as Markov chain Monte Carlo. We illustrate the current state‐of‐the‐art with three contrasting examples using both simulated and empirical data. The use of simulated data allows the robustness of the methods to be tested with respect to deficiencies in both data and model. These examples show how mechanistic understanding of the processes that determine distribution and abundance can be combined with different sources of information at a range of spatial and temporal scales. Application of such techniques will enable more reliable inference and projections, e.g. under future climate change scenarios than is possible with purely correlative approaches. Conversely, confronting such process‐oriented niche models with abundance and distribution data will test current understanding and may ultimately feedback to improve underlying ecological theory.},
  significance = {Species’ distributions arise from dynamic processes such as reproduction, mortality and dispersal. Most statistical species distribution models, however, are static: they relate recorded occurrences to environmental variables, which is quick, but they assume that the species is in equilibrium with its environment and usually ignore dispersal. Ignoring dispersal matters for invasions and climate change, the paper notes, since a species may be absent from a site more because it has not arrived than because the site is unsuitable. Process-based models exist, but fitting them to the data at hand (maps, counts, prior knowledge) has been difficult. The problem the paper takes on is how to confront such dynamic models with these data and quantify the uncertainty. \par The paper shows that process-based species distribution models, static or dynamic, can be fitted to data with one generic Bayesian scheme that quantifies uncertainty. The likelihood is built from a process model, for population change, and an observation model, for detection. Combined with priors (what is known beforehand), the posterior is sampled by Markov chain Monte Carlo, a sampling algorithm; in stochastic models the unobserved population history is inferred along with the parameters. Three examples illustrate the scheme; the first uses a static equilibrium niche model. In a simulation with presence/absence data from one time point, the 95% credibility intervals contained the true parameter values. For Rhododendron ponticum in Britain, 1970–2000, a colonisation model (Catterall et al. 2012; the application to this species was previously unpublished) matched the observed 1987 colonisations by visual comparison and gave a risk map for 2030. In a virtual study taken from Pagel and Schurr (2012), combining maps and abundance time series, the fitted model forecast ranges accurately even under severe dispersal limitation. \par The paper argues that fitting process-oriented niche models allows more reliable inference and projections under climate change than purely correlative models, and that confronting them with data will test, and may improve, ecological theory about the niche. Limits remain: calculating the likelihood exactly may become costly as models grow, so the paper names likelihood-free and particle Markov chain Monte Carlo methods as possible alternatives. Caley et al. (2015) cite the paper for the point that exact likelihood calculation is impractical for invasion models, which motivates their approximate Bayesian computation.},
  significance_refs = {10.1111/j.1600-0587.2011.07190.x 10.1111/j.1466-8238.2011.00663.x 10.1371/journal.pone.0116631},
  license = {publisher (subscription)},
  funding = {Scottish Government, RESAS (G.M., S.C.); ERC advanced grant (FH) (233066); LOEWE initiative of the German federal state of Hesse (workshop)},
}

@article{schurr2012how,
  author  = {Schurr, Frank M. and Pagel, Jörn and Cabral, Juliano Sarmento and Groeneveld, Jürgen and Bykova, Olga and O'Hara, Robert B. and Hartig, Florian and Kissling, W. Daniel and Linder, H. Peter and Midgley, Guy F. and Schröder, Boris and Singer, Alexander and Zimmermann, Niklaus E.},
  title   = {How to understand species’ niches and range dynamics: a demographic research agenda for biogeography},
  journal = {Journal of Biogeography},
  year    = {2012},
  volume  = {39},
  number  = {12},
  pages   = {2146--2162},
  doi     = {10.1111/j.1365-2699.2012.02737.x},
  abstract = {Range dynamics causes mismatches between a species’ geographical distribution and the set of suitable environments in which population growth is positive (the Hutchinsonian niche). This is because source–sink population dynamics cause species to occupy unsuitable environments, and because environmental change creates non‐equilibrium situations in which species may be absent from suitable environments (due to migration limitation) or present in unsuitable environments that were previously suitable (due to time‐delayed extinction). Because correlative species distribution models do not account for these processes, they are likely to produce biased niche estimates and biased forecasts of future range dynamics. Recently developed dynamic range models (DRMs) overcome this problem: they statistically estimate both range dynamics and the underlying environmental response of demographic rates from species distribution data. This process‐based statistical approach qualitatively advances biogeographical analyses. Yet, the application of DRMs to a broad range of species and study systems requires substantial research efforts in statistical modelling, empirical data collection and ecological theory. Here we review current and potential contributions of these fields to a demographic understanding of niches and range dynamics. Our review serves to formulate a demographic research agenda that entails: (1) advances in incorporating process‐based models of demographic responses and range dynamics into a statistical framework, (2) systematic collection of data on temporal changes in distribution and abundance and on the response of demographic rates to environmental variation, and (3) improved theoretical understanding of the scaling of demographic rates and the dynamics of spatially coupled populations. This demographic research agenda is challenging but necessary for improved comprehension and quantification of niches and range dynamics. It also forms the basis for understanding how niches and range dynamics are shaped by evolutionary dynamics and biotic interactions. Ultimately, the demographic research agenda should lead to deeper integration of biogeography with empirical and theoretical ecology.},
  significance = {A species’ niche, in Hutchinson’s sense, is the set of environments where its population can grow when rare (its intrinsic growth rate is positive). The paper notes that niches and future range shifts are statistically estimated almost entirely with correlative species distribution models, which relate where a species is recorded to environmental conditions; direct demographic measurements and mechanistic niche models take too much effort for many species. The correlation is often taken to reflect the niche, yet the two can differ: individuals spill from good into poor habitat (Pulliam 2000), dispersal-limited species are missing from suitable places, and species linger where conditions have recently deteriorated. Unbiased niche estimates thus seem to require knowing range dynamics, but these in turn require knowing how demographic rates respond to the environment, which is the niche itself. \par The paper argues that this circularity between niche and range dynamics can be undone by a demographic research agenda whose central step is to estimate niches and range dynamics together with dynamic range models (DRMs), which are fitted statistically to distribution and demographic data. A DRM links three parts: how birth, death and dispersal vary with the environment (birth and death determine the niche), how these rates shape the founding and loss of local populations, and how the populations are sampled in the data. As an illustration, the paper reuses a simulation by Pagel and Schurr (2012): a virtual species’ range was followed through 75 years of climate change, and models were fitted to data from the first 10 years. The DRM estimated the species’ true niche and its future range size much better than a logistic-regression distribution model fitted to the same data. \par The paper sets out what is needed to apply DRMs to many species. Statistical work should extend them to structured populations and complex dynamics; for now they suit only species with simple life cycles and enough data. Data collection should add repeated distribution surveys, population time series, demographic measurements across environments and long-distance dispersal data. Theory should clarify how demographic rates scale up and how coupled populations behave. The paper reads this basis as a prerequisite for understanding how evolution and species interactions shape niches and ranges, and expects it to lead to closer integration of biogeography with empirical and theoretical ecology.},
  significance_refs = {10.1046/j.1461-0248.2000.00143.x 10.1111/j.1466-8238.2011.00663.x},
  license = {publisher (subscription)},
  funding = {German Research Foundation DFG (SCHU 2259/3-1, SCHU 2259/5-1); ERC advanced grant (FH) (233066); Villum Kann Rasmussen Foundation (W.D.K.) (VKR09b-141); Danish Council for Independent Research – Natural Sciences (W.D.K.) (11-106163); German Research Foundation DFG (B.S.) (SCHR1000/6-1)},
}

@article{dormann2012correlation,
  author  = {Dormann, Carsten F. and Schymanski, Stanislaus J. and Cabral, Juliano and Chuine, Isabelle and Graham, Catherine and Hartig, Florian and Kearney, Michael and Morin, Xavier and R{\"o}mermann, Christine and Schr{\"o}der, Boris and Singer, Alexander},
  title   = {Correlation and process in species distribution models: bridging a dichotomy},
  journal = {Journal of Biogeography},
  year    = {2012},
  volume  = {39},
  number  = {12},
  pages   = {2119--2131},
  doi     = {10.1111/j.1365-2699.2011.02659.x},
  abstract = {Within the field of species distribution modelling an apparent dichotomy exists between process‐based and correlative approaches, where the processes are explicit in the former and implicit in the latter. However, these intuitive distinctions can become blurred when comparing species distribution modelling approaches in more detail. In this review article, we contrast the extremes of the correlative–process spectrum of species distribution models with respect to core assumptions, model building and selection strategies, validation, uncertainties, common errors and the questions they are most suited to answer. The extremes of such approaches differ clearly in many aspects, such as model building approaches, parameter estimation strategies and transferability. However, they also share strengths and weaknesses. We show that claims of one approach being intrinsically superior to the other are misguided and that they ignore the process–correlation continuum as well as the domains of questions that each approach is addressing. Nonetheless, the application of process‐based approaches to species distribution modelling lags far behind more correlative (process‐implicit) methods and more research is required to explore their potential benefits. Critical issues for the employment of species distribution modelling approaches are given, together with a guideline for appropriate usage. We close with challenges for future development of process‐explicit species distribution models and how they may complement current approaches to study species distributions.},
  significance = {Correlative species distribution models relate occurrence records statistically to environmental data, mainly climate, leaving the processes implicit. The paper notes that their predictions are usually limited in biological realism and transferability. Process-based models, built around explicitly stated mechanisms, can address these deficits, but they often need many parameters and data of limited availability, and so have been used for far fewer species. The two are easily seen as rival camps, one presumed better. The paper questions this assumption of a sharp dichotomy with an intrinsically superior side. \par The paper argues that correlative and process-based species distribution models lie on a continuum defined by how explicitly processes are represented, so that claims of one being intrinsically superior are misguided. The review compares the two extremes on thirteen features, among them assumptions, validation and uncertainty. Two results carry the argument. Once process-based models are fitted to distribution data, they share the statistical assumptions and uncertainty problems of correlative models. The data used for fitting cannot also test the model’s structure, and a good fit does not show that a model is right for the right reasons. Only forward process-based models, whose parameters come from independent data or theory, can in principle use distribution data to test their structure. Correlative models, in turn, yield correlations whose causal reading remains a hypothesis: a link with temperature does not necessarily show that temperature limits a species. \par The paper concludes that neither camp should claim the moral high ground: the success of a correlative model may rest on spurious correlations, and a process-based model can only reveal effects of the processes put into it. Process-based approaches, it adds, lag far behind correlative ones in use and need more research. It highlights three avenues: Bayesian fitting of process-based models, forward models, and a combined workflow in which correlative models generate hypotheses that process-based models take up and turn into predictions for a test on independent data. Yates et al. (2018) cite the paper for their statement that the correlative–mechanistic distinction is usually blurred in practice.},
  significance_refs = {10.1016/j.tree.2018.08.001},
  license = {publisher (subscription)},
  funding = {LOEWE-BiK-F Biodiversity and Climate Research Centre Frankfurt (funded the initiating workshop); Helmholtz Association (to C.F.D.) (VH-NG 247); German Research Foundation DFG (to C.F.D.) (DO 686/5-1); Max Planck Society (to S.J.S.); DFG (to C.R.) (RO 3842/1-1)},
}

@incollection{johst2012offsetting,
  author    = {Johst, Karin and Hartig, Florian and Drechsler, Martin},
  title     = {Offsetting Policies for Biodiversity Conservation: The Need for Compensating Habitat Relocation},
  booktitle = {Models of the Ecological Hierarchy - From Molecules to the Ecosphere},
  publisher = {Elsevier},
  year      = {2012},
  pages     = {413--430},
  doi       = {10.1016/B978-0-444-59396-2.00024-9},
  note      = {Book chapter, edited by F. Jord{\'a}n and S. E. J{\o}rgensen.},
  abstract = {To halt biodiversity loss, market-based conservation policies known as biodiversity offsetting are increasingly implemented in developed countries. These policies allow the destruction of natural habitats if new habitat of equal quality has been created elsewhere. Yet, even at constant total habitat area, patch relocations can be detrimental for species. Using an analytical formula for metapopulation viability, we provide understanding and novel insights into the interplay between the landscape attributes patch number, connectivity, and level of patch turnover. We show that both landscape and species characteristics must be considered to ensure that biodiversity offsetting is effective and derive guidelines for the design of such policies.},
  significance = {Biodiversity offsetting is a market-based conservation policy that, according to the chapter, is increasingly implemented in developed countries to halt biodiversity loss. It allows natural habitat to be destroyed if new habitat of equal quality has been created elsewhere. The problem the chapter takes on is whether moving habitat patches is harmless for species when the total habitat area stays the same. \par The chapter argues that offsetting can harm species even when total habitat area is kept constant, and examines how the number of patches, their connectivity and the level of patch turnover (how often patches are lost and replaced) interact in this. It uses an analytical formula for metapopulation viability, a measure of the prospects for persistence of a set of linked local populations. \par The chapter presents its results as showing that effective offsetting has to take both landscape and species characteristics into account, and derives guidelines for the design of offsetting policies.},
  license = {publisher (subscription)},
}

