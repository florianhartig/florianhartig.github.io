@article{hulsmann2021variation,
  author   = {H{\"u}lsmann, Lisa and Chisholm, Ryan A. and Hartig, Florian},
  title    = {Is Variation in Conspecific Negative Density Dependence Driving Tree Diversity Patterns at Large Scales?},
  journal  = {Trends in Ecology \& Evolution},
  year     = {2021},
  volume   = {36},
  number   = {2},
  pages    = {151--163},
  doi      = {10.1016/j.tree.2020.10.003},
  featured = {true},
  abstract = {Half a century ago, Janzen and Connell hypothesized that the high tree species diversity in tropical forests is maintained by specialized natural enemies. Along with other mechanisms, these can cause conspecific negative density dependence (CNDD) and thus maintain species diversity. Numerous studies have measured proxies of CNDD worldwide, but doubt about its relative importance remains. We find ample evidence for CNDD in local populations, but methodological limitations make it difficult to assess if CNDD scales up to control community diversity and thereby local and global biodiversity patterns. A combination of more robust statistical methods, new study designs, and eco-evolutionary models are needed to provide a more definite evaluation of the importance of CNDD for geographic variation in plant species diversity.},
  significance = {Janzen and Connell proposed that enemies keep tree species from becoming too common, maintaining tropical forest diversity. The hypothesis is tied to conspecific negative density dependence (CNDD): a species does worse where its own kind is dense, which is stabilising if stronger than the effect of other species’ density. It implies that geographic variation in CNDD helps explain patterns such as the latitudinal diversity gradient. Most studies measure local density effects on one life stage, yet much of the literature equates these effects, the original enemy-based mechanism and community stabilisation. The paper takes on whether locally measured CNDD scales up to community diversity and geographic patterns. \par The paper examines the Janzen–Connell hypothesis and argues that the evidence supports local conspecific negative density dependence (CNDD), but not yet its large-scale consequences. It splits the hypothesis into four claims: CNDD exists; it exceeds density dependence between species; it stabilises the community; and it varies along gradients and drives diversity patterns. Evidence is ample for the first claim, weaker but convincing for the second, and much weaker for the last two: the paper finds no compelling evidence that CNDD causally shapes large-scale tree diversity. A main reason is regression dilution: studies that compare young with adult trees and take proportionality as the no-CNDD null count fewer recruits (young trees) per adult as CNDD, but adult density measured with error flattens the fitted slope and mimics this signature, as a simulation adapted from Detto et al. (2019) shows. Simulations show such biases, with confounding by environment and dispersal, can produce regional and global patterns of CNDD strength reported in the criticised studies of Johnson et al. (2012) and LaManna et al. (2017), even without CNDD. \par The paper regards the Janzen–Connell hypothesis as unresolved, although seedlings and saplings of many tree species likely experience stabilising CNDD (stronger than between-species density dependence). Its roadmap asks for unbiased CNDD estimates tested against density dependence between species as the null; standardised observational cross-site studies rather than meta-analyses, or, more ambitiously, a coordinated global experiment; and models linking local CNDD to regional diversity. A later study by a larger group including the paper’s authors (Hülsmann et al. 2024) estimated CNDD at 23 forest sites from mortality data, a design in which regression dilution can only bias estimates conservatively.},
  significance_refs = {10.1111/ele.13372 10.1126/science.1220269 10.1126/science.aam5678 10.1038/s41586-024-07118-4},
  license = {publisher (subscription)},
  funding = {James S. McDonnell Foundation},
}

@article{pichler2021new,
  author  = {Pichler, Maximilian and Hartig, Florian},
  title   = {A new joint species distribution model for faster and more accurate inference of species associations from big community data},
  journal = {Methods in Ecology and Evolution},
  year    = {2021},
  volume  = {12},
  number  = {11},
  pages   = {2159--2173},
  doi     = {10.1111/2041-210X.13687},
  abstract = {Joint species distribution models (JSDMs) explain spatial variation in community composition by contributions of the environment, biotic associations and possibly spatially structured residual covariance. They show great promise as a general analytical framework for community ecology and macroecology, but current JSDMs, even when approximated by latent variables, scale poorly on large datasets, limiting their usefulness for currently emerging big (e.g. metabarcoding and metagenomics) community datasets. Here, we present a novel, more scalable JSDM (sjSDM) that circumvents the need to use latent variables by using a Monte Carlo integration of the joint JSDM likelihood together with flexible elastic net regularization on all model components. We implemented sjSDM in PyTorch, a modern machine learning framework, which allows making use of both CPU and GPU calculations. Using simulated communities with known species–species associations and different number of species and sites, we compare sjSDM with state‐of‐the‐art JSDM implementations to determine computational runtimes and accuracy of the inferred species–species and species–environment associations. We find that sjSDM is orders of magnitude faster than existing JSDM algorithms (even when run on the CPU) and can be scaled to very large datasets. Despite the dramatically improved speed, sjSDM produces more accurate estimates of species association structures than alternative JSDM implementations. We demonstrate the applicability of sjSDM to big community data using eDNA case study with thousands of fungi operational taxonomic units (OTU). Our sjSDM approach makes the analysis of JSDMs to large community datasets with hundreds or thousands of species possible, substantially extending the applicability of JSDMs in ecology. We provide our method in an R package to facilitate its applicability for practical data analysis.},
  significance = {Joint species distribution models (JSDMs) describe species communities by combining each species’ response to the environment with associations between species (pairs that occur together more or less often than the environment predicts). They suit large datasets from environmental DNA (eDNA) and metabarcoding but scale poorly: the full model’s covariance matrix grows quadratically with the number of species. The usual remedy replaces it by a few latent variables, hidden gradients summarising the associations (Warton et al. 2015). This is reasonable, as it should in theory reduce the variance of the estimates. Yet fitting can still take hours to days for hundreds of species, and this low-rank structure may bias the estimated associations. The paper takes on the assumption that scalable JSDMs need latent variables. \par The paper shows that joint species distribution models (JSDMs) with a full association matrix can be fitted fast and accurately on big community data without latent variables. Its method, sjSDM, approximates the likelihood by random sampling (Monte Carlo integration), which runs in parallel on a processor or a graphics card (GPU), and limits overfitting with elastic-net regularisation, a penalty shrinking weak associations towards zero. In simulations with known associations, sjSDM was faster than Hmsc, gllvm and BayesComm, with a gap that grew with species number and reached orders of magnitude on a GPU, where it fitted 30,000 sites with up to 1,000 species in about 4.5 minutes. It also recovered the signs of associations, and which are non-zero, better than the latent-variable packages Hmsc and gllvm, though accuracy stayed moderate; all predicted occurrences about equally well. The paper treats the latent-variable structure as the likely but unproven cause of the bias. As an example, it fits 3,649 fungal operational taxonomic units (OTUs) from 125 Danish sites. \par The results make JSDMs usable for hundreds to thousands of species, the largest runs using a GPU, and suggest that shrinking a full covariance matrix can estimate associations better than a low-rank structure. The paper cautions that associations are not necessarily causal and that their uncertainty has no analytical estimate yet but can be obtained by resampling (bootstrapping), and offers the R package sjSDM. Rahman et al. (2024), when porting the JSDM package Hmsc to GPUs, state that, to their knowledge, sjSDM is the only existing JSDM package designed for GPUs.},
  significance_refs = {10.1016/j.tree.2015.09.007 10.1371/journal.pcbi.1011914},
  license = {CC BY 4.0},
}

@article{oberpriller2021towards,
  author  = {Oberpriller, Johannes and Cameron, David R. and Dietze, Michael C. and Hartig, Florian},
  title   = {Towards robust statistical inference for complex computer models},
  journal = {Ecology Letters},
  year    = {2021},
  volume  = {24},
  number  = {6},
  pages   = {1251--1261},
  doi     = {10.1111/ele.13728},
  abstract = {Ecologists increasingly rely on complex computer simulations to forecast ecological systems. To make such forecasts precise, uncertainties in model parameters and structure must be reduced and correctly propagated to model outputs. Naively using standard statistical techniques for this task, however, can lead to bias and underestimation of uncertainties in parameters and predictions. Here, we explain why these problems occur and propose a framework for robust inference with complex computer simulations. After having identified that model error is more consequential in complex computer simulations, due to their more pronounced nonlinearity and interconnectedness, we discuss as possible solutions data rebalancing and adding bias corrections on model outputs or processes during or after the calibration procedure. We illustrate the methods in a case study, using a dynamic vegetation model. We conclude that developing better methods for robust inference of complex computer simulations is vital for generating reliable predictions of ecosystem responses.},
  significance = {Ecologists increasingly use complex computer simulations, such as process-based models of forests, to forecast ecosystem change, and forecasts are only as useful for decisions as their parameters and uncertainty estimates are reliable. The field has moved from informal tuning to statistical calibration by maximum likelihood or Bayesian inference, which looks no different from fitting a regression model. These methods, however, estimate parameters and uncertainties on the assumption that the model’s structure is correct. That is tolerable for flexible statistical models but not for simulations that are rigid, strongly nonlinear, tightly interconnected and often fitted to several data streams of very different size. The paper takes on the assumption that calibrating such simulations needs nothing beyond ordinary regression statistics. \par The paper argues that conventional statistical calibration of complex computer simulations can give biased parameters and predictions and uncertainty estimates that are too narrow, because errors in the model’s structure are absorbed by distorted parameter values. Unbalanced data make this worse. In a test, a forest ecosystem model (BASFOR) with five deliberate structural changes was fitted to synthetic data generated by the unchanged model, and errors were far larger than the estimated uncertainty. Parameter error was about 5% when one data type had ten times fewer observations, against about 1.7% with balanced data. Giving the data-rich stream less weight improved results greatly when the structure was wrong. Fitting a flexible statistical model (a Gaussian process) to the residual errors after calibration improved predictions: error fell for gross primary production and came much closer to the estimated uncertainty for both outputs. A cheaper variant of the approach of Kennedy and O’Hagan (2001), which fits an error term during calibration, also improved parameter estimates. An attempt to correct errors inside the model’s processes did not improve inference in this setup. \par Naive calibration can therefore mislead about parameters, forecasts and their uncertainty. The paper judges that conventional methods remain adequate where random error dominates. It recommends down-weighting the larger data stream as a simple fix, and bias corrections after or during calibration for experienced modellers, at a computational cost. It stresses that these corrections are no panacea and better model structure remains preferable. Its evidence comes from one model with one error structure. Cameron et al. (2022) later examined unbalanced data using simulated (‘virtual’) data.},
  significance_refs = {10.1111/1467-9868.00294 10.1111/2041-210x.14002},
  license = {CC BY 4.0},
  funding = {Bavarian Ministry of Science and the Arts (Bavarian Climate Research Network, bayklif); Projekt DEAL (open access funding)},
}

@article{speich2021sequential,
  author  = {Speich, Matthias and Dormann, Carsten F. and Hartig, Florian},
  title   = {Sequential Monte-Carlo algorithms for Bayesian model calibration – A review and method comparison},
  journal = {Ecological Modelling},
  year    = {2021},
  volume  = {455},
  pages   = {109608},
  doi     = {10.1016/j.ecolmodel.2021.109608},
  abstract = {Bayesian inference has become an important framework for calibrating complex ecological and environmental models. Markov-Chain Monte Carlo (MCMC) algorithms are the methodological backbone of this framework, but they are not easily parallelizable and can thus not make optimal use of modern computer architectures. A possible solution is the use of Sequential Monte Carlo (SMC) algorithms. Currently, SMCs are used mainly for Bayesian state updating, for example in weather forecasting, and are thought to be less efficient for parameter calibration than MCMCs. Unlike MCMCs, however, SMCs are easily parallelizable. Thus, SMCs may become an interesting alternative when modelers have access to parallel computing environments. The purpose of this paper is to provide an introduction to SMC algorithms for Bayesian model calibration, and to explore the trade-off between efficiency and parallelizability for MCMC and SMC algorithms. To that end, we discuss different SMC variants, and benchmark them against a state-of-the-art MCMC algorithm by calibrating three ecological models of increasing complexity. Our results show that, with appropriately chosen settings, SMCs can be faster than state-of-the-art MCMC algorithms when a sufficiently large number of parallel cores are available and when the model runtime is large compared to communication overhead for parallelization (on our hardware, a model runtime of 20 ms was enough to favor SMC algorithms). Efficient SMC settings were characterized by a balanced mix of SMC filtering and MCMC mutation steps, suggesting that mixing MCMC and SMC principles may be ideal for creating efficient and parallelizable calibration algorithms. The algorithms used in this study are provided within the BayesianTools R package for Bayesian inference with complex ecological models.},
  significance = {Bayesian calibration of complex ecological and environmental models mostly relies on Markov chain Monte Carlo (MCMC) samplers. These explore the parameter space step by step, each step depending on the last, so they need very many model runs and can use parallel computers only to a very limited degree. Sequential Monte Carlo (SMC) samplers instead keep a large population of candidate parameter sets (“particles”) that are reweighted and moved according to their fit to the data, which parallelises easily. SMC is thought to be less efficient and to need careful tuning for calibration, because a badly tuned SMC can lose the diversity of its particles. The main earlier comparison (Jeremiah et al. 2011) used an older, less advanced MCMC as benchmark. The paper asks whether the parallelisability of SMC can offset its lower efficiency in practice. \par The study argues that sequential Monte Carlo (SMC) samplers can calibrate slow models faster than a state-of-the-art Markov chain Monte Carlo (MCMC) sampler once some tens of processor cores are available, even though SMC is less efficient for a single calibration. It tests up to 240 SMC settings against a differential-evolution MCMC on test cases up to a forest growth model (synthetic data for the dynamic models). At the forest model’s normal 1 ms run time, the best SMC settings came close to, but did not beat, MCMC. With a 50 ms pause added to emulate a slow model, every converged SMC run matched or beat MCMC, and five or more cores sufficed to be faster. Run time then fell almost in proportion to core number (log–log slopes −0.88 and −0.94 for 20 and 50 ms pauses, where −1 is exact proportionality; −0.5 without a pause). Convergence depended strongly on tuning: the number of MCMC moves per particle and iteration mattered more than the number of particles. \par SMC is thus an alternative to MCMC worth considering for modellers with slow models and parallel hardware; on the authors’ cluster, a model run had to take about 20–50 ms for SMC to pay off. Because the best settings used many MCMC steps, the paper suggests that hybrids of SMC and MCMC may suit complex models best, and names automatic tuning and convergence monitoring for SMC as open needs. The sampler is in the BayesianTools R package.},
  significance_refs = {10.1029/2010WR010217},
  license = {publisher (subscription)},
  funding = {Deutsche Forschungsgemeinschaft (DOR 786/8–1)},
}

@article{chalmandrier2021linking,
  author  = {Chalmandrier, Lo{\"i}c and Hartig, Florian and Laughlin, Daniel C. and Lischke, Heike and Pichler, Maximilian and Stouffer, Daniel B. and Pellissier, Lo{\"i}c},
  title   = {Linking functional traits and demography to model species-rich communities},
  journal = {Nature Communications},
  year    = {2021},
  volume  = {12},
  number  = {1},
  pages   = {2724},
  doi     = {10.1038/s41467-021-22630-1},
  abstract = {It has long been anticipated that relating functional traits to species demography would be a cornerstone for achieving large-scale predictability of ecological systems. If such a relationship existed, species demography could be modeled only by measuring functional traits, transforming our ability to predict states and dynamics of species-rich communities with process-based community models. Here, we introduce a new method that links empirical functional traits with the demographic parameters of a process-based model by calibrating a transfer function through inverse modeling. As a case study, we parameterize a modified Lotka–Volterra model of a high-diversity mountain grassland with static plant community and functional trait data only. The calibrated trait–demography relationships are amenable to ecological interpretation, and lead to species abundances that fit well to the observed community structure. We conclude that our new method offers a general solution to bridge the divide between trait data and process-based models in species-rich ecosystems.},
  significance = {Process-based community models are hard to calibrate in species-rich systems because their demographic parameters multiply with every added species. In this study, led by Loïc Chalmandrier, the authors circumvent this by predicting demographic parameters from functional traits through a transfer function, which is itself fitted by inverse modelling to observed community abundances. For 118 grassland plant species along a temperature gradient in the French Alps, a Lotka–Volterra-type competition model governed by only eleven transfer-function parameters reproduced species turnover and fitted far better than null models built on randomised traits. The inferred trait–demography links were ecologically sensible, aligning with the leaf-economics axis and plant size, and the authors argue that the approach opens the way to fitting richer community models in diverse ecosystems.},
  license = {CC BY 4.0},
  funding = {European Union's Horizon 2020 research and innovation program, Marie Skłodowska-Curie grant agreement (Project CLIMB) (840946); European Research Council, European Community's Seventh Framework Program FP7/2007–2013 (TEEMBIO) (281422); Swiss National Science Foundation (SNSF) (162604)},
}

@article{hagen2021gen3sis,
  author  = {Hagen, Oskar and Fl{\"u}ck, Benjamin and Fopp, Fabian and Cabral, Juliano S. and Hartig, Florian and Pontarp, Mikael and Rangel, Thiago F. and Pellissier, Lo{\"i}c},
  title   = {gen3sis: A general engine for eco-evolutionary simulations of the processes that shape Earth’s biodiversity},
  journal = {PLOS Biology},
  year    = {2021},
  volume  = {19},
  number  = {7},
  pages   = {e3001340},
  doi     = {10.1371/journal.pbio.3001340},
  preprint = {https://www.biorxiv.org/content/10.1101/2021.03.24.436109v1},
  abstract = {Understanding the origins of biodiversity has been an aspiration since the days of early naturalists. The immense complexity of ecological, evolutionary, and spatial processes, however, has made this goal elusive to this day. Computer models serve progress in many scientific fields, but in the fields of macroecology and macroevolution, eco-evolutionary models are comparatively less developed. We present a general, spatially explicit, eco-evolutionary engine with a modular implementation that enables the modeling of multiple macroecological and macroevolutionary processes and feedbacks across representative spatiotemporally dynamic landscapes. Modeled processes can include species’ abiotic tolerances, biotic interactions, dispersal, speciation, and evolution of ecological traits. Commonly observed biodiversity patterns, such as α, β, and γ diversity, species ranges, ecological traits, and phylogenies, emerge as simulations proceed. As an illustration, we examine alternative hypotheses expected to have shaped the latitudinal diversity gradient (LDG) during the Earth’s Cenozoic era. Our exploratory simulations simultaneously produce multiple realistic biodiversity patterns, such as the LDG, current species richness, and range size frequencies, as well as phylogenetic metrics. The model engine is open source and available as an R package, enabling future exploration of various landscapes and biological processes, while outputs can be linked with a variety of empirical biodiversity patterns. This work represents a key toward a numeric, interdisciplinary, and mechanistic understanding of the physical and biological processes that shape Earth’s biodiversity.},
  significance = {Species numbers differ between continents and regions and change with latitude, with elevation or between islands. Such patterns arise from many processes acting together on changing landscapes: species spread, adapt, interact, split and go extinct. Most hypotheses about how they produce the observed patterns are verbal, so they are hard to test against each other. Simulation models could make them precise, as Gotelli et al. (2009) argued in calling for a general simulation model for macroecology. But the models built since were mostly made for specific questions, each with a fixed set of mechanisms. The problem the paper takes on is thus the lack of a common platform in which competing explanations can be formulated and tested. \par gen3sis is a simulation engine in which the processes that shape biodiversity can be combined freely and run over landscapes that change through time. Mechanisms and landscapes are exchangeable building blocks: a user specifies how species disperse, which conditions they tolerate, how they compete and evolve, and when isolated populations become new species. From these, species richness, ranges, traits and phylogenies emerge together, so that different hypotheses can be written in one framework and each checked against several observed patterns at once. As an example, the paper implements several hypotheses for the latitudinal diversity gradient, from a null model without ecological interactions to limits on how many individuals a site can support, set by its temperature and aridity, and runs them over the Cenozoic. All of them can produce a decline in species richness towards the poles; only the model with these environment-dependent limits also matches the other patterns – the shape of that decline, local richness, range sizes and the shape of phylogenies – although only in a small fraction of its simulation runs. \par The case study does not settle what causes the latitudinal gradient; the paper notes that it covered only a few of the candidate processes. What it shows is why explanations should be judged against many patterns at once: reproducing the gradient alone is a weak test, since quite different mechanisms pass it. The contribution is the tool: mechanisms that had been described only in words become explicit, reproducible models, in an open R package. gen3sis has since been used for very different systems, among them the uneven diversity of tropical moist forests (Hagen et al. 2021, PNAS), the exchange of land vertebrates across Wallace’s Line (Skeels et al. 2023) and the freshwater fishes of the western Amazon (Boschman et al. 2023).},
  significance_refs = {10.1111/j.1461-0248.2009.01353.x 10.1073/pnas.2026347118 10.1126/science.adf7122 10.1038/s41559-023-02220-8},
  license = {CC BY 4.0},
  funding = {Synthesis Centre of the German Centre for Integrative Biodiversity Research (iDiv) Halle-Jena-Leipzig (support of the sELDiG working group) (DFG FZT 118); Swiss National Science Foundation (310030_188550)},
}

@article{rosbakh2021siberian,
  author  = {Rosbakh, Sergey and Hartig, Florian and Sandanov, Denis V. and Bukharova, Evgenya V. and Miller, Tara K. and Primack, Richard B.},
  title   = {Siberian plants shift their phenology in response to climate change},
  journal = {Global Change Biology},
  year    = {2021},
  volume  = {27},
  number  = {18},
  pages   = {4435--4448},
  doi     = {10.1111/gcb.15744},
  abstract = {Siberia has undergone dramatic climatic changes due to global warming in recent decades. Yet, the ecological responses to these climatic changes are still poorly understood due to a lack of data. Here, we use a unique data set from the Russian ‘Chronicles of Nature’ network to analyse the long‐term (1976–2018) phenological shifts in leaf out, flowering, fruiting and senescence of 67 common Siberian plant species. We find that Siberian boreal forest plants advanced their early season (leaf out and flowering) and mid‐season (fruiting) phenology by −2.2, −0.7 and −1.6 days/decade, and delayed the onset of senescence by 1.6 days/decade during this period. These mean values, however, are subject to substantial intraspecific variability, which is partly explained by the plants' growth forms. Trees and shrubs advanced leaf out and flowering (−3.1 and −3.3. days/decade) faster than herbs (−1 day/decade), presumably due to the more direct exposure of leaf and flower buds to ambient air for the woody vegetation. For senescence, we detected a reverse pattern: stronger delays in herbs (2.1 days/decade) than in woody plants (1.0–1.2 days/decade), presumably due to the stronger effects of autumn frosts on the leaves of herbs. Interestingly, the timing of fruiting in all four growth forms advanced at similar paces, from 1.4 days/decade in shrubs to 1.7 days/decade in trees and herbs. Our findings point to a strong, yet heterogeneous, response of Siberian plant phenology to recent global warming. Furthermore, the results highlight that species‐ and growth form‐specific differences among study species could be used to identify plants particularly at risk of decline due to their low adaptive capacity or a loss of synchronization with important interaction partners.},
  significance = {Ground-based records of plant phenology from Siberia have been largely missing. In this study, led by Sergey Rosbakh, the authors analyse a long series of leaf-out, flowering, fruiting and senescence observations for common boreal forest species, collected at the Barguzin Nature Reserve within the Russian Chronicles of Nature monitoring programme. On average, early- and mid-season events advanced and senescence was delayed, at rates comparable to other cold, strongly seasonal climates, implying a longer growing season. Responses differed considerably between species, many of which showed no significant shift in flowering, fruiting or senescence, and growth form explained part of this variation, with woody plants advancing leaf-out more strongly than herbs. The authors suggest that such differences could help identify species at risk and may lead to phenological mismatches within Siberian forest communities.},
  license = {CC BY-NC 4.0},
  funding = {BayHost (to SR); Russian Geographic Society (23/2019); Russian Federal Budget (121030900138-8); Projekt DEAL (open access funding)},
}

@article{barraquand2021inferring,
  author   = {Barraquand, Fr{\'e}d{\'e}ric and Picoche, Coralie and Detto, Matteo and Hartig, Florian},
  title    = {Inferring species interactions using Granger causality and convergent cross mapping},
  journal  = {Theoretical Ecology},
  year     = {2021},
  volume   = {14},
  number   = {1},
  pages    = {87--105},
  doi      = {10.1007/s12080-020-00482-7},
  abstract = {Identifying directed interactions between species from time series of their population densities has many uses in ecology. This key statistical task is equivalent to causal time series inference, which connects to the Granger causality (GC) concept: x causes y if x improves the prediction of y in a dynamic model. However, the entangled nature of nonlinear ecological systems has led to question the appropriateness of Granger causality, especially in its classical linear multivariate autoregressive (MAR) model form. Convergent cross mapping (CCM), a nonparametric method developed for deterministic dynamical systems, has been suggested as an alternative. Here, we show that linear GC and CCM are able to uncover interactions with surprisingly similar performance, for predator-prey cycles, 2-species deterministic (chaotic), or stochastic competition, as well as 10- and 20-species interaction networks. We found no correspondence between the degree of nonlinearity of the dynamics and which method performs best. Our results therefore imply that Granger causality, even in its linear MAR(p) formulation, is a valid method for inferring interactions in nonlinear ecological networks; using GC or CCM (or both) can instead be decided based on the aims and specifics of the analysis.},
  preprint = {https://arxiv.org/abs/1909.00731},
  significance = {Ecologists often want to know which species affect one another’s populations from time series of abundances. This is a causal-inference problem, and the classical statistical answer is Granger causality: one series “causes” another if its past values improve the prediction of the other’s future. It is often tested with linear multivariate autoregressive (MAR) models, in which each species depends on the earlier abundances of all species. Sugihara et al. (2012) argued that Granger causality is best suited to linear systems dominated by random noise and not strongly nonlinear deterministic ones, which call for convergent cross mapping (CCM), a method that reconstructs the system’s dynamics from the series themselves. Their concern has a basis: in a deterministic system, a driver leaves a trace in the affected species’ own past values. Many later CCM studies adopted this view, which suggests choosing the method by how nonlinear a system is. The paper tests this assumption. \par The paper shows that linear Granger causality and convergent cross mapping infer species interactions from time series with similar performance, and that which method does better does not follow the degree of nonlinearity. This holds when the model is fitted to log abundances and the number of past time steps included (the lags) is chosen with information criteria. Both methods detect the two-way coupling in Veilleux’s predator–prey data. In a chaotic two-species model, both detect the strong interaction in all simulations and find roughly half of the weak one. In 20-species networks with weaker interactions, Granger causality tends to do better, because CCM yields more false positives. When two species share an environmental driver, both struggle: CCM gives many false positives and Granger causality misses a weak interaction. \par The results imply that Granger causality, even in its linear form, is a valid way to infer interactions in nonlinear ecological communities, and that the choice between it, CCM or both can rest on the aims and data of the analysis rather than on assumed nonlinearity. What matters more, the paper argues, are details such as lag selection (for Granger causality) and the definition of p-values (for CCM), and which confounders, such as a shared environmental driver, are included in the model. Lidgard et al. (2021) cite the paper when applying Granger causality to fossil time series of bryozoan diversification.},
  significance_refs = {10.1126/science.1227079 10.1098/rspb.2021.1632},
  license = {publisher (subscription)},
  funding = {French ANR through LabEx COTE (ANR-10-LABX-45)},
}

@article{reisch2021species,
  author  = {Reisch, Christoph and Hartig, Florian},
  title   = {Species and genetic diversity patterns show different responses to land use intensity in central European grasslands},
  journal = {Diversity and Distributions},
  year    = {2021},
  volume  = {27},
  number  = {3},
  pages   = {392--401},
  doi     = {10.1111/ddi.13199},
  abstract = {Aim: Empirical studies have often reported parallel patterns of genetic and species diversity, but the strength and generality of this association, as well as its origin, are still debated. Particularly in human‐dominated landscapes with complex histories of land use histories, more complicated and partly diverging patterns have been observed. In this study, we examine whether species and genetic diversity correlate across grasslands with different levels of land use pressure and spatial differentiation in habitat quality and heterogeneity. Location: We selected eight extensively used (grazed, unfertilized) dry grasslands and eight intensively used (mown, fertilized) hay meadows in southeastern Germany. Methods: We used vegetation surveys and molecular markers of six widespread dry grassland and six hay meadow plant species to compare species and genetic alpha and beta diversity between the two grassland types. Results: Species diversity patterns expectedly showed higher alpha diversity, stronger spatial structure and less turnover in dry grasslands than in hay meadows. Neither of the corresponding genetic diversity patterns showed the same significant trends. Main conclusion: Our results question the idea that species and genetic diversity patterns will always show similar patterns. Likely, genetic and species diversity emerge partly from shared, partly from different processes, including the regional species pool, environmental heterogeneity, fragmentation and land use history. The practical conservation implication is that species and genetic diversity are not generally interchangeable. Looking at species and genetic patterns together, however, may eventually lead to a better understanding of the complex processes that shape the structure and dynamics of ecological communities.},
  significance = {Genetic diversity within species is a conservation goal in its own right and is sometimes used as an indicator of species diversity. Many studies found the two to go together, and Vellend (2005) and Vellend et al. (2014) offer a reasonable explanation: if both are shaped mainly by habitat patch size and isolation, as island biogeography and the island model of population genetics assume, they should run in parallel. This rests on equilibrium conditions, which are often the exception, particularly in human-dominated cultural landscapes. Other studies found no or even negative relationships; most studies of either kind examined a single species. The open question is whether the two still run in parallel in such landscapes. \par The paper suggests that, in human-dominated landscapes, species diversity and genetic diversity are driven partly by the same processes and partly by different ones, so their patterns need not run in parallel. It tests this near Regensburg, comparing eight grazed dry grasslands with eight mown, fertilised hay meadows, using vegetation surveys and AFLP fingerprints of six common plant species per habitat. Species diversity differed: dry grasslands had more species per site, their communities were more strongly structured in space, and they differed less between sites. Genetic diversity within populations did not differ significantly between grassland types after allowing for species differences, nor did genetic differentiation between populations. Power is low with six species per habitat, but the paper reads the smaller estimated effects as suggesting that any genetic differences are likely smaller than the species differences. It conjectures that species patterns follow habitat differences, whereas genetic patterns are evened out by gene flow and by history, for example that dry grasslands were once the more widespread type and hay meadows now are. \par Parallel patterns of species and genetic diversity cannot be taken for granted in human-dominated landscapes. Protecting species diversity may not automatically protect genetic diversity, and the genetic diversity of common species may not be a reliable stand-in for species diversity (or for endangered species), although the paper cautions that rare or self-compatible species could behave differently; it recommends considering both levels explicitly in conservation. The paper still favours studying the two together, as their differences carry complementary information, and calls for a landscape-scale theory of communities with models predicting both from the same processes.},
  significance_refs = {10.1086/431318 10.1111/mec.12756},
  license = {CC BY 4.0},
  funding = {Projekt DEAL (open access funding)},
}

@article{udy2021environmental,
  author  = {Udy, Kristy and Fritsch, Matthias and Meyer, Katrin M. and Grass, Ingo and Han{\ss}, Sebastian and Hartig, Florian and Kneib, Thomas and Kreft, Holger and Kukunda, Collins B. and Pe'er, Guy and Reininghaus, Hannah and Tietjen, Britta and Tscharntke, Teja and van Waveren, Clara-Sophie and Wiegand, Kerstin},
  title   = {Environmental heterogeneity predicts global species richness patterns better than area},
  journal = {Global Ecology and Biogeography},
  year    = {2021},
  volume  = {30},
  number  = {4},
  pages   = {842--851},
  doi     = {10.1111/geb.13261},
  abstract = {Aim: It is widely accepted that biodiversity is influenced by both niche‐related and spatial processes from local to global scales. Their relative importance, however, is still disputed, and empirical tests are surprisingly scarce at the global scale. Here, we compare the importance of area (as a proxy for pure spatial processes) and environmental heterogeneity (as a proxy for niche‐related processes) for predicting native mammal species richness world‐wide and within biogeographical regions. Location: Global. Time period: We analyse a spatial snapshot of richness data collated by the International Union for Conservation of Nature. Major taxa studied: All terrestrial mammal species, including possibly extinct species and species with uncertain presence. Methods: We applied a spreading dye algorithm to analyse how native mammal species richness changes with area and environmental heterogeneity. As measures for environmental heterogeneity, we used elevation ranges and precipitation ranges, which are well‐known correlates of species richness. Results: We found that environmental heterogeneity explained species richness relationships better than did area, suggesting that niche‐related processes are more prevalent than pure area effects at broad scales. Main conclusions: Our results imply that niche‐related processes are essential to understand broad‐scale species–area relationships and that habitat diversity is more important than area alone for the protection of global biodiversity.},
  significance = {In this study, led by Kristy Udy, the authors use a spreading-dye algorithm that grows contiguous samples of grid cells to partition how much of the variation in native terrestrial mammal richness is explained by area versus two measures of environmental heterogeneity, elevation range and precipitation range, worldwide and within six biogeographical regions. Heterogeneity consistently explained more of the variation than area alone, which is interpreted as evidence that niche-related processes, rather than pure area effects, mainly underlie broad-scale species–area relationships. The authors caution that species-pool size and regional history were not accounted for, but argue that habitat diversity matters more than area alone for protecting global biodiversity.},
  license = {CC BY 4.0},
  funding = {Deutsche Forschungsgemeinschaft (DFG), Research Training Group 1644 'Scaling problems in statistics' at the University of Göttingen},
}

@article{ryo2021explainable,
  author   = {Ryo, Masahiro and Angelov, Boyan and Mammola, Stefano and Kass, Jamie M. and Benito, Blas M. and Hartig, Florian},
  title    = {Explainable artificial intelligence enhances the ecological interpretability of black-box species distribution models},
  journal  = {Ecography},
  year     = {2021},
  volume   = {44},
  number   = {2},
  pages    = {199--205},
  doi      = {10.1111/ecog.05360},
  preprint = {https://ecoevorxiv.org/w96pk},
  abstract = {Species distribution models (SDMs) are widely used in ecology, biogeography and conservation biology to estimate relationships between environmental variables and species occurrence data and make predictions of how their distributions vary in space and time. During the past two decades, the field has increasingly made use of machine learning approaches for constructing and validating SDMs. Model accuracy has steadily increased as a result, but the interpretability of the fitted models, for example the relative importance of predictor variables or their causal effects on focal species, has not always kept pace. Here we draw attention to an emerging subdiscipline of artificial intelligence, explainable AI (xAI), as a toolbox for better interpreting SDMs. xAI aims at deciphering the behavior of complex statistical or machine learning models (e.g. neural networks, random forests, boosted regression trees), and can produce more transparent and understandable SDM predictions. We describe the rationale behind xAI and provide a list of tools that can be used to help ecological modelers better understand complex model behavior at different scales. As an example, we perform a reproducible SDM analysis in R on the African elephant and showcase some xAI tools such as local interpretable model‐agnostic explanation (LIME) to help interpret local‐scale behavior of the model. We conclude with what we see as the benefits and caveats of these techniques and advocate for their use to improve the interpretability of machine learning SDMs.},
  significance = {Species distribution models (SDMs), which relate where a species occurs to environmental conditions, have become more accurate as ecologists adopted machine learning, but how these models arrive at their predictions has not necessarily become easier to understand. Modellers therefore appear to face a trade-off between accuracy and interpretability (Breiman 2001). Asking whether ecologists should give up interpretability for slight gains in accuracy is reasonable, and some argue that simpler models, which can be read directly, are the better choice (Rudin 2019). Ecology already used some tools for looking inside fitted models, but explainable AI (xAI), which brings such tools together, had not yet been applied to SDM research, according to the paper. The paper takes on the assumption that a complex model has to remain an uninterpretable ‘black box’. \par The paper argues that explainable AI (xAI) lets ecologists keep complex species distribution models and still interpret them, both across the whole modelled area (global) and at single sites (local). It sorts interpretation methods into those that use simple, directly readable models and those applied afterwards to a fitted model, and sorts the latter into global and local ones. Among the tools that work with any algorithm, it lists permutation importance (how much accuracy drops when a variable is scrambled), partial dependence (the average effect of a variable on the predictions), Shapley values (each variable’s contribution to a single prediction) and LIME. LIME explains one prediction by fitting a simple model that mimics the complex one in the neighbourhood of that site (Ribeiro et al. 2016). A random-forest model for the African elephant, built purely as a demonstration, shows what this can reveal: the variable that matters most over the whole modelled area is not among the top variables listed at three randomly chosen sites. \par The paper concludes that such explanations can help ecologists judge whether a fitted model is ecologically plausible, notice where a variable’s importance changes across space, and spot predictors that may not act causally before the model is used for extrapolation or management. It stresses that explaining a model is not the same as explaining real causal relationships, that a local surrogate only approximates the model it explains, and that the case for simpler models remains under debate.},
  significance_refs = {10.1214/ss/1009213726 10.1038/s42256-019-0048-x 10.1145/2939672.2939778},
  license = {CC BY 3.0},
  funding = {Japan Society for the Promotion of Science (JSPS), Grant-in-Aid for JSPS Overseas Research Fellowships (MR); European Research Council, BIODESERT project (BMB) (647038); European Commission, Horizon 2020 Marie Skłodowska-Curie Actions individual fellowship (SM) (882221); Japan Society for the Promotion of Science Postdoctoral Fellowships for Foreign Researchers (JMK); Okinawa Institute of Science and Technology Graduate University (JMK); OpenAccess Publication Fund of Freie Universität Berlin; Projekt DEAL (open access funding)},
}

@article{oberpriller2021modellunsicherheiten,
  author   = {Oberpriller, Johannes and Arneth, Almut and Herschlein, Christine and Rammig, Anja and Hartig, Florian},
  title    = {Modellunsicherheiten in Klimafolgeprojektionen. Eine Einf{\"u}hrung},
  journal  = {Mitteilungen der Fr{\"a}nkischen Geographischen Gesellschaft},
  year     = {2021},
  volume   = {67},
  pages    = {70--81},
  url      = {https://fgg-erlangen.de/fgg/ojs/index.php/mfgg/article/view/590},
  language = {de},
  abstract = {Um Folgen des Klimawandels abzuschätzen, erzeugen Klimaforscher oft Modellvorhersagen basierend auf einem Emissionsszenario, sogenannte Klimafolgeprojektionen. Solche Modellprojektionen sind mit Unsicherheiten behaftet, die sich aus den Unsicherheiten der einzelnen Modellkomponenten (z.B. Treibern, Parametern oder Struktur) ergeben. Die Quantifizierung dieser Unsicherheiten ist für die Interpretation der Projektionen durch Forschung, Entscheidungsträger und Öffentlichkeit von essenzieller Wichtigkeit. Ziel dieses Artikels ist es, eine Einführung in die Berechnung von Modellunsicherheiten im Kontext von Klimafolgeprojektionen zu geben. Wir diskutieren hierzu zunächst die Gründe und Typen von Modellunsicherheiten und erklären danach wie man diese quantifizieren (=Unsicherheitsanalyse) und über den Abgleich mit Beobachtungsdaten reduzieren (=Modellinversion) kann. Wir veranschaulichen die besprochenen Konzepte durch eine Fallstudie, in der wir eine Unsicherheitsanalyse des terrestrischen Ökosystemmodells LPJ-GUESS für einen Standort in Franken vornehmen.},
  significance = {In this introductory article, written in German, the authors explain why projections of climate impacts carry uncertainty arising from drivers, parameters and model structure, and how that uncertainty can be quantified by uncertainty and sensitivity analysis and narrowed by calibrating models against observations. A case study with the vegetation model LPJ-GUESS for pedunculate oak at a site in Franconia finds that, under present-day climate, deviations towards lower aboveground carbon production are more plausible than towards higher production, and that sensitivity shifts from mainly demographic parameters under pre-industrial conditions towards photosynthesis parameters and a broader set of parameters under present-day conditions. The authors also stress that communicating uncertainty to the public and to decision-makers is a challenge in its own right.},
  funding = {Bayerisches Staatsministerium für Wissenschaft und Kunst, Bayerisches Klimaforschungsnetzwerk (bayklif), BLIZ project},
}

