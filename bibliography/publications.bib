@article{hartig2012connecting,
  author  = {Hartig, Florian and Dyke, James and Hickler, Thomas and Higgins, Steven I. and O'Hara, Robert B. and Scheiter, Simon and Huth, Andreas},
  title   = {Connecting dynamic vegetation models to data – an inverse perspective},
  journal = {Journal of Biogeography},
  year    = {2012},
  volume  = {39},
  number  = {12},
  pages   = {2240--2252},
  doi     = {10.1111/j.1365-2699.2012.02745.x},
  abstract = {Dynamic vegetation models provide process‐based explanations of the dynamics and the distribution of plant ecosystems. They offer significant advantages over static, correlative modelling approaches, particularly for ecosystems that are outside their equilibrium due to global change or climate change. A persistent problem, however, is their parameterization. Parameters and processes of dynamic vegetation models (DVMs) are traditionally determined independently of the model, while model outputs are compared to empirical data for validation and informal model comparison only. But field data for such independent estimates of parameters and processes are often difficult to obtain, and the desire to include better descriptions of processes such as biotic interactions, dispersal, phenotypic plasticity and evolution in future vegetation models aggravates limitations related to the current parameterization paradigm. In this paper, we discuss the use of Bayesian methods to bridge this gap. We explain how Bayesian methods allow direct estimates of parameters and processes, encoded in prior distributions, to be combined with inverse estimates, encoded in likelihood functions. The combination of direct and inverse estimation of parameters and processes allows a much wider range of vegetation data to be used simultaneously, including vegetation inventories, species traits, species distributions, remote sensing, eddy flux measurements and palaeorecords. The possible reduction of uncertainty regarding structure, parameters and predictions of DVMs may not only foster scientific progress, but will also increase the relevance of these models for policy advice.},
  significance = {Dynamic vegetation models describe plant growth, competition, mortality and regeneration from basic processes. For vegetation not in equilibrium, for example under climate change, this gives them advantages over correlative species distribution models. The models’ parameters, however, are traditionally set directly from independent measurements, and model output is compared with field data only to validate. That route is appealing because processes can be tested independently, but it limits how many processes, species and places a model can cover, leaves large uncertainty, and leaves unused data, such as distribution or pollen records, that reflect many interacting processes at once. The problem the paper takes on is the assumption that a process-based vegetation model must be parameterised directly, independently of the data it is meant to predict. \par The paper argues that Bayesian inference lets dynamic vegetation models be fitted to a much wider range of data while keeping their process basis. Direct knowledge about parameters enters as prior distributions; observations of the quantities the model predicts enter inversely, through likelihoods, which state how probable the observations are given the parameters and an assumed error model. The resulting posterior distribution, which weighs the prior knowledge against the data, supports parameter estimation, comparison of model structures and prediction uncertainty. The paper spells out what this requires: more complex error models for correlated data, diagnostics in which systematic mismatches can point to structural errors in the model or systematic errors in the data, and about 5 × 10⁴ to 5 × 10⁵ model runs for about 20 parameters, so that, with limited parallelisation, one simulation should take no more than about a minute. It reviews candidate data, from inventories to eddy flux (gas exchange) measurements and palaeorecords, and recommends combining data from different scales, because their errors tend to be less correlated. \par The paper concludes that fitting vegetation models to data need not reduce them to a complicated correlative model that is blindly adjusted to data, because prior knowledge about parameters and model structure stays central. The authors expect better-constrained predictions with quantified uncertainty, which matters for policy, and tests of ecological theory at different scales. Van Oijen et al. (2013) cite the paper in support of combining prior knowledge with data in their Bayesian calibration, comparison and averaging of six forest models.},
  significance_refs = {10.1016/j.foreco.2012.09.043},
  license = {publisher (subscription)},
}

@article{marion2012parameter,
  author  = {Marion, Glenn and McInerny, Greg J. and Pagel, Jörn and Catterall, Stephen and Cook, Alex R. and Hartig, Florian and O'Hara, Robert B.},
  title   = {Parameter and uncertainty estimation for process-oriented population and distribution models: data, statistics and the niche},
  journal = {Journal of Biogeography},
  year    = {2012},
  volume  = {39},
  number  = {12},
  pages   = {2225--2239},
  doi     = {10.1111/j.1365-2699.2012.02772.x},
  abstract = {The spatial distribution of a species is determined by dynamic processes such as reproduction, mortality and dispersal. Conventional static species distribution models (SDMs) do not incorporate these processes explicitly. This limits their applicability, particularly for non‐equilibrium situations such as invasions or climate change. In this paper we show how dynamic SDMs can be formulated and fitted to data within a Bayesian framework. Our focus is on discrete state‐space Markov process models which provide a flexible framework to account for stochasticity in key demographic processes, including dispersal, growth and competition. We show how to construct likelihood functions for such models (both discrete and continuous time versions) and how these can be combined with suitable observation models to conduct Bayesian parameter inference using computational techniques such as Markov chain Monte Carlo. We illustrate the current state‐of‐the‐art with three contrasting examples using both simulated and empirical data. The use of simulated data allows the robustness of the methods to be tested with respect to deficiencies in both data and model. These examples show how mechanistic understanding of the processes that determine distribution and abundance can be combined with different sources of information at a range of spatial and temporal scales. Application of such techniques will enable more reliable inference and projections, e.g. under future climate change scenarios than is possible with purely correlative approaches. Conversely, confronting such process‐oriented niche models with abundance and distribution data will test current understanding and may ultimately feedback to improve underlying ecological theory.},
  significance = {Static species distribution models do not represent the demographic processes that generate distributions, which limits their use under invasions or climate change. In this paper, led by Glenn Marion, the authors show how dynamic, process-based distribution models formulated as discrete state-space Markov processes can be fitted in a Bayesian framework, by constructing likelihoods for discrete- and continuous-time versions and combining them with observation models for Markov chain Monte Carlo inference. Three examples with simulated and empirical data illustrate how mechanistic understanding and data from different scales can be combined, and the authors argue that confronting such models with data can feed back into ecological theory.},
  license = {publisher (subscription)},
}

@article{schurr2012how,
  author  = {Schurr, Frank M. and Pagel, Jörn and Cabral, Juliano Sarmento and Groeneveld, Jürgen and Bykova, Olga and O'Hara, Robert B. and Hartig, Florian and Kissling, W. Daniel and Linder, H. Peter and Midgley, Guy F. and Schröder, Boris and Singer, Alexander and Zimmermann, Niklaus E.},
  title   = {How to understand species’ niches and range dynamics: a demographic research agenda for biogeography},
  journal = {Journal of Biogeography},
  year    = {2012},
  volume  = {39},
  number  = {12},
  pages   = {2146--2162},
  doi     = {10.1111/j.1365-2699.2012.02737.x},
  abstract = {Range dynamics causes mismatches between a species’ geographical distribution and the set of suitable environments in which population growth is positive (the Hutchinsonian niche). This is because source–sink population dynamics cause species to occupy unsuitable environments, and because environmental change creates non‐equilibrium situations in which species may be absent from suitable environments (due to migration limitation) or present in unsuitable environments that were previously suitable (due to time‐delayed extinction). Because correlative species distribution models do not account for these processes, they are likely to produce biased niche estimates and biased forecasts of future range dynamics. Recently developed dynamic range models (DRMs) overcome this problem: they statistically estimate both range dynamics and the underlying environmental response of demographic rates from species distribution data. This process‐based statistical approach qualitatively advances biogeographical analyses. Yet, the application of DRMs to a broad range of species and study systems requires substantial research efforts in statistical modelling, empirical data collection and ecological theory. Here we review current and potential contributions of these fields to a demographic understanding of niches and range dynamics. Our review serves to formulate a demographic research agenda that entails: (1) advances in incorporating process‐based models of demographic responses and range dynamics into a statistical framework, (2) systematic collection of data on temporal changes in distribution and abundance and on the response of demographic rates to environmental variation, and (3) improved theoretical understanding of the scaling of demographic rates and the dynamics of spatially coupled populations. This demographic research agenda is challenging but necessary for improved comprehension and quantification of niches and range dynamics. It also forms the basis for understanding how niches and range dynamics are shaped by evolutionary dynamics and biotic interactions. Ultimately, the demographic research agenda should lead to deeper integration of biogeography with empirical and theoretical ecology.},
  significance = {Because source-sink dynamics, migration limitation and delayed extinction decouple where species occur from where their populations can actually grow, correlative species distribution models are likely to give biased estimates of niches and of future range shifts. In this review, led by Frank M. Schurr, the authors promote dynamic range models, which estimate range dynamics together with the environmental responses of demographic rates from distribution data, as a process-based statistical alternative. The authors set out a demographic research agenda spanning statistical modelling, systematic collection of data on distribution and abundance change and on demographic responses to environment, and theory on scaling demographic rates and on spatially coupled populations. The authors see this agenda as a basis for studying how evolution and biotic interactions shape niches and ranges, and for integrating biogeography more closely with empirical and theoretical ecology.},
  license = {publisher (subscription)},
}

@article{dormann2012correlation,
  author  = {Dormann, Carsten F. and Schymanski, Stanislaus J. and Cabral, Juliano and Chuine, Isabelle and Graham, Catherine and Hartig, Florian and Kearney, Michael and Morin, Xavier and R{\"o}mermann, Christine and Schr{\"o}der, Boris and Singer, Alexander},
  title   = {Correlation and process in species distribution models: bridging a dichotomy},
  journal = {Journal of Biogeography},
  year    = {2012},
  volume  = {39},
  number  = {12},
  pages   = {2119--2131},
  doi     = {10.1111/j.1365-2699.2011.02659.x},
  abstract = {Within the field of species distribution modelling an apparent dichotomy exists between process‐based and correlative approaches, where the processes are explicit in the former and implicit in the latter. However, these intuitive distinctions can become blurred when comparing species distribution modelling approaches in more detail. In this review article, we contrast the extremes of the correlative–process spectrum of species distribution models with respect to core assumptions, model building and selection strategies, validation, uncertainties, common errors and the questions they are most suited to answer. The extremes of such approaches differ clearly in many aspects, such as model building approaches, parameter estimation strategies and transferability. However, they also share strengths and weaknesses. We show that claims of one approach being intrinsically superior to the other are misguided and that they ignore the process–correlation continuum as well as the domains of questions that each approach is addressing. Nonetheless, the application of process‐based approaches to species distribution modelling lags far behind more correlative (process‐implicit) methods and more research is required to explore their potential benefits. Critical issues for the employment of species distribution modelling approaches are given, together with a guideline for appropriate usage. We close with challenges for future development of process‐explicit species distribution models and how they may complement current approaches to study species distributions.},
  significance = {Correlative and process-based species distribution models are often presented as rival camps. In this review, led by Carsten F. Dormann, the authors argue that they lie on a continuum defined by how explicitly processes are represented, with hybrid and integrated models in between. Comparing the two extremes in their assumptions, model building, validation, uncertainty and typical errors, the authors find that once models are fitted to data they share many weaknesses, and that neither a good fit nor a mechanistic structure guarantees being right for the right reasons. The authors reject claims that either approach is intrinsically superior; instead they call for Bayesian calibration of process-based models, forward models parameterised independently of the data they predict, and workflows in which correlative models generate hypotheses that process-based models then test.},
  license = {publisher (subscription)},
  funding = {LOEWE-BiK-F Biodiversity and Climate Research Centre Frankfurt (funded the initiating workshop); Helmholtz Association (to C.F.D.) (VH-NG 247); German Research Foundation DFG (to C.F.D.) (DO 686/5-1); Max Planck Society (to S.J.S.); DFG (to C.R.) (RO 3842/1-1)},
}

@incollection{johst2012offsetting,
  author    = {Johst, Karin and Hartig, Florian and Drechsler, Martin},
  title     = {Offsetting Policies for Biodiversity Conservation},
  booktitle = {Models of the Ecological Hierarchy - From Molecules to the Ecosphere},
  publisher = {Elsevier},
  year      = {2012},
  pages     = {413--430},
  doi       = {10.1016/B978-0-444-59396-2.00024-9},
  note      = {Book chapter, edited by F. Jord{\'a}n and S. E. J{\o}rgensen.},
  abstract = {To halt biodiversity loss, market-based conservation policies known as biodiversity offsetting are increasingly implemented in developed countries. These policies allow the destruction of natural habitats if new habitat of equal quality has been created elsewhere. Yet, even at constant total habitat area, patch relocations can be detrimental for species. Using an analytical formula for metapopulation viability, we provide understanding and novel insights into the interplay between the landscape attributes patch number, connectivity, and level of patch turnover. We show that both landscape and species characteristics must be considered to ensure that biodiversity offsetting is effective and derive guidelines for the design of such policies.},
  significance = {Biodiversity offsetting allows habitat destruction if habitat of equal quality is created elsewhere, but such relocation can harm species even when total habitat area stays constant. In this chapter, led by Karin Johst, the authors apply an analytical formula for metapopulation viability to examine how patch number, connectivity and patch turnover interact, show that effective offsetting must account for both landscape and species characteristics, and derive guidelines for designing such policies.},
  license = {publisher (subscription)},
}

% ------------------------------------------------------------------ 2011 ----

@article{hartig2011statistical,
  author  = {Hartig, Florian and Calabrese, Justin M. and Reineking, Bj{\"o}rn and Wiegand, Thorsten and Huth, Andreas},
  title   = {Statistical inference for stochastic simulation models – theory and application},
  journal = {Ecology Letters},
  year    = {2011},
  volume  = {14},
  number  = {8},
  pages   = {816--827},
  doi     = {10.1111/j.1461-0248.2011.01640.x},
  abstract = {Statistical models are the traditional choice to test scientific theories when observations, processes or boundary conditions are subject to stochasticity. Many important systems in ecology and biology, however, are difficult to capture with statistical models. Stochastic simulation models offer an alternative, but they were hitherto associated with a major disadvantage: their likelihood functions can usually not be calculated explicitly, and thus it is difficult to couple them to well-established statistical theory such as maximum likelihood and Bayesian statistics. A number of new methods, among them Approximate Bayesian Computing and Pattern-Oriented Modelling, bypass this limitation. These methods share three main principles: aggregation of simulated and observed data via summary statistics, likelihood approximation based on the summary statistics, and efficient sampling. We discuss principles as well as advantages and caveats of these methods, and demonstrate their potential for integrating stochastic simulation models into a unified framework for statistical modelling.},
  significance = {Statistical inference in ecology and biology mostly requires a likelihood that can be calculated: the probability of the observed data for given parameter values. Systems in which many individuals interact by chance and are only partly observed usually lack such a likelihood and are modelled with stochastic simulation models. The likelihood of such a model usually cannot be calculated explicitly, so these models were seen as hard to connect to maximum likelihood and Bayesian statistics. Methods that get around this appear to have grown up in separate fields with little exchange. The paper takes on the assumption that a likelihood that cannot be calculated places simulation models outside likelihood-based statistical inference. \par The paper argues that a stochastic simulation model does have a likelihood, which is only implicit (termed implicit statistical models by Diggle and Gratton 1984), and that the methods for connecting such models to data mostly follow the same three steps (not all approximate the likelihood explicitly). Estimating the likelihood by simulation alone is hopelessly inefficient in most practical cases, so the methods (1) reduce observed and simulated data to summary statistics, (2) approximate the likelihood of the observed statistics at a given parameter value, and (3) explore the parameter space efficiently, for example by Markov chain Monte Carlo. For step 2 the paper distinguishes four groups, from nonparametric methods such as Approximate Bayesian Computation, which accept simulations close to the observations, to rejection filters, as in Pattern-Oriented Modelling, which only sort parameter sets by tests against the data. Caveats include that the error of the approximation affects the sampler it is combined with, and that summary statistics adequate for estimating parameters may not be adequate for comparing models. A simulated movement path (summary statistics) and a brown bear model for the Eastern Alps, fitted by rejection of parameter sets (Pattern-Oriented Modelling), serve as examples. \par The paper concludes that, once a likelihood approximation exists, fitting, comparing and checking the uncertainty of a simulation model can follow the logic of any statistical model, so simulation modelling can, in principle, join one statistical framework. It names usability and standardization as the main open issues and hopes to prompt exchange across communities. Grimm and Railsback (2012) point to it for optimisation techniques when many parameters are calibrated.},
  significance_refs = {10.1111/j.2517-6161.1984.tb01290.x 10.1098/rstb.2011.0180},
  license = {publisher (subscription)},
  featured = {true},
}

@article{drechsler2011conserving,
  author  = {Drechsler, Martin and Hartig, Florian},
  title   = {Conserving biodiversity with tradable permits under changing conservation costs and habitat restoration time lags},
  journal = {Ecological Economics},
  year    = {2011},
  volume  = {70},
  number  = {3},
  pages   = {533--541},
  doi     = {10.1016/j.ecolecon.2010.10.004},
  abstract = {Tradable permits are a common environmental policy instrument that has recently been applied also to the conservation of biodiversity. Biodiversity conservation differs in many respects to the classical applications of tradable permits like emissions control. One particularity is that, even if the permit system maintains a constant total amount of species habitat, habitat turnover (the destruction of a habitat and restoration elsewhere) affects the ecosystem. Another particularity is that the restoration of habitats often takes much time, leading to time lags between the initiation of restoration activities and the time when restored habitat is available for trading. We use an agent-based model of a tradable permit market to study the influence of heterogeneous and dynamic conservation costs and habitat restoration time lags on key variables of the market, such as the costs incurred to the market participants and the amount of habitat turnover. Our results show that there may be trade-offs between these key variables. We also find that restoration time lags can lead to fluctuations in permit prices that reduce the efficiency of the permit market. We conclude that temporal lags deserve a careful analysis when implementing tradable permit systems for the preservation of natural habitats and biodiversity.},
  significance = {“Habitat banking” uses tradable permits to protect habitat: destroying a habitat requires a permit, gained by restoring equal habitat elsewhere or bought. For biodiversity, timing matters much more than for greenhouse gases. Each trade destroys a habitat patch and its local populations, and this turnover of habitat can harm species even when the total amount of habitat stays constant. Restoring habitat also takes years, in some cases centuries, so a permit appears long after the decision to restore. Earlier studies of permit markets, mostly on carbon trading, reasonably examined banking and borrowing, but did not consider that changes in management take time and cost money. The paper takes on how restoration costs and delays shape habitat permit markets. \par The paper argues that in tradable-permit markets for habitat conservation, restoration costs and time lags shape how the market behaves and deserve careful analysis when such markets are designed. It uses an agent-based model with 1000 landowners, one patch each, whose forgone profits (opportunity costs) differ between patches and fluctuate over time; owners decide on the current permit price and costs. With instant restoration the market is stable, and there is a trade-off: dearer restoration lowers turnover, but also raises the total opportunity cost, because restoration then no longer happens only on the sites where forgone profit is lowest. With delayed restoration, owners restore too much, because the price at decision time no longer holds when the habitat is ready. Permits are then periodically oversupplied, and prices, turnover and costs fluctuate like the classic pork cycle, where producers react to today’s price and cause tomorrow’s glut; this raises average costs. With delay, by contrast, dearer restoration can lower the total opportunity cost, because it curbs the excess. In the base setting, total cost is highest at a one-period delay. \par The results suggest that restoration time lags can make a permit scheme less efficient than with instant restoration, and that with instant restoration low turnover and low opportunity cost can conflict. Because restoration cost affects turnover, the paper suggests a tax on restoration as a possible instrument to steer turnover, higher for species that react more strongly to turnover, and to dampen excess restoration. It names its limits: owners react to current prices only, permits are not banked and space is ignored.},
  license = {publisher (subscription)},
}

@article{johst2011biodiversity,
  author  = {Johst, Karin and Drechsler, Martin and van Teeffelen, Astrid J. A. and Hartig, Florian and Vos, Claire C. and Wissel, Silvia and Wätzold, Frank and Opdam, Paul},
  title   = {Biodiversity conservation in dynamic landscapes: trade-offs between number, connectivity and turnover of habitat patches},
  journal = {Journal of Applied Ecology},
  year    = {2011},
  volume  = {48},
  number  = {5},
  pages   = {1227--1235},
  doi     = {10.1111/j.1365-2664.2011.02015.x},
  abstract = {1. Many species are adapted to landscapes with characteristic dynamics generated by ongoing habitat destruction and creation. Climate change and human land use, however, may change the dynamics of these landscapes. Studies have repeatedly shown that many species are not able to cope with such changes in landscape dynamics. Conservation policies must, therefore, explicitly address this threat. The way in which management should be modified when formerly static landscapes become dynamic or when landscape dynamics change is unclear. 2. Using an analytical formula for the rapid assessment of metapopulation lifetime in dynamic landscapes, we investigate if and how changes in one landscape attribute may be compensated by changes in another attribute to maintain species viability. We study such trade‐offs considering both spatial (number, connectivity of patches) and temporal (patch destruction and creation rates) landscape attributes. 3. We show that increasing patch destruction can be compensated to a certain extent by improvements in other spatial and/or temporal landscape attributes. Focusing on trade‐offs between management options reveals two key factors essential for management decisions: First, the trade‐offs are generally nonlinear irrespective of considering spatial or temporal landscape attributes. Secondly, species can be grouped according to their response to particular management options. 4. Synthesis and applications. We demonstrate the usefulness of an analytical formula for calculating trade‐offs between landscape attributes for a variety of landscapes and species. Two practical and robust management recommendations can be derived: (i) The nonlinearity of trade‐offs implies that the effectiveness of conservation measures depends explicitly on the current level of landscape attributes. It must, therefore, be taken into account in conservation decision making. In particular, the existing level of patch turnover is decisive: if it is already high, improvements in other landscape attributes are ineffective in maintaining species viability. Thus, monitoring the current level of landscape attributes is indispensable for effective biodiversity conservation. (ii) Compensation of increased patch destruction by increased patch creation is only suitable for species with high dispersal propensity adapted to variable environments (aside from habitat patch turnover). This implies that conservation policies which rely on such compensation, like offsetting and conservation banking, are feasible only for this type of species.},
  significance = {In this study, led by Karin Johst, the authors use an analytical formula for metapopulation lifetime in dynamic landscapes to ask whether a change in one landscape attribute, such as faster patch destruction, can be compensated by changes in others, including patch number, connectivity or patch creation. Compensation is possible only to a certain extent and the trade-offs are generally nonlinear, so the effectiveness of a conservation measure depends on the current state of the landscape; where patch turnover is high, improving other attributes does little to maintain viability. Offsetting destruction by creating new habitat is suitable only for species with high dispersal propensity adapted to variable environments, which limits the scope of offsetting and conservation banking policies.},
  license = {publisher (subscription)},
}

@incollection{watzold2011applying,
  author    = {W{\"a}tzold, Frank and Drechsler, Martin and Hartig, Florian and Wissel, Silvia},
  title     = {Applying tradable permits to biodiversity conservation: design issues, modelling and policies},
  scholar_id = {Zph67rFs4hoC},
  booktitle = {Permit Trading in Different Applications},
  publisher = {Routledge},
  year      = {2011},
  pages      = {157--173},
  note      = {Book chapter, edited by B. Hansj{\"u}rgens, R. Antes and M. Strunz.},
  abstract = {Habitat loss and fragmentation caused by economic development are major threats to the conservation of biodiversity (Millennium Ecosystem Assessment 2005). Policy responses aimed at addressing this threat have so far been inadequate. The main policy response -- the designation of areas as reserves where economic development is not allowed -- has generated some protection. However, the selection of reserves may not have led to a cost-effective allocation of land between areas for conservation and areas for economic development (see Ando et al. 1998 for the general idea of cost-effective land allocation, and Polasky et al. 2008 for an empirical analysis where land allocation is not cost-effective).},
  significance = {In this book chapter, led by Frank Wätzold, the authors consider how tradable permits could be applied to biodiversity conservation, addressing questions of design, modelling and policy. The authors start from the observation that habitat loss and fragmentation driven by economic development threaten biodiversity, and that the main policy response, designating reserves closed to development, may not have allocated land cost-effectively between conservation and economic use.},
  abstract_kind = {opening},
}

% ------------------------------------------------------------------ 2010 ----

@article{hartig2010ecotrade,
  author  = {Hartig, Florian and Horn, Martin and Drechsler, Martin},
  title   = {EcoTRADE – A multi-player network game of a tradable permit market for biodiversity credits},
  journal = {Environmental Modelling \& Software},
  year    = {2010},
  volume  = {25},
  number  = {11},
  pages   = {1479--1480},
  doi     = {10.1016/j.envsoft.2009.01.003},
  abstract = {EcoTRADE is a multi-player network game of a virtual biodiversity credit market. Each player controls the land use of a certain amount of parcels on a virtual landscape. The biodiversity credits of a particular parcel depend on neighboring parcels, which may be owned by other players. The game can be used to study the strategies of players in experiments or classroom games and as a communication tool for stakeholders participating in credit markets that include spatially interdependent credits.},
  preprint = {https://arxiv.org/abs/0812.0956},
  significance = {Tradable permits are an economic instrument for controlling the use of environmental resources: rights to use are traded. Carbon emissions trading is one example; in recent years similar schemes, called biobanking or biodiversity credit trading, have also been used to restrict land use and maintain natural habitats (Wissel and Wätzold 2010). Unlike carbon emissions, however, biodiversity credits (tradable units of habitat conservation) cannot be issued independently of location. Species depend on the connectedness of their habitat, so conserving a site is worth more near other conserved sites, and credits should be issued accordingly (Drechsler and Wätzold 2009). The problem the paper takes on is that such spatially interdependent credits make landowners influence each other’s payoffs (Hartig and Drechsler 2010), which leaves open how participants behave and how the difficulty can be conveyed to stakeholders. \par EcoTRADE is a networked multiplayer game in which players trade biodiversity credits whose amount depends on how neighbouring parcels, possibly owned by other players, are used, which makes the problem of spatially interdependent credits tangible. Each player starts with land and a conservation obligation and sets each parcel to conservation or agriculture. A player who falls short of the obligation must buy credits from others; a surplus can be sold. The aim is to maximise profit from farming and credit sales. The paper reports use in several workshops, with participants ranging from children aged 10 to 15 to ecology and economics students and scientists in conservation and resource economics. According to the authors, the game proved useful for observing typical player behaviour and strategies and for communicating the problems of spatially interdependent credits. This experience is described informally, without data. \par The paper poses questions that such credit markets raise: whether landowners coordinate or cooperate to raise profits, whether they find the land configurations that pay best, and whether they consider it unfair that others influence their payoffs. The authors hope the game will be used for classroom games, stakeholder workshops and experimental economics. The paper itself makes no claim about how real credit markets perform; its contribution is the game itself, first available in 2008, with documentation and an online applet offered at the time of publication.},
  significance_refs = {10.1111/j.1523-1739.2009.01444.x 10.1016/j.ecolecon.2008.07.019 10.1016/j.ecocom.2009.07.001},
  license = {publisher (subscription)},
}

@article{hartig2010stay,
  author  = {Hartig, Florian and Drechsler, Martin},
  title   = {Stay by thy neighbor? Social organization determines the efficiency of biodiversity markets with spatial incentives},
  journal = {Ecological Complexity},
  year    = {2010},
  volume  = {7},
  number  = {1},
  pages   = {91--99},
  doi     = {10.1016/j.ecocom.2009.07.001},
  preprint = {https://arxiv.org/abs/0808.0111},
  abstract = {Market-based conservation instruments, such as payments, auctions or tradable permits, are environmental policies that create financial incentives for landowners to engage in voluntary conservation on their land. But what if ecological processes operate across property boundaries and land use decisions on one property influence ecosystem functions on neighboring sites? This paper examines how to account for such spatial externalities when designing market-based conservation instruments. We use an agent-based model to analyze different spatial metrics and their implications on land use decisions in a dynamic cost environment. The model contains a number of alternative submodels which differ in incentive design and social interactions of agents, the latter including coordinating as well as cooperating behavior of agents. We find that incentive design and social interactions have a strong influence on the spatial allocation and the costs of the conservation market.},
  significance = {Market-based conservation schemes (payments, auctions, tradable permits) award landowners credits for voluntary conservation. Ecological processes often cross property boundaries, so a conserved site is worth more when its neighbours are conserved too. Spatial incentives, such as those of Parkhurst et al. (2002), build this into the credits. The paper asks how the benefit shared by neighbouring sites should be divided: equally between them (“additive” incentives) or by crediting each site with the loss in total value that its removal would cause (“marginal” incentives). It also asks whether landowners who each decide for themselves produce the intended landscape pattern at reasonable cost. Finally, it asks whether the design of the incentive alone settles the outcome, or whether the social organisation of the landowners matters as well. \par In market-based conservation with spatial incentives, both the design of the incentive and the social organisation of the landowners shape the resulting landscape pattern and what it costs. The paper shows this with an agent-based model: every cell of a 50 × 50 grid has its own owner, and costs fluctuate. Owners who decide individually end up with either one large cluster of conserved sites or scattered ones, switching sharply between the two once the variation in costs passes a critical level. They stop trading once no owner can gain alone, leaving them in a local cost optimum: an arrangement that no individual move can improve. Additive incentives make owners abandon the cluster too early, at a cost variation of about 0.33 instead of 0.5 under marginal incentives (for a connectivity weight of 0.5). This raises costs by roughly 20% near the transition. Non-binding exchange of intentions (“cheap talk”) closes most of the cost gap without moving the transition. With full cooperation, costs are lowest, the response is gradual, and the two incentive types perform identically. \par The results suggest that simple local incentives can steer landscape-scale conservation. Marginal incentives, which depend on the order of trading, suit sequential, long-term schemes such as tradable permits; additive incentives, for which the order does not matter, suit parallel, short-term schemes such as yearly payments. If landowners decide individually, marginal incentives perform better. The paper concludes that market designs encouraging cooperation among landowners look beneficial, while leaving open whether it is stable against free-riding and strategic misreporting, which the model excludes.},
  significance_refs = {10.1016/S0921-8009(02)00036-8},
  license = {publisher (subscription)},
}

@phdthesis{hartig2010metapopulations,
  author   = {Hartig, Florian},
  title    = {Metapopulations, Markets and the Individual: Refining incentive-based approaches for biodiversity conservation on private lands},
  school   = {University of Osnabr{\"u}ck},
  year     = {2009},
  url      = {https://osnadocs.ub.uni-osnabrueck.de/handle/urn:nbn:de:gbv:700-2010012932},
  abstract = {When designing financial incentives for voluntary conservation of threatened habitats and ecosystems, we are faced with the problem that there is no single indicator for "biodiversity value". The value of a habitat depends on multiple factors such as habitat type, area, and spatial and temporal connectivity. Moreover, not only are there local trade-offs between these indicators, but land use changes at one location may also change the value of sites in the vicinity. This doctoral thesis analyzes the consequences of including trade-offs and interactions between sites in market-based conservation schemes. We ask the following questions: How can trade-offs between the survival of different species be quantified? How can spatial processes and temporal processes be included in market-based conservation, in particular the value of spatial and temporal connectivity? And how do underlying economic dynamics relate to the spatio-temporal allocation of conservation measures in market-based conservation schemes?},
  significance = {In this doctoral thesis, I examine how market-based schemes for voluntary conservation on private land can cope with the absence of a single indicator of biodiversity value, given that a site's value depends on habitat type, area and spatial and temporal connectivity, and that land-use change on one site alters the value of nearby sites. I ask how trade-offs between the survival of different species can be quantified, how spatial and temporal processes, including connectivity, can be built into conservation markets, and how the underlying economic dynamics shape where and when conservation measures are allocated.},
}

