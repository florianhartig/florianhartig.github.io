@article{hartig2009smart,
  author  = {Hartig, Florian and Drechsler, Martin},
  title   = {Smart spatial incentives for market-based conservation},
  journal = {Biological Conservation},
  year    = {2009},
  volume  = {142},
  number  = {4},
  pages   = {779--788},
  doi     = {10.1016/j.biocon.2008.12.014},
  abstract = {Market-based instruments such as payments, auctions or tradable permits have been proposed as flexible and cost-effective instruments for biodiversity conservation on private lands. Trading the service of conservation requires one to define a metric that determines the extent to which a conserved site adds to the regional conservation objective. Yet, while markets for conservation are widely discussed and increasingly applied, little research has been conducted on explicitly accounting for spatial ecological processes in the trading. In this paper, we use a coupled ecological–economic simulation model to examine how spatial connectivity may be considered in the financial incentives created by a market-based conservation scheme. Land use decisions, driven by changing conservation costs and the conservation market, are simulated by an agent-based model of land users. On top of that, a metapopulation model evaluates the conservational success of the market. We find that optimal spatial incentives for agents correlate with species characteristics such as the dispersal distance, but they also depend on the spatio-temporal distribution of conservation costs. We conclude that a combined analysis of ecological and socio-economic conditions should be applied when designing market instruments to protect biodiversity.},
  preprint = {https://arxiv.org/abs/0809.0228},
  significance = {Payments, auctions and tradable permits are promoted as cost-effective ways to conserve biodiversity on private land. Each needs a metric that turns a conserved site into conservation credits. Most existing schemes value a site only by its own size and quality, although for many species a site’s worth depends on the habitat around it. Connectivity metrics from reserve planning are an obvious model, but they assume a planner who sees the whole landscape. Landowners in a market decide individually and with limited information, so copying the planners’ metrics directly would be short-sighted. The paper takes on the problem of how connectivity should enter the incentives of such landowners. \par Rewarding landowners for the connectivity of the sites they conserve (how much conserved habitat lies nearby), and not only for size and quality, considerably improves the outcome of a conservation market where dispersal limits the species concerned; the best form of that reward depends on the species and on how conservation costs vary. The study couples a model of landowners trading credits under a fixed budget with a stochastic metapopulation model (colonisations and extinctions of local populations) on a virtual landscape. Markets with a connectivity reward gave higher species survival than markets without one, most clearly for species that disperse over short distances. These did best when a site’s credits depended strongly on conserved habitat in its immediate surroundings, whereas species that disperse across the whole landscape did better with a low weight, because that lets the budget pay for more conserved sites. The cost pattern shifted the optimum too, because the incentive also changes turnover, the rate at which conserved sites are dropped and recreated elsewhere, and turnover acts like extra local extinction. With uncorrelated random costs, a strong connectivity weight was best for all species because it lowers turnover. \par The results suggest that spatial incentives may raise the cost-effectiveness of conservation markets substantially where fragmentation limits the species concerned. Because a voluntary market lets landowners withdraw while others step in, it is likely to produce dynamic landscapes, and this turnover must be considered in design. Optimal spatial incentives are not context-free: ecological and socio-economic conditions should be analysed together. The paper also recommends examining the efficiency gains that spatially explicit metrics could bring to existing market schemes.},
  license = {publisher (subscription)},
}

