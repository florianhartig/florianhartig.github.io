@article{fassnacht2014importance,
  author  = {Fassnacht, Fabian and Hartig, Florian and Latifi, Hooman and Berger, Christian and Hern{\'a}ndez, Jaime and Corval{\'a}n, Patricio and Koch, Barbara},
  title   = {Importance of sample size, data type and prediction method for remote sensing-based estimations of aboveground forest biomass},
  journal = {Remote Sensing of Environment},
  year    = {2014},
  volume  = {154},
  pages   = {102--114},
  doi     = {10.1016/j.rse.2014.07.028},
  abstract = {Estimates of forest biomass are needed for various technical and scientific applications, ranging from carbon and bioenergy policies to sustainable forest management. As local measurements are costly, there is a great interest in obtaining reliable estimates over large areas from remote sensing data. Currently, such estimates are obtained with a variety of data sources, statistical methods and prediction standards, and there is no agreement on what are best practices for this task. To improve our understanding of how these different methods affect prediction quality, we first conducted a systematic review of the available literature to identify the most common sensor types and prediction methods. Based on the review, we identified sample size of the reference points on the ground, prediction method (stepwise linear regression, support vector machines, random forest, Gaussian processes and k-nearest neighbor), and sensor type as the main differences that could potentially affect predictive quality. We then compared those factors in two case study areas in Germany and Chile, for which airborne discrete return Light Detection And Ranging (LiDAR) and airborne hyperspectral as well as airborne discrete return LiDAR and spaceborne hyperspectral data were available. For each factor combination, we calculated Pearson's coefficient of correlation between observations and predictions (r²) and root mean squared error (RMSE) for bootstrapped estimates using k-fold cross-validation with a varying number of folds. Finally, Analysis of Variance (ANOVA) was used to quantify the influence of the factors on the predictive error of the biomass models. Our results confirm previous findings that predictor data (sensor) type is the most important factor for the accuracy of biomass estimates, with LiDAR being preferable to hyperspectral data. In contrast to some previous studies, complementing LiDAR with hyperspectral data did not improve predictive accuracy. Also the prediction method had a substantial effect on accuracy and was generally more important than the sample size. In most cases, random forest performed best and stepwise linear models worst, judging from r² and RMSE under cross-validation. Additional results suggested that r² may deliver unrealistically large values when the hold-out sample during the cross-validation is too small. In conclusion, our literature review revealed that different methods for biomass estimation are currently used, with no general agreement on best practices. In our case studies, we found substantial accuracy differences between those methods, with LiDAR data, in combination with a random forest algorithm and a large number of reference sample units on the ground yielding the lowest error for biomass predictions. The comparatively high importance of the statistical prediction method seems particularly relevant, as they suggest that choosing the appropriate statistical method may be more effective than obtaining additional field data for obtaining good biomass estimates. Considering the costs of improving accuracy of global and regional biomass estimates by ground measurements, it seems sensible to invest in further comparative studies, preferably with a wider range of sites and including also RADAR sensors, to establish robust best-practice recommendations for obtaining regional and global biomass estimates from remote-sensing data.},
  significance = {Estimates of forest biomass are needed for carbon accounting, bioenergy planning and forest management. Ground measurements are costly, so maps over large areas are built by training statistical models on a limited number of field plots, using remote sensing data such as LiDAR (laser scanning, which captures canopy height) and hyperspectral imagery (light recorded in many narrow wavelength bands). The paper’s own systematic review of 113 studies found a wide mix of sensors, prediction methods, sample sizes and validation practices; results are therefore hard to compare, and there is still no agreement on best practice. More field plots are one way to improve estimates, but they are expensive. The paper asks how much the number of plots, the sensor type and the prediction method each contribute to accuracy. \par The study finds that, in two case studies on forest biomass estimated from remote sensing data, the choice of statistical prediction method affects accuracy more than the number of field plots and second only to the type of sensor. The case studies are in Germany and Chile; the study resampled the field data, fitted five prediction methods and used analysis of variance (ANOVA, which splits variation in accuracy among factors) to rank the factors. LiDAR performed better than hyperspectral data, and adding hyperspectral data to LiDAR did not improve accuracy. Random forest, which averages many decision trees, usually performed best, and stepwise linear regression was among the worst methods. A second result concerns how accuracy is judged: when cross-validation hold-out sets were very small (three to four samples, at the Chilean site Monte Oscuro), r², the correlation between observed and predicted values, became unrealistically high, whereas the root mean squared error (RMSE) was not notably affected. \par The paper reads these results as a sign that choosing the statistical method well can be more effective than collecting additional field data, although a minimum number of plots is still needed. Within the limits of the data and methods tested, it advises LiDAR with many reference plots and random forest, and reporting at least RMSE and one correlation measure rather than r² alone. It names its limits as two sites, two kinds of sensor and five methods, and calls for repeats on more sites and sensors, including RADAR.},
  license = {publisher (subscription)},
  funding = {Deutsches Zentrum für Luft- und Raumfahrt e.V. (50EE1025); Deutsches Zentrum für Luft- und Raumfahrt e.V. (50EE1265); BioComsa, Consorcio Tecnológico de Biocombustibles S.A},
}

@article{hartig2014sympatric,
  author  = {Hartig, Florian and M{\"u}nkem{\"u}ller, Tamara and Johst, Karin and Dieckmann, Ulf},
  title   = {On the Sympatric Evolution and Evolutionary Stability of Coexistence by Relative Nonlinearity of Competition},
  journal = {PLoS ONE},
  year    = {2014},
  volume  = {9},
  number  = {9},
  pages   = {e94454},
  doi     = {10.1371/journal.pone.0094454},
  abstract = {If two species exhibit different nonlinear responses to a single shared resource, and if each species modifies the resource dynamics such that this favors its competitor, they may stably coexist. This coexistence mechanism, known as relative nonlinearity of competition, is well understood theoretically, but less is known about its evolutionary properties and its prevalence in real communities. We address this challenge by using adaptive dynamics theory and individual-based simulations to compare community stabilization and evolutionary stability of species that coexist by relative nonlinearity. In our analysis, evolution operates on the species' density-compensation strategies, and we consider a trade-off between population growth rates at high and low resource availability. We confirm previous findings that, irrespective of the particular model of density dependence, there are many combinations of overcompensating and undercompensating density-compensation strategies that allow stable coexistence by relative nonlinearity. However, our analysis also shows that most of these strategy combinations are not evolutionarily stable and will be outcompeted by an intermediate density-compensation strategy. Only very specific trade-offs lead to evolutionarily stable coexistence by relative nonlinearity. As we find no reason why these particular trade-offs should be common in nature, we conclude that the sympatric evolution and evolutionary stability of relative nonlinearity, while possible in principle, seems rather unlikely. We speculate that this may, at least in part, explain why empirical demonstrations of this coexistence mechanism are rare, noting, however, that the difficulty to detect relative nonlinearity in the field is an equally likely explanation for the current lack of empirical observations, and that our results are limited to communities with non-overlapping generations and constant resource supply. Our study highlights the need for combining ecological and evolutionary perspectives for gaining a better understanding of community assembly and biogeographic patterns.},
  significance = {Many ways for species to coexist beyond classical niche differences are plausible, and community-level data and ecological models have not settled which of them sustain diversity. Asking whether selection would produce and maintain a given mechanism can complement these approaches. Relative nonlinearity of competition (RNC) is a candidate: species respond differently and nonlinearly to a shared resource, and each shapes the resource’s fluctuations in a way that favours its competitor. Its theory is relatively well understood, and coexistence that is stable on ecological time scales is a plausible contributor to diversity. The paper takes on the step from this dynamic stability to evolutionary stability: whether such a mechanism can also arise and persist under evolution. \par The paper asks whether coexistence through relative nonlinearity of competition (RNC) survives evolution and finds that it generally does not: many pairs of species coexist stably, but selection favours a single intermediate strategy that excludes them. The study lets species evolve their “density-compensation strategy” (how strongly growth reacts when numbers depart from the carrying capacity) under a trade-off between growth at high and at low resource availability. Adaptive dynamics theory and individual-based simulations of classical population models show that strongly and weakly compensating strategies coexist stably; in the simulations, times to exclusion are up to four orders of magnitude longer than for two species with identical strategies. Yet evolution, even when started from such a pair, ends at one intermediate strategy near the onset of population cycles, which excludes both. Of the trade-offs examined, only a deliberately modified, irregular one led one strategy to split into a stable pair, and it needed fine-tuning that depends on growth rate and mortality. A flowering-time study parameterised with field data (Metcalf et al. 2008) likewise found coexisting strategies to be evolutionarily unstable. \par The paper concludes that sympatric evolution and evolutionary stability of RNC are possible in principle but unlikely, as nothing suggests that such finely tuned trade-offs are common. It speculates that this may partly explain why empirical demonstrations are rare, although the difficulty of detecting RNC in the field is an equally likely explanation. The results are limited to non-overlapping generations, constant resource supply and unstructured space. More generally, dynamic and evolutionary stability are different properties of a coexistence mechanism and need to be assessed together.},
  significance_refs = {10.1073/pnas.0800777105},
  license = {CC BY 4.0},
  funding = {ERC Advanced Grant (FH) (233066); European Community's Seventh Framework Programme (FP7/2007-2013), TEEMBIO (TM) (grant agreement no 281422); European Commission (UD); European Science Foundation (UD); Austrian Science Fund (UD); Austrian Ministry for Science and Research (UD); Vienna Science and Technology Fund (UD)},
}

@article{teeffelen2014ecological,
  author  = {van Teeffelen, Astrid J. A. and Opdam, Paul and Wätzold, Frank and Hartig, Florian and Johst, Karin and Drechsler, Martin and Vos, Claire C. and Wissel, Silvia and Quétier, Fabien},
  title   = {Ecological and economic conditions and associated institutional challenges for conservation banking in dynamic landscapes},
  journal = {Landscape and Urban Planning},
  year    = {2014},
  volume  = {130},
  pages   = {64--72},
  doi     = {10.1016/j.landurbplan.2014.06.004},
  abstract = {Protected areas are a cornerstone of current biodiversity policy. The continued loss of biodiversity, however, as well as the limited scope to extend protected area networks necessitates a conservation perspective that encompasses both protected areas and the wider landscape. This calls for policy instruments that can govern land use dynamics, simultaneously meeting demands for conservation (i.e. no net loss of biodiversity) and economic development. Conservation banking could be such an instrument, but only when certain criteria are met. Building on the theory of ecological networks, we combine ecological, economic and institutional perspectives on conservation banking to identify when and where conservation banking could be feasible. Economic prerequisites include sufficient market activity to match demand and supply. Adequate regulatory capacity is needed to design and enforce trading rules. From an ecological perspective, habitat turnover is least detrimental in large and well-connected networks. For many ecosystem types, those prerequisites will be rarely met in practice: sufficient market activity implies sufficient habitat turnover, but most ecological networks are not robust enough to buffer frequent habitat turnover. Therefore, banking is best limited to common and fast-regenerating ecosystem types (e.g. certain coastal systems, wetlands, nutrient-rich grasslands). Furthermore, conservation banking could be applied to a subset of the network only, i.e. the wider landscape, as a complementary instrument to protected area policy. With appropriate trading rules and institutional arrangements, the loss and gain of habitat could be governed to improve the spatial cohesion and size of ecological networks and the capacity of landscapes to support biodiversity.},
  significance = {Protected areas alone are not expected to stop biodiversity loss and are hard to extend, so conservation also has to work in landscapes used for other purposes. This calls for instruments that let development proceed while biodiversity overall is not reduced (“no net loss”). Conservation banking is one candidate: landowners restore habitat and earn tradable credits, which developers buy to compensate for habitat they destroy. The paper notes earlier suggestions that, with suitable trading rules, such a scheme can shift habitat around in space and time while keeping its ecological value, and banking has been regarded as a promising part of the policy mix. The problem the paper takes on is whether the ecological, economic and institutional conditions such a scheme requires can be met at the same time. \par The paper argues that conservation banking can secure no net loss only where ecological, economic and institutional conditions hold together, and that for many ecosystems they conflict. Ecologically, a species persists in a network of habitat patches by recolonising patches after local extinctions, and habitat turnover (patches destroyed and re-created) makes this harder. Large, well-connected networks of fast-regenerating habitat tolerate turnover best; in a worked example (Fig. 2), longer regeneration or faster turnover demands more patches. Economically, a credit market needs enough buyers, sellers and trading, and development, and thus habitat turnover, is a main source of trading activity. Institutionally, authorities must design and enforce the trading rules, which takes expertise. Where regeneration is slow or uncertain, the ecological and economic perspectives are both unfavourable and strict protection is the only option that may avoid net loss. The conditions overlap mainly for common, fast-regenerating ecosystem types, such as certain coastal systems, nutrient-rich marshes and nutrient-rich grasslands. \par The paper reads these results as limiting banking, not rejecting it. Endangered habitats rarely have large networks and short restoration times, so banking is no substitute for protecting them. In the wider landscape, for common ecosystem types, it can complement protected areas, provided trading rules reflect network size, connectivity and each patch’s contribution and governments supply the regulatory capacity. The paper cautions against loosening equivalence rules (the rules defining which restored habitat counts as equivalent) to raise offset supply, as was considered in the Netherlands for protected areas and species in unfavourable condition.},
  license = {publisher (subscription)},
  funding = {European Science Foundation; Dutch Ministry of Agriculture, Nature Conservation and Food Quality; European Union (308393 “OPERAs”)},
}

@article{peer2014eu,
  author   = {Pe'er, G. and Dicks, L. V. and Visconti, P. and Arlettaz, R. and B{\'a}ldi, A. and Benton, T. G. and Collins, S. and Dieterich, M. and Gregory, R. D. and Hartig, F. and Henle, K. and Hobson, P. R. and Kleijn, D. and Neumann, R. K. and Robijns, T. and Schmidt, J. and Shwartz, A. and Sutherland, W. J. and Turb{\'e}, A. and Wulf, F. and Scott, A. V.},
  title    = {EU agricultural reform fails on biodiversity},
  journal  = {Science},
  year     = {2014},
  volume   = {344},
  number   = {6188},
  pages    = {1090--1092},
  doi      = {10.1126/science.1253425},
  abstract = {Extra steps by Member States are needed to protect farmed and grassland ecosystems},
  featured = {true},
  significance = {Agricultural expansion and intensification are major drivers of biodiversity loss, and in Europe the habitats tied to farming, such as grasslands and peatlands, have the worst conservation status of all ecosystems. The EU’s Common Agricultural Policy (CAP) accounts for almost 40% of the EU budget and influences management of half its land, giving it more environmental impact than any other EU policy. In 2010 the Commission proposed tying 30% of direct payments to three “greening” measures in the 2014–2020 reform, and the enacted reform was presented as greener. A greener CAP is consistent with the EU Biodiversity Strategy for 2020, which asks the CAP to maximise areas under biodiversity-related measures. The paper questions the assumption that the greening measures, as finally negotiated, will benefit biodiversity. \par The paper argues that the 2014–2020 reform of the EU’s Common Agricultural Policy fails on biodiversity: its greening measures are so diluted that they are unlikely to help, while funding for rural development (Pillar 2), which pays for voluntary agri-environment schemes, falls. Ecological Focus Areas, areas on farms meant to benefit nature, were cut from a proposed 7% to 5% of farmed area and apply only to farms with more than 15 ha of arable land, a threshold that exempts at least 88% of EU farms. The land uses that qualify, such as nitrogen-fixing crops, are not known to benefit biodiversity. Permanent grassland may shrink by up to 5% of its net area, with little protection outside the EU’s Natura 2000 sites. The crop-diversity requirement exempts farms under 10 ha and, in many Member States, sets a minimum below the average crop diversity farms already have. Pillar 2 funding falls by 18% in absolute terms. \par The paper concludes that the EU has lost an opportunity, but that the increased devolution of responsibility to the Member States leaves them flexibility to protect farmland habitats. If they adopt only the minimum requirements, the EU’s 2020 biodiversity targets and the relevant global Aichi targets would be undermined. The paper gives six recommendations for Member States and five actions for the next reform, among them a larger agri-environment budget with outcome-based rather than area-based targets and fewer exemptions for Ecological Focus Areas. A follow-up by Pe’er et al. (2020) set out action points for the post-2020 policy.},
  significance_refs = {10.1002/pan3.10080},
  license = {publisher (subscription)},
  funding = {EC FP7 project SCALES (226852); Swiss National Science Foundation (31003A-120152); Swiss Government; EC FP7 project LIBERATION (311781); MTA Lendület; Arcadia; Natural Environment Research Council (NE/K015419/1)},
}

@article{hartig2014technical,
  author  = {Hartig, F. and Dislich, C. and Wiegand, T. and Huth, A.},
  title   = {Technical Note: Approximate Bayesian parameterization of a process-based tropical forest model},
  journal = {Biogeosciences},
  year    = {2014},
  volume  = {11},
  number   = {4},
  pages   = {1261--1272},
  doi     = {10.5194/bg-11-1261-2014},
  abstract = {Inverse parameter estimation of process-based models is a long-standing problem in many scientific disciplines. A key question for inverse parameter estimation is how to define the metric that quantifies how well model predictions fit to the data. This metric can be expressed by general cost or objective functions, but statistical inversion methods require a particular metric, the probability of observing the data given the model parameters, known as the likelihood. For technical and computational reasons, likelihoods for process-based stochastic models are usually based on general assumptions about variability in the observed data, and not on the stochasticity generated by the model. Only in recent years have new methods become available that allow the generation of likelihoods directly from stochastic simulations. Previous applications of these approximate Bayesian methods have concentrated on relatively simple models. Here, we report on the application of a simulation-based likelihood approximation for FORMIND, a parameter-rich individual-based model of tropical forest dynamics. We show that approximate Bayesian inference, based on a parametric likelihood approximation placed in a conventional Markov chain Monte Carlo (MCMC) sampler, performs well in retrieving known parameter values from virtual inventory data generated by the forest model. We analyze the results of the parameter estimation, examine its sensitivity to the choice and aggregation of model outputs and observed data (summary statistics), and demonstrate the application of this method by fitting the FORMIND model to field data from an Ecuadorian tropical forest. Finally, we discuss how this approach differs from approximate Bayesian computation (ABC), another method commonly used to generate simulation-based likelihood approximations. Our results demonstrate that simulation-based inference, which offers considerable conceptual advantages over more traditional methods for inverse parameter estimation, can be successfully applied to process-based models of high complexity. The methodology is particularly suitable for heterogeneous and complex data structures and can easily be adjusted to other model types, including most stochastic population and individual-based models. Our study therefore provides a blueprint for a fairly general approach to parameter estimation of stochastic process-based models.},
  preprint = {https://arxiv.org/abs/1401.8205},
  significance = {Bayesian calibration of a process-based model requires the likelihood: the probability of the observations given particular parameter values. Most Bayesian calibrations of process-based ecological models have assumed how observations scatter around the model’s mean prediction, either ad hoc or from the variance in the data. Such assumptions are practical and can reflect measurement error, but are unrelated to the model’s processes, whereas many process-based models are stochastic and already predict variability, which a mechanism-based likelihood could use. Deriving such likelihoods used to be intractable; simulation-based approximations now exist but had mainly been applied to relatively simple models. The paper asks whether they work for a computationally expensive, parameter-rich model. \par The paper shows that Bayesian calibration of a stochastic process-based model can use a likelihood computed from the model’s own simulations instead of assumptions about how observations scatter around its mean prediction, even for a parameter-rich, individual-based model; the model’s mechanisms must then explain both the mean and the variability of the data. The study repeatedly simulates FORMIND, a model of tropical forest dynamics, and fits a normal distribution to the simulated outputs (the “synthetic likelihood” of Wood 2010). This likelihood is used in a conventional Markov chain Monte Carlo sampler, which explores plausible parameter values. On virtual inventories generated by the model itself, where the true parameters are known, the most detailed data recovered the estimated parameters largely without bias, while coarser data summaries or more free parameters widened the uncertainty of the estimates and strengthened correlations between parameters. Fitted to tree size data from an Ecuadorian montane forest, the method considerably narrowed the prior ranges of the mortality and growth parameters and gave values broadly similar to an earlier manual calibration, with some differences in mortality. \par The results show that simulation-based inference is feasible for a model of this complexity, at 2–5 times the computing time of a conventional Bayesian approach, since the model has to be run to equilibrium anyway. The paper argues that such likelihoods are a promising and fairly general route for calibrating stochastic models, particularly those that are run to equilibrium. If the model contains the dominant sources of variability, the likelihood weights different kinds of data and accounts for their correlations automatically, and competing mechanistic hypotheses can be compared with formal statistical tests.},
  significance_refs = {10.1038/nature09319},
  license = {CC BY 3.0},
  funding = {ERC advanced grant (FH) (233066); German Research Foundation (DFG), Research Unit 816 (C. Dislich); Research Centre of the Helmholtz Association (open access publication charges)},
}

