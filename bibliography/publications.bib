@article{morlon2022studying,
  author   = {Morlon, H{\'e}l{\`e}ne and Robin, St{\'e}phane and Hartig, Florian},
  title    = {Studying speciation and extinction dynamics from phylogenies: addressing identifiability issues},
  journal  = {Trends in Ecology \& Evolution},
  year     = {2022},
  volume   = {37},
  number   = {6},
  pages    = {497--506},
  doi      = {10.1016/j.tree.2022.02.004},
  abstract = {A lot of what we know about past speciation and extinction dynamics is based on statistically fitting birth-death processes to phylogenies of extant species. Despite their wide use, the reliability of these tools is regularly questioned. It was recently demonstrated that vast "congruent" sets of alternative diversification histories cannot be distinguished (i.e., are not identifiable) using extant phylogenies alone, reanimating the debate about the limits of phylogenetic diversification analysis. Here, we summarize what we know about the identifiability of the birth-death process and how identifiability issues can be addressed. We conclude that extant phylogenies, when combined with appropriate prior hypotheses and regularization techniques, can still tell us a lot about past diversification dynamics.},
  featured = {true},
  significance = {Past speciation and extinction are mostly inferred by fitting birth–death models, which describe lineage splitting and extinction, to dated family trees (phylogenies) of living species. Louca and Pennell (2020) proved that if speciation and extinction rates may vary freely, infinitely many different diversification histories (called congruent) give exactly the same likelihood, so the data cannot tell them apart. They proposed switching to so-called “pulled” rates, which are identifiable but hard to interpret. The paper accepts the result but challenges the assumption behind the conclusion, namely that the aim is to recover completely unconstrained rate functions. Only under that assumption would non-identifiability mean that phylogenies cannot reveal speciation and extinction dynamics. \par The paper reviews which birth–death models can be identified from phylogenies and argues that non-identifiability is a familiar problem in science, usually handled by constraining the model. It separates problems that persist with unlimited data (asymptotic) from those caused by realistic tree sizes (practical). Remedies are reparameterising with identifiable quantities (at the cost of interpretability), adding fossils, testing a few biologically motivated hypotheses set in advance, and preferring simple solutions through parsimony or regularisation (penalties or Bayesian priors that encode a preference for simplicity or prior biological knowledge). May et al. (2016) showed that a prior on the share of species surviving a mass extinction makes it possible to tell mass extinctions from shifts in the underlying speciation and extinction rates, in an otherwise unidentifiable model. This is a counter-example to the claim that regularisation cannot resolve non-identifiability. A simplified analysis of Madagascan vangas illustrates the point: the two families of congruent models examined for the best-supported “early burst” model (fast speciation at the origin of the group, then a slowdown) are either biologically implausible, with negative extinction rates, or keep its declining speciation trend. \par The paper concludes that non-identifiability of the fully flexible model limits unconstrained inference, not phylogenetic diversification analysis as such. Estimates of speciation and extinction rates can remain informative when interpreted in light of the hypotheses or regularising assumptions behind them, and the paper advocates regularised models that act directly on these rates. Whether such constraints steer inference towards the true history among many congruent ones is left open. The paper suggests testing this mathematically and by simulating eco-evolutionary models.},
  significance_refs = {10.1038/s41586-020-2176-1 10.1111/2041-210x.12563},
  license = {publisher (subscription)},
}

@article{hartig2022evidence,
  author  = {Hartig, Florian and Barraquand, Fr{\'e}d{\'e}ric},
  title   = {The evidence contained in the P-value is context dependent},
  journal = {Trends in Ecology \& Evolution},
  year    = {2022},
  volume  = {37},
  number  = {7},
  pages   = {569--570},
  doi     = {10.1016/j.tree.2022.02.011},
  abstract = {In a recent opinion article, Muff et al. recapitulated well-known objections to the Neyman-Pearson Null-Hypothesis Significance Testing (NHST) framework and called for reforming our practices in statistical reporting. We agree with them on several important points: the significance threshold P < 0.05 is only a convention, chosen as a compromise between type I and II error rates; transforming the P-value into a dichotomous statement leads to a loss of information; and P-values should be interpreted together with other statistical indicators, in particular effect sizes and their uncertainties. In our view, a lot of progress in reporting results can already be achieved by keeping these three points in mind.},
  significance = {Muff et al. (2022a) proposed that results sections stop sorting findings into “significant” and “not significant” and instead describe p-values in a graded language of evidence, from “very strong evidence” for an effect at very small p-values down to “little or no evidence” when p exceeds 0.1. The idea has real appeal: it keeps the information that a yes-or-no verdict throws away, avoids an arbitrary cut-off and reads intuitively. It rests, however, on an assumption: that a given p-value stands for a fixed amount of evidence, whatever study produced it. \par Hartig and Barraquand argue that graded evidence labels for p-values mislead, because the evidence a p-value carries depends on the sample size and power of the study behind it. How much a given p-value speaks for or against an effect depends on how often such a value would arise with and without the effect, and that changes with the power of the study, a point Lakens (2022) also raised. The letter makes this concrete with a simulated t-test in which p-values are translated into the probability of an effect via the Bayes factor: with 200 observations the same p-value meant much less support for an effect than with 13, and most p-values above 0.1, which the proposal would label “little or no evidence”, in fact favoured the absence of an effect. A fixed verbal scale would therefore attach the same words to different amounts of evidence, and, the letter expects, most readers would take two results labelled “strong evidence” as equally convincing when they need not be. \par What follows for practice is simple. Researchers who want to avoid the significance cut-off can report the p-value as a number, and those who want to express the evidence for an effect should use a measure built for that purpose, such as the Bayes factor, whose limitations are at least well understood. In their joint reply, Muff et al. (2022b) accepted the point in principle but considered it relevant only for very small samples. The argument has since been taken up in work on significance levels that change with sample size (Wulff and Taylor 2024).},
  significance_refs = {10.1016/j.tree.2021.10.009|a 10.1016/j.tree.2021.12.006 10.1016/j.tree.2022.03.007|b 10.1177/14761270231214429},
  preprint = {https://arxiv.org/abs/2205.13488},
  abstract_kind = {opening},
  license = {publisher (subscription)},
}

@article{mahnken2022accuracy,
  author  = {Mahnken, Mats and Cailleret, Maxime and Collalti, Alessio and Trotta, Carlo and Biondo, Corrado and D'Andrea, Ettore and Dalmonech, Daniela and Marano, Gina and Mäkelä, Annikki and Minunno, Francesco and Peltoniemi, Mikko and Trotsiuk, Volodymyr and Nadal-Sala, Daniel and Sabaté, Santiago and Vallet, Patrick and Aussenac, Raphaël and Cameron, David R. and Bohn, Friedrich J. and Grote, Rüdiger and Augustynczik, Andrey L. D. and Yousefpour, Rasoul and Huber, Nica and Bugmann, Harald and Merganičová, Katarina and Merganic, Jan and Valent, Peter and Lasch-Born, Petra and Hartig, Florian and Vega del Valle, Iliusi D. and Volkholz, Jan and Gutsch, Martin and Matteucci, Giorgio and Krejza, Jan and Ibrom, Andreas and Meesenburg, Henning and Rötzer, Thomas and van der Maaten-Theunissen, Marieke and van der Maaten, Ernst and Reyer, Christopher P. O.},
  title   = {Accuracy, realism and general applicability of European forest models},
  journal = {Global Change Biology},
  year    = {2022},
  volume  = {28},
  number  = {23},
  pages   = {6921--6943},
  doi     = {10.1111/gcb.16384},
  abstract = {Forest models are instrumental for understanding and projecting the impact of climate change on forests. A considerable number of forest models have been developed in the last decades. However, few systematic and comprehensive model comparisons have been performed in Europe that combine an evaluation of modelled carbon and water fluxes and forest structure. We evaluate 13 widely used, state‐of‐the‐art, stand‐scale forest models against field measurements of forest structure and eddy‐covariance data of carbon and water fluxes over multiple decades across an environmental gradient at nine typical European forest stands. We test the models' performance in three dimensions: accuracy of local predictions (agreement of modelled and observed annual data), realism of environmental responses (agreement of modelled and observed responses of daily gross primary productivity to temperature, radiation and vapour pressure deficit) and general applicability (proportion of European tree species covered). We find that multiple models are available that excel according to our three dimensions of model performance. For the accuracy of local predictions, variables related to forest structure have lower random and systematic errors than annual carbon and water flux variables. Moreover, the multi‐model ensemble mean provided overall more realistic daily productivity responses to environmental drivers across all sites than any single individual model. The general applicability of the models is high, as almost all models are currently able to cover Europe's common tree species. We show that forest models complement each other in their response to environmental drivers and that there are several cases in which individual models outperform the model ensemble. Our framework provides a first step to capturing essential differences between forest models that go beyond the most commonly used accuracy of predictions. Overall, this study provides a point of reference for future model work aimed at predicting climate impacts and supporting climate mitigation and adaptation measures in forests.},
  significance = {In this study, led by Mats Mahnken, the authors evaluate thirteen stand-scale forest models against multi-decadal forest structure measurements and eddy-covariance carbon and water fluxes at nine European forest stands, judging them on the accuracy of local predictions, the realism of responses to environmental drivers and their coverage of European tree species. No single model was best on all three criteria; structural variables were predicted more accurately than annual fluxes, and the multi-model ensemble mean gave the most realistic daily productivity responses, although individual models sometimes beat the ensemble. Simpler models were not necessarily less accurate than complex ones, and the framework provides a benchmark against which new forest models can be tested.},
  license = {CC BY-NC 4.0},
  funding = {ERA-NET Cofund ForestValue (I-Maestro) (773324 and 22035418); Foundation Euro-Mediterranean Centre on Climate Change; ALForLab project, Italian National Operational Program for Research and Competitiveness (PON R&C) 2007-2013, European Regional Development Fund and national resource (Revolving Fund - Cohesion Action Plan) MIUR (PON03PE_00024_1); COST Action PROCLIAS (CA19139); ERA4CS Joint Call (ISIpedia), BMBF (01LS1711A); German Federal Ministry of Education and Research (BMBF), ISIAccess (16QK05); Bavarian Ministry of Science and the Arts, Bavarian Climate Research Network (bayklif); BiodivClim ERA-Net Cofund with Academy of Finland (project Funpotential) (344722)},
}

@article{schultz2022climate,
  author  = {Schultz, Emily L. and H{\"u}lsmann, Lisa and Pillet, Michiel D. and Hartig, Florian and Breshears, David D. and Record, Sydne and Shaw, John D. and DeRose, R. Justin and Zuidema, Pieter A. and Evans, Margaret E. K.},
  title   = {Climate-driven, but dynamic and complex? A reconciliation of competing hypotheses for species’ distributions},
  journal = {Ecology Letters},
  year    = {2022},
  volume  = {25},
  number  = {1},
  pages   = {38--51},
  doi     = {10.1111/ele.13902},
  abstract = {Estimates of the percentage of species “committed to extinction” by climate change range from 15% to 37%. The question is whether factors other than climate need to be included in models predicting species’ range change. We created demographic range models that include climate vs. climate‐plus‐competition, evaluating their influence on the geographic distribution of Pinus edulis, a pine endemic to the semiarid southwestern U.S. Analyses of data on 23,426 trees in 1941 forest inventory plots support the inclusion of competition in range models. However, climate and competition together only partially explain this species’ distribution. Instead, the evidence suggests that climate affects other range‐limiting processes, including landscape‐scale, spatial processes such as disturbances and antagonistic biotic interactions. Complex effects of climate on species distributions—through indirect effects, interactions, and feedbacks—are likely to cause sudden changes in abundance and distribution that are not predictable from a climate‐only perspective.},
  significance = {In this study, led by Emily L. Schultz, the authors use forest inventory data on the piñon pine Pinus edulis in the south-western United States to build demographic range models from vital rates rather than occurrence records, and compare a climate-only with a climate-plus-competition version. Including competition improved the fit to observed presence and absence, but both models predicted viable populations at cool, wet, high-elevation sites where the species is absent, and competition had negligible influence on survival, the vital rate that matters most for population growth. The authors propose that climate shapes distributions partly indirectly, through landscape-scale processes such as fire and its interaction with drought and insect outbreaks. If so, range dynamics under climate change may include sudden shifts that climate-only models cannot anticipate.},
  license = {publisher (subscription)},
  funding = {U.S. National Science Foundation (DBI-1632706; DBI-1802893); University of Arizona College of Science; NSF (DDB) (DEB 1824796); USGS SW Climate Adaptation Science Center (G20AC00257); Bavarian Ministry of Science and the Arts, Bavarian Climate Research Network (bayklif)},
}

@article{oberpriller2022climate,
  author  = {Oberpriller, Johannes and Herschlein, Christine and Anthoni, Peter and Arneth, Almut and Krause, Andreas and Rammig, Anja and Lindeskog, Mats and Olin, Stefan and Hartig, Florian},
  title   = {Climate and parameter sensitivity and induced uncertainties in carbon stock projections for European forests (using LPJ-GUESS 4.0)},
  journal = {Geoscientific Model Development},
  year    = {2022},
  volume  = {15},
  number  = {16},
  pages   = {6495--6519},
  doi     = {10.5194/gmd-15-6495-2022},
  preprint = {https://gmd.copernicus.org/preprints/gmd-2021-287/},
  abstract = {Understanding uncertainties and sensitivities of projected ecosystem dynamics under environmental change is of immense value for research and climate change policy. Here, we analyze sensitivities (change in model outputs per unit change in inputs) and uncertainties (changes in model outputs scaled to uncertainty in inputs) of vegetation dynamics under climate change, projected by a state-of-the-art dynamic vegetation model (LPJ-GUESS v4.0) across European forests (the species Picea abies, Fagus sylvatica and Pinus sylvestris), considering uncertainties of both model parameters and environmental drivers. We find that projected forest carbon fluxes are most sensitive to photosynthesis-, water-, and mortality-related parameters, while predictive uncertainties are dominantly induced by environmental drivers and parameters related to water and mortality. The importance of environmental drivers for predictive uncertainty increases with increasing temperature. Moreover, most of the interactions of model inputs (environmental drivers and parameters) are between environmental drivers themselves or between parameters and environmental drivers. In conclusion, our study highlights the importance of environmental drivers not only as contributors to predictive uncertainty in their own right but also as modifiers of sensitivities and thus uncertainties in other ecosystem processes. Reducing uncertainty in mortality-related processes and accounting for environmental influence on processes should therefore be a focus in further model development.},
  significance = {Dynamic vegetation models project forest carbon under climate change but disagree, and knowing which inputs cause the uncertainty is valuable for interpreting projections and for deciding where to improve a model. Sensitivity analysis measures how an output responds to an input; uncertainty analysis asks how much of the output’s spread each input causes. Both are rarely applied to complex models. Earlier analyses of the LPJ family of models, to which LPJ-GUESS belongs (Zaehle et al. 2005; Pappas et al. 2013), varied parameters at a few chosen sites and ranked them, a tractable approach; other studies varied only environmental drivers. Treating the two separately assumes that a parameter matters equally in every climate. The paper tests this assumption. \par The paper argues, from a joint sensitivity and uncertainty analysis of the vegetation model LPJ-GUESS 4.0 for European forests, that the importance of a model’s processes depends on the environment, so parameters and environmental drivers must be analysed together. The model was run about 16 million times at 200 sites for beech, pine and spruce, varying 33 parameters (ranges set by experts) and five drivers (temperature, precipitation, solar radiation, CO2, nitrogen deposition). For the assumed input ranges, environmental drivers caused about as much of the uncertainty in carbon as all parameters together; for standing biomass their share averaged around 45%. Among parameters, those for tree mortality and photosynthesis contributed most to the uncertainty in standing biomass; water-related parameters were prominent for other carbon outputs. The share caused by drivers rose with mean annual temperature, while that of parameters for tree structure and nitrogen fell, and most interactions between inputs involved drivers. \par A parameter’s importance is not a fixed property of the model, and analyses at a single site or scenario may not carry over to other climates. From its ranking of parameters, the paper points to mortality as a priority for model development, and to fitting the model to data region by region, for the parameters that contribute most uncertainty there. It notes that much driver uncertainty stems from future emissions and is hard to reduce. A later study of an extended version of the model (Meyer et al. 2025) cites the paper for the rarity of such analyses and follows its choice of outputs.},
  significance_refs = {10.1029/2004GB002395 10.1002/jgrg.20035 10.5194/gmd-18-4643-2025},
  license = {CC BY 4.0},
  funding = {Bayerisches Staatsministerium für Wissenschaft, Forschung und Kunst (Bavarian Climate Research Network, bayklif)},
}

@article{henrich2022deer,
  author  = {Henrich, Maik and Hartig, Florian and Dormann, Carsten F. and K{\"u}hl, Hjalmar S. and Peters, Wibke and Franke, Frederik and Peterka, Tomáš and Šustr, Pavel and Heurich, Marco},
  title   = {Deer Behavior Affects Density Estimates With Camera Traps, but Is Outweighed by Spatial Variability},
  journal = {Frontiers in Ecology and Evolution},
  year    = {2022},
  volume  = {10},
  pages   = {881502},
  doi     = {10.3389/fevo.2022.881502},
  abstract = {Density is a key trait of populations and an essential parameter in ecological research, wildlife conservation and management. Several models have been developed to estimate population density based on camera trapping data, including the random encounter model (REM) and camera trap distance sampling (CTDS). Both models need to account for variation in animal behavior that depends, for example, on the species and sex of the animals along with temporally varying environmental factors. We examined whether the density estimates of REM and CTDS can be improved for Europe’s most numerous deer species, by adjusting the behavior-related model parameters per species and accounting for differences in movement speeds between sexes, seasons, and years. Our results showed that bias through inadequate consideration of animal behavior was exceeded by the uncertainty of the density estimates, which was mainly influenced by variation in the number of independent observations between camera trap locations. The neglection of seasonal and annual differences in movement speed estimates for REM overestimated densities of red deer in autumn and spring by ca. 14%. This GPS telemetry-derived parameter was found to be most problematic for roe deer females in summer and spring when movement behavior was characterized by small-scale displacements relative to the intervals of the GPS fixes. In CTDS, density estimates of red deer improved foremost through the consideration of behavioral reactions to the camera traps (avoiding bias of max. 19%), while species-specific delays between photos had a larger effect for roe deer. In general, the applicability of both REM and CTDS would profit profoundly from improvements in their precision along with the reduction in bias achieved by exploiting the available information on animal behavior in the camera trap data.},
  significance = {Led by Maik Henrich, the authors use year-round camera trapping of red and roe deer in the Bavarian Forest and Šumava National Parks to test how density estimates from the random encounter model and camera trap distance sampling change when behaviour-related parameters are adjusted for species, sex, season and year. Biases from ignoring such behavioural differences were smaller than the uncertainty of the estimates, which arose mainly from variation in the number of independent observations among camera locations. The authors advise caution with GPS-derived movement speeds in the random encounter model, identify reactions of red deer to the cameras as the largest confirmed bias in distance sampling, and conclude that both methods would gain most from better precision alongside fuller use of behavioural information in camera data.},
  license = {CC BY 4.0},
  funding = {Bavarian State Ministry of the Environment and Consumer Protection (project ID 77262); Program Ziel ETZ Free State of Bavaria – Czech Republic 2014–2020 (INTERREG V) (project number 184)},
}

@article{cameron2022issues,
  author  = {Cameron, David and Hartig, Florian and Minnuno, Francesco and Oberpriller, Johannes and Reineking, Björn and Van Oijen, Marcel and Dietze, Michael},
  title   = {Issues in calibrating models with multiple unbalanced constraints: the significance of systematic model and data errors},
  journal = {Methods in Ecology and Evolution},
  year    = {2022},
  volume  = {13},
  number  = {12},
  pages   = {2757--2770},
  doi     = {10.1111/2041-210X.14002},
  abstract = {Calibrating process‐based models using multiple constraints often improves the identifiability of model parameters, helps to avoid several errors compensating each other and produces model predictions that are more consistent with underlying processes. However, using multiple constraints can lead to predictions for some variables getting worse. This is particularly common when combining data sources with very different sample sizes. Such unbalanced model‐data fusion efforts are becoming increasingly common, for example when combining manual and automated measurements. Here we use a series of simulated virtual data experiments that aim to demonstrate and disentangle the underlying cause of issues that can occur when calibrating models with multiple unbalanced constraints in combination with systematic errors in models and data. We propose a diagnostic tool to help identify whether a calibration is failing due to these factors. We also test the utility of adding terms representing uncertainty in systematic model/data systematic error in calibrations. We show that unbalanced data by itself is not the problem—when fitting simulated data to the ‘true’ model, we can correctly recover model parameters and the true dynamics of latent variables. However, when there are systematic errors in the model or the data, we cannot recover the correct parameters. Consequently, the modelled dynamics of the low data volume variables departs significantly from the true values. We demonstrate the utility of the diagnostic tool and show that it can also be used to identify the extent of the imbalance before the calibration starts to ignore the more sparse data. Finally, we show that representing uncertainty in model structural errors and data biases in the calibration can greatly improve the model fit to low‐volume data, and improve coverage of uncertainty estimates. We conclude that the underlying issue is not one of sample size or information content per se, despite the popularity of ad hoc approaches that focus on ‘weighting’ datasets to achieve balance. Our results emphasize the importance of considering model structural deficiencies and data systematic biases in the calibration of process‐based models.},
  significance = {In this study, led by David Cameron, the authors use virtual-data experiments with a very simple ecosystem model to show that calibrating against data streams of very different sizes is not problematic in itself: with a correct model and unbiased data, parameters and latent dynamics were recovered. Problems arose only when unbalanced data were combined with structural model errors or data biases, in which case parameters absorbed the errors and fits to the sparse data deteriorated. The authors propose a diagnostic plot to detect this situation and show that adding simple linear bias-correction terms to the likelihood improved fits to sparse data and the coverage of uncertainty estimates, arguing that systematic errors should be addressed directly rather than by reweighting data sets.},
  license = {CC BY 4.0},
  funding = {European Space Agency (4000135015/21/I-NB); Strategic Research Council under the Academy of Finland (IBC-Carbon project) (312559)},
}

@article{leibold2022internal,
  author  = {Leibold, Mathew A. and Rudolph, F. Javiera and Blanchet, F. Guillaume and De Meester, Luc and Gravel, Dominique and Hartig, Florian and Peres-Neto, Pedro and Shoemaker, Lauren and Chase, Jonathan M.},
  title   = {The internal structure of metacommunities},
  journal = {Oikos},
  year    = {2022},
  volume  = {2022},
  number  = {1},
  doi     = {10.1111/oik.08618},
  preprint = {https://www.biorxiv.org/content/10.1101/2020.07.04.187955v3},
  abstract = {Current analyses of metacommunity data largely focus on global attributes across the entire metacommunity, such as mean alpha, beta, and gamma diversity, as well as the partitioning of compositional variation into single estimates of contributions of space and environmental effects and, more recently, possible contributions of species interactions. However, this view neglects the fact that different species and sites in the landscape can vary widely in how they contribute to these metacommunity‐wide attributes. We argue for a new conceptual framework with matched analytics with the goals of studying the complex and interactive relations between process and pattern in metacommunities that is focused on the variation among species and among sites which we call the ‘internal structure' of the metacommunity. To demonstrate how the internal structure could be studied, we create synthetic data using a process‐based colonization–extinction metacommunity model. We then use joint species distribution models to estimate how the contributions of space, environment, and biotic interactions driving metacommunity assembly differ among species and sites. We find that this approach to the internal structure of metacommunities provides useful information about the distinct ways that different species and different sites contribute to metacommunity structure. Although it has limitations, our work points at a more general approach to understand how other possible complexities might affect internal structure and might thus be incorporated into a more cohesive metacommunity theory.},
  significance = {Metacommunity analyses usually summarise the roles of environment, space and biotic interactions as single values for the whole system. In this paper, led by Mathew A. Leibold, the authors argue for also examining how individual species and individual sites contribute, which they call the internal structure of a metacommunity. Fitting joint species distribution models to data simulated from a colonisation–extinction model, the authors show that species differ in how strongly their distributions reflect environment, space or co-distribution depending on dispersal and niche position, and that sites differ according to how distinct their environment is from the metacommunity mean. The paper cautions that the co-distribution component tends to absorb unmeasured environmental or spatial effects and so cannot be read simply as species interactions.},
  license = {publisher (subscription)},
  funding = {German Centre for Integrative Biodiversity Research (iDiv) Halle-Jena-Leipzig, funded by the German Research Foundation (FZT 118); Alexander von Humboldt Foundation (Research Award); NSF (2025118); KU Leuven Research Fund (C/2017/002); FWO (G0B9818); FWO (G0C3818)},
}

