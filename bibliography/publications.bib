@article{pichler2020machine,
  author  = {Pichler, Maximilian and Boreux, Virginie and Klein, Alexandra-Maria and Schleuning, Matthias and Hartig, Florian},
  title   = {Machine learning algorithms to infer trait-matching and predict species interactions in ecological networks},
  journal = {Methods in Ecology and Evolution},
  year    = {2020},
  volume  = {11},
  number  = {2},
  pages   = {281--293},
  doi     = {10.1111/2041-210X.13329},
  preprint = {https://arxiv.org/abs/1908.09853},
  abstract = {Ecologists have long suspected that species are more likely to interact if their traits match in a particular way. For example, a pollination interaction may be more likely if the proportions of a bee's tongue fit a plant's flower shape. Empirical estimates of the importance of trait‐matching for determining species interactions, however, vary significantly among different types of ecological networks. Here, we show that ambiguity among empirical trait‐matching studies may have arisen at least in parts from using overly simple statistical models. Using simulated and real data, we contrast conventional generalized linear models (GLM) with more flexible Machine Learning (ML) models (Random Forest, Boosted Regression Trees, Deep Neural Networks, Convolutional Neural Networks, Support Vector Machines, naïve Bayes, and k‐Nearest‐Neighbor), testing their ability to predict species interactions based on traits, and infer trait combinations causally responsible for species interactions. We found that the best ML models can successfully predict species interactions in plant–pollinator networks, outperforming GLMs by a substantial margin. Our results also demonstrate that ML models can better identify the causally responsible trait‐matching combinations than GLMs. In two case studies, the best ML models successfully predicted species interactions in a global plant–pollinator database and inferred ecologically plausible trait‐matching rules for a plant–hummingbird network from Costa Rica, without any prior assumptions about the system. We conclude that flexible ML models offer many advantages over traditional regression models for understanding interaction networks. We anticipate that these results extrapolate to other ecological network types. More generally, our results highlight the potential of machine learning and artificial intelligence for inference in ecology, beyond standard tasks such as image or pattern recognition.},
  significance = {Ecologists suspect that species interact when their traits fit together, for example a bee’s tongue and a flower’s shape (trait-matching). Estimates of how much it matters vary widely between network types, and predicting interactions from traits has often worked only moderately. Most studies used conventional regression models such as generalised linear models (GLMs), with trait combinations specified in advance, or phylogenetic proxies for traits. Such models are interpretable, and a few trait axes often explain a network’s structure (Eklöf et al. 2013). But they may be too rigid for how traits give rise to interactions. Flexible machine-learning methods had predicted food-web links (Desjardins-Proulx et al. 2017), yet, to the authors’ knowledge, it had not been shown that they can also reveal which trait combinations are responsible. The paper questions the assumption that simple regression models are adequate for inferring trait-matching. \par The paper argues that the mixed evidence on trait-matching in species-interaction networks may partly reflect overly simple statistical models: the best flexible machine-learning models predict interactions from traits, and identify the responsible trait pairs, better than regression does in simulations. In simulated plant–pollinator networks, random forests, boosted regression trees and deep neural networks reached a true skill statistic (0 is chance, 1 perfect) of 0.61–0.63, against 0.41 for GLMs. The H-statistic, a measure of how strongly a model’s predictions depend on two traits jointly, recovered on average 70–80% of the true trait pairs for presence-absence data. The accuracy of GLMs in identifying pairs fell most as more pairs mattered. In two real data sets, random forests predicted crop–pollinator interactions best (AUC 0.73, where 0.5 is chance and 1 perfect), and in Costa Rican plant–hummingbird networks the models singled out corolla length matched with bill length, among the strongest, ecologically plausible pairs, without prior assumptions. \par The study speculates that earlier GLM-based work may have considerably underestimated trait-matching, unless only one or two trait pairs dominate a network. It offers flexible models plus interpretation tools as a way to infer, not only predict, how traits shape interaction networks. The H-statistic is, however, computationally expensive and sensitive to correlated traits. A later study (Van Kleunen et al. 2026) built on this and other flexible-model approaches to trait-matching to predict missing links in food webs.},
  significance_refs = {10.1111/ele.12081 10.7717/peerj.3644 10.1038/s41467-026-68769-7},
  license = {CC BY 4.0},
  funding = {Bayer CropScience (assembly of the global plant–pollinator database used in case study 1)},
}

@article{mair2020mdd,
  author  = {Mair, Magdalena M. and Kattwinkel, Mira and Jakoby, Oliver and Hartig, Florian},
  title   = {The Minimum Detectable Difference (MDD) Concept for Establishing Trust in Nonsignificant Results: A Critical Review},
  journal = {Environmental Toxicology and Chemistry},
  year    = {2020},
  volume  = {39},
  number  = {11},
  pages   = {2109--2123},
  doi     = {10.1002/etc.4847},
  abstract = {Current regulatory guidelines for pesticide risk assessment recommend that nonsignificant results should be complemented by the minimum detectable difference (MDD), a statistical indicator that is used to decide whether the experiment could have detected biologically relevant effects. We review the statistical theory of the MDD and perform simulations to understand its properties and error rates. Most importantly, we compare the skill of the MDD in distinguishing between true and false negatives (i.e., type II errors) with 2 alternatives: the minimum detectable effect (MDE), an indicator based on a post hoc power analysis common in medical studies; and confidence intervals (CIs). Our results demonstrate that MDD and MDE only differ in that the power of the MDD depends on the sample size. Moreover, although both MDD and MDE have some skill in distinguishing between false negatives and true absence of an effect, they do not perform as well as using CI upper bounds to establish trust in a nonsignificant result. The reason is that, unlike the CI, neither MDD nor MDE consider the estimated effect size in their calculation. We also show that MDD and MDE are no better than CIs in identifying larger effects among the false negatives. We conclude that, although MDDs are useful, CIs are preferable for deciding whether to treat a nonsignificant test result as a true negative, or for determining an upper bound for an unknown true effect.},
  significance = {Pesticide risk assessment has to show that a substance does no harm to non-target organisms. Significance tests limit only the rate of false alarms, so a nonsignificant result can come as easily from too few or too noisy data as from a true absence of an effect, especially in costly mesocosm studies. Guidelines therefore add a second filter, described by Brock et al. (2015): a nonsignificant result is trusted only if the minimum detectable difference (MDD), the effect size that would just have been significant, is below a threshold. Like the minimum detectable effect (MDE) of post hoc power analysis, the effect detected with a stated power (criticised by Hoenig and Heisey 2001), the MDD is computed without the estimated effect. Whether it can nevertheless separate true from false negatives (a real effect that was missed) was unclear. \par The paper shows that, in pesticide risk assessment, the upper bound of a confidence interval separates trustworthy from untrustworthy nonsignificant results better than the minimum detectable difference (MDD), the effect size that would just have been significant. The MDD is the MDE with a power that is not controlled: a real effect equal to the MDD is significant in only about half of the experiments, probably 50–60% at sample sizes typical of risk assessment, whereas the MDE assumes a high, fixed power. In simulated count-data experiments with 3 to 10 replicates, MDD and MDE led to virtually identical decisions, and, whichever threshold was chosen, an upper-bound threshold gave fewer false trusts at no more false mistrusts. At a 70% threshold, for instance, over 40% of nonsignificant experiments with a real 50% reduction passed the MDD filter, against a little over 20% for the interval, at similar false mistrust. The interval uses the estimated effect; the MDD and MDE do not. \par The MDD correctly states the effect that would just have been significant, but it separates true from false negatives less well than the upper confidence bound. Where risk assessment stays with significance tests, the paper recommends thresholds on the upper confidence bound. It also warns that describing the MDD as the effect that “could have been detected” can mislead. More broadly, the paper argues that regulatory decisions would be better and more transparent if they focused on estimated effects and their intervals and defined acceptable effects openly.},
  significance_refs = {10.1007/s11356-014-3398-2 10.1198/000313001300339897},
  license = {CC BY 4.0},
  funding = {Christiane Nüsslein-Volhard Foundation},
}

@article{trotsiuk2020r3pg,
  author  = {Trotsiuk, Volodymyr and Hartig, Florian and Forrester, David I.},
  title   = {r3PG – An R package for simulating forest growth using the 3-PG process-based model},
  journal = {Methods in Ecology and Evolution},
  year    = {2020},
  volume  = {11},
  number  = {11},
  pages   = {1470--1475},
  doi     = {10.1111/2041-210X.13474},
  abstract = {Process‐based forest models (PBMs) are important tools for quantifying forest growth and vulnerability, particularly under climate change. The 3‐PG model (Physiological Processes Predicting Growth) is one of the most widely used forest growth simulators for this purpose worldwide. Here, we present r3PG, a new Fortran implementation of 3‐PG, wrapped into an r package. r3PG can simulate monospecific as well as mixtures of evergreen and deciduous tree species in even‐aged or uneven‐aged stands. The combination of Fortran functions with an r interface makes the model extremely fast. This facilitates the use of r3PG for extensive computer experiments and sensitivity analysis. We demonstrate this in a case study including (a) single model runs; (b) a sensitivity analysis and a full Bayesian calibration of the model and (c) spatial simulations of forest growth across Switzerland. r3PG is faster and easier to use than previous implementations of 3‐PG in visual basic. We believe that this will make 3‐PG even more useful and popular for ecologists and climate change scientists.},
  significance = {Forest growth models are used to project how forests develop, particularly under climate change. The paper takes up 3-PG (Physiological Processes Predicting Growth), a process-based model of stand development that the paper calls one of the most popular worldwide. The available implementations, however, did not fit the R-centred workflow of data-oriented ecologists. The original Visual Basic versions, including the extension to deciduous, uneven-aged and mixed-species stands, did not easily interface with R and were relatively slow, which made calibration and sensitivity analysis challenging. Fortran re-implementations existed, but they were not designed for end users, were not on CRAN (the central R package archive) and lacked those extensions. The problem the paper takes on is therefore a tool gap: a fast version of the model, with its extensions, that can be run from within R. \par The study presents r3PG, an R package that runs a Fortran re-implementation of the 3-PG forest growth model, and argues that this makes the model, including its mixed-species extensions, fast and convenient enough for computationally heavy work from within R. The package re-implements all major published sub-modules and functions of the model and the major available extensions, and unit tests show results numerically identical to the Visual Basic implementations. The paper states that r3PG is faster and easier to use than those versions; no timing comparison is reported. Three case studies demonstrate the functionality. The first simulates a mixed beech and Scots pine stand. The second applies a Morris screening, a method that ranks parameters by their influence on model fit, to a Norway spruce site, then calibrates the most influential parameters against observed stand data in a Bayesian framework. The third simulates spruce stem biomass on a grid across Switzerland, with uncertainty. \par The paper concludes that the package makes sensitivity analysis, Bayesian calibration and parametrisation for new tree species faster and easier, including for mixed and uneven-aged stands. Running the model directly from R, it argues, also supports transparent reporting of the computational protocol and reproducible simulations. As an example of use by others, Nölte et al. (2023) ran the model through r3PG to estimate the productivity of tropical reforestation under climate scenarios.},
  significance_refs = {10.1126/sciadv.adg9175},
  license = {publisher (subscription)},
  funding = {WSL internal project 'Forecasting forest growth and carbon sequestration: current and novel species mixtures, climatic conditions and management regimes'; SwissForestLab QUPFiS project; Bavarian Climate Research Network bayklif, research project BLIZ},
}

@article{morlon2020prior,
  author   = {Morlon, H{\'e}l{\`e}ne and Hartig, Florian and Robin, St{\'e}phane},
  title    = {Prior hypotheses or regularization allow inference of diversification histories from extant timetrees},
  journal  = {bioRxiv},
  year     = {2020},
  note     = {Comment on Louca \& Pennell, Nature, 2020.},
  doi      = {10.1101/2020.07.03.185074},
  abstract = {Phylogenies of extant species are widely used to study past diversification dynamics. The most common approach is to formulate a set of candidate models representing evolutionary hypotheses for how and why speciation and extinction rates in a clade changed over time, and compare those models through their probability to have generated the corresponding empirical tree. Recently, Louca & Pennell reported the existence of an infinite number of ‘congruent’ models with potentially markedly different diversification dynamics, but equal likelihood, for any empirical tree (see also Lambert & Stadler). Here we explore the implications of these results, and conclude that they neither undermine the hypothesis-driven model selection procedure widely used in the field nor show that speciation and extinction dynamics cannot be investigated from extant timetrees using a data-driven procedure.},
  significance = {Phylogenies of living species are used to infer how speciation and extinction rates changed in the past. The most common approach is to compare a few birth-death models, each standing for an evolutionary hypothesis, and ask which explains the tree best. Louca and Pennell (2020) showed that for any such tree there are infinitely many “congruent” models with different rate histories but identical likelihood, the measure of how well a model explains the data. The paper finds this result interesting and useful, but takes on its implicit goal: to learn the rate histories from the data alone, treating all congruent models as equally admissible and leaving out hypotheses, prior knowledge and a penalty for complexity. \par The paper argues that the existence of many equally likely birth-death models for one tree does not undermine inference of diversification histories from trees of living species, because hypotheses and regularisation supply the constraints. Congruent models stand for no hypothesis formulated beforehand, so a well-conducted comparison would not consider them, and, as Louca and Pennell admit, most hypotheses that biologists compare can be told apart. To estimate rates from the data, regularisation (constraining a model, for example by smoothing or Bayesian priors) can handle the fact that the data cannot single out one model, and the paper expects it to remove the cases with markedly different histories. A deliberately simplified analysis of the Madagascan vangas illustrates these points. Of four models, one with declining speciation is best supported. Congruent models derived from it with a constant extinction rate differ in detail but keep the declining trend; those with constant speciation imply negative extinction and are discarded. \par The paper concludes that the implications of the congruence result are largely overinterpreted in Louca and Pennell’s paper, mainly because the constraints from hypothesis-driven research, prior knowledge and penalising complexity are not considered there. It treats the result as a reminder that chosen hypotheses shape conclusions, and as a possible source of new hypotheses, not as a challenge to current practice. Two questions stay open: whether model selection picks the right hypothesis when the true model is outside the candidate set, and which regularisation methods work best. Helmstetter et al. (2022) cite the paper as a response from the community to Louca and Pennell.},
  significance_refs = {10.1038/s41586-020-2176-1 10.1093/sysbio/syab083},
  license = {CC BY-NC-ND 4.0},
  funding = {European Research Council (ERC) (ERC-CoG PANDA)},
}

@article{dormann2020plant,
  author  = {Dormann, Carsten F. and Bagnara, Maurizio and Boch, Steffen and Hinderling, Judith and Janeiro-Otero, Andrea and Sch{\"a}fer, Deborah and Schall, Peter and Hartig, Florian},
  title   = {Plant species richness increases with light availability, but not variability, in temperate forests understorey},
  journal = {BMC Ecology},
  year    = {2020},
  volume  = {20},
  number  = {1},
  pages   = {43},
  doi     = {10.1186/s12898-020-00311-9},
  abstract = {Background: Temperate forest understorey vegetation poses an excellent study system to investigate whether increases in resource availability lead to an increase in plant species richness. Most sunlight is absorbed by the species-poor tree canopy, making the much more species-rich understorey species inhabit a severely resource-limited habitat. Additionally, the heterogeneity of light availability, resulting from management-moderated tree composition and age structure, may contribute to species coexistence. One would therefore expect that the diversity in the herb layer correlates positively with either the overall light availability, or the light heterogeneity, depending on whether resource availability or heterogeneity are more important drivers of diversity. To test this idea, we assessed variability of light conditions in 75 forest plots across three ecoregions with four different methods. Results: We correlated these data with vegetation relevés and found light availability to be strongly positively correlated with understorey plant species richness, as well as with understorey cover. Light variability (assessed with two approaches) within plots was positively correlated with transmittance, but did not improve the relationship further, suggesting that the main driver of species richness in this system is the overall resource availability. Two of the three beech-dominated regions exhibited near-identical effects of light transmittance, while the third, featuring pine alongside beech and thus with the longest gradient of transmittance and lowest species richness, displayed a weaker light response. Conclusions: While site conditions are certainly responsible for the trees selected by foresters, for the resulting forest structure, and for the differences in plant species pools, our results suggest that light transmittance is a strong mediating factor of understorey plant species richness.},
  significance = {Two ideas are usually offered for why some places hold more species than others. More resources can support more individuals and so more species, and a more varied supply of resources lets more specialised species coexist. Both are plausible for plants beneath a forest canopy, where light is most likely the scarcest resource. Yet few studies recorded both average light and its variability, and the two tend to rise together. It was therefore unclear whether the number of species follows the amount of light or its patchiness (a question posed by Bartels and Chen 2010). Many studies also used proxies such as canopy closure, which match measured light poorly. The paper asks this question for understorey plant species richness, across forest types. \par The paper argues that overall light availability, not its heterogeneity, is the main light-related correlate of understorey plant species richness in the temperate forests studied. The case rests on 75 plots in three German regions, with light quantified in four ways: sensor readings of the proportion of light that reaches the forest floor, observers’ estimates of canopy cover, canopy openness derived from laser scans, and crown areas computed from tree inventories. Richness rose strongly with the first three, not with crown area. In the sensor data, two regions responded almost identically; the dry, sandy region with pine alongside beech responded less strongly. Once average light was accounted for, light variability within plots did not raise richness: its effect was negative for sensor-measured light and absent for laser-scan openness. Plant cover, used as a stand-in for the number of individuals, explained only a small part of the light effect. As a side result, observers’ cover estimates and laser-scan openness explained richness better than the one-off sensor readings. \par The paper presents light at the forest floor as a strong link between forest structure, which management shapes, and understorey plant diversity, and recommends measuring it as routinely as soil nutrients or moisture. The data are correlational and light is entangled with soil, climate, tree species and management, so the paper leaves the causal pathways open. A later study of 135 plots reported higher species richness with greater light heterogeneity where soil C:N variability was also high (Helbach et al. 2022), so the question of heterogeneity remains open.},
  significance_refs = {10.1890/09-1376.1 10.1002/ece3.8534},
  license = {CC BY 4.0},
  funding = {DFG Priority Program 1374 'Infrastructure-Biodiversity-Exploratories' (DOR 786/8-1); German Science Foundation (DFG); Projekt DEAL (open access funding)},
}

@article{reyer2020profound,
  author  = {Reyer, Christopher P. O. and Silveyra Gonzalez, Ramiro and Dolos, Klara and Hartig, Florian and Hauf, Ylva and Noack, Matthias and Lasch-Born, Petra and Rötzer, Thomas and Pretzsch, Hans and Meesenburg, Henning and Fleck, Stefan and Wagner, Markus and Bolte, Andreas and Sanders, Tanja G. M. and Kolari, Pasi and Mäkelä, Annikki and Vesala, Timo and Mammarella, Ivan and Pumpanen, Jukka and Collalti, Alessio and Trotta, Carlo and Matteucci, Giorgio and D'Andrea, Ettore and Foltýnová, Lenka and Krejza, Jan and Ibrom, Andreas and Pilegaard, Kim and Loustau, Denis and Bonnefond, Jean-Marc and Berbigier, Paul and Picart, Delphine and Lafont, Sébastien and Dietze, Michael and Cameron, David and Vieno, Massimo and Tian, Hanqin and Palacios-Orueta, Alicia and Cicuendez, Victor and Recuero, Laura and Wiese, Klaus and Büchner, Matthias and Lange, Stefan and Volkholz, Jan and Kim, Hyungjun and Horemans, Joanna A. and Bohn, Friedrich and Steinkamp, Jörg and Chikalanov, Alexander and Weedon, Graham P. and Sheffield, Justin and Babst, Flurin and Vega del Valle, Iliusi and Suckow, Felicitas and Martel, Simon and Mahnken, Mats and Gutsch, Martin and Frieler, Katja},
  title   = {The PROFOUND Database for evaluating vegetation models and simulating climate impacts on European forests},
  journal = {Earth System Science Data},
  year    = {2020},
  volume  = {12},
  number  = {2},
  pages   = {1295--1320},
  doi     = {10.5194/essd-12-1295-2020},
  preprint = {https://essd.copernicus.org/preprints/essd-2019-220/},
  abstract = {Process-based vegetation models are widely used to predict local and global ecosystem dynamics and climate change impacts. Due to their complexity, they require careful parameterization and evaluation to ensure that projections are accurate and reliable. The PROFOUND Database (PROFOUND DB) provides a wide range of empirical data on European forests to calibrate and evaluate vegetation models that simulate climate impacts at the forest stand scale. A particular advantage of this database is its wide coverage of multiple data sources at different hierarchical and temporal scales, together with environmental driving data as well as the latest climate scenarios. Specifically, the PROFOUND DB provides general site descriptions, soil, climate, CO₂, nitrogen deposition, tree and forest stand level, and remote sensing data for nine contrasting forest stands distributed across Europe. Moreover, for a subset of five sites, time series of carbon fluxes, atmospheric heat conduction and soil water are also available. The climate and nitrogen deposition data contain several datasets for the historic period and a wide range of future climate change scenarios following the Representative Concentration Pathways (RCP2.6, RCP4.5, RCP6.0, RCP8.5). We also provide pre-industrial climate simulations that allow for model runs aimed at disentangling the contribution of climate change to observed forest productivity changes. The PROFOUND DB is available freely as a “SQLite” relational database or “ASCII” flat file version (at https://doi.org/10.5880/PIK.2020.006; Reyer et al., 2020). The data policies of the individual contributing datasets are provided in the metadata of each data file. The PROFOUND DB can also be accessed via the ProfoundData R package (https://CRAN.R-project.org/package=ProfoundData; Silveyra Gonzalez et al., 2020), which provides basic functions to explore, plot and extract the data for model set-up, calibration and evaluation.},
  significance = {Process-based vegetation models simulate how forests respond to climate, and their projections inform policy and management. This calls for quality control: because the models are complex, they must be calibrated against observations and compared with each other, and the formal statistical methods used for this need systematic reference data. Such data are scattered over many sources and formats, so model comparisons have often been limited by what data were available and comparable. Earlier benchmarking systems (Kelley et al. 2013; Collier et al. 2018) brought important progress, but many initiatives of this kind work at the global scale with global products, which lack long-term, detailed measurements of forest stand structure. The problem the paper takes on is how to assess models rigorously at the scale of single forest stands without harmonised data. \par The study presents the PROFOUND Database, a freely available, harmonised collection of evaluation and driving data for nine contrasting European forest stands, built so that both stand-scale models and global vegetation models can be run and compared with it. For each stand, the database holds site and soil descriptions, climate, atmospheric CO₂ and nitrogen deposition, tree and stand measurements and satellite-derived (MODIS) products; for five stands it also holds time series of carbon fluxes, heat conduction and soil water. Climate comes both bias-corrected with local data and as 0.5° grid cells, the form global models use. Future climate follows four Representative Concentration Pathways (RCPs, scenarios of greenhouse-gas concentrations), and pre-industrial climate simulations allow model runs aimed at separating the contribution of climate change to observed changes in forest productivity. An R package, ProfoundData, provides functions to explore and extract the data. \par The paper concludes that the database facilitates model evaluation, calibration, uncertainty analysis and model intercomparison, and that it highlights the value of long-term environmental monitoring data for robust inferences about causal processes and future dynamics of forests. It is designed so that uncertainties can be told apart: structural ones through comparing models on common data, input ones through the range of climate datasets and scenarios, and parametric ones through inverse calibration, that is, fitting model parameters to observations. Lasch-Born et al. (2020) used data from the database to evaluate the forest model 4C at four European sites.},
  significance_refs = {10.5194/bg-10-3313-2013 10.1029/2018MS001354 10.5194/gmd-13-5311-2020},
  license = {CC BY 4.0},
  funding = {COST (European Cooperation in Science and Technology), COST Action FP1304 PROFOUND (FP1304); Inter-Sectoral Impact Model Intercomparison project (ISIMIP); BMBF (01L1201A1); I-Maestro project, ERA-NET Cofund Forest-Value (773324 and 22035418); German Federal Office for Agriculture and Food (BLE) (2816ERA06S); Joint DECC and Defra Integrated Climate Programme (DECC/Defra) (GA01101); Foundation for Polish Science, HOMING programme, co-financed by the EU European Regional Development Fund (project Inside out) (POIR.04.04.00-00-5F85/18-00); Japan Society for the Promotion of Science (16H06291; 18KK0117)},
}

@article{trotsiuk2020assessing,
  author  = {Trotsiuk, Volodymyr and Hartig, Florian and Cailleret, Maxime and Babst, Flurin and Forrester, David I. and Baltensweiler, Andri and Buchmann, Nina and Bugmann, Harald and Gessler, Arthur and Gharun, Mana and Minunno, Francesco and Rigling, Andreas and Rohner, Brigitte and Stillhard, Jonas and Th{\"u}rig, Esther and Waldner, Peter and Ferretti, Marco and Eugster, Werner and Schaub, Marcus},
  title   = {Assessing the response of forest productivity to climate extremes in Switzerland using model--data fusion},
  journal = {Global Change Biology},
  year    = {2020},
  volume  = {26},
  number  = {4},
  pages   = {2463--2476},
  doi     = {10.1111/gcb.15011},
  abstract = {The response of forest productivity to climate extremes strongly depends on ambient environmental and site conditions. To better understand these relationships at a regional scale, we used nearly 800 observation years from 271 permanent long‐term forest monitoring plots across Switzerland, obtained between 1980 and 2017. We assimilated these data into the 3‐PG forest ecosystem model using Bayesian inference, reducing the bias of model predictions from 14% to 5% for forest stem carbon stocks and from 45% to 9% for stem carbon stock changes. We then estimated the productivity of forests dominated by Picea abies and Fagus sylvatica for the period of 1960–2018, and tested for productivity shifts in response to climate along elevational gradient and in extreme years. Simulated net primary productivity (NPP) decreased with elevation (2.86 ± 0.006 Mg C ha⁻¹ year⁻¹ km⁻¹ for P. abies and 0.93 ± 0.010 Mg C ha⁻¹ year⁻¹ km⁻¹ for F. sylvatica). During warm–dry extremes, simulated NPP for both species increased at higher and decreased at lower elevations, with reductions in NPP of more than 25% for up to 21% of the potential species distribution range in Switzerland. Reduced plant water availability had a stronger effect on NPP than temperature during warm‐dry extremes. Importantly, cold–dry extremes had negative impacts on regional forest NPP comparable to warm–dry extremes. Overall, our calibrated model suggests that the response of forest productivity to climate extremes is more complex than simple shift toward higher elevation. Such robust estimates of NPP are key for increasing our understanding of forests ecosystems carbon dynamics under climate extremes.},
  significance = {Forests in cold, high-elevation places are limited by low temperature and may gain from warming, whereas forests at lower elevations may increasingly suffer from a lack of soil water. Research on extremes has concentrated on warm and dry years, cold and wet extremes have received less attention, and high-resolution estimates of how forest productivity responds to extremes are still rare. Such estimates can come from dynamic vegetation models (process-based computer simulations of vegetation) constrained by data, yet the paper notes that only few studies have fed extensive monitoring data into such a model at regional scale. The paper addresses this gap: whether such a model can show how productivity responds to extremes across environmental gradients, and whether the response amounts to more than a simple shift towards higher elevation. \par The study finds that a forest model fitted to monitoring data indicates a response of forest productivity to climate extremes that is more complex than a shift towards higher elevation, with a cold–dry extreme year (1984) reducing the simulated productivity of Norway spruce and European beech stands in Switzerland about as much as warm–dry years. It combined almost 800 observation years from 271 plots with the 3-PG forest model, using Bayesian inference to estimate parameters and their uncertainty. Calibration brought prediction bias below 10% for all variables. The study simulated net primary productivity (NPP, the carbon plants take up net of their own respiration) of hypothetical stands of both species. During warm–dry extremes, simulated NPP of both species fell at lower elevations, and that of Norway spruce also rose at higher elevations in 2003, with reductions above 25% over up to 21% of a species’ potential range. The cold–dry year 1984 reduced NPP comparably to the warm–dry year 2018. \par The paper reads these results as a case for including cold extremes alongside warm and dry ones and for spatially resolved analyses, because NPP changes vary non-linearly along elevation. It also presents them as showing that monitoring data from several networks can be integrated into a process-based model. It notes that 3-PG and similar models have often overestimated forest sensitivity to drought. A later paper on statistical inference for complex computer models uses the study as an example of such a model (Oberpriller et al. 2021).},
  significance_refs = {10.1111/ele.13728},
  license = {CC BY 4.0},
  funding = {SwissForestLab; Swiss Federal Office for the Environment (FOEN) (16.0074.PJ/Q351-0167); Bavarian Climate Research Network (bayklif), research network BLIZ; W. Szafer Institute of Botany PAS (statutory funds); Foundation for Polish Science, HOMING programme, project 'Inside out', co-financed by the European Union under the European Regional Development Fund (POIR.04.04.00-00-5F85/18-00); Swiss National Science Foundation, project ICOS-CH Phase 2 (20FI20_173691)},
}

@article{beckman2020advancing,
  author  = {Beckman, Noelle G and Aslan, Clare E and Rogers, Haldre S and Kogan, Oleg and Bronstein, Judith L and Bullock, James M and Hartig, Florian and HilleRisLambers, Janneke and Zhou, Ying and Zurell, Damaris and Brodie, Jedediah F and Bruna, Emilio M and Cantrell, Robert Stephen and Decker, Robin R and Efiom, Edu and Fricke, Evan C and Gurski, Katherine and Hastings, Alan and Johnson, Jeremy S and Loiselle, Bette A and Miriti, Maria N and Neubert, Michael G and Pejchar, Liba and Poulsen, John R and Pufal, Gesine and Razafindratsima, Onja H and Sandor, Manette E and Shea, Katriona and Schreiber, Sebastian and Schupp, Eugene W and Snell, Rebecca S and Strickland, Christopher and Zambrano, Jenny},
  title   = {Advancing an interdisciplinary framework to study seed dispersal ecology},
  journal = {AoB PLANTS},
  year    = {2020},
  volume  = {12},
  number  = {2},
  pages   = {plz048},
  doi     = {10.1093/aobpla/plz048},
  abstract = {Although dispersal is generally viewed as a crucial determinant for the fitness of any organism, our understanding of its role in the persistence and spread of plant populations remains incomplete. Generalizing and predicting dispersal processes are challenging due to context dependence of seed dispersal, environmental heterogeneity and interdependent processes occurring over multiple spatial and temporal scales. Current population models often use simple phenomenological descriptions of dispersal processes, limiting their ability to examine the role of population persistence and spread, especially under global change. To move seed dispersal ecology forward, we need to evaluate the impact of any single seed dispersal event within the full spatial and temporal context of a plant’s life history and environmental variability that ultimately influences a population’s ability to persist and spread. In this perspective, we provide guidance on integrating empirical and theoretical approaches that account for the context dependency of seed dispersal to improve our ability to generalize and predict the consequences of dispersal, and its anthropogenic alteration, across systems. We synthesize suitable theoretical frameworks for this work and discuss concepts, approaches and available data from diverse subdisciplines to help operationalize concepts, highlight recent breakthroughs across research areas and discuss ongoing challenges and open questions. We address knowledge gaps in the movement ecology of seeds and the integration of dispersal and demography that could benefit from such a synthesis. With an interdisciplinary perspective, we will be able to better understand how global change will impact seed dispersal processes, and potential cascading effects on plant population persistence, spread and biodiversity.},
  significance = {Seed dispersal matters for whether plant populations persist, spread and cope with global change, yet its contribution to their long-term dynamics is still poorly understood. The paper traces this to a split in the evidence: empirical studies are mostly short-term, local and limited to few species, while dispersal models often rest on simplified assumptions. Dispersal is also only one link in a long chain from flower to reproductive adult, so its demographic weight is hard to separate from that of later stages. The paper regards the seed dispersal effectiveness framework (Schupp et al. 2010), which weighs the quantity of seeds each dispersal vector delivers and the quality of that dispersal, as an important step towards handling the dependence of dispersal outcomes on their setting. The problem it takes on is how to evaluate a single dispersal event within the plant’s full life history, spatial setting and environment. \par The paper argues that the contribution of seed dispersal to plant population dynamics can be quantified if data collection and modelling proceed together. It calls this closing the “seed dispersal loop”, a phrase it takes from Wang and Smith (2002). Models built alongside the data generate hypotheses that field work can test, are refined by the results, and can project dispersal consequences beyond what experiments allow. The paper develops this for two gaps: the movement ecology of seeds, including long-distance dispersal, and the link between dispersal and demography, where the effectiveness framework is combined with population models for local dynamics and for spread. It treats model choice as a trade-off, since simple models help generalisation while detailed ones serve predictions for one system, and names a balance between necessary complexity and tractability as the aim. It is a perspective that synthesises existing frameworks and studies, not new data. \par The paper offers a roadmap. It recommends collating scattered dispersal data sets and linking them to process-based models with Bayesian methods or, for simulation models whose likelihood cannot be written down, approximate Bayesian methods. Sensitivity analyses would show which parameters need better data, and coordinated networks with standardised protocols would fill remaining gaps. The paper presents these steps as a way towards better understanding and predicting how global change alters seed dispersal and, through it, plant persistence, spread and biodiversity.},
  significance_refs = {10.1111/j.1469-8137.2010.03402.x 10.1016/S0169-5347(02)02541-7},
  license = {CC BY 4.0},
  funding = {US National Science Foundation (DEB-1548194); National Socio-Environmental Synthesis Center under the US National Science Foundation (DBI-1052875); Swiss National Science Foundation (SNF) (PZ00P3_168136/1); German Science Foundation (DFG) (ZU 361/1-1)},
}

@article{berzaghi2020towards,
  author  = {Berzaghi, Fabio and Wright, Ian J. and Kramer, Koen and Oddou-Muratorio, Sylvie and Bohn, Friedrich J. and Reyer, Christopher P. O. and Sabat{\'e}, Santiago and Sanders, Tanja G. M. and Hartig, Florian},
  title   = {Towards a New Generation of Trait-Flexible Vegetation Models},
  journal = {Trends in Ecology \& Evolution},
  year    = {2020},
  volume  = {35},
  number  = {3},
  pages   = {191--205},
  doi     = {10.1016/j.tree.2019.11.006},
  abstract = {Plant trait variability, emerging from eco-evolutionary dynamics that range from alleles to macroecological scales, is one of the most elusive, but possibly most consequential, aspects of biodiversity. Plasticity, epigenetics, and genetic diversity are major determinants of how plants will respond to climate change, yet these processes are rarely represented in current vegetation models. Here, we provide an overview of the challenges associated with understanding the causes and consequences of plant trait variability, and review current developments to include plasticity and evolutionary mechanisms in vegetation models. We also present a roadmap of research priorities to develop a next generation of vegetation models with flexible traits. Including trait variability in vegetation models is necessary to better represent biosphere responses to global change.},
  significance = {Dynamic vegetation models are the main tools for projecting how vegetation responds to climate change. They usually describe each species, or each plant functional type (a group of species treated as one), by a single set of fixed trait values. This keeps the number of types manageable, and the models have been instrumental for understanding the global distribution of biomes. Plants, however, vary within species through plasticity (one genotype producing different traits in different environments), genetic differences and epigenetic inheritance. Rapid evolution also suggests that traits can change on ecological timescales. The paper takes on the assumption that a species or functional type is a functionally static unit, which leaves the models ill-equipped to explore what trait variability does for ecosystems and adds uncertainty to their predictions. \par The review argues that dynamic vegetation models need a new generation of “trait-flexible” versions, in which trait variability emerges from plastic and evolutionary processes instead of being fixed or merely prescribed. Existing attempts fall into three approaches: models of plasticity, which describe how traits adjust to the environment but assume that all individuals of a species respond alike; models with prescribed trait distributions, which take trait values from data without explaining them; and eco-evolutionary models, in which traits arise through inheritance, mutation and selection. Models of European beech that combine physiology, demography and genetics serve as an example: in simulations, a few generations sufficed for budburst timing to differ genetically along a climatic gradient. The roadmap then names the steps needed, among them lagged plastic responses, closing the “demographic loop” of reproduction, growth and mortality (a constant seed rain, as in many models, is inadequate for simulating evolution because it makes reproduction independent of trait performance), spatial processes and dispersal, and the link from genotype to phenotype. \par Such models would let researchers quantify how far trait variability buffers biodiversity and ecosystem functioning against climate change, and could help separate heritable from plastic variation. The paper warns that added processes risk making models more complex, harder to parameterise and more uncertain, suggests optimality-based components, which in principle need fewer inputs, and sees immediate progress as possible. Westerband et al. (2021) cite the review for the same caveat: that models with explicit trait variation are often computationally demanding, hard to parameterise and uncertain.},
  significance_refs = {10.1093/aob/mcab011},
  license = {publisher (subscription)},
  funding = {COST Action FP1304 PROFOUND, supported by COST (European Cooperation in Science and Technology); CEA Enhanced Eurotalents Fellowship (a Marie Sklodowska-Curie Actions Programme); University of Tuscia doctoral program; European Union's Horizon 2020 research and innovation programme, Marie Sklodowska-Curie grant (845265); Australian Research Council (DP170103410); German Ministry for Education and Research (BMBF) (01LS1711A); Bavarian Climate Research Network bayklif, research project BLIZ},
}

@article{ruizbenito2020available,
  author  = {Ruiz-Benito, Paloma and Vacchiano, Giorgio and Lines, Emily R. and Reyer, Christopher P. O. and Ratcliffe, Sophia and Morin, Xavier and Hartig, Florian and M{\"a}kel{\"a}, Annikki and Yousefpour, Rasoul and Chaves, Jimena E. and Palacios-Orueta, Alicia and Benito-Garz{\'o}n, Marta and Morales-Molino, Cesar and Camarero, J. Julio and Jump, Alistair S. and Kattge, Jens and Lehtonen, Aleksi and Ibrom, Andreas and Owen, Harry J. F. and Zavala, Miguel A.},
  title   = {Available and missing data to model impact of climate change on European forests},
  journal = {Ecological Modelling},
  year    = {2020},
  volume  = {416},
  pages   = {108870},
  doi     = {10.1016/j.ecolmodel.2019.108870},
  abstract = {Climate change is expected to cause major changes in forest ecosystems during the 21st century and beyond. To assess forest impacts from climate change, the existing empirical information must be structured, harmonised and assimilated into a form suitable to develop and test state-of-the-art forest and ecosystem models. The combination of empirical data collected at large spatial and long temporal scales with suitable modelling approaches is key to understand forest dynamics under climate change. To facilitate data and model integration, we identified major climate change impacts observed on European forest functioning and summarised the data available for monitoring and predicting such impacts. Our analysis of c. 120 forest-related databases (including information from remote sensing, vegetation inventories, dendroecology, palaeoecology, eddy-flux sites, common garden experiments and genetic techniques) and 50 databases of environmental drivers highlights a substantial degree of data availability and accessibility. However, some critical variables relevant to predicting European forest responses to climate change are only available at relatively short time frames (up to 10-20 years), including intra-specific trait variability, defoliation patterns, tree mortality and recruitment. Moreover, we identified data gaps or lack of data integration particularly in variables related to local adaptation and phenotypic plasticity, dispersal capabilities and physiological responses. Overall, we conclude that forest data availability across Europe is improving, but further efforts are needed to integrate, harmonise and interpret this data (i.e. making data useable for non-experts). Continuation of existing monitoring and networks schemes together with the establishments of new networks to address data gaps is crucial to rigorously predict climate change impacts on European forests.},
  significance = {Predicting how forests respond to climate change depends on combining empirical data gathered over large areas and long periods with models, and one challenge is to parameterise and test those models at large spatial scales (Hartig et al. 2012). Many kinds of data exist, from genetics, flux towers (which record local productivity continuously) and inventories to tree rings, palaeoecological records, remote sensing and environmental drivers such as climate and soils. They differ, however, in resolution, accessibility and harmonisation. The paper therefore asks which of these data are available and accessible at the European scale, and where the gaps lie that models of climate-change impacts need filled. \par The paper argues that data on European forests and their environment are largely available and accessible, but that several variables critical for predicting climate responses are scarce, short or not integrated. It rests on a review of about 120 forest-related databases and 50 databases of environmental drivers, built on a literature review of the types of forest response and on the authors’ expert knowledge of each data type. Long records exist for tree growth and forest cover, but they are often localised. For intraspecific trait variability (differences within a species), defoliation, tree mortality and recruitment, data are available only over relatively short time frames (up to 10–20 years). The paper also finds gaps or poor integration for local adaptation and phenotypic plasticity (how far differences between populations are genetic or flexible), dispersal and physiological responses. For drivers, it names soil information and long-term data on disturbances and management as the main limitations. The paper adds that inventory data under-represent large trees and extreme responses, which can bias predictions. \par The paper concludes that the main gap lies in the scarcity of high-quality, freely available data at high spatial and temporal resolution on the biological processes that climate change affects, such as dispersal, physiology and adaptation, while availability overall is improving. It sets four priorities: maintaining existing monitoring and adding targeted new monitoring for the gaps; harmonised, freely available databases; closer exchange between those who collect data and those who model; and methods that integrate data from different sources.},
  significance_refs = {10.1111/j.1365-2699.2012.02745.x},
  license = {CC BY 4.0},
  funding = {European Cooperation in Science and Technology (COST) (FP1304 PROFOUND); European Union Seventh Framework Programme (FP7/2007-2013), Plant Fellows (PCOFUND-GA-2010-267243); Ministerio de Ciencia, Innovación y Universidades, Spain (CGL2015-69186-C2-2-R FUNDIVER; RTI2018-096884-B-C32 DARE); Comunidad de Madrid (S2013/MAE-2719 Remedinal-3; 2016-T2/AMB-1665); German Ministry of Science and Education (BMBF) (01LS1711A; 01LS1201A2); Investments for the Future program IdEx Bordeaux (ANR-10-IDEX-03-02); Bavarian Climate Research Network, research network BLIZ},
}

@article{henrich2020influence,
  author  = {Henrich, Maik and Niederlechner, Sandra and Kr{\"o}schel, Max and Thoma, Stefanie and Dormann, Carsten F. and Hartig, Florian and Heurich, Marco},
  title   = {The influence of camera trap flash type on the behavioural reactions and trapping rates of red deer and roe deer},
  journal = {Remote Sensing in Ecology and Conservation},
  year    = {2020},
  volume  = {6},
  number  = {3},
  pages   = {399--410},
  doi     = {10.1002/rse2.150},
  abstract = {Camera traps have become an important tool in wildlife monitoring. However, an issue in interpreting their data in statistical analyses of population densities, demography or behaviour is that the probability of detecting the target animals and their behaviours may vary depending on environmental and methodological factors. A specific problem is the type of flash used in the camera trap, as animals may react differently to different flash types and change their avoidance or habituation behaviour accordingly over time. Here, we provide the first systematic test of the impact of flash type in studies of red deer (Cervus elaphus) and roe deer (Capreolus capreolus), based on an analysis of behavioural responses to white, standard infrared and black flashes during 900 camera trap deployments in the Bavarian Forest National Park and the Northern Black Forest. The results revealed that both deer species were more likely to react to standard infrared than to black flash, but trigger delays prevented comparisons to white flash. Red deer reacted more frequently to camera traps than did roe deer, and responses were more common in the Northern Black Forest than in the Bavarian Forest National Park, where hunting is severely restricted. Contrary to our expectations, camera trapping rates of free‐ranging deer did not significantly decline over time for any flash type or species. Despite the lack of evidence for avoidance behaviour, we recommend the use of black flash for behavioural studies of deer populations to minimize the risk of introducing a source of disturbance whereas infrared and white flash are equally suitable for determinations of demographic parameters.},
  significance = {Camera traps are considered non-invasive, yet their night-time flash may disturb animals. After reports that white flash disturbed animals, it has increasingly been replaced by infrared (IR) light, in the belief that these longer wavelengths disturb less, although many nocturnal mammals can see IR light. Reactions also matter for the data: animals that avoid a camera, or get used to it, change how often they are detected. That would violate the assumption of capture–recapture methods and of the random encounter model (an estimator for unmarked populations) that cameras do not affect animal movement. How far flash type changes behaviour and trapping rates is unclear and probably species-specific; the study addresses this for red deer and roe deer. \par The study finds that the flash type of a camera trap changes what deer do at the moment of detection, but not how often they are detected over time. It compared white, standard IR and black flash (IR of longer wavelength) in about 900 deployments in two German forest areas (Bavarian Forest National Park, Northern Black Forest). Red deer and roe deer looked at the camera and fled more often at standard IR flash than at black flash, whose reactions resembled those in daytime photos without flash; the study reads this as indicating that deer can perceive standard IR light, or at least the red glow of its LEDs, and suggests that they do not see black flash. White flash could not be compared because of trigger delays. Trapping rates of free-ranging deer did not decline for any flash type or species, so flash-specific avoidance was not detected. \par The study concludes that all three flash types can be used for studies of population parameters, with the choice following range and photo quality, whereas black flash suits behavioural studies because it disturbs least. It suggests that a brief, harmless disturbance may have no lasting effect, and that individual red deer rarely return to the same site, which makes avoidance unlikely but also makes changes in visitation hard to detect. The behavioural effect of white flash was not measured, so its suitability rests on trapping rates alone.},
  license = {CC BY-NC-ND 4.0},
  funding = {Program Ziel ETZ Free State of Bavaria – Czech Republic 2014–2020 (INTERREG V) (project number 184); State of Baden-Württemberg, project 'Rotwildkonzeption Nordschwarzwald' (project number 1414)},
}

@article{cailleret2020bayesian,
  author  = {Cailleret, Maxime and Bircher, Nicolas and Hartig, Florian and H{\"u}lsmann, Lisa and Bugmann, Harald},
  title   = {Bayesian calibration of a growth-dependent tree mortality model to simulate the dynamics of European temperate forests},
  journal = {Ecological Applications},
  year    = {2020},
  volume  = {30},
  number  = {1},
  pages   = {e02021},
  doi     = {10.1002/eap.2021},
  abstract = {Dynamic vegetation models (DVMs) are important tools to understand and predict the functioning and dynamics of terrestrial ecosystems under changing environmental conditions. In these models, uncertainty in the description of demographic processes, in particular tree mortality, is a persistent problem. Current mortality formulations lack realism and are insufficiently constrained by empirical evidence. It has been suggested that empirically estimated mortality submodels would enhance DVM performance, but due to the many processes and interactions within a DVM, the claim has rarely been tested. Here, we compare the performance of three alternative growth‐dependent tree mortality submodels in the DVM ForClim: (1) a mortality function with theoretical foundation (ForClim v3.3); (2) a mortality function with parameters directly estimated based on forest inventory data; and (3) the same function, but with parameters estimated using an inverse approach through Bayesian calibration (BC). Time series of inventory data from 30 ecologically distinct Swiss natural forest reserves collected over 35+ yr, including the main tree species of Central Europe, were used for the calibration and subsequent validation of the mortality functions and the DVM. The recalibration resulted in mortality parameters that differed from the direct empirical estimates, particularly for the relationship between tree size and mortality. The calibrated parameters outperformed the direct estimates, and to a lesser extent the original mortality function, for predicting decadal‐scale forest dynamics at both calibration and validation sites. The same pattern was observed regarding the plausibility of their long‐term projections under contrasting environmental conditions. Our results demonstrate that inverse calibration may be useful even when direct empirical estimates of DVM parameters are available, as structural model deficiencies or data problems can result in discrepancies between direct and inverse estimates. Thus, we interpret the good performance of the inversely calibrated model for long‐term projections (which were not a calibration target) as evidence that the calibration did not compensate for model errors. Rather, we surmise that the discrepancy was mainly caused by a lack of representativeness of the mortality data. Our results underline the potential for learning more about elusive processes, such as tree mortality or recruitment, through data integration in DVMs.},
  significance = {Dynamic vegetation models project how ecosystems respond to environmental change, but their projections remain uncertain, partly because demographic processes, tree mortality above all, are weakly constrained by empirical evidence. Submodels built on empirical estimates have been suggested as a remedy. Earlier studies in the forest model ForClim tested this with parameters taken directly from field data (for example Bircher et al. 2015; Hülsmann et al. 2018). The paper reads these studies as showing that, contrary to general expectations, direct estimates did not substantially improve the model’s reliability. It questions the assumption behind that expectation: that parameters estimated directly from field data are the best ones to put into a complex process-based model. \par The study argues that, for forest models with a poorly known process such as tree mortality, calibrating parameters inversely, by adjusting them until the model’s outputs match observed data, can be worthwhile even where direct field estimates exist, because direct estimates need not make the whole model behave well. It tests this in ForClim with a growth-dependent mortality function, comparing the original theoretically founded version, one with parameters estimated directly from forest inventory data, and one calibrated by Bayesian methods, using inventories from Swiss natural forest reserves. The calibration changed the parameters relative to the direct estimates, notably for the link between tree size and mortality. The calibrated version predicted decadal-scale forest dynamics better on average than the direct estimates, and to a lesser extent better than the original function, at calibration and validation sites alike, and its long-term projections under contrasting environmental conditions were more plausible than those of the direct estimates. The paper suspects that the mismatch arose mainly because the mortality data under-represent large trees. \par The paper concludes that direct measurements are not always ideal for constraining a complex model so that it produces satisfactory patterns as a whole, and that tree mortality crucially determines simulated forest development. Comparing direct and inverse estimates is therefore informative: the paper argues that a mismatch can reveal structural problems in the model or biases in the data. It notes that generalising from a single case is difficult and that Bayesian calibration is computationally costly.},
  significance_refs = {10.1890/14-1462.1 10.1002/eap.1668},
  license = {publisher (subscription)},
  funding = {Swiss Federal Office for the Environment FOEN, program 'Forests and Climate Change'; Swiss National Science Foundation (140968); European Union (EU) COST Action PROFOUND (FP1304); Bavarian Ministry of Science and the Arts, Bavarian Climate Research Network (bayklif); DFG Priority Program 1374 'Infrastructure-Biodiversity-Exploratories' (DO 786/8-1); EU ERA-NET SUMFOREST project REFORCE},
}

