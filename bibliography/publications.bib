@article{hartig2011statistical,
  author  = {Hartig, Florian and Calabrese, Justin M. and Reineking, Bj{\"o}rn and Wiegand, Thorsten and Huth, Andreas},
  title   = {Statistical inference for stochastic simulation models – theory and application},
  journal = {Ecology Letters},
  year    = {2011},
  volume  = {14},
  number  = {8},
  pages   = {816--827},
  doi     = {10.1111/j.1461-0248.2011.01640.x},
  abstract = {Statistical models are the traditional choice to test scientific theories when observations, processes or boundary conditions are subject to stochasticity. Many important systems in ecology and biology, however, are difficult to capture with statistical models. Stochastic simulation models offer an alternative, but they were hitherto associated with a major disadvantage: their likelihood functions can usually not be calculated explicitly, and thus it is difficult to couple them to well-established statistical theory such as maximum likelihood and Bayesian statistics. A number of new methods, among them Approximate Bayesian Computing and Pattern-Oriented Modelling, bypass this limitation. These methods share three main principles: aggregation of simulated and observed data via summary statistics, likelihood approximation based on the summary statistics, and efficient sampling. We discuss principles as well as advantages and caveats of these methods, and demonstrate their potential for integrating stochastic simulation models into a unified framework for statistical modelling.},
  significance = {Statistical inference in ecology and biology mostly requires a likelihood that can be calculated: the probability of the observed data for given parameter values. Systems in which many individuals interact by chance and are only partly observed usually lack such a likelihood and are modelled with stochastic simulation models. The likelihood of such a model usually cannot be calculated explicitly, so these models were seen as hard to connect to maximum likelihood and Bayesian statistics. Methods that get around this appear to have grown up in separate fields with little exchange. The paper takes on the assumption that a likelihood that cannot be calculated places simulation models outside likelihood-based statistical inference. \par The paper argues that a stochastic simulation model does have a likelihood, which is only implicit (termed implicit statistical models by Diggle and Gratton 1984), and that the methods for connecting such models to data mostly follow the same three steps (not all approximate the likelihood explicitly). Estimating the likelihood by simulation alone is hopelessly inefficient in most practical cases, so the methods (1) reduce observed and simulated data to summary statistics, (2) approximate the likelihood of the observed statistics at a given parameter value, and (3) explore the parameter space efficiently, for example by Markov chain Monte Carlo. For step 2 the paper distinguishes four groups, from nonparametric methods such as Approximate Bayesian Computation, which accept simulations close to the observations, to rejection filters, as in Pattern-Oriented Modelling, which only sort parameter sets by tests against the data. Caveats include that the error of the approximation affects the sampler it is combined with, and that summary statistics adequate for estimating parameters may not be adequate for comparing models. A simulated movement path (summary statistics) and a brown bear model for the Eastern Alps, fitted by rejection of parameter sets (Pattern-Oriented Modelling), serve as examples. \par The paper concludes that, once a likelihood approximation exists, fitting, comparing and checking the uncertainty of a simulation model can follow the logic of any statistical model, so simulation modelling can, in principle, join one statistical framework. It names usability and standardisation as the main open issues and hopes to prompt exchange across communities. Grimm and Railsback (2012) point to it for optimisation techniques when many parameters are calibrated.},
  significance_refs = {10.1111/j.2517-6161.1984.tb01290.x 10.1098/rstb.2011.0180},
  license = {publisher (subscription)},
  featured = {true},
  funding = {ERC advanced grant (FH) (233066)},
}

@article{drechsler2011conserving,
  author  = {Drechsler, Martin and Hartig, Florian},
  title   = {Conserving biodiversity with tradable permits under changing conservation costs and habitat restoration time lags},
  journal = {Ecological Economics},
  year    = {2011},
  volume  = {70},
  number  = {3},
  pages   = {533--541},
  doi     = {10.1016/j.ecolecon.2010.10.004},
  abstract = {Tradable permits are a common environmental policy instrument that has recently been applied also to the conservation of biodiversity. Biodiversity conservation differs in many respects to the classical applications of tradable permits like emissions control. One particularity is that, even if the permit system maintains a constant total amount of species habitat, habitat turnover (the destruction of a habitat and restoration elsewhere) affects the ecosystem. Another particularity is that the restoration of habitats often takes much time, leading to time lags between the initiation of restoration activities and the time when restored habitat is available for trading. We use an agent-based model of a tradable permit market to study the influence of heterogeneous and dynamic conservation costs and habitat restoration time lags on key variables of the market, such as the costs incurred to the market participants and the amount of habitat turnover. Our results show that there may be trade-offs between these key variables. We also find that restoration time lags can lead to fluctuations in permit prices that reduce the efficiency of the permit market. We conclude that temporal lags deserve a careful analysis when implementing tradable permit systems for the preservation of natural habitats and biodiversity.},
  significance = {“Habitat banking” uses tradable permits to protect habitat: destroying a habitat requires a permit, gained by restoring equal habitat elsewhere or bought. For biodiversity, timing matters much more than for greenhouse gases. Each trade destroys a habitat patch and its local populations, and this turnover of habitat can harm species even when the total amount of habitat stays constant. Restoring habitat also takes years, in some cases centuries, so a permit appears long after the decision to restore. Earlier studies of permit markets, mostly on carbon trading, reasonably examined banking and borrowing, but did not consider that changes in management take time and cost money. The paper asks how restoration costs and delays shape habitat permit markets. \par The paper argues that in tradable-permit markets for habitat conservation, restoration costs and time lags shape how the market behaves and deserve careful analysis when such markets are designed. It uses an agent-based model with 1000 landowners, one patch each, whose forgone profits (opportunity costs) differ between patches and fluctuate over time; owners decide on the current permit price and costs. With instant restoration the market is stable, and there is a trade-off: dearer restoration lowers turnover, but also raises the total opportunity cost, because restoration then no longer happens only on the sites where forgone profit is lowest. With delayed restoration, owners restore too much, because the price at decision time no longer holds when the habitat is ready. Permits are then periodically oversupplied, and prices, turnover and costs fluctuate like the classic pork cycle, where producers react to today’s price and cause tomorrow’s glut; this raises average costs. With delay, by contrast, dearer restoration can lower the total opportunity cost, because it curbs the excess. In the base setting, total cost is highest at a one-period delay. \par The results suggest that restoration time lags can make a permit scheme less efficient than with instant restoration, and that with instant restoration low turnover and low opportunity cost can conflict. Because restoration cost affects turnover, the paper suggests a tax on restoration as a possible instrument to steer turnover, higher for species that react more strongly to turnover, and to dampen excess restoration. It names its limits: owners react to current prices only, permits are not banked and space is ignored.},
  license = {publisher (subscription)},
}

@article{johst2011biodiversity,
  author  = {Johst, Karin and Drechsler, Martin and van Teeffelen, Astrid J. A. and Hartig, Florian and Vos, Claire C. and Wissel, Silvia and Wätzold, Frank and Opdam, Paul},
  title   = {Biodiversity conservation in dynamic landscapes: trade-offs between number, connectivity and turnover of habitat patches},
  journal = {Journal of Applied Ecology},
  year    = {2011},
  volume  = {48},
  number  = {5},
  pages   = {1227--1235},
  doi     = {10.1111/j.1365-2664.2011.02015.x},
  abstract = {1. Many species are adapted to landscapes with characteristic dynamics generated by ongoing habitat destruction and creation. Climate change and human land use, however, may change the dynamics of these landscapes. Studies have repeatedly shown that many species are not able to cope with such changes in landscape dynamics. Conservation policies must, therefore, explicitly address this threat. The way in which management should be modified when formerly static landscapes become dynamic or when landscape dynamics change is unclear. 2. Using an analytical formula for the rapid assessment of metapopulation lifetime in dynamic landscapes, we investigate if and how changes in one landscape attribute may be compensated by changes in another attribute to maintain species viability. We study such trade‐offs considering both spatial (number, connectivity of patches) and temporal (patch destruction and creation rates) landscape attributes. 3. We show that increasing patch destruction can be compensated to a certain extent by improvements in other spatial and/or temporal landscape attributes. Focusing on trade‐offs between management options reveals two key factors essential for management decisions: First, the trade‐offs are generally nonlinear irrespective of considering spatial or temporal landscape attributes. Secondly, species can be grouped according to their response to particular management options. 4. Synthesis and applications. We demonstrate the usefulness of an analytical formula for calculating trade‐offs between landscape attributes for a variety of landscapes and species. Two practical and robust management recommendations can be derived: (i) The nonlinearity of trade‐offs implies that the effectiveness of conservation measures depends explicitly on the current level of landscape attributes. It must, therefore, be taken into account in conservation decision making. In particular, the existing level of patch turnover is decisive: if it is already high, improvements in other landscape attributes are ineffective in maintaining species viability. Thus, monitoring the current level of landscape attributes is indispensable for effective biodiversity conservation. (ii) Compensation of increased patch destruction by increased patch creation is only suitable for species with high dispersal propensity adapted to variable environments (aside from habitat patch turnover). This implies that conservation policies which rely on such compensation, like offsetting and conservation banking, are feasible only for this type of species.},
  significance = {Many species live in landscapes where habitat patches are continually destroyed and created. Climate change and land use may alter this turnover, and how management should respond is unclear. For static landscapes, trade-offs between attributes such as patch number and connectivity are well discussed: they quantify how much of one attribute makes up for the loss of another. The paper notes that conservation planning software generally assumes constant exchange ratios between such attributes, and offsetting and conservation banking allow habitat to be destroyed if habitat is created elsewhere. For dynamic landscapes, such trade-offs are unclear, and simulations make a systematic exploration cumbersome. The paper takes on the assumption that one attribute can be traded for another at a fixed rate, whatever the state of the landscape. \par The paper argues that, where habitat patches are continually destroyed and created, trade-offs between landscape attributes such as patch number, connectivity and destruction rate are generally nonlinear and depend on the type of species, so the effect of a conservation measure depends on the landscape’s current state, above all on how fast patches already turn over. It shows this with curves of equal metapopulation lifetime (the mean time until a network of local populations linked by dispersal dies out), calculated from an analytical formula for four example species types that combine low or high dispersal propensity with low or high exposure to environmental fluctuations. Higher connectivity makes up for increased patch destruction only for species with high dispersal propensity, and more patches only for species exposed to strong fluctuations. Creating patches to offset destruction is very effective only while destruction is still low and for species with both high dispersal propensity and strong exposure to fluctuations. \par The paper reads these results as meaning that conservation measures cannot be ranked independently of the landscape’s state and the species type: strategies have to be attuned to each, and monitoring the current state of the landscape is indispensable. It concludes that offsetting and conservation banking suit only good dispersers adapted to variable environments, and only in landscapes with enough well-connected patches but still low turnover. It suggests that the nonlinear trade-offs could help to design differentiated trading rules and improve planning software. The results come from a formula and four example parameter sets, not field data.},
  license = {publisher (subscription)},
  funding = {Deutsche Forschungsgemeinschaft; European Science Foundation (CRP 05_EDIV_FP207-EcoTRADE)},
}

@incollection{watzold2011applying,
  author    = {W{\"a}tzold, Frank and Drechsler, Martin and Hartig, Florian and Wissel, Silvia},
  title     = {Applying tradable permits to biodiversity conservation: design issues, modelling and policies},
  scholar_id = {Zph67rFs4hoC},
  booktitle = {Permit Trading in Different Applications},
  publisher = {Routledge},
  year      = {2011},
  pages      = {157--173},
  note      = {Book chapter, edited by B. Hansj{\"u}rgens, R. Antes and M. Strunz.},
  abstract = {Habitat loss and fragmentation caused by economic development are major threats to the conservation of biodiversity (Millennium Ecosystem Assessment 2005). Policy responses aimed at addressing this threat have so far been inadequate. The main policy response -- the designation of areas as reserves where economic development is not allowed -- has generated some protection. However, the selection of reserves may not have led to a cost-effective allocation of land between areas for conservation and areas for economic development (see Ando et al. 1998 for the general idea of cost-effective land allocation, and Polasky et al. 2008 for an empirical analysis where land allocation is not cost-effective).},
  significance = {Habitat loss and fragmentation caused by economic development are major threats to biodiversity, and the available text judges existing policy responses to be inadequate. The main response has been to designate reserves, areas where economic development is not allowed, and this has generated some protection. The study questions, however, whether the selection of reserves has led to a cost-effective allocation of land between conservation and development. The general idea of cost-effective land allocation is set out in Ando et al. (1998), and the study points to Polasky et al. (2008) as an empirical analysis in which the allocation is not cost-effective. \par The study considers how tradable permits could be applied to biodiversity conservation. Its title names three strands: design issues, modelling and policies. The text available for this note is short and does not report the study’s own findings, so no results are given here. \par What the study concludes about permit design and policy, and how it has been taken up, is not covered by the available text.},
  significance_refs = {10.1126/science.279.5359.2126 10.1016/j.biocon.2008.03.022},
  abstract_kind = {opening},
}

